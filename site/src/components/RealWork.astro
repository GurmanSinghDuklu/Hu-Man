---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { caseStudies } from '../data/content';
import Arrow from './Arrow.astro';
import Laptop from './devices/Laptop.astro';
import Phone from './devices/Phone.astro';

const images = import.meta.glob<{ default: ImageMetadata }>('../assets/work/*.jpg', {
  eager: true,
});
const img = (name: string) => {
  const found = images[`../assets/work/${name}.jpg`];
  if (!found) throw new Error(`Missing work image: ${name}`);
  return found.default;
};
---

<section class="rw" id="real-work" aria-labelledby="rw-title">
  <div class="wrap">
    <div class="rw__head">
      <div class="rw__titles">
        <p class="eyebrow" data-reveal>
          Real work
        </p>
        <h2 id="rw-title" class="section-title" data-reveal>
          Live <span class="hl">projects</span>
        </h2>
      </div>
      <p class="rw__note" data-reveal>
        Sites I've designed and built that are live today. Go and try them.
      </p>
    </div>

    <ol class="rw__list">
      {caseStudies.map((cs, i) => (
        <li class:list={['rw__case', { 'rw__case--flip': i % 2 === 1 }]}>
          <div class="rw__stage" data-reveal aria-hidden="true">
            <div class="rw__glow" />
            <Laptop class="rw__laptop" bg="#0b0b0c">
              <Image
                class="rw__scroll"
                src={img(`${cs.id}-scroll`)}
                alt=""
                width={960}
                format="webp"
                quality={68}
                loading="lazy"
                decoding="async"
              />
            </Laptop>
            <Phone class="rw__phone" bg="#0b0b0c" fg="#ffffff" status={false}>
              <Image
                class="rw__mobile"
                src={img(`${cs.id}-mobile`)}
                alt=""
                width={360}
                format="webp"
                quality={70}
                loading="lazy"
                decoding="async"
              />
            </Phone>
          </div>

          <div class="rw__copy" data-reveal>
            <span class="rw__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{cs.name}</h3>
            <p class="rw__rel">
              <span class="rw__live">Live</span>
              {cs.relationship}
            </p>
            <ul class="rw__tags">
              {cs.tags.map((tag) => (
                <li>{tag}</li>
              ))}
            </ul>
            <dl class="rw__detail">
              <dt>The brief</dt>
              <dd>{cs.brief}</dd>
              <dt>What I built</dt>
              <dd>{cs.built}</dd>
            </dl>
            <a class="btn btn--lime" href={cs.href} rel="noopener">
              Visit the live site
              <span class="btn__icon">
                <Arrow />
              </span>
            </a>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .rw {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .rw__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(2.5rem, 6vw, 4.5rem);
  }

  .rw__titles {
    display: grid;
    gap: var(--space-3);
  }

  .rw__note {
    color: var(--color-text-muted);
    max-width: 24rem;
  }

  .rw__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(4rem, 10vw, 8rem);
  }

  .rw__case {
    display: grid;
    gap: clamp(2rem, 4vw, 3rem);
    align-items: center;
  }

  .rw__stage {
    position: relative;
    padding: 0 8% 10% 0;
  }

  .rw__glow {
    position: absolute;
    inset: 10% 5%;
    border-radius: 50%;
    background: radial-gradient(
      closest-side,
      rgba(0, 255, 48, 0.28),
      rgba(173, 255, 0, 0.08) 60%,
      transparent
    );
    filter: blur(40px);
    z-index: -1;
  }

  .rw__stage :global(.rw__laptop) {
    position: relative;
  }

  .rw__stage :global(.rw__phone) {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 22%;
  }

  .rw__stage :global(.rw__scroll) {
    display: block;
    width: 100%;
    height: auto;
    animation: site-scroll 22s ease-in-out infinite;
  }

  .rw__stage:hover :global(.rw__scroll) {
    animation-play-state: paused;
  }

  @keyframes site-scroll {
    0%,
    12% {
      transform: translateY(0);
    }
    50%,
    62% {
      transform: translateY(-78%);
    }
    100% {
      transform: translateY(0);
    }
  }

  .rw__stage :global(.rw__mobile) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
  }

  .rw__copy {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .rw__num {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--neon);
  }

  .rw__copy h3 {
    font-size: clamp(2rem, 4vw, 3.25rem);
    text-transform: uppercase;
    letter-spacing: -0.04em;
  }

  .rw__rel {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--on-dark-muted);
    font-size: 0.9rem;
  }

  .rw__live {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.2em 0.75em;
    border-radius: var(--radius-pill);
    background: var(--neon);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 700;
    box-shadow: 0 0 16px -4px rgba(0, 255, 48, 0.8);
  }

  .rw__tags {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 0;
    padding: 0;
  }

  .rw__tags li {
    padding: 0.3em 0.9em;
    border-radius: var(--radius-pill);
    border: 1px solid var(--color-line);
    font-size: 0.75rem;
    color: #d6d9de;
  }

  .rw__detail {
    margin: var(--space-3) 0 var(--space-4);
    display: grid;
    gap: 0.35rem;
    max-width: 32rem;
  }

  .rw__detail dt {
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--acid);
  }

  .rw__detail dd {
    margin: 0 0 var(--space-3);
    color: #c9cdd3;
  }

  @media (min-width: 48rem) {
    .rw__head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .rw__note {
      text-align: right;
    }
  }

  @media (min-width: 64rem) {
    .rw__case {
      grid-template-columns: 1.35fr 1fr;
    }

    .rw__case--flip {
      grid-template-columns: 1fr 1.35fr;
    }

    .rw__case--flip .rw__stage {
      order: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .rw__stage :global(.rw__scroll) {
      animation: none;
    }
  }
</style>
