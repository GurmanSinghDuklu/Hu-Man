---
import { services } from '../data/content';

const panels = [
  {
    id: 'development',
    title: 'Development',
    tone: 'magenta',
    intro: 'Fast, mobile-first sites and apps, moved over without losing what you have earned.',
  },
  {
    id: 'ai',
    title: 'AI and automation',
    tone: 'blue',
    intro: 'Assistants that answer from your own information, and follow-ups that run themselves.',
  },
  {
    id: 'visibility',
    title: 'Visibility and care',
    tone: 'ember',
    intro: 'Found on Google and in AI search, then kept fast, safe and up to date.',
  },
] as const;
---

<section class="services" id="services" aria-labelledby="services-title">
  <h2 id="services-title" class="visually-hidden">
    Services
  </h2>

  <article class="panel panel--design" id="design" aria-labelledby="design-title">
    <div class="wrap panel__inner">
      <h3 id="design-title" class="panel__title">
        Design
      </h3>
      <div class="panel__body">
        <div class="panel__blob panel__blob--design" aria-hidden="true"></div>
        <p class="panel__intro">
          High-end, mobile-first design for local businesses. You see a mock-up of your new site
          before any build starts.
        </p>
        <a href="#work" class="pill-btn">
          See concept work
        </a>
      </div>
    </div>
  </article>

  {panels.map((panel) => (
    <article
      class={`panel panel--${panel.tone}`}
      id={panel.id}
      aria-labelledby={`${panel.id}-title`}
    >
      <div class="wrap panel__inner">
        <h3 id={`${panel.id}-title`} class="panel__title">
          {panel.title}
        </h3>
        <div class="panel__body">
          {panel.tone === 'ember' && (
            <div class="panel__blob panel__blob--ember" aria-hidden="true" />
          )}
          <p class="panel__intro">{panel.intro}</p>
          <ul class="panel__list">
            {services
              .filter((s) => s.group === panel.id)
              .map((service) => (
                <li>
                  <details>
                    <summary>
                      <span>{service.title}</span>
                      <span class="panel__tag">{service.tag}</span>
                      <span class="panel__plus" aria-hidden="true" />
                    </summary>
                    <p>{service.description}</p>
                  </details>
                </li>
              ))}
          </ul>
        </div>
      </div>
    </article>
  ))}
</section>

<style>
  .panel {
    position: relative;
    overflow: hidden;
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
    background: #000;
  }

  .panel--magenta {
    background:
      radial-gradient(80% 120% at 0% 100%, rgba(233, 90, 40, 0.55), transparent 60%),
      linear-gradient(120deg, #5a0a3e 0%, #8e0f6a 45%, #b0137e 100%);
  }

  .panel--blue {
    background:
      radial-gradient(70% 120% at 100% 0%, rgba(77, 142, 240, 0.6), transparent 60%),
      linear-gradient(120deg, #06102a 0%, #0f2f78 55%, #1c6cdc 100%);
  }

  .panel--ember {
    background: #000;
  }

  .panel__inner {
    display: grid;
    gap: var(--space-5);
  }

  .panel__title {
    font-size: clamp(2.75rem, 6.5vw, 5rem);
    font-weight: 500;
    letter-spacing: -0.05em;
  }

  .panel__body {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 36rem;
  }

  .panel__intro {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.5;
  }

  .panel__blob {
    width: clamp(120px, 16vw, 190px);
    aspect-ratio: 1;
    border-radius: 22%;
    filter: blur(14px);
    margin-bottom: var(--space-3);
  }

  .panel__blob--design {
    background: radial-gradient(
      circle at 50% 55%,
      #1ea0ff 0%,
      #1c6cdc 30%,
      #c21a9c 72%,
      #7a0a62 100%
    );
  }

  .panel__blob--ember {
    background: radial-gradient(
      circle at 50% 55%,
      #8a2bff 0%,
      #b23cd6 25%,
      #ff6a1a 70%,
      #ff9a3c 100%
    );
  }

  .panel__list {
    list-style: none;
    width: 100%;
    margin: 0;
    padding: 0;
  }

  .panel__list li {
    border-bottom: 1px solid rgba(255, 255, 255, 0.35);
  }

  .panel__list summary {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: var(--space-3);
    padding-block: 1.3rem;
    cursor: pointer;
    text-transform: uppercase;
    font-size: clamp(0.95rem, 1.3vw, 1.05rem);
    letter-spacing: 0.01em;
  }

  .panel__list summary::-webkit-details-marker {
    display: none;
  }

  .panel__tag {
    font-size: 0.72rem;
    text-transform: none;
    padding: 0.25em 0.8em;
    border-radius: var(--radius-pill);
    border: 1px solid rgba(255, 255, 255, 0.5);
    white-space: nowrap;
  }

  .panel__plus {
    position: relative;
    width: 18px;
    height: 18px;
  }

  .panel__plus::before,
  .panel__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 16px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.3s var(--ease-out);
  }

  .panel__plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .panel__plus::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .panel__list details p {
    padding-bottom: 1.3rem;
    max-width: 32rem;
    color: rgba(255, 255, 255, 0.9);
  }

  @media (min-width: 60rem) {
    .panel__inner {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .panel__body {
      max-width: 34rem;
    }
  }
</style>
