---
import { Image } from 'astro:assets';
import { services, type Service } from '../data/content';
import { projectImage } from '../data/projects';

// Three focus areas instead of a six-row list. Care plans are a monthly add-on, so they
// live with pricing, not here. Each area opens with a black-and-white frame cut by a
// see-through brand shape (the Swiss shape-over-photo reference).
interface Area {
  id: Service['group'];
  code: string;
  title: string;
  /** SVG path(s) on a 100 x 100 square, filled with the band colour over the photo. */
  shape: string;
  image: string;
  /** Shown under the frame when the image is a concept render, not a real project. */
  note?: string;
}

const areas: Area[] = [
  {
    id: 'development',
    code: 'Web',
    title: 'Websites, booking and payments',
    // Two corner arcs, opposite each other.
    shape: 'M0 0H56A56 56 0 0 1 0 56Z M100 100H58A42 42 0 0 1 100 58Z',
    image: 'work/essence-desktop',
  },
  {
    id: 'ai',
    code: 'AI',
    title: 'AI assistants and automations',
    // Four corner quarter-circles: the photo shows through a concave star.
    shape:
      'M0 0H48A48 48 0 0 1 0 48Z M100 0V48A48 48 0 0 1 52 0Z M100 100H52A48 48 0 0 1 100 52Z M0 100V52A48 48 0 0 1 48 100Z',
    image: 'concepts/assistant',
    note: 'Concept render, fictional business',
  },
  {
    id: 'visibility',
    code: 'Search',
    title: 'Local and AI-search visibility',
    // A half-disc hanging from the top edge, and a small quarter in the corner.
    shape: 'M100 0A50 50 0 0 1 0 0Z M0 100V68A32 32 0 0 1 32 100Z',
    image: 'work/calculator-desktop',
  },
];

// Each frame glitches in its own colour now and then.
const glitchColours = ['pulse', 'flare', 'scan'];

const byArea = (id: Area['id']) => services.filter((s) => s.group === id && s.tag !== 'Care plan');
---

<section class="services night" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services__head">
      <h2 id="services-title" class="section-title" data-reveal>
        What we do
      </h2>
      <p data-reveal>
        Local businesses deserve websites as good as the national brands'. We design, build and test
        every site, app and assistant, then look after it month by month. If something breaks, call
        us. We fix it.
      </p>
    </div>

    <ol class="services__areas">
      {areas.map((area, i) => (
        <li class="area" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
          <figure class="area__frame" aria-hidden="true">
            <Image
              src={projectImage(area.image)}
              alt=""
              width={560}
              format="webp"
              quality={60}
              loading="lazy"
              decoding="async"
            />
            <svg class="area__shape" viewBox="0 0 100 100" preserveAspectRatio="none">
              <path d={area.shape} />
            </svg>
            <span
              class="area__glitch"
              style={`--g:var(--${glitchColours[i]});--d:${(i * 1.9).toFixed(1)}s`}
            />
            <span class="area__code">{area.code}</span>
          </figure>
          {area.note && <p class="area__note">{area.note}</p>}
          <h3>{area.title}</h3>
          <ul class="area__list">
            {byArea(area.id).map((service) => (
              <li>
                <h4>{service.title}</h4>
                <p>{service.description}</p>
                <span class="tag area__tag">From {service.tag}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .services__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .services__head p {
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }

  .services__areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 6vw, 2.5rem);
  }

  .area {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  /* A square photo cell with a brand shape laid over it in the band's own colour, so the
     photo shows only through the gaps in the shape. */
  .area__frame {
    position: relative;
    margin: 0;
    aspect-ratio: 1;
    overflow: hidden;
    background: var(--surface-raised);
  }

  .area__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    filter: grayscale(1) contrast(1.1);
  }

  .area__shape {
    fill: var(--surface);
  }

  .area__frame .area__shape {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  /* A band of colour flashes across the photo and jumps sideways, twice, every few seconds. */
  .area__glitch {
    position: absolute;
    inset: 0;
    background: var(--g);
    clip-path: inset(38% 0 48% 0);
    opacity: 0;
    pointer-events: none;
    animation: area-glitch 5.5s steps(1, end) infinite var(--d);
  }

  @keyframes area-glitch {
    0%,
    100% {
      opacity: 0;
      transform: none;
    }
    86% {
      opacity: 1;
      transform: translateX(-5%);
    }
    89% {
      opacity: 0;
    }
    91% {
      opacity: 1;
      transform: translate(4%, 160%);
    }
    94% {
      opacity: 0;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .area__glitch {
      animation: none;
    }
  }

  .area__code {
    position: absolute;
    left: 0;
    bottom: 0;
    padding: 0.55rem 0.8rem 0.45rem;
    background: var(--signal);
    color: var(--on-signal);
    font: 800 clamp(1.5rem, 3vw, 2.25rem) / 1 var(--font-display);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .area__note {
    margin-top: calc(var(--space-3) * -1);
    font: 500 0.75rem/1.35 var(--font-mono);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .area h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .area__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-hairline) solid var(--line);
  }

  .area__list li {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding-block: var(--space-4);
    border-bottom: var(--border-hairline) solid var(--line);
  }

  .area__list h4 {
    font: 700 1.0625rem/1.3 var(--font-text);
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-text);
  }

  .area__list p {
    color: var(--ink-muted);
  }

  .area__tag {
    border-color: var(--line-strong);
  }

  @media (min-width: 48rem) {
    .services__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  @media (min-width: 64rem) {
    .services__areas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
