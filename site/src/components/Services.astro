---
import { services, type Service } from '../data/content';
import Module, { type ModuleKind, type ModuleColour } from './Module.astro';

// Three focus areas instead of a six-row list. Care plans are a monthly add-on, so they live
// with pricing, not here. Each area is marked by one square, the width of its column, that
// glitches from one module-kit image to the next (2026-10-17; photos cut by shapes and 3 x 2
// posters were tried first and rejected).
type Mark = [ModuleKind, ModuleColour, ModuleColour];

interface Area {
  id: Service['group'];
  code: string;
  title: string;
  /** The images the square glitches through, in order. */
  marks: Mark[];
}

const areas: Area[] = [
  {
    id: 'development',
    code: 'Web',
    title: 'Websites, booking and payments',
    marks: [
      ['rings', 'pulse', 'ink'],
      ['checker', 'ink', 'paper'],
      ['stripes', 'flare', 'ink'],
      ['half', 'paper', 'ink'],
      ['squares', 'signal', 'ink'],
    ],
  },
  {
    id: 'ai',
    code: 'AI',
    title: 'AI assistants and automations',
    marks: [
      ['ridge', 'ink', 'signal'],
      ['burst', 'volt', 'ink'],
      ['dots', 'scan', 'ink'],
      ['sparkle', 'paper', 'ink'],
      ['linearcs', 'pulse', 'ink'],
    ],
  },
  {
    id: 'visibility',
    code: 'Search',
    title: 'Local and AI-search visibility',
    marks: [
      ['hex', 'scan', 'ink'],
      ['arc', 'paper', 'ink'],
      ['hourglass', 'ink', 'signal'],
      ['field', 'paper', 'ink'],
      ['slash', 'flare', 'ink'],
    ],
  },
];

// Each image holds for this long; the three squares are offset so they never change together.
const SLOT = 2.4;
const COUNT = 5;

const byArea = (id: Area['id']) => services.filter((s) => s.group === id && s.tag !== 'Care plan');
---

<section class="services night" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services__head">
      <h2 id="services-title" class="section-title" data-reveal>
        What we do
      </h2>
      <p data-reveal>
        Local businesses deserve websites as good as the national brands'. We design, build and test
        every site, app and assistant, then look after it month by month. If something breaks, call
        us. We fix it.
      </p>
    </div>

    <ol class="services__areas">
      {areas.map((area, i) => (
        <li class="area" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
          <div class="area__top">
            <span
              class="area__mark"
              aria-hidden="true"
              style={`--slot:${SLOT}s;--cycle:${SLOT * COUNT}s;--off:${(i * 0.8).toFixed(1)}s`}
            >
              {area.marks.map(([kind, fg, bg], k) => (
                <span class="area__layer" style={`--k:${(COUNT - k) % COUNT}`}>
                  <Module kind={kind} fg={fg} bg={bg} spin={kind === 'rings' || kind === 'hex'} />
                </span>
              ))}
              <span class="area__slice area__slice--a" />
              <span class="area__slice area__slice--b" />
            </span>
            <span class="area__code">{`0${i + 1} · ${area.code}`}</span>
          </div>
          <h3>{area.title}</h3>
          <ul class="area__list">
            {byArea(area.id).map((service) => (
              <li>
                <h4>{service.title}</h4>
                <p>{service.description}</p>
                <span class="tag area__tag">From {service.tag}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .services__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .services__head p {
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }

  .services__areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 6vw, 2.5rem);
  }

  .area {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .area__top {
    display: grid;
    gap: 0.75rem;
  }

  /* One square, the width of the column, holding a stack of module-kit images. */
  .area__mark {
    position: relative;
    display: block;
    aspect-ratio: 1;
    overflow: hidden;
    border: var(--border-hairline) solid var(--line);
    background: var(--brand-ink);
  }

  .area__layer {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: area-swap var(--cycle) steps(1, end) infinite;
    /* Always negative, so every layer is mid-cycle from the first frame (no empty square). */
    animation-delay: calc(var(--off) - var(--k) * var(--slot) - var(--cycle));
  }

  .area__layer :global(.mod) {
    width: 100%;
    height: 100%;
  }

  /* Each image shows for one slot in five, then cuts straight to the next. */
  @keyframes area-swap {
    0% {
      opacity: 1;
      transform: none;
    }
    1% {
      transform: translateX(-6%);
    }
    2% {
      transform: translateX(4%);
    }
    3% {
      transform: none;
    }
    20%,
    100% {
      opacity: 0;
    }
  }

  /* The glitch on every change: two colour bands jump across the square for a moment. */
  .area__slice {
    position: absolute;
    left: 0;
    right: 0;
    opacity: 0;
    pointer-events: none;
    animation: area-slice var(--slot) steps(1, end) infinite var(--off);
  }

  .area__slice--a {
    top: 22%;
    height: 14%;
    background: var(--pulse);
  }

  .area__slice--b {
    top: 61%;
    height: 9%;
    background: var(--scan);
    animation-delay: calc(var(--off) + 0.05s);
  }

  @keyframes area-slice {
    0% {
      opacity: 1;
      transform: translateX(-12%);
    }
    3% {
      transform: translateX(9%);
    }
    6%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  .area__code {
    font: 500 0.75rem/1.35 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* Reduced motion: the first image only, still. */
  @media (prefers-reduced-motion: reduce) {
    .area__layer,
    .area__slice {
      animation: none;
    }

    .area__layer:first-child {
      opacity: 1;
    }
  }

  .area h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .area__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-hairline) solid var(--line);
  }

  .area__list li {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding-block: var(--space-4);
    border-bottom: var(--border-hairline) solid var(--line);
  }

  .area__list h4 {
    font: 700 1.0625rem/1.3 var(--font-text);
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-text);
  }

  .area__list p {
    color: var(--ink-muted);
  }

  .area__tag {
    border-color: var(--line-strong);
  }

  @media (min-width: 48rem) {
    .services__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  @media (min-width: 64rem) {
    .services__areas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
