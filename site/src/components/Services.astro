---
import { services } from '../data/content';
import Arrow from './Arrow.astro';
import RenderPhysioSite from './renders/RenderPhysioSite.astro';
import RenderBarberApp from './renders/RenderBarberApp.astro';
import RenderAssistant from './renders/RenderAssistant.astro';
import RenderSalonSite from './renders/RenderSalonSite.astro';
import RenderOwnerDigest from './renders/RenderOwnerDigest.astro';
import RenderTradesDashboard from './renders/RenderTradesDashboard.astro';

// One preview render per service, in the same order as `services`.
const previews = [
  RenderPhysioSite,
  RenderBarberApp,
  RenderAssistant,
  RenderSalonSite,
  RenderOwnerDigest,
  RenderTradesDashboard,
];
---

<section class="services on-dark" id="services" aria-labelledby="services-title" data-services>
  <div class="wrap">
    <div class="services__head">
      <p class="eyebrow" data-reveal>
        Services
      </p>
      <h2 id="services-title" class="section-title" data-reveal>
        What I <span class="hl">do</span>
      </h2>
    </div>

    <div class="services__layout">
      <ol class="services__list">
        {services.map((service, i) => (
          <li
            class:list={['services__item', { 'is-active': i === 0 }]}
            data-service={i}
            data-reveal
          >
            <span class="services__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="services__body">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
            <span class="services__tag">{service.tag}</span>
          </li>
        ))}
      </ol>

      <div class="services__preview" aria-hidden="true">
        <div class="services__frame">
          {previews.map((Preview, i) => (
            <div class:list={['services__slide', { 'is-active': i === 0 }]} data-slide={i}>
              <Preview ratio="4 / 3.2" />
            </div>
          ))}
        </div>
        <p class="services__caption">Concept render · fictional business</p>
        <a href="#work" class="btn btn--lime services__cta" tabindex="-1">
          See concept work
          <span class="btn__icon">
            <Arrow />
          </span>
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/services-preview.ts';
</script>

<style>
  .services {
    position: relative;
    margin-inline: clamp(0.5rem, 1.5vw, 1.25rem);
    border-radius: var(--radius-xl);
    background:
      radial-gradient(55% 45% at 92% 0%, rgba(173, 255, 0, 0.1), transparent 70%),
      radial-gradient(60% 55% at 0% 100%, rgba(0, 255, 48, 0.12), transparent 70%),
      var(--graphite-1);
    border: 1px solid var(--color-line);
    color: var(--on-dark);
    padding-block: clamp(4rem, 9vw, 7rem);
    overflow: hidden;
  }

  .services__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .services__layout {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--on-dark-line);
  }

  .services__item {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.5rem 1rem;
    padding-block: clamp(1.25rem, 2.4vw, 1.75rem);
    border-bottom: 1px solid var(--on-dark-line);
    transition:
      padding 0.4s var(--ease-out),
      background-color 0.3s;
    cursor: default;
  }

  .services__num {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--on-dark-muted);
    padding-top: 0.55em;
  }

  .services__body h3 {
    font-size: clamp(1.4rem, 2.8vw, 2.25rem);
    text-transform: uppercase;
    letter-spacing: -0.035em;
    font-weight: 800;
    color: rgba(255, 255, 255, 0.55);
    transition: color 0.3s;
  }

  .services__body p {
    margin-top: 0.6rem;
    max-width: 34rem;
    color: var(--on-dark-muted);
    font-size: 0.95rem;
  }

  .services__tag {
    grid-column: 2;
    justify-self: start;
    font-size: 0.72rem;
    font-weight: 600;
    padding: 0.3em 0.9em;
    border-radius: var(--radius-pill);
    border: 1px solid var(--on-dark-line);
    color: var(--on-dark-muted);
  }

  .services__item.is-active .services__body h3,
  .services__item:hover .services__body h3 {
    color: #fff;
  }

  .services__item.is-active .services__num {
    color: var(--neon);
  }

  .services__item.is-active .services__tag {
    background: var(--neon);
    color: var(--ink);
    border-color: var(--neon);
  }

  .services__preview {
    display: none;
  }

  @media (min-width: 62rem) {
    .services__layout {
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    /* Inactive descriptions are visually hidden but stay in the accessibility tree. */
    .services__item:not(.is-active) .services__body p {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      margin: 0;
    }

    .services__item.is-active .services__body p {
      animation: fadeUp 0.45s var(--ease-out);
    }

    .services__preview {
      display: grid;
      gap: var(--space-3);
      position: sticky;
      top: 110px;
    }

    .services__frame {
      position: relative;
      border-radius: var(--radius-lg);
      overflow: hidden;
      box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.7);
      aspect-ratio: 4 / 3.2;
    }

    .services__slide {
      position: absolute;
      inset: 0;
      opacity: 0;
      transform: scale(1.04);
      transition:
        opacity 0.6s var(--ease-out),
        transform 0.9s var(--ease-out);
    }

    .services__slide.is-active {
      opacity: 1;
      transform: none;
    }

    .services__slide :global(.tile) {
      border-radius: 0;
    }

    .services__caption {
      font-size: 0.8rem;
      color: var(--on-dark-muted);
    }

    .services__cta {
      justify-self: start;
    }
  }

  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }
</style>
