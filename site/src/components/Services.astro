---
import { services } from '../data/content';
import RenderPhysioSite from './renders/RenderPhysioSite.astro';
import RenderBarberApp from './renders/RenderBarberApp.astro';
import RenderAssistant from './renders/RenderAssistant.astro';
import RenderSalonSite from './renders/RenderSalonSite.astro';
import RenderOwnerDigest from './renders/RenderOwnerDigest.astro';
import RenderTradesDashboard from './renders/RenderTradesDashboard.astro';

// One preview render per service, in the same order as `services`.
const previews = [
  RenderPhysioSite,
  RenderBarberApp,
  RenderAssistant,
  RenderSalonSite,
  RenderOwnerDigest,
  RenderTradesDashboard,
];
---

<section class="services on-dark" id="services" aria-labelledby="services-title" data-services>
  <div class="wrap">
    <div class="services__head">
      <p class="eyebrow" data-reveal>
        Services
      </p>
      <h2 id="services-title" class="section-title" data-reveal>
        What I <span class="hl">do</span>
      </h2>
    </div>

    <div class="services__layout">
      <ol class="services__list">
        {services.map((service, i) => (
          <li
            class:list={['services__item', { 'is-active': i === 0 }]}
            data-service={i}
            data-reveal
          >
            <span class="services__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <div class="services__body">
              <h3>{service.title}</h3>
              <p>{service.description}</p>
            </div>
            <span class="tag services__tag">{service.tag}</span>
          </li>
        ))}
      </ol>

      <div class="services__preview" aria-hidden="true">
        <div class="services__frame">
          {previews.map((Preview, i) => (
            <div class:list={['services__slide', { 'is-active': i === 0 }]} data-slide={i}>
              <Preview ratio="4 / 3.2" />
            </div>
          ))}
        </div>
        <p class="services__caption">Concept render · fictional business</p>
        <a href="#work" class="btn btn--secondary services__cta" tabindex="-1">
          See concept work
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  import '../scripts/services-preview.ts';
</script>

<style>
  .services {
    position: relative;
    background: var(--brand-ink);
    border-top: var(--border-hairline) solid var(--line);
    color: var(--on-dark);
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .services__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .services__layout {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .services__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-hairline) solid var(--line);
  }

  .services__item {
    position: relative;
    display: grid;
    grid-template-columns: 2.75rem 1fr;
    gap: 0.6rem 1rem;
    padding-block: clamp(1.25rem, 2.4vw, 1.75rem);
    border-bottom: var(--border-hairline) solid var(--line);
    cursor: default;
  }

  /* The active row gets a Signal bar on its left edge. */
  .services__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: -1px;
    bottom: -1px;
    width: 4px;
    background: var(--signal);
    opacity: 0;
  }

  .services__num {
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.1em;
    color: var(--on-dark-muted);
    padding: 0.7em 0 0 0.9rem;
  }

  .services__body h3 {
    font-size: clamp(1.4rem, 2.8vw, 2.25rem);
    color: var(--ink-muted);
    transition: color 0.15s linear;
  }

  .services__body p {
    margin-top: 0.6rem;
    max-width: 34rem;
    color: var(--ink-text);
    font-size: 1rem;
  }

  .services__tag {
    grid-column: 2;
    justify-self: start;
    color: var(--on-dark-muted);
    border-color: var(--line);
  }

  .services__item.is-active::before {
    opacity: 1;
  }

  .services__item.is-active .services__body h3,
  .services__item:hover .services__body h3 {
    color: var(--ink-text);
  }

  .services__item.is-active .services__num {
    color: var(--signal);
  }

  .services__item.is-active .services__tag {
    background: var(--signal);
    color: var(--on-signal);
    border-color: var(--signal);
  }

  .services__preview {
    display: none;
  }

  @media (min-width: 62rem) {
    .services__layout {
      grid-template-columns: 1.1fr 1fr;
      gap: clamp(2.5rem, 5vw, 5rem);
    }

    /* Inactive descriptions are visually hidden but stay in the accessibility tree. */
    .services__item:not(.is-active) .services__body p {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip-path: inset(50%);
      white-space: nowrap;
      margin: 0;
    }

    .services__preview {
      display: grid;
      gap: var(--space-3);
      position: sticky;
      top: 100px;
    }

    .services__frame {
      position: relative;
      overflow: hidden;
      aspect-ratio: 4 / 3.2;
      border: var(--border-hairline) solid var(--line);
    }

    /* Slides cut, they don't cross-fade or scale. */
    .services__slide {
      position: absolute;
      inset: 0;
      visibility: hidden;
    }

    .services__slide.is-active {
      visibility: visible;
    }

    .services__slide :global(.tile) {
      border-radius: 0;
    }

    .services__caption {
      font: 500 0.75rem var(--font-mono);
      letter-spacing: 0.12em;
      text-transform: uppercase;
      color: var(--on-dark-muted);
    }

    .services__cta {
      justify-self: start;
    }
  }
</style>
