---
import { services, type Service } from '../data/content';
import Module, { type ModuleKind, type ModuleColour } from './Module.astro';

// Three focus areas instead of a six-row list. Care plans are a monthly add-on, so they live
// with pricing, not here. Each area is marked by one small square from the brand's module kit,
// which glitches in another colour now and then. (Photos cut by shapes, then 3 x 2 posters,
// were both tried on 2026-10-17 and rejected: too odd, then too big.)
interface Area {
  id: Service['group'];
  code: string;
  title: string;
  mark: [ModuleKind, ModuleColour, ModuleColour];
  flash: string;
}

const areas: Area[] = [
  {
    id: 'development',
    code: 'Web',
    title: 'Websites, booking and payments',
    mark: ['rings', 'pulse', 'ink'],
    flash: 'flare',
  },
  {
    id: 'ai',
    code: 'AI',
    title: 'AI assistants and automations',
    mark: ['ridge', 'ink', 'signal'],
    flash: 'pulse',
  },
  {
    id: 'visibility',
    code: 'Search',
    title: 'Local and AI-search visibility',
    mark: ['hex', 'scan', 'ink'],
    flash: 'volt',
  },
];

const byArea = (id: Area['id']) => services.filter((s) => s.group === id && s.tag !== 'Care plan');
---

<section class="services night" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services__head">
      <h2 id="services-title" class="section-title" data-reveal>
        What we do
      </h2>
      <p data-reveal>
        Local businesses deserve websites as good as the national brands'. We design, build and test
        every site, app and assistant, then look after it month by month. If something breaks, call
        us. We fix it.
      </p>
    </div>

    <ol class="services__areas">
      {areas.map((area, i) => (
        <li class="area" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
          <div class="area__top">
            <span
              class="area__mark"
              aria-hidden="true"
              style={`--g:var(--${area.flash});--d:${(i * 1.6).toFixed(1)}s`}
            >
              <Module kind={area.mark[0]} fg={area.mark[1]} bg={area.mark[2]} />
            </span>
            <span class="area__code">{`0${i + 1} · ${area.code}`}</span>
          </div>
          <h3>{area.title}</h3>
          <ul class="area__list">
            {byArea(area.id).map((service) => (
              <li>
                <h4>{service.title}</h4>
                <p>{service.description}</p>
                <span class="tag area__tag">From {service.tag}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .services__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .services__head p {
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }

  .services__areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 6vw, 2.5rem);
  }

  .area {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .area__top {
    display: flex;
    align-items: flex-end;
    gap: var(--space-3);
  }

  /* One small square module per area. */
  .area__mark {
    position: relative;
    flex: none;
    width: 4.5rem;
    aspect-ratio: 1;
    overflow: hidden;
    border: var(--border-hairline) solid var(--line);
  }

  .area__mark :global(.mod) {
    width: 100%;
    height: 100%;
  }

  .area__code {
    font: 500 0.75rem/1.35 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  /* The glitch: a block of another colour flashes over the square, twice. */
  .area__mark::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--g);
    opacity: 0;
    animation: area-flash 4.5s steps(1, end) infinite var(--d);
  }

  @keyframes area-flash {
    0%,
    100% {
      opacity: 0;
      transform: none;
    }
    80% {
      opacity: 1;
      transform: translateX(-8%);
    }
    84% {
      opacity: 0;
    }
    88% {
      opacity: 1;
      transform: translateX(6%) scaleY(0.4);
    }
    91% {
      opacity: 0;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .area__mark::after {
      animation: none;
    }
  }

  .area h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .area__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-hairline) solid var(--line);
  }

  .area__list li {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding-block: var(--space-4);
    border-bottom: var(--border-hairline) solid var(--line);
  }

  .area__list h4 {
    font: 700 1.0625rem/1.3 var(--font-text);
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-text);
  }

  .area__list p {
    color: var(--ink-muted);
  }

  .area__tag {
    border-color: var(--line-strong);
  }

  @media (min-width: 48rem) {
    .services__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  @media (min-width: 64rem) {
    .services__areas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
