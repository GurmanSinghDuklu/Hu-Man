---
import { services, type Service } from '../data/content';
import Module, { type ModuleKind, type ModuleColour } from './Module.astro';

// Three focus areas instead of a six-row list. Care plans are a monthly add-on, so they live
// with pricing, not here. Each area opens with a small modular poster from the brand's module
// kit: the area's name in a solid block, kit patterns around it (2026-10-17, replacing photos
// cut by shapes, which read as odd crops).
type PosterCell =
  | { text: string; bg: 'signal' | 'paper' | 'pulse'; wide?: boolean }
  | { mod: [ModuleKind, ModuleColour, ModuleColour]; flash?: string };

interface Area {
  id: Service['group'];
  title: string;
  /** Six slots on a 3 x 2 grid; a wide text cell takes two. */
  poster: PosterCell[];
}

const areas: Area[] = [
  {
    id: 'development',
    title: 'Websites, booking and payments',
    poster: [
      { mod: ['rings', 'pulse', 'ink'] },
      { mod: ['checker', 'ink', 'paper'], flash: 'flare' },
      { mod: ['stripes', 'flare', 'ink'] },
      { text: 'Web', bg: 'signal', wide: true },
      { mod: ['half', 'paper', 'ink'] },
    ],
  },
  {
    id: 'ai',
    title: 'AI assistants and automations',
    poster: [
      { mod: ['ridge', 'ink', 'signal'] },
      { text: 'AI', bg: 'paper', wide: true },
      { mod: ['hex', 'scan', 'ink'], flash: 'pulse' },
      { mod: ['burst', 'volt', 'ink'] },
      { mod: ['squares', 'ink', 'paper'] },
    ],
  },
  {
    id: 'visibility',
    title: 'Local and AI-search visibility',
    poster: [
      { mod: ['dots', 'signal', 'ink'] },
      { mod: ['arc', 'paper', 'ink'] },
      { mod: ['hourglass', 'ink', 'paper'], flash: 'scan' },
      { mod: ['linearcs', 'flare', 'ink'] },
      { text: 'Search', bg: 'pulse', wide: true },
    ],
  },
];

const byArea = (id: Area['id']) => services.filter((s) => s.group === id && s.tag !== 'Care plan');
---

<section class="services night" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="services__head">
      <h2 id="services-title" class="section-title" data-reveal>
        What we do
      </h2>
      <p data-reveal>
        Local businesses deserve websites as good as the national brands'. We design, build and test
        every site, app and assistant, then look after it month by month. If something breaks, call
        us. We fix it.
      </p>
    </div>

    <ol class="services__areas">
      {areas.map((area, i) => (
        <li class="area" data-reveal style={`--reveal-delay:${i * 0.1}s`}>
          <div class="area__poster" aria-hidden="true" data-cells>
            {area.poster.map((cell, k) =>
              'text' in cell ? (
                <span
                  class:list={[
                    'area__cell',
                    'area__word',
                    `area__word--${cell.bg}`,
                    { 'is-wide': cell.wide },
                  ]}
                >
                  {cell.text}
                </span>
              ) : (
                <span
                  class:list={['area__cell', { 'is-flash': cell.flash }]}
                  style={
                    cell.flash
                      ? `--g:var(--${cell.flash});--d:${(i * 1.9 + k * 0.4).toFixed(1)}s`
                      : undefined
                  }
                >
                  <Module kind={cell.mod[0]} fg={cell.mod[1]} bg={cell.mod[2]} />
                </span>
              ),
            )}
          </div>
          <h3>{area.title}</h3>
          <ul class="area__list">
            {byArea(area.id).map((service) => (
              <li>
                <h4>{service.title}</h4>
                <p>{service.description}</p>
                <span class="tag area__tag">From {service.tag}</span>
              </li>
            ))}
          </ul>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .services {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .services__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(2.5rem, 6vw, 4rem);
  }

  .services__head p {
    max-width: 38rem;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }

  .services__areas {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(3rem, 6vw, 2.5rem);
  }

  .area {
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  /* A small modular poster: a flush 3 x 2 grid of square cells, one wide name block. */
  .area__poster {
    container-type: inline-size;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border: var(--border-hairline) solid var(--line);
    background: var(--brand-ink);
  }

  .area__cell {
    position: relative;
    overflow: hidden;
    aspect-ratio: 1;
  }

  .area__cell.is-wide {
    grid-column: span 2;
    aspect-ratio: 2 / 1;
  }

  .area__word {
    display: flex;
    align-items: flex-end;
    padding: 4cqw;
    color: var(--brand-ink);
    font: 800 14cqw / 0.85 var(--font-display);
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .area__word--signal {
    background: var(--signal);
  }

  .area__word--paper {
    background: var(--brand-paper);
  }

  .area__word--pulse {
    background: var(--pulse);
  }

  /* One cell per poster glitches: a block of another colour flashes over it, twice. */
  .area__cell.is-flash::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--g);
    opacity: 0;
    animation: area-flash 4.5s steps(1, end) infinite var(--d);
  }

  @keyframes area-flash {
    0%,
    100% {
      opacity: 0;
      transform: none;
    }
    80% {
      opacity: 1;
      transform: translateX(-8%);
    }
    84% {
      opacity: 0;
    }
    88% {
      opacity: 1;
      transform: translateX(6%) scaleY(0.4);
    }
    91% {
      opacity: 0;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .area__cell.is-flash::after {
      animation: none;
    }
  }

  .area h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .area__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-hairline) solid var(--line);
  }

  .area__list li {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
    padding-block: var(--space-4);
    border-bottom: var(--border-hairline) solid var(--line);
  }

  .area__list h4 {
    font: 700 1.0625rem/1.3 var(--font-text);
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-text);
  }

  .area__list p {
    color: var(--ink-muted);
  }

  .area__tag {
    border-color: var(--line-strong);
  }

  @media (min-width: 48rem) {
    .services__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }

  @media (min-width: 64rem) {
    .services__areas {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
