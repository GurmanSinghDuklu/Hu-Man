---
/** Diagonal arrow used inside buttons and cards. Decorative. */
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

<svg
  class={className}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  aria-hidden="true"
>
  <path d="M7 17 17 7M8.5 7H17v8.5" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
