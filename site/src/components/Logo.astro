---
/**
 * The Hu/man wordmark: fixed artwork from the brand pack, never retyped
 * (docs/brand/2-identity.md). Inlined so it stays sharp and costs no request.
 *   signal: the primary, gradient on Ink grounds
 *   paper:  one colour, on Ink or dark photos
 *   ink:    one colour, on Signal, Paper or Concrete
 * Minimum width 96px on screen; clear space is half the cap height.
 */
import signalSvg from '../assets/brand/logo-signal.svg?raw';
import paperSvg from '../assets/brand/logo-paper.svg?raw';
import inkSvg from '../assets/brand/logo-ink.svg?raw';
import { site } from '../config/site';

interface Props {
  variant?: 'signal' | 'paper' | 'ink';
  /** Accessible name; pass '' when a parent already names it (e.g. a labelled link). */
  label?: string;
  class?: string;
}

const { variant = 'signal', label = site.name, class: className } = Astro.props;
const raw = { signal: signalSvg, paper: paperSvg, ink: inkSvg }[variant];

// Each instance gets its own gradient id, and the fixed width/height go so CSS sizes it.
const uid = `lg${Math.random().toString(36).slice(2, 8)}`;
const svg = raw
  .replace(/\s(width|height)="[\d.]+"/g, '')
  .replace(/id="g"/g, `id="${uid}"`)
  .replace(/url\(#g\)/g, `url(#${uid})`)
  .replace(
    '<svg ',
    label ? `<svg role="img" aria-label="${label}" ` : '<svg aria-hidden="true" focusable="false" ',
  );
---

<span class:list={['logo', className]} set:html={svg} />

<style>
  .logo {
    display: inline-block;
    width: 7.5rem;
    min-width: 96px;
    line-height: 0;
  }

  .logo :global(svg) {
    width: 100%;
    height: auto;
  }
</style>
