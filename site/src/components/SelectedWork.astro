---
/**
 * Selected work, in the hanusek.com layout (2026-11-12): the projects as a list on the left and a
 * large browser window on the right playing a muted walkthrough of the chosen one. The preview
 * changes only by choice (click, hover with a mouse, arrow keys), never by scrolling.
 * Behaviour: scripts/selected-work.ts. Clips: scripts/record-work-clips.mjs.
 *
 * Without JavaScript every project shows its poster in turn. Reduced motion and Data Saver keep
 * the posters and never play. Facts and wording come from src/data/projects.ts.
 */
import { getImage } from 'astro:assets';
import { withBase } from '../config/paths';
import { projects } from '../data/projects';
import essencePoster from '../assets/work-clips/essence.jpg';
import calculatorPoster from '../assets/work-clips/calculator.jpg';

interface Props {
  /** "06 / Our work" style label. */
  label: string;
  title: string;
  /** A "See all our work" link under the list (the home page). */
  moreLink?: boolean;
  /** The band before a dark band sinks under it (scroll story). */
  handoff?: boolean;
}

const { label, title, moreLink = false, handoff = false } = Astro.props;
const uid = title.toLowerCase().replace(/[^a-z]+/g, '-');

const posters = { essence: essencePoster, calculator: calculatorPoster };
const items = await Promise.all(
  projects.map(async (p, i) => ({
    ...p,
    n: String(i + 1).padStart(2, '0'),
    host: p.url ? new URL(p.url).hostname.replace(/^www\./, '') : '',
    clip: withBase(`/video/${p.id}-walk.mp4`),
    poster: (await getImage({ src: posters[p.id], width: 1280, format: 'webp', quality: 68 })).src,
  })),
);
---

<section
  class="band band--paper-2 sw section"
  data-handoff={handoff ? '' : undefined}
  aria-labelledby={`${uid}-title`}
>
  <div class="sheet">
    <p class="label" data-reveal>
      {label}
    </p>
    <h2 id={`${uid}-title`} class="display display--m" data-reveal="lines">
      {title}
    </h2>

    <div class="sw__grid" data-sw>
      <ol class="sw__list">
        {items.map((p, i) => (
          <li class:list={['sw__item', { 'is-active': i === 0 }]}>
            <h3 class="sw__name">
              <button
                type="button"
                class="sw__pick"
                aria-pressed={i === 0 ? 'true' : 'false'}
                aria-controls={`${uid}-${p.id}`}
                data-sw-pick={p.id}
              >
                <span class="sw__n" aria-hidden="true">
                  {p.n}
                </span>
                {p.name}
              </button>
            </h3>
            <p class="sw__blurb">
              {p.blurb}
              {p.linkText && p.url &&
                /* prettier-ignore */
                <><a href={p.url} target="_blank" rel="noopener noreferrer">{p.linkText}<span class="visually-hidden"> (opens in a new tab)</span></a>.</>}
            </p>
          </li>
        ))}
      </ol>

      <div class="sw__stage" data-rise>
        {items.map((p, i) => (
          <figure
            id={`${uid}-${p.id}`}
            class:list={['sw__media', { 'is-active': i === 0 }]}
            data-sw-media={p.id}
          >
            <div class="sw__window">
              <span class="sw__bar" aria-hidden="true">
                <i />
                <i />
                <i />
                <span class="sw__host">{p.host}</span>
                {p.live && <span class="sw__live">Live</span>}
              </span>
              <video
                class="sw__video"
                width="1280"
                height="800"
                poster={p.poster}
                data-src={p.clip}
                muted
                loop
                playsinline
                preload="none"
                disablepictureinpicture
                aria-hidden="true"
                tabindex="-1"
              />
            </div>
            <figcaption class="visually-hidden">
              {p.name}: a walkthrough of the live site's home page.
            </figcaption>
          </figure>
        ))}
      </div>
    </div>

    {moreLink && (
      <a class="more-link sw__more" href={withBase('/work/')}>
        See all our work <span aria-hidden="true">↗</span>
      </a>
    )}
  </div>
</section>

<script>
  import '../scripts/selected-work.ts';
</script>

<style>
  .sw__grid {
    display: grid;
    gap: clamp(1.5rem, calc(var(--u) * 0.5), 3rem);
    margin-top: clamp(1.75rem, calc(var(--u) * 0.6), 3.5rem);
  }

  /* ---------- the list ---------- */
  .sw__list {
    display: grid;
    gap: 0;
    align-content: start;
    border-top: 1px solid var(--ink);
  }

  .sw__item {
    padding-block: clamp(1rem, calc(var(--u) * 0.26), 1.6rem);
    border-bottom: 1px solid var(--ink);
  }

  .sw__pick {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    /* An AA grey on Paper 2 until chosen. */
    color: #60625d;
    font: inherit;
    text-align: left;
    text-transform: inherit;
    cursor: pointer;
    transition: color 0.3s var(--ease-out);
  }

  .sw__name {
    font-size: clamp(1.6rem, calc(var(--u) * 0.52), 3rem);
    line-height: 0.95;
  }

  .sw__n {
    flex: none;
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.14em;
  }

  .sw__item.is-active .sw__pick,
  .sw__pick:hover {
    color: var(--ink);
  }

  .sw__item.is-active .sw__n::before {
    content: '';
    display: inline-block;
    width: 0.6rem;
    height: 0.6rem;
    margin-right: 0.5rem;
    background: var(--indigo);
  }

  .sw__pick:focus-visible {
    outline: 2px solid var(--indigo);
    outline-offset: 4px;
  }

  .sw__blurb {
    max-width: 30rem;
    margin-top: 0.7rem;
    font-size: 0.975rem;
    line-height: 1.5;
  }

  .sw__blurb a {
    font-weight: 600;
  }

  .sw__more {
    margin-top: clamp(1.75rem, calc(var(--u) * 0.5), 3rem);
  }

  /* ---------- the preview window ---------- */
  .sw__stage {
    position: relative;
    align-self: start;
  }

  .sw__media {
    margin: 0;
  }

  .sw__media + .sw__media {
    margin-top: 1rem;
  }

  .sw__window {
    overflow: hidden;
    border: 1px solid var(--ink);
    border-radius: 18px;
    background: var(--ink);
  }

  .sw__bar {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 34px;
    padding: 0 14px;
    background: var(--paper);
    border-bottom: 1px solid var(--ink);
  }

  .sw__bar i {
    width: 9px;
    height: 9px;
    border: 1px solid var(--ink);
    border-radius: 50%;
  }

  .sw__host {
    margin-left: 10px;
    font: 500 0.6875rem/1 var(--font-mono);
    letter-spacing: 0.08em;
  }

  .sw__live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    margin-left: auto;
    font: 500 0.6875rem/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sw__live::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #1e9e4f;
  }

  .sw__video {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    background: var(--paper);
  }

  /* With JavaScript the windows stack and the chosen one shows; without it, each shows in turn. */
  :global(.js) .sw__media {
    transition:
      opacity 0.5s var(--ease-out),
      scale 0.6s var(--ease-out),
      visibility 0s linear 0.5s;
  }

  :global(.js) .sw__media + .sw__media {
    margin-top: 0;
  }

  :global(.js) .sw__media:not(.is-active) {
    position: absolute;
    inset: 0 0 auto;
    opacity: 0;
    scale: 0.97;
    visibility: hidden;
  }

  :global(.js) .sw__media.is-active {
    transition:
      opacity 0.5s var(--ease-out),
      scale 0.6s var(--ease-out);
  }

  @media (min-width: 64rem) {
    .sw__grid {
      grid-template-columns: minmax(0, calc(var(--u) * 4.6)) minmax(0, 1fr);
      gap: calc(var(--u) * 0.66);
    }

    /* The window stays in view while the list is read. */
    .sw__stage {
      position: sticky;
      top: calc(var(--u) * 1.3);
    }
  }

  @media (max-width: 63.99rem) {
    .sw__stage {
      order: -1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .sw__media,
    .sw__pick {
      transition: none;
    }
  }
</style>
