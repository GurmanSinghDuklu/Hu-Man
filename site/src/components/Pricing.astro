---
import { pricingTiers } from '../data/pricing';
import { site } from '../config/site';
import Arrow from './Arrow.astro';

function mailtoFor(tierName: string): string {
  const subject = encodeURIComponent(`${tierName} enquiry`);
  const body = encodeURIComponent(
    `Hi,\n\nI'm interested in the ${tierName} package. My business is...\n\n`,
  );
  return `mailto:${site.contact.email}?subject=${subject}&body=${body}`;
}
---

<section class="pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="wrap pricing__inner">
    <div class="pricing__head">
      <h2 id="pricing-title" class="section-title" data-reveal>
        Pricing
      </h2>
      <p>
        Introductory pricing while we build our portfolio in Bradford. Prices rise as the diary
        fills, so quotes are valid for 30 days. Monthly plans stay the same.
      </p>
    </div>

    <ul class="pricing__cards">
      {pricingTiers.map((tier) => (
        <li class:list={['tier', { 'tier--featured': tier.id === 'growth' }]} data-reveal>
          <div class="tier__top">
            <h3>{tier.name}</h3>
            <span class:list={['tag', tier.id === 'growth' ? 'tier__tag--ink' : 'tag--pulse']}>
              Introductory
            </span>
          </div>
          <p class="tier__price">
            <span class="tier__from">from</span> {tier.introFrom}
          </p>
          <p class="tier__monthly">Monthly plan: {tier.monthly}</p>
          <p class="tier__for">{tier.for}</p>
          <ul class="tier__includes">
            {tier.includes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a
            class:list={['btn', tier.id === 'growth' ? 'tier__btn--ink' : 'btn--secondary']}
            href={mailtoFor(tier.name)}
          >
            Ask about {tier.name}
            <span class="btn__icon">
              <Arrow />
            </span>
          </a>
        </li>
      ))}
    </ul>

    <p class="pricing__terms">
      Fixed price after a free discovery call. 50% deposit, two revision rounds, and you own your
      site and content after final payment. Platform and AI usage fees are billed at cost.
    </p>
  </div>
</section>

<style>
  .pricing {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--brand-ink);
  }

  .pricing__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .pricing__head > p {
    color: var(--color-text-muted);
    max-width: 30rem;
  }

  /* Flush, hairline-ruled tiers. Growth is the Signal block; the Introductory tag is Pulse
     (offers), except inside the Signal block, where it turns Ink so two neons never touch. */
  .pricing__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--border-hairline);
    background: var(--line);
    border: var(--border-hairline) solid var(--line);
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.5rem, 2.6vw, 2.25rem);
    background: var(--brand-ink);
  }

  .tier--featured {
    background: var(--signal);
    color: var(--on-signal);
  }

  .tier__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .tier h3 {
    font-size: 1.5rem;
  }

  .tier__tag--ink {
    background: var(--brand-ink);
    border-color: var(--brand-ink);
    color: var(--brand-paper);
  }

  .tier__price {
    font: 800 clamp(3rem, 5vw, 4.5rem) / 0.9 var(--font-display);
    letter-spacing: -0.04em;
    margin-top: var(--space-3);
    font-variant-numeric: tabular-nums;
  }

  .tier__from {
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    vertical-align: 1.6em;
    color: var(--color-text-muted);
  }

  .tier__monthly {
    font: 500 0.8125rem var(--font-mono);
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
  }

  .tier--featured .tier__from,
  .tier--featured .tier__monthly {
    color: var(--on-signal);
  }

  .tier__for {
    padding-block: var(--space-3);
    border-block: var(--border-hairline) solid var(--line);
    font-size: 0.975rem;
  }

  .tier--featured .tier__for {
    border-color: var(--brand-ink);
  }

  .tier__includes {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9375rem;
    flex: 1;
    align-content: start;
  }

  .tier__includes li {
    display: flex;
    gap: 0.75em;
  }

  .tier__includes li::before {
    content: '';
    flex: none;
    width: 0.5em;
    height: 0.5em;
    margin-top: 0.5em;
    background: var(--signal);
  }

  .tier--featured .tier__includes li::before {
    background: var(--brand-ink);
  }

  .tier .btn {
    justify-content: space-between;
  }

  .tier__btn--ink {
    background: var(--brand-ink);
    border-color: var(--brand-ink);
    color: var(--brand-paper);
  }

  .tier__btn--ink:hover {
    background: var(--brand-paper);
    border-color: var(--brand-ink);
    color: var(--brand-ink);
  }

  .pricing__terms {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    max-width: 44rem;
    font-size: 0.95rem;
  }

  @media (min-width: 60rem) {
    .pricing__head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .pricing__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
