---
import { pricingTiers } from '../data/pricing';
import { site } from '../config/site';

function mailtoFor(tierName: string): string {
  const subject = encodeURIComponent(`${tierName} enquiry`);
  const body = encodeURIComponent(
    `Hi Gurman,\n\nI'm interested in the ${tierName} package. My business is...\n\n`,
  );
  return `mailto:${site.contact.email}?subject=${subject}&body=${body}`;
}
---

<section class="pricing" id="pricing" aria-labelledby="pricing-title">
  <div class="pricing__glow" aria-hidden="true"></div>
  <div class="wrap pricing__inner">
    <div class="pricing__head">
      <h2 id="pricing-title" class="section-title">
        <span class="t-bold t-silver">Pricing</span>
      </h2>
      <p>
        Introductory pricing while I build my portfolio in Bradford. Prices rise as my diary fills,
        so quotes are valid for 30 days. Monthly plans stay the same.
      </p>
    </div>

    <ul class="pricing__cards">
      {pricingTiers.map((tier) => (
        <li class:list={['tier', { 'tier--featured': tier.id === 'growth' }]}>
          <div class="tier__top">
            <h3>{tier.name}</h3>
            <span class="tier__tag">Introductory</span>
          </div>
          <p class="tier__price">
            <span class="tier__from">from</span> {tier.introFrom}
          </p>
          <p class="tier__monthly">Monthly plan: {tier.monthly}</p>
          <p class="tier__for">{tier.for}</p>
          <ul class="tier__includes">
            {tier.includes.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
          <a
            class:list={['pill-btn', { 'pill-btn--solid': tier.id === 'growth' }]}
            href={mailtoFor(tier.name)}
          >
            Ask about {tier.name}
          </a>
        </li>
      ))}
    </ul>

    <p class="pricing__terms">
      Fixed price after a free discovery call. 50% deposit, two revision rounds, and you own your
      site and content after final payment. Platform and AI usage fees are billed at cost.
    </p>
  </div>
</section>

<style>
  .pricing {
    position: relative;
    padding-block: clamp(4rem, 9vw, 7rem);
    overflow: hidden;
  }

  .pricing__glow {
    position: absolute;
    left: 50%;
    top: 30%;
    width: 90%;
    height: 80%;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(156, 13, 124, 0.55), transparent);
    filter: blur(30px);
    pointer-events: none;
  }

  .pricing__inner {
    position: relative;
  }

  .pricing__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .pricing__head p {
    color: rgba(255, 255, 255, 0.86);
    max-width: 30rem;
  }

  .pricing__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
  }

  .tier {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.5rem, 2.6vw, 2.25rem);
    border-radius: var(--radius-lg);
    background: rgba(18, 23, 38, 0.75);
    border: 1px solid var(--color-line);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }

  .tier--featured {
    background: linear-gradient(160deg, #b0137e 0%, #7a0a62 55%, #3e0a4f 100%);
    border-color: transparent;
  }

  .tier__top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
  }

  .tier h3 {
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .tier__tag {
    padding: 0.3em 0.9em;
    border-radius: var(--radius-pill);
    background: #fff;
    color: var(--paper-text);
    font-size: 0.75rem;
    font-weight: 600;
  }

  .tier__price {
    font-size: clamp(3rem, 5vw, 4.25rem);
    font-weight: 700;
    letter-spacing: -0.055em;
    line-height: 1;
    margin-top: var(--space-3);
  }

  .tier__from {
    font-size: 0.3em;
    font-weight: 300;
    font-style: italic;
    letter-spacing: 0;
    vertical-align: 0.5em;
  }

  .tier__monthly {
    color: rgba(255, 255, 255, 0.86);
  }

  .tier__for {
    padding-block: var(--space-3);
    border-block: 1px solid rgba(255, 255, 255, 0.2);
    font-size: 0.95rem;
  }

  .tier__includes {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.925rem;
    flex: 1;
    align-content: start;
  }

  .tier__includes li {
    display: flex;
    gap: 0.6em;
  }

  .tier__includes li::before {
    content: '';
    flex: none;
    width: 0.45em;
    height: 0.45em;
    margin-top: 0.55em;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.8;
  }

  .tier .pill-btn {
    justify-content: center;
  }

  .pricing__terms {
    margin-top: var(--space-5);
    color: var(--color-text-muted);
    max-width: 44rem;
    font-size: 0.95rem;
  }

  @media (min-width: 60rem) {
    .pricing__head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .pricing__cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
