---
import { site } from '../config/site';
import { withBase } from '../config/paths';
import BrandMark from './BrandMark.astro';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="sheet site-footer__grid">
    <div class="site-footer__brand">
      <div class="site-footer__marks">
        <BrandMark label={site.name} class="site-footer__mark" />
      </div>
      <p>
        {site.locations.join(' · ')}
        <br />
        {site.reach.join(' · ')}
      </p>
      <p class="site-footer__founder">Founded by {site.founderShort}</p>
    </div>
    <div>
      <p class="site-footer__label">Contact</p>
      <ul>
        <li>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
        <li>
          <a
            class="site-footer__wa"
            href={`https://wa.me/${site.contact.phoneIntl}`}
            target="_blank"
            rel="noopener noreferrer"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path
                d="M12 2.2a9.8 9.8 0 0 0-8.5 14.7L2.2 21.8l5-1.3A9.8 9.8 0 1 0 12 2.2z"
                fill="none"
                stroke="currentColor"
                stroke-width="1.7"
                stroke-linejoin="round"
              ></path>
              <path
                d="M8.6 7.3c.3-.6.6-.6.9-.6h.6c.2 0 .5.1.7.6l.8 1.9c.1.2.1.5 0 .7l-.5.7c-.2.2-.2.5 0 .7.4.7 1 1.4 1.6 1.9.6.5 1.2.9 1.9 1.2.2.1.5.1.7-.1l.7-.8c.2-.2.4-.3.7-.2l1.9.9c.3.1.4.3.4.6 0 .4-.1 1.1-.6 1.6-.5.5-1.4.9-2.4.8-1.6-.2-3.5-1-5.2-2.6-1.7-1.6-2.8-3.6-3-5.1-.2-1.2.4-2.1.8-2.6z"
                fill="currentColor"
              ></path>
            </svg>
            Contact on WhatsApp<span class="visually-hidden"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </div>
    <div>
      <p class="site-footer__label">Explore</p>
      <ul>
        <li>
          <a href={withBase('/services/')}>Our services</a>
        </li>
        <li>
          <a href={withBase('/work/')}>Real work</a>
        </li>
        <li>
          <a href={withBase('/pricing/')}>Pricing</a>
        </li>
        <li>
          <a href={withBase('/portfolio/')}>Portfolio sites</a>
        </li>
        <li>
          <a href={withBase('/about/')}>About</a>
        </li>
        <li>
          <a href={withBase('/how-we-build/')}>How we build</a>
        </li>
        <li>
          <a href={withBase('/agentic-ai-ready/')}>What is agentic AI-ready?</a>
        </li>
        <li>
          <a href={withBase('/free-ai-check/')}>Free AI check</a>
        </li>
        <li>
          <a href={withBase('/contact/')}>Contact</a>
        </li>
        <li>
          <a href={`${withBase('/pricing/')}#faq`}>FAQ</a>
        </li>
      </ul>
    </div>
    <div>
      <p class="site-footer__label">Legal</p>
      <ul>
        <li>
          <a href={withBase('/terms/')}>Terms and conditions</a>
        </li>
        <li>
          <a href={withBase('/user-agreement/')}>User agreement</a>
        </li>
        <li>
          <a href={withBase('/privacy/')}>Privacy notice</a>
        </li>
        <li>
          <a href={withBase('/cookies/')}>Cookie policy</a>
        </li>
      </ul>
    </div>
    <p class="site-footer__base">
      {`Copyright © ${currentYear} ${site.fullName}. All rights reserved. A trading name of ${site.founder} · No cookies`}
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(3rem, calc(var(--u) * 0.6), 4rem) clamp(1.5rem, calc(var(--u) * 0.3), 2rem);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-5) var(--space-4);
  }

  .site-footer__brand p {
    color: #c9cac4;
    line-height: 1.6;
  }

  .site-footer__founder {
    margin-top: 0.75rem;
  }

  .site-footer__label {
    margin-bottom: 1rem;
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-on-ink);
  }

  .site-footer li {
    line-height: 1.6;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__base {
    grid-column: 1 / -1;
    margin-top: var(--space-4);
    font-size: 0.8125rem;
    color: var(--muted-on-ink);
  }

  /* Phones: the last line stops short of the fixed cookie button (CookieButton.astro). */
  @media (max-width: 39.99rem) {
    .site-footer__base {
      padding-right: 60px;
    }
  }

  @media (min-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 6.5fr 3fr 3fr 2.5fr;
    }
  }

  /* The colour flow (.logo-led, base.css): the lighter palette colours, which glow on Ink. */
  /* WhatsApp (Gurman's go-ahead, 2026-11-11): the glyph in WhatsApp green, the words as the other links. */
  .site-footer__wa {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .site-footer__wa svg {
    flex: none;
    width: 1.15em;
    height: 1.15em;
    color: #25d366;
  }

  .site-footer__marks {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 1.5rem;
    --led-colours: #cea4ee, #93aee0, #4a9bb0, #edd1a8, #f8cea2, #e79569, #e85e8f, #db92db, #cea4ee;
  }

  .site-footer__marks :global(.site-footer__mark) {
    --lw: clamp(96px, calc(var(--u) * 1.2), 120px);
    --hh: 42px;
  }
</style>
