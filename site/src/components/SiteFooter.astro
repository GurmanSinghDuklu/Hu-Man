---
import { site } from '../config/site';
import { isHomePath, withBase } from '../config/paths';
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
const isHome = isHomePath(Astro.url.pathname);
const prefix = isHome ? '' : withBase('/');
---

<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <p class="site-footer__label">{site.name}</p>
        <p>
          {site.location.town}, {site.location.region}
        </p>
        <p class="site-footer__muted">Areas served: {site.areasServed.join(', ')}</p>
      </div>
      <div>
        <p class="site-footer__label">Contact</p>
        <ul>
          <li>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          <li>
            <a href={`tel:${site.contact.phone.replace(/\s+/g, '')}`}>{site.contact.phone}</a>
          </li>
          <li>
            <a href={site.contact.whatsapp} rel="noopener">
              WhatsApp
            </a>
          </li>
        </ul>
      </div>
      <div>
        <p class="site-footer__label">Explore</p>
        <ul>
          <li>
            <a href={`${prefix}#services`}>Services</a>
          </li>
          <li>
            <a href={`${prefix}#real-work`}>Real work</a>
          </li>
          <li>
            <a href={`${prefix}#work`}>Concept work</a>
          </li>
          <li>
            <a href={`${prefix}#pricing`}>Pricing</a>
          </li>
          <li>
            <a href={`${prefix}#faq`}>FAQ</a>
          </li>
        </ul>
      </div>
      <div>
        <p class="site-footer__label">Elsewhere</p>
        <ul>
          <li>
            <a href={site.contact.github} rel="noopener">
              GitHub
            </a>
          </li>
          <li>
            <a href={site.contact.linkedin} rel="noopener">
              LinkedIn
            </a>
          </li>
          <li>
            <a href={withBase('/privacy')}>Privacy notice</a>
          </li>
        </ul>
      </div>
    </div>

    <div class="site-footer__wordmark-box">
      <Logo label="" class="site-footer__logo" />
    </div>

    <div class="site-footer__base">
      <p>
        © {currentYear} {site.founder}.
      </p>
      <p>This site uses no tracking cookies.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--brand-ink);
    border-top: var(--border-hairline) solid var(--line);
    color: var(--on-dark);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    overflow: hidden;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .site-footer__brand {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }

  .site-footer p,
  .site-footer li {
    font-size: 0.9375rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .site-footer a {
    text-decoration: none;
    display: inline-block;
    padding-block: 0.3rem;
    transition: color 0.15s linear;
  }

  .site-footer a:hover {
    color: var(--signal);
  }

  .site-footer .site-footer__label {
    color: var(--on-dark-muted);
    margin-bottom: 0.75rem;
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .site-footer__muted {
    color: var(--on-dark-muted);
    max-width: 22rem;
  }

  /* The logo artwork, full width, as the sign-off. Never retyped. */
  .site-footer__wordmark-box {
    margin-top: clamp(3rem, 6vw, 5rem);
    padding-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .site-footer__wordmark-box :global(.site-footer__logo) {
    width: 100%;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: var(--border-hairline) solid var(--line);
    color: var(--on-dark-muted);
  }

  .site-footer__base p {
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
</style>
