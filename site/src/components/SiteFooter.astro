---
import { site } from '../config/site';

const currentYear = new Date().getFullYear();
const isHome = Astro.url.pathname === '/';
const prefix = isHome ? '' : '/';
---

<footer class="site-footer">
  <div class="wrap">
    <div class="site-footer__grid">
      <div>
        <p class="site-footer__label">Studio</p>
        <p>
          {site.location.town}, {site.location.region}
        </p>
        <p class="site-footer__muted">Areas served: {site.areasServed.join(', ')}</p>
      </div>
      <div>
        <p class="site-footer__label">Contact</p>
        <ul>
          <li>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          <li>
            <a href={`tel:${site.contact.phone.replace(/\s+/g, '')}`}>{site.contact.phone}</a>
          </li>
        </ul>
      </div>
      <div>
        <p class="site-footer__label">Elsewhere</p>
        <ul>
          <li>
            <a href={site.contact.github} rel="noopener">
              GitHub
            </a>
          </li>
          <li>
            <a href={site.contact.linkedin} rel="noopener">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="/privacy">Privacy notice</a>
          </li>
        </ul>
      </div>
      <div>
        <p class="site-footer__label">Explore</p>
        <ul>
          <li>
            <a href={`${prefix}#work`}>Work</a>
          </li>
          <li>
            <a href={`${prefix}#services`}>Services</a>
          </li>
          <li>
            <a href={`${prefix}#pricing`}>Pricing</a>
          </li>
        </ul>
      </div>
    </div>

    <p class="site-footer__wordmark" aria-hidden="true">
      {site.wordmark}
    </p>

    <div class="site-footer__base">
      <p>
        © {currentYear} {site.founder}.
      </p>
      <p>This site uses no tracking cookies.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    padding-top: clamp(3rem, 6vw, 5rem);
    border-top: 1px solid var(--color-line);
    overflow: hidden;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .site-footer p,
  .site-footer li {
    font-size: 0.925rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.2rem;
  }

  .site-footer a {
    text-decoration: none;
    display: inline-block;
    padding-block: 0.3rem;
    opacity: 0.9;
  }

  .site-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .site-footer__label {
    color: var(--color-text-muted);
    margin-bottom: 0.75rem;
  }

  .site-footer__muted {
    color: var(--color-text-muted);
    margin-top: 0.4rem;
    max-width: 22rem;
  }

  .site-footer .site-footer__wordmark {
    font-weight: 800;
    font-size: clamp(4rem, 23vw, 22rem);
    letter-spacing: -0.07em;
    line-height: 0.8;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.95), rgba(156, 13, 124, 0.25));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
    text-align: center;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: 1px solid var(--color-line);
    color: var(--color-text-muted);
  }
</style>
