---
import { site } from '../config/site';
import { withBase } from '../config/paths';
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
const tel = `tel:${site.contact.phone.replace(/\s+/g, '')}`;
// Areas after the base town, set on two lines as in the design.
const [, ...areas] = site.areasServed;
---

<footer class="site-footer">
  <div class="sheet site-footer__grid">
    <div class="site-footer__brand">
      <Logo variant="paper" label={site.name} class="site-footer__logo" />
      <p>
        {site.location.town}, {site.location.region}
        <br />
        {areas.slice(0, 2).join(' · ')}
        <br />
        {areas.slice(2).join(' · ')}
      </p>
    </div>
    <div>
      <p class="site-footer__label">Contact</p>
      <ul>
        <li>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
        <li>
          <a href={tel}>{site.contact.phone}</a>
        </li>
        <li>
          <a href={site.contact.whatsapp} rel="noopener">
            WhatsApp
          </a>
        </li>
      </ul>
    </div>
    <div>
      <p class="site-footer__label">Explore</p>
      <ul>
        <li>
          <a href={withBase('/services/')}>Services</a>
        </li>
        <li>
          <a href={withBase('/work/')}>Real work</a>
        </li>
        <li>
          <a href={withBase('/pricing/')}>Pricing</a>
        </li>
        <li>
          <a href={withBase('/about/')}>About</a>
        </li>
        <li>
          <a href={withBase('/how-we-build/')}>How we build</a>
        </li>
        <li>
          <a href={`${withBase('/pricing/')}#faq`}>FAQ</a>
        </li>
      </ul>
    </div>
    <div>
      <p class="site-footer__label">Elsewhere</p>
      <ul>
        <li>
          <a href={withBase('/privacy/')}>Privacy notice</a>
        </li>
      </ul>
    </div>
    <p class="site-footer__base">
      © {currentYear} {site.name} · No tracking cookies
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(3rem, calc(var(--u) * 0.6), 4rem) clamp(1.5rem, calc(var(--u) * 0.3), 2rem);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-5) var(--space-4);
  }

  .site-footer :global(.site-footer__logo) {
    width: clamp(96px, calc(var(--u) * 1.2), 120px);
    margin-bottom: 1.5rem;
  }

  .site-footer__brand p {
    color: #c9cac4;
    line-height: 1.6;
  }

  .site-footer__label {
    margin-bottom: 1rem;
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-on-ink);
  }

  .site-footer li {
    line-height: 1.6;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__base {
    grid-column: 1 / -1;
    margin-top: var(--space-4);
    font-size: 0.8125rem;
    color: var(--muted-on-ink);
  }

  @media (min-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 6.5fr 3fr 3fr 2.5fr;
    }
  }
</style>
