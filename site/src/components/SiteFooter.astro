---
import { site } from '../config/site';
import Logo from './Logo.astro';

const currentYear = new Date().getFullYear();
const isHome = Astro.url.pathname === '/';
const prefix = isHome ? '' : '/';
---

<footer class="site-footer on-dark">
  <div class="wrap">
    <div class="site-footer__grid">
      <div class="site-footer__brand">
        <Logo />
        <p>
          {site.location.town}, {site.location.region}
        </p>
        <p class="site-footer__muted">Areas served: {site.areasServed.join(', ')}</p>
      </div>
      <div>
        <p class="site-footer__label">Contact</p>
        <ul>
          <li>
            <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
          </li>
          <li>
            <a href={`tel:${site.contact.phone.replace(/\s+/g, '')}`}>{site.contact.phone}</a>
          </li>
          <li>
            <a href={site.contact.whatsapp} rel="noopener">
              WhatsApp
            </a>
          </li>
        </ul>
      </div>
      <div>
        <p class="site-footer__label">Explore</p>
        <ul>
          <li>
            <a href={`${prefix}#services`}>Services</a>
          </li>
          <li>
            <a href={`${prefix}#real-work`}>Real work</a>
          </li>
          <li>
            <a href={`${prefix}#work`}>Concept work</a>
          </li>
          <li>
            <a href={`${prefix}#pricing`}>Pricing</a>
          </li>
          <li>
            <a href={`${prefix}#faq`}>FAQ</a>
          </li>
        </ul>
      </div>
      <div>
        <p class="site-footer__label">Elsewhere</p>
        <ul>
          <li>
            <a href={site.contact.github} rel="noopener">
              GitHub
            </a>
          </li>
          <li>
            <a href={site.contact.linkedin} rel="noopener">
              LinkedIn
            </a>
          </li>
          <li>
            <a href="/privacy">Privacy notice</a>
          </li>
        </ul>
      </div>
    </div>

    <p class="site-footer__wordmark" aria-hidden="true">
      {site.wordmark}
    </p>

    <div class="site-footer__base">
      <p>
        © {currentYear} {site.founder}.
      </p>
      <p>This site uses no tracking cookies.</p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: clamp(0.5rem, 1.5vw, 1.25rem);
    background: #000000;
    border-top: 1px solid var(--color-line);
    color: var(--on-dark);
    padding-top: clamp(3.5rem, 7vw, 5.5rem);
    overflow: hidden;
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
  }

  .site-footer__brand {
    display: grid;
    gap: 0.6rem;
    align-content: start;
    font-size: 1.1rem;
  }

  .site-footer p,
  .site-footer li {
    font-size: 0.925rem;
  }

  .site-footer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.1rem;
  }

  .site-footer a {
    text-decoration: none;
    display: inline-block;
    padding-block: 0.3rem;
    transition: color 0.2s;
  }

  .site-footer a:hover {
    color: var(--neon);
  }

  .site-footer__label {
    color: var(--on-dark-muted);
    margin-bottom: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .site-footer .site-footer__label {
    font-size: 0.75rem;
  }

  .site-footer__muted {
    color: var(--on-dark-muted);
    max-width: 22rem;
  }

  .site-footer .site-footer__wordmark {
    font-weight: 800;
    font-size: clamp(4rem, 22vw, 21rem);
    letter-spacing: -0.07em;
    line-height: 0.8;
    margin: clamp(3rem, 6vw, 5rem) 0 0;
    background: linear-gradient(
      180deg,
      var(--acid) 0%,
      var(--neon) 40%,
      rgba(0, 255, 48, 0.04) 96%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    white-space: nowrap;
    text-align: center;
  }

  .site-footer__base {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block: var(--space-4);
    border-top: 1px solid var(--on-dark-line);
    color: var(--on-dark-muted);
  }
</style>
