---
import { site } from '../config/site';
import { withBase } from '../config/paths';
import Logo from './Logo.astro';
import logoMask from '../assets/brand/logo-paper.svg?url';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="sheet site-footer__grid">
    <div class="site-footer__brand">
      <span class="site-footer__led logo-led" style={`--logo-mask:url("${logoMask}")`}>
        <Logo variant="paper" label={site.name} class="site-footer__logo" />
      </span>
      <p>
        {site.location.town}, {site.location.region}
        <br />
        {site.reach.join(' · ')}
      </p>
    </div>
    <div>
      <p class="site-footer__label">Contact</p>
      <ul>
        <li>
          <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
        </li>
        <li>
          <a href={site.contact.whatsapp} rel="noopener">
            WhatsApp
          </a>
        </li>
      </ul>
    </div>
    <div>
      <p class="site-footer__label">Explore</p>
      <ul>
        <li>
          <a href={withBase('/services/')}>Our services</a>
        </li>
        <li>
          <a href={withBase('/work/')}>Real work</a>
        </li>
        <li>
          <a href={withBase('/pricing/')}>Pricing</a>
        </li>
        <li>
          <a href={withBase('/about/')}>About</a>
        </li>
        <li>
          <a href={withBase('/how-we-build/')}>How we build</a>
        </li>
        <li>
          <a href={withBase('/agentic-ai-ready/')}>What is agentic AI-ready?</a>
        </li>
        <li>
          <a href={withBase('/free-ai-check/')}>Free AI check</a>
        </li>
        <li>
          <a href={withBase('/contact/')}>Contact</a>
        </li>
        <li>
          <a href={`${withBase('/pricing/')}#faq`}>FAQ</a>
        </li>
      </ul>
    </div>
    <div>
      <p class="site-footer__label">Legal</p>
      <ul>
        <li>
          <a href={withBase('/terms/')}>Terms and conditions</a>
        </li>
        <li>
          <a href={withBase('/user-agreement/')}>User agreement</a>
        </li>
        <li>
          <a href={withBase('/privacy/')}>Privacy notice</a>
        </li>
        <li>
          <a href={withBase('/cookies/')}>Cookie policy</a>
        </li>
      </ul>
    </div>
    <p class="site-footer__base">
      © {currentYear} {site.fullName}, a trading name of {site.founder} · No cookies
    </p>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(3rem, calc(var(--u) * 0.6), 4rem) clamp(1.5rem, calc(var(--u) * 0.3), 2rem);
  }

  .site-footer__grid {
    display: grid;
    gap: var(--space-5) var(--space-4);
  }

  .site-footer :global(.site-footer__logo) {
    width: clamp(96px, calc(var(--u) * 1.2), 120px);
  }

  .site-footer__brand p {
    color: #c9cac4;
    line-height: 1.6;
  }

  .site-footer__label {
    margin-bottom: 1rem;
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted-on-ink);
  }

  .site-footer li {
    line-height: 1.6;
  }

  .site-footer a {
    text-decoration: none;
  }

  .site-footer a:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  .site-footer__base {
    grid-column: 1 / -1;
    margin-top: var(--space-4);
    font-size: 0.8125rem;
    color: var(--muted-on-ink);
  }

  @media (min-width: 40rem) {
    .site-footer__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .site-footer__grid {
      grid-template-columns: 6.5fr 3fr 3fr 2.5fr;
    }
  }

  /* The colour flow (.logo-led, base.css): the lighter palette colours, which glow on Ink. */
  .site-footer__led {
    display: block;
    width: fit-content;
    line-height: 0;
    margin-bottom: 1.5rem;
    --led-colours: #cea4ee, #93aee0, #4a9bb0, #edd1a8, #f8cea2, #e79569, #e85e8f, #db92db, #cea4ee;
  }
</style>
