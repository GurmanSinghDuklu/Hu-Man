---
import HeadlineCards from '../HeadlineCards.astro';
import { withBase } from '../../config/paths';
import { portfolioTiers } from '../../data/pricing';
---

<section class="band teaser" aria-labelledby="teaser-title">
  <div class="sheet">
    <p class="label" data-reveal>
      08 / Pricing
    </p>
    <h2 id="teaser-title" class="display display--m teaser__title" data-reveal="lines">
      Start small. Add
      <br />
      as you grow.
    </h2>
    <div class="teaser__arches">
      <HeadlineCards />
    </div>
    <a class="more-link teaser__link" href={withBase('/pricing/')}>
      See full pricing <span aria-hidden="true">↗</span>
    </a>
    <p class="teaser__strip" data-reveal>
      <a class="more-link" href={withBase('/portfolio/')}>
        Building a portfolio or CV site? From {portfolioTiers[0].price}{' '}
        <span aria-hidden="true">↗</span>
      </a>
    </p>
  </div>
</section>

<style>
  .teaser {
    padding-block: clamp(3rem, calc(var(--u) * 1.2), 7rem) clamp(3rem, calc(var(--u) * 0.75), 5rem);
  }

  .teaser__title {
    margin-top: 0.3rem;
  }

  .teaser__arches {
    margin-top: clamp(2rem, calc(var(--u) * 0.15), 3rem);
  }

  .teaser__strip {
    margin-top: clamp(1.5rem, calc(var(--u) * 0.4), 2.5rem);
    padding-top: clamp(1rem, calc(var(--u) * 0.25), 1.5rem);
    border-top: 1px solid var(--ink);
  }

  .teaser__link {
    margin-top: clamp(1.5rem, calc(var(--u) * 0.4), 2.5rem);
  }
</style>
