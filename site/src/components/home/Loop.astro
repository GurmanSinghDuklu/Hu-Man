---
// The working sequence, as five linked circles (the design's "03 / Human in the loop").
const steps = [
  { title: 'Call', text: 'You talk to the person who builds it, not a sales team.', style: 'ink' },
  { title: 'Design + concept', text: 'You see the design before anything is built.' },
  { title: 'Build', text: 'AI speeds it up. A human checks every page.' },
  { title: 'Launch', text: 'Tested on real phones, redirects in place.' },
  { title: 'Still here', text: 'When something breaks, you message a person.', style: 'lilac' },
];
---

<section class="band grid loop" aria-labelledby="loop-title">
  <div class="sheet">
    <p class="label" data-reveal>
      03 / Human in the loop
    </p>
    <h2 id="loop-title" class="display loop__title" data-reveal>
      AI builds fast. A human
      <br />
      makes sure it works.
    </h2>

    <div class="loop__track">
      <span class="pill loop__pill">We don’t disappear at launch</span>
      <ol class="loop__steps">
        {steps.map((s, i) => (
          <li class="loop__step" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
            <span class:list={['loop__circle', s.style && `loop__circle--${s.style}`]}>
              <span class="loop__n">{String(i + 1).padStart(2, '0')}</span>
              <span class="loop__name">{s.title}</span>
            </span>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .loop {
    padding-block: clamp(3.5rem, calc(var(--u) * 1.1), 6rem) clamp(3rem, calc(var(--u) * 1), 6rem);
  }

  .loop__title {
    margin-top: 0.4rem;
  }

  .loop__track {
    position: relative;
    margin-top: clamp(2.5rem, calc(var(--u) * 1.95), 9rem);
  }

  .loop__pill {
    display: none;
  }

  .loop__steps {
    display: grid;
    gap: 2rem;
  }

  .loop__step {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: 1.25rem;
  }

  .loop__circle {
    position: relative;
    z-index: 1;
    display: grid;
    place-content: center;
    gap: 0.35rem;
    width: 8.5rem;
    aspect-ratio: 1;
    padding: 0.75rem;
    border: 1px solid var(--ink);
    border-radius: 50%;
    background: var(--paper);
    text-align: center;
  }

  .loop__circle--ink {
    background: var(--ink);
    color: var(--paper);
  }

  .loop__circle--lilac {
    background: var(--grad-lilac);
  }

  .loop__n {
    font: 400 0.6875rem var(--font-mono);
    letter-spacing: 0.14em;
  }

  .loop__name {
    font: 800 1.15rem/0.95 var(--font-display);
    text-transform: uppercase;
  }

  .loop__step p {
    font-size: 1rem;
    line-height: 1.4;
  }

  @media (min-width: 64rem) {
    .loop__pill {
      display: inline-flex;
      position: absolute;
      right: calc(var(--u) * 0.28);
      top: calc(var(--u) * -0.55);
      font-size: calc(var(--u) * 0.12);
    }

    .loop__steps {
      grid-template-columns: repeat(5, 1fr);
      gap: 0;
    }

    /* The line that links the circles, through their centres. */
    .loop__steps::before {
      content: '';
      position: absolute;
      left: 10%;
      right: 10%;
      top: var(--u);
      height: 2px;
      background: var(--ink);
    }

    .loop__step {
      grid-template-columns: 1fr;
      justify-items: center;
      gap: calc(var(--u) * 0.36);
      text-align: center;
    }

    .loop__circle {
      width: calc(var(--u) * 2);
    }

    .loop__n {
      font-size: calc(var(--u) * 0.11);
    }

    .loop__name {
      font-size: calc(var(--u) * 0.27);
    }

    .loop__step p {
      max-width: calc(var(--u) * 2.6);
      font-size: calc(var(--u) * 0.19);
    }
  }
</style>
