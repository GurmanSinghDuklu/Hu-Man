---
import Collage from '../Collage.astro';
import BookingLink from '../BookingLink.astro';
import { withBase } from '../../config/paths';
import { site } from '../../config/site';

// What we make, top right of the hero (from the design).
const offer = [
  'AI overview',
  'Agent readable websites',
  'Owner dashboards',
  'AI assistants',
  'SEO and GEO optimised',
  'Support that stays',
];
---

<section class="band grid hero" aria-labelledby="hero-title">
  <div class="sheet hero__sheet">
    <p class="label hero__kicker">Est. {site.founded}</p>
    <h1 id="hero-title" class="hero__title">
      Got an idea? We’ll build it, and build it to be found by AI.
    </h1>

    <ul class="hero__offer" aria-label="What we make">
      {offer.map((item) => (
        <li>{item}</li>
      ))}
    </ul>

    <div class="hero__collage">
      <Collage variant="home" lens="Lens 01 / Built by people" />
    </div>

    <div class="hero__intro">
      <p class="label">Planners, builders, developers</p>
      <p class="hero__serif">One human team, from first call to aftercare.</p>
      <p class="hero__body">
        Websites, apps and software built properly, agentic AI-ready as standard, with a real person
        beside you from first call to long after launch.
      </p>
    </div>

    <div class="hero__actions">
      <BookingLink class="btn btn--display" />
      <a href={withBase('/free-ai-check/')} class="btn btn--outline btn--display">
        Free AI check
      </a>
    </div>
  </div>
</section>

<style>
  /* The hero fits one window: on phones a tight stack with the collage capped by the window height; on desktop the whole layout shrinks with the window (see the media query). */
  .hero {
    --collage-h: 20svh;
  }

  .hero__sheet {
    display: grid;
    gap: 1.25rem;
    padding-block: var(--space-4);
  }

  .hero__title {
    margin-top: -0.75rem;
    /* capped by the window height too, so a tablet's hero still fits one screen */
    font-size: clamp(2.1rem, min(10.5vw, 5.5svh), 5.5rem);
    line-height: 0.95;
    letter-spacing: -0.015em;
    text-wrap: balance;
  }

  .hero__offer {
    font: 400 0.75rem/1.25 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .hero__intro {
    display: grid;
    gap: 0.6rem;
    max-width: 26rem;
  }

  .hero__serif {
    font: italic 400 clamp(1.5rem, calc(var(--u) * 0.36), 2.2rem) / 1.12 var(--font-serif);
    letter-spacing: -0.01em;
  }

  .hero__body {
    color: var(--muted);
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  @media (max-width: 63.99rem) {
    .hero__intro {
      gap: 0.4rem;
    }

    /* Both buttons on one row on a phone; a long label wraps inside its button. */
    .hero__actions {
      display: grid;
      grid-template-columns: 1fr 1fr;
    }

    .hero__actions :global(.btn) {
      padding-inline: 0.75rem;
      font-size: 0.875rem;
      line-height: 1.15;
      text-align: center;
    }
  }

  /* Desktop: everything sits on the grid, positioned in grid units from the design. */
  @media (min-width: 64rem) {
    /* The hero's own grid unit: the page unit, or smaller when the window is too short for the 9 rows under the 1-unit header, so the whole hero shrinks to fit (never below 70%). The grid lines are centred on the sheet so the collage cells still sit on them. */
    .hero {
      --page-u: min(100vw / 16, 100px);
      --u: clamp(var(--page-u) * 0.7, (100svh - var(--page-u) - 1px) * 0.96 / 9, var(--page-u));
      --pad: calc(var(--u) / 2);
      --sheet: calc(var(--u) * 16);
      background-position: calc(50% - var(--u) / 2) 0;
    }

    .hero__sheet {
      display: block;
      height: calc(var(--u) * 9);
      padding: 0;
    }

    .hero__kicker {
      position: absolute;
      left: var(--pad);
      top: calc(var(--u) * 0.05);
      font-size: calc(var(--u) * 0.135);
    }

    .hero__title {
      position: absolute;
      left: var(--pad);
      top: calc(var(--u) * 0.31);
      margin: 0;
      max-width: calc(var(--u) * 7.4);
      font-size: calc(var(--u) * 0.74);
    }

    .hero__offer {
      position: absolute;
      right: var(--pad);
      top: calc(var(--u) * 0.05);
      /* Two columns of three keep the list clear of the eye ring (see Collage.astro). */
      display: grid;
      grid-auto-flow: column;
      grid-template-rows: repeat(3, auto);
      column-gap: calc(var(--u) * 0.5);
      text-align: right;
      font-size: calc(var(--u) * 0.15);
    }

    .hero__collage {
      position: absolute;
      left: calc(var(--u) * 6);
      top: var(--u);
    }

    .hero__intro {
      position: absolute;
      left: var(--pad);
      top: calc(var(--u) * 6.7);
      max-width: calc(var(--u) * 4.2);
      gap: calc(var(--u) * 0.1);
    }

    .hero__intro .label {
      font-size: calc(var(--u) * 0.15);
    }

    .hero__serif {
      font-size: calc(var(--u) * 0.35);
    }

    .hero__body {
      font-size: max(0.875rem, calc(var(--u) * 0.19));
    }

    .hero__actions {
      position: absolute;
      right: var(--pad);
      top: calc(var(--u) * 8.02);
      gap: calc(var(--u) * 0.2);
    }

    .hero__actions :global(.btn) {
      min-height: max(44px, calc(var(--u) * 0.6));
      padding: 0 calc(var(--u) * 0.27);
      font-size: max(0.875rem, calc(var(--u) * 0.17));
    }
  }
</style>
