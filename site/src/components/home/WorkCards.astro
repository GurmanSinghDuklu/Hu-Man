---
/**
 * "Real projects. Real people." (home 06): each project's front page in a browser window, linking
 * to /work/. Eldeva is a concept for a family business: its line always says "Concept". Links to
 * other sites open in a new tab, so the visitor keeps this one.
 */
import { Image } from 'astro:assets';
import { withBase } from '../../config/paths';
import essence from '../../assets/work/essence-desktop.jpg';
import eldeva from '../../assets/projects/eldeva-hero.jpg';
import calculator from '../../assets/work/calculator-desktop.jpg';
import { projects } from '../../data/projects';

const project = (id: string) => projects.find((p) => p.id === id)!;

const cards = [
  {
    ...project('essence'),
    src: essence,
    alt: 'The Essence Hair home page: “More than hair, a place to relax, refresh and feel your best.”',
  },
  {
    ...project('eldeva'),
    src: eldeva,
    alt: 'The Eldeva concept home page: “Golden hour, bottled.”',
  },
  {
    ...project('calculator'),
    src: calculator,
    alt: 'The Calculator App home page, with featured calculators',
  },
];
---

<section class="band band--paper-2 cards section" aria-labelledby="cards-title">
  <div class="sheet">
    <p class="label" data-reveal>
      06 / Our work
    </p>
    <h2 id="cards-title" class="display display--m" data-reveal="lines">
      Real projects. Real people.
    </h2>

    <ul class="cards__list">
      {cards.map((c, i) => (
        <li class="card" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <div class="card__window">
            <span class="card__bar" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </span>
            <Image
              src={c.src}
              alt={c.alt}
              width={640}
              format="webp"
              quality={70}
              loading="lazy"
              decoding="async"
              class="card__shot"
            />
          </div>
          <h3 class="card__name">{c.name}</h3>
          <p class="card__blurb">
            {c.blurb}
            {c.linkText && c.url &&
              /* prettier-ignore */
              <><a href={c.url} target="_blank" rel="noopener noreferrer">{c.linkText}<span class="visually-hidden"> (opens in a new tab)</span></a>.</>}
          </p>
        </li>
      ))}
    </ul>

    <a class="more-link cards__link" href={withBase('/work/')}>
      See all our work <span aria-hidden="true">↗</span>
    </a>
  </div>
</section>

<style>
  .cards {
    padding-bottom: clamp(2.5rem, calc(var(--u) * 0.55), 3.5rem);
  }

  .cards__list {
    display: grid;
    gap: 2.5rem max(12px, calc(var(--u) * 0.33));
    margin-top: clamp(2rem, calc(var(--u) * 0.75), 4.5rem);
  }

  .card__window {
    border: 1px solid var(--ink);
    border-bottom-right-radius: calc(var(--u) * 0.83);
    overflow: hidden;
    background: var(--paper);
  }

  .card__bar {
    display: flex;
    gap: 5px;
    align-items: center;
    height: max(24px, calc(var(--u) * 0.33));
    padding-left: max(12px, calc(var(--u) * 0.15));
    border-bottom: 1px solid var(--ink);
  }

  .card__bar i {
    width: max(9px, calc(var(--u) * 0.13));
    aspect-ratio: 1;
    border: 1px solid var(--ink);
    border-radius: 50%;
  }

  .card :global(.card__shot) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 430 / 275;
    object-fit: cover;
    object-position: top center;
  }

  .card__name {
    margin-top: clamp(1rem, calc(var(--u) * 0.36), 2rem);
    font-size: clamp(1.25rem, calc(var(--u) * 0.31), 1.9rem);
    line-height: 1;
  }

  .card__blurb {
    max-width: 34ch;
    margin-top: 0.75rem;
    font-size: clamp(0.95rem, calc(var(--u) * 0.17), 1.05rem);
    line-height: 1.5;
  }

  .card__blurb a {
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .cards__link {
    margin-top: clamp(2rem, calc(var(--u) * 0.5), 3rem);
  }

  @media (min-width: 48rem) {
    .cards__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
  }

  .card__shot {
    transition: scale 0.6s var(--ease-out);
  }

  .card:hover .card__shot {
    scale: 1.04;
  }
</style>
