---
/**
 * "Portfolio" (home 06): the three concept portfolio sites from /portfolio
 * (src/data/portfolioConcepts.ts), each front page in a browser window, linking
 * to its concept page. All three are fictional people and say so. Real
 * projects stay on /work/.
 */
import { Image } from 'astro:assets';
import { withBase } from '../../config/paths';
import { portfolioConcepts, portfolioConceptsIntro } from '../../data/portfolioConcepts';
import noorShot from '../../assets/portfolio-concepts/noor.webp';
import theoShot from '../../assets/portfolio-concepts/theo.webp';
import mayaShot from '../../assets/portfolio-concepts/maya.webp';

const conceptShots = { noor: noorShot, theo: theoShot, maya: mayaShot };
---

<section class="band band--paper-2 cards section" aria-labelledby="cards-title">
  <div class="sheet">
    <p class="label" data-reveal>
      06 / Our work
    </p>
    <h2 id="cards-title" class="display display--m" data-reveal="lines">
      Portfolio
    </h2>

    <ul class="cards__list">
      {portfolioConcepts.map((c, i) => (
        <li class="card" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <div class="card__window">
            <span class="card__bar" aria-hidden="true">
              <i></i>
              <i></i>
              <i></i>
            </span>
            <Image
              src={conceptShots[c.slug]}
              alt={c.alt}
              width={800}
              format="webp"
              quality={70}
              loading="lazy"
              decoding="async"
              class="card__shot"
            />
          </div>
          <p class="card__note">{portfolioConceptsIntro.note}</p>
          <h3 class="card__name">{c.name}</h3>
          <p class="card__role">{c.role}</p>
          <p class="card__blurb">{c.shows}</p>
          <a class="card__link" href={withBase(`/concepts/${c.slug}/`)}>
            {portfolioConceptsIntro.linkText}
            <span class="visually-hidden"> for {c.name}</span>
          </a>
        </li>
      ))}
    </ul>

    <div class="cards__links">
      <a class="more-link" href={withBase('/portfolio/')}>
        See portfolio sites <span aria-hidden="true">↗</span>
      </a>
      <a class="cards__quiet" href={withBase('/work/')}>
        See our client work
      </a>
    </div>
  </div>
</section>

<style>
  .cards {
    padding-bottom: clamp(2.5rem, calc(var(--u) * 0.55), 3.5rem);
  }

  .cards__list {
    display: grid;
    gap: 2.5rem max(12px, calc(var(--u) * 0.33));
    margin-top: clamp(2rem, calc(var(--u) * 0.75), 4.5rem);
  }

  .card__window {
    border: 1px solid var(--ink);
    border-bottom-right-radius: calc(var(--u) * 0.83);
    overflow: hidden;
    background: var(--paper);
  }

  .card__bar {
    display: flex;
    gap: 5px;
    align-items: center;
    height: max(24px, calc(var(--u) * 0.33));
    padding-left: max(12px, calc(var(--u) * 0.15));
    border-bottom: 1px solid var(--ink);
  }

  .card__bar i {
    width: max(9px, calc(var(--u) * 0.13));
    aspect-ratio: 1;
    border: 1px solid var(--ink);
    border-radius: 50%;
  }

  .card :global(.card__shot) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 430 / 275;
    object-fit: cover;
    object-position: top center;
  }

  .card__name {
    margin-top: 0.5rem;
    font-size: clamp(1.25rem, calc(var(--u) * 0.31), 1.9rem);
    line-height: 1;
  }

  .card__blurb {
    max-width: 34ch;
    margin-top: 0.75rem;
    font-size: clamp(0.95rem, calc(var(--u) * 0.17), 1.05rem);
    line-height: 1.5;
  }

  .cards__links {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 2rem;
    align-items: center;
    margin-top: clamp(2rem, calc(var(--u) * 0.5), 3rem);
  }

  .cards__quiet,
  .card__link {
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .cards__quiet {
    font-weight: 400;
  }

  .card__link {
    display: inline-block;
    margin-top: 0.75rem;
  }

  .card__note {
    margin-top: clamp(1rem, calc(var(--u) * 0.36), 2rem);
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .card__role {
    margin-top: 0.5rem;
    font-size: clamp(0.95rem, calc(var(--u) * 0.17), 1.05rem);
  }

  @media (min-width: 48rem) {
    .cards__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
  }

  .card__shot {
    transition: scale 0.6s var(--ease-out);
  }

  .card:hover .card__shot {
    scale: 1.04;
  }
</style>
