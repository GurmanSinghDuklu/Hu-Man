---
import Sparkle from '../Sparkle.astro';
import { site } from '../../config/site';

const mail = (subject: string, body = '') =>
  `mailto:${site.contact.email}?subject=${encodeURIComponent(subject)}${body ? `&body=${encodeURIComponent(body)}` : ''}`;

// No booking tool or mailing-list service yet, so these open an email (docs/03: no forms until a
// backend is chosen). "Not yet" signs people up by asking, which is clear consent.
const moves = [
  {
    label: 'Check my site',
    href: '#check',
    caption: 'Free AI check, back in 48 hours.',
    shape: 'circle',
  },
  {
    label: 'Build my site',
    href: mail(
      'Book a 15-minute call',
      'Hi,\n\nI’d like a 15-minute call about a new site.\n\nBusiness name:\nBest times to call:\n\n',
    ),
    caption: 'Book a 15-minute call.',
    shape: 'ink',
  },
  {
    label: 'Not yet',
    href: mail('Add me to the monthly email', 'Hi,\n\nPlease add me to your monthly email.\n\n'),
    caption: 'One useful email a month. No spam.',
    shape: 'arch',
  },
];
---

<section class="band band--paper-2 move" aria-labelledby="move-title">
  <div class="sheet">
    <p class="label" data-reveal>
      08 / Your move
    </p>
    <h2 id="move-title" class="display move__title" data-reveal>
      So, what do you
      <br />
      want to do?
    </h2>
    <ul class="move__list">
      {moves.map((m, i) => (
        <li data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <a class:list={['move__shape', `move__shape--${m.shape}`]} href={m.href}>
            <Sparkle class="move__star" />
            <span>{m.label}</span>
          </a>
          <p>{m.caption}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .move {
    padding-block: clamp(3.5rem, calc(var(--u) * 1.05), 6rem)
      clamp(3.5rem, calc(var(--u) * 1), 6rem);
  }

  .move__title {
    margin-top: 0.3rem;
  }

  .move__list {
    display: grid;
    gap: 2.5rem;
    margin-top: clamp(2.5rem, calc(var(--u) * 0.5), 3.5rem);
  }

  .move__list li {
    display: grid;
    justify-items: center;
    gap: 1.25rem;
    text-align: center;
  }

  .move__shape {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 0.9rem;
    width: min(16rem, 70vw);
    aspect-ratio: 1;
    border: 1px solid var(--ink);
    text-decoration: none;
    transition: transform 0.25s var(--ease-out);
  }

  .move__shape:hover {
    transform: translateY(-4px);
  }

  .move__shape span {
    font: 800 clamp(1.4rem, calc(var(--u) * 0.317), 2rem) / 1 var(--font-display);
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }

  .move__shape :global(.move__star) {
    width: clamp(1.6rem, calc(var(--u) * 0.42), 2.6rem);
  }

  .move__shape--circle {
    border-radius: 50%;
    background: var(--grad-lilac);
  }

  .move__shape--ink {
    border-color: var(--ink);
    border-bottom-left-radius: 50%;
    background: var(--ink);
    color: var(--paper);
  }

  .move__shape--arch {
    border-radius: 999px 999px 0 0;
    background: var(--paper);
  }

  .move__list p {
    font-size: clamp(1rem, calc(var(--u) * 0.19), 1.15rem);
  }

  @media (min-width: 48rem) {
    .move__list {
      grid-template-columns: repeat(3, 1fr);
      gap: 1rem;
    }
  }

  @media (min-width: 64rem) {
    .move__shape {
      width: calc(var(--u) * 3.33);
    }

    .move__list li {
      gap: calc(var(--u) * 0.36);
    }
  }
</style>
