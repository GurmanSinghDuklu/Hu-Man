---
import fingerprint from '../assets/brand/fingerprint.webp?url';
import Module, { type ModuleKind, type ModuleColour } from './Module.astro';

// The hero mosaic (2026-10-17 agency redesign, refs in reference/agency-redesign/): the brand's
// fingerprint scan in Paper, cut into square cells. Signal blocks sit over it like the pixel
// posters, a few cells drop out to Ink and kit modules fill the edges. No project screenshots:
// Gurman removed them (2026-10-18); the work grid below shows the projects. Decorative only
// (aria-hidden).
//
// It never quite settles: every block flashes another brand colour now and then, and coloured
// copies of the print jump sideways (an RGB split in the brand's own colours).
//
// Grid: 9 columns by 8 rows of square cells. Each cell is [column, row, width, height].
type Cell = {
  at: [number, number, number?, number?];
  kind: 'signal' | 'ink' | 'paper' | 'module';
  mod?: [ModuleKind, ModuleColour, ModuleColour];
};

const cells: Cell[] = [
  { at: [1, 6], kind: 'module', mod: ['checker', 'ink', 'paper'] },
  { at: [2, 6], kind: 'module', mod: ['hex', 'pulse', 'ink'] },
  { at: [1, 7], kind: 'module', mod: ['stripes', 'flare', 'ink'] },
  { at: [2, 7], kind: 'module', mod: ['burst', 'volt', 'ink'] },
  { at: [9, 5], kind: 'module', mod: ['half', 'paper', 'ink'] },
  { at: [9, 6], kind: 'module', mod: ['dots', 'scan', 'ink'] },
  { at: [3, 1], kind: 'signal' },
  { at: [5, 1], kind: 'signal' },
  { at: [4, 2], kind: 'signal' },
  { at: [5, 2], kind: 'signal' },
  { at: [6, 2], kind: 'signal' },
  { at: [7, 2], kind: 'paper' },
  { at: [3, 3], kind: 'signal' },
  { at: [5, 3], kind: 'ink' },
  { at: [6, 3], kind: 'signal' },
  { at: [7, 3], kind: 'signal' },
  { at: [2, 4], kind: 'signal' },
  { at: [4, 4], kind: 'signal' },
  { at: [5, 4], kind: 'signal' },
  { at: [3, 5], kind: 'ink' },
  { at: [5, 5], kind: 'signal' },
  { at: [6, 5], kind: 'signal' },
  { at: [8, 5], kind: 'signal' },
  { at: [3, 6], kind: 'signal' },
  { at: [4, 6], kind: 'signal' },
  { at: [7, 6], kind: 'signal' },
  { at: [3, 7], kind: 'ink' },
  { at: [5, 7], kind: 'signal' },
  { at: [6, 7], kind: 'signal' },
  { at: [2, 8], kind: 'paper' },
  { at: [4, 8], kind: 'signal' },
  { at: [7, 8], kind: 'signal' },
];

// A scattered (but fixed) order for the cells to cut on in.
const order = (c: Cell) => (c.at[0] * 7 + c.at[1] * 3) % 11;
const area = ([x, y, w = 1, h = 1]: Cell['at']) => `${y} / ${x} / span ${h} / span ${w}`;

// Each block flashes its own colour on its own clock, so the glitches never line up.
const flashes = ['pulse', 'flare', 'volt', 'scan', 'paper'];
const flash = (c: Cell, i: number) =>
  c.kind === 'signal'
    ? `;--flash:var(--${flashes[i % flashes.length]});--dur:${(2.2 + ((i * 0.7) % 2.6)).toFixed(1)}s;--d:${((i * 0.45) % 3).toFixed(2)}s`
    : '';
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="label hero__label">Your human in the loop</p>
      <h1 id="hero-title" class="hero__title">
        Your site, rebuilt and found.
      </h1>
      <p class="hero__lede">
        We rebuild websites for local businesses, add booking, payments and AI enquiry assistants,
        and help you get found on Google and in AI search. Built in Bradford, and we stay to look
        after it.
      </p>
      <div class="hero__actions">
        <a href="#audit" class="btn btn--primary">
          Get your free audit
        </a>
        <a href="#work" class="btn btn--secondary">
          See the work
        </a>
      </div>
      <p class="hero__status">
        <span class="tag tag--signal tag--status">
          <span aria-hidden="true">●</span> Open
        </span>
        <span class="label">Taking on new projects across West Yorkshire</span>
      </p>
    </div>

    <div class="hero__mosaic" aria-hidden="true" style={`--print:url(${fingerprint})`}>
      <span class="hero__print"></span>
      {cells.map((c, i) => (
        <span
          class:list={[
            'hero__cell',
            `hero__cell--${c.kind}`,
            { 'is-cycle': c.kind === 'signal' && i % 4 === 0 },
          ]}
          style={`grid-area:${area(c.at)};--i:${order(c)}${flash(c, i)}`}
        >
          {c.mod && <Module kind={c.mod[0]} fg={c.mod[1]} bg={c.mod[2]} />}
        </span>
      ))}
      <span class="hero__print hero__split hero__split--a"></span>
      <span class="hero__print hero__split hero__split--b"></span>
      <span class="hero__print hero__split hero__split--c"></span>
      <span class="hero__bar hero__bar--a"></span>
      <span class="hero__bar hero__bar--b"></span>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: -73px;
    padding-top: calc(73px + clamp(1.5rem, 4vw, 3.5rem));
    padding-bottom: clamp(3rem, 7vw, 6rem);
    background: var(--brand-ink);
    color: var(--ink-text);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .hero__label {
    color: var(--signal-text);
  }

  .hero__title {
    font-size: clamp(2.75rem, 9.5vw, 5.75rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }

  .hero__lede {
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .hero__status .label {
    color: var(--ink-text);
  }

  /* ---------- mosaic ---------- */
  .hero__mosaic {
    position: relative;
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    grid-template-rows: repeat(8, 1fr);
    aspect-ratio: 9 / 8;
    width: 100%;
    border: var(--border-hairline) solid var(--line);
  }

  /* The scan is white ridges on black, used as a luminance mask, so it paints in Paper. */
  .hero__print {
    grid-area: 1 / 1 / -1 / -1;
    background: var(--brand-paper);
    -webkit-mask: var(--print) center / auto 100% no-repeat;
    mask: var(--print) center / auto 100% no-repeat luminance;
  }

  .hero__cell {
    position: relative;
    overflow: hidden;
    animation: cell-on 1ms steps(1, end) both;
    animation-delay: calc(150ms + var(--i) * 90ms);
  }

  .hero__cell--signal {
    background: var(--signal);
  }

  .hero__cell--ink {
    background: var(--brand-ink);
  }

  .hero__cell--paper {
    background: var(--brand-paper);
  }

  .hero__cell--module :global(.mod) {
    width: 100%;
    height: 100%;
  }

  /* Every Signal block flashes another brand colour now and then (opacity only, hard steps). */
  .hero__cell--signal::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--flash);
    opacity: 0;
    animation: hero-flash var(--dur) steps(1, end) infinite calc(1.5s + var(--d));
  }

  @keyframes hero-flash {
    0%,
    100% {
      opacity: 0;
    }
    70% {
      opacity: 1;
    }
    78% {
      opacity: 0;
    }
    84% {
      opacity: 1;
    }
    88% {
      opacity: 0;
    }
  }

  /* A few blocks never settle: they step through the brand colours, holding each for a beat. */
  .hero__cell--signal.is-cycle::after {
    opacity: 1;
    animation: hero-cycle 6s steps(1, end) infinite var(--d);
  }

  @keyframes hero-cycle {
    0% {
      background: var(--signal);
    }
    16% {
      background: var(--pulse);
    }
    33% {
      background: var(--brand-ink);
    }
    40% {
      background: var(--flare);
    }
    56% {
      background: var(--scan);
    }
    72% {
      background: var(--volt);
    }
    86% {
      background: var(--brand-paper);
    }
    93% {
      background: var(--signal);
    }
  }

  /* The RGB split, in brand colours: copies of the print, each clipped to a band, jump sideways
     on their own clocks. Stacked over the cells so the split cuts across the blocks too. */
  .hero__split {
    position: relative;
    z-index: 1;
    opacity: 0;
    pointer-events: none;
  }

  .hero__split--a {
    background: var(--pulse);
    clip-path: inset(14% 0 70% 0);
    animation: hero-split 1.9s steps(1, end) infinite 1.2s;
  }

  .hero__split--b {
    background: var(--scan);
    clip-path: inset(46% 0 38% 0);
    animation: hero-split 2.7s steps(1, end) infinite 1.6s;
  }

  .hero__split--c {
    background: var(--flare);
    clip-path: inset(72% 0 12% 0);
    animation: hero-split 3.5s steps(1, end) infinite 2.1s;
  }

  @keyframes hero-split {
    0%,
    100% {
      opacity: 0;
      transform: none;
    }
    80% {
      opacity: 1;
      transform: translateX(-4%);
    }
    84% {
      transform: translateX(3%);
    }
    88% {
      transform: translateX(-1.5%);
    }
    91% {
      opacity: 0;
      transform: none;
    }
  }

  /* Two thin scan bars that flash across the picture, Volt and Paper. */
  .hero__bar {
    position: relative;
    z-index: 2;
    opacity: 0;
    pointer-events: none;
  }

  .hero__bar--a {
    grid-area: 3 / 1 / span 1 / -1;
    background: var(--volt);
    clip-path: inset(40% 0 52% 18%);
    animation: hero-bar 2.3s steps(1, end) infinite 1.4s;
  }

  .hero__bar--b {
    grid-area: 6 / 1 / span 1 / -1;
    background: var(--brand-paper);
    clip-path: inset(20% 30% 70% 0);
    animation: hero-bar 3.1s steps(1, end) infinite 2.2s;
  }

  @keyframes hero-bar {
    0%,
    100% {
      opacity: 0;
      transform: none;
    }
    90% {
      opacity: 1;
      transform: translateX(6%);
    }
    93% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes cell-on {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 5fr 6fr;
    }

    .hero__title {
      font-size: clamp(3.5rem, 5.6vw, 5.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cell,
    .hero__cell--signal::after,
    .hero__split,
    .hero__bar {
      animation: none;
    }
  }
</style>
