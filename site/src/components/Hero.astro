---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';
import WordmarkIntro from './WordmarkIntro.astro';

// "See, don't explain": a Higgsfield-style collage of real work filling the
// first screen. Live sites are tagged "Live"; design work that isn't live is
// tagged "Concept" (Eldeva, a mock-up for a family business, and an unofficial
// Tesla fan site, not affiliated with Tesla). No fictional-brand tiles. Images
// live in src/assets and ship as resized WebP.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/{work,projects}/*.jpg', {
  eager: true,
});
const img = (path: string) => {
  const found = images[`../assets/${path}.jpg`];
  if (!found) throw new Error(`Missing collage image: ${path}`);
  return found.default;
};

type Project = 'calculator' | 'essence' | 'eldeva' | 'tesla';
const PROJECTS: Record<Project, { name: string; live: boolean; caption: string; tag?: string }> = {
  calculator: { name: 'The Calculator App', live: true, caption: 'Live: The Calculator App' },
  essence: {
    name: 'Essence',
    live: true,
    caption: 'Live: Essence Hair Treatment, built for a family business',
  },
  eldeva: {
    name: 'Eldeva',
    live: false,
    caption: 'Concept: Eldeva, a mock-up for a family business (not live)',
    tag: 'Concept',
  },
  tesla: {
    name: 'Tesla (unofficial)',
    live: false,
    caption: 'Concept: unofficial Tesla fan site, not affiliated with Tesla, Inc.',
    tag: 'Unofficial concept',
  },
};

interface Tile {
  src: string;
  project: Project;
  /** width / height of the tile; rows share a height, so this sets its width */
  r: number;
  /** "scroll" pans a tall screenshot like a screen recording */
  motion?: 'scroll' | 'zoom';
  /** scroll tiles: the screenshot's height / width */
  tall?: number;
  pos?: string;
}

const rows: Tile[][] = [
  [
    { src: 'work/essence-mobile', project: 'essence', r: 0.62, pos: 'top' },
    { src: 'projects/eldeva-hero', project: 'eldeva', r: 1.2, motion: 'zoom' },
    { src: 'work/calculator-scroll', project: 'calculator', r: 1.15, motion: 'scroll' },
    { src: 'projects/tesla-model-s', project: 'tesla', r: 1.1, motion: 'zoom', pos: '62% 50%' },
    { src: 'projects/eldeva-velvet-peony', project: 'eldeva', r: 0.9, pos: '62% 50%' },
    { src: 'work/calculator-compound', project: 'calculator', r: 1.1, pos: 'top' },
  ],
  [
    { src: 'projects/tesla-hero', project: 'tesla', r: 1.2, motion: 'zoom', pos: 'left' },
    {
      src: 'work/calculator-retirement',
      project: 'calculator',
      r: 0.62,
      motion: 'scroll',
      tall: 1712 / 1000,
    },
    { src: 'projects/eldeva-light-it-slowly', project: 'eldeva', r: 1.1, motion: 'zoom' },
    { src: 'work/essence-scroll', project: 'essence', r: 1.15, motion: 'scroll' },
    { src: 'projects/tesla-semi', project: 'tesla', r: 1.0, pos: '68% 50%' },
    { src: 'projects/eldeva-sweet-plum', project: 'eldeva', r: 0.85, pos: '62% 50%' },
  ],
  [
    { src: 'projects/eldeva-scents', project: 'eldeva', r: 1.0, pos: 'left' },
    { src: 'projects/tesla-under-the-skin', project: 'tesla', r: 1.2, motion: 'zoom' },
    { src: 'work/essence-thumb', project: 'essence', r: 1.1 },
    { src: 'projects/eldeva-white-sands', project: 'eldeva', r: 0.85, pos: '52% 50%' },
    { src: 'work/calculator-mobile', project: 'calculator', r: 0.62, pos: 'top' },
    { src: 'projects/tesla-master-plan', project: 'tesla', r: 1.2, motion: 'zoom' },
  ],
  [
    { src: 'projects/tesla-network', project: 'tesla', r: 1.2, pos: 'left' },
    { src: 'projects/eldeva-ritual', project: 'eldeva', r: 1.1, motion: 'zoom' },
    { src: 'work/calculator-thumb', project: 'calculator', r: 1.1 },
    { src: 'projects/tesla-timeline', project: 'tesla', r: 1.0, pos: 'left' },
    { src: 'projects/eldeva-linen-breeze', project: 'eldeva', r: 0.9, pos: '62% 50%' },
    { src: 'projects/eldeva-footer', project: 'eldeva', r: 1.0, motion: 'zoom' },
  ],
];

type Filter = 'all' | 'live' | 'concept' | Project;
const filters: { id: Filter; label: string }[] = [
  { id: 'all', label: 'All' },
  { id: 'live', label: 'Live sites' },
  { id: 'concept', label: 'Concepts' },
  ...(Object.keys(PROJECTS) as Project[]).map((id) => ({ id, label: PROJECTS[id].name })),
];

// Scroll tiles pan from the top to the bottom of a tall screenshot, as a
// percentage of its own height, for the tile's ratio. Homepage captures are
// 1440x4200 unless the tile says otherwise.
const SCROLL_RATIO = 4200 / 1440;
const scrollEnd = (r: number, tall = SCROLL_RATIO) =>
  `-${Math.max(0, (1 - 1 / r / tall) * 100).toFixed(1)}%`;
let n = 0;
---

<section class="hero on-dark" aria-labelledby="hero-title" data-collage>
  <div class="wrap">
    <WordmarkIntro />
  </div>

  <div class="wrap hero__top">
    <div class="hero__copy">
      <p class="hero__status">
        <span class="hero__pulse" aria-hidden="true"></span>
        Taking on new projects across West Yorkshire
      </p>
      <h1 id="hero-title" class="hero__title">
        The software agency <span class="hero__accent">of the future.</span>
      </h1>
    </div>
    <div class="hero__side">
      <p class="hero__lede">
        Websites, booking apps and AI assistants that turn local searches into bookings. Designed,
        built and looked after in Bradford.
      </p>
      <div class="hero__actions">
        <a href="#real-work" class="btn btn--lime">
          See the work
          <span class="btn__icon">
            <Arrow />
          </span>
        </a>
        <a href="#audit" class="btn btn--ghost">
          Free presence audit
        </a>
      </div>
    </div>
  </div>

  <div class="wrap hero__bar">
    <div class="hero__chips" role="group" aria-label="Filter the work below">
      {filters.map((f, i) => (
        <button
          type="button"
          class="hero__chip"
          data-collage-filter={f.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {f.label}
        </button>
      ))}
    </div>
    <p class="hero__key">
      <span class="hero__key-dot" aria-hidden="true"></span>
      Live sites I've built and launched. Tiles marked Concept are design work that isn't live:
      Eldeva is a mock-up for a family business, and the Tesla fan site is an unofficial redesign,
      not affiliated with Tesla, Inc.
    </p>
  </div>

  <div class="hero__collage">
    {rows.map((row) => (
      <div class="hero__row">
        {row.map((tile) => {
          const i = n++;
          const project = PROJECTS[tile.project];
          return (
            <figure
              class:list={[
                'hero__tile',
                { 'is-live': project.live, [`is-${tile.motion}`]: tile.motion },
              ]}
              style={`--r:${tile.r};--scroll-end:${scrollEnd(tile.r, tile.tall)};--scroll-end-m:${scrollEnd(0.75, tile.tall)};--delay:${(i % 5) * -2.3}s`}
              data-cats={`${project.live ? 'live' : 'concept'} ${tile.project}`}
            >
              <Image
                src={img(tile.src)}
                alt=""
                width={tile.motion === 'scroll' ? 520 : 480}
                format="webp"
                quality={64}
                loading={i < 6 ? 'eager' : 'lazy'}
                decoding="async"
                style={tile.pos ? `object-position:${tile.pos}` : undefined}
              />
              {project.tag && (
                <span class="hero__tag" aria-hidden="true">
                  {project.tag}
                </span>
              )}
              <figcaption class="visually-hidden">{project.caption}</figcaption>
            </figure>
          );
        })}
      </div>
    ))}
    <div class="hero__fade" aria-hidden="true"></div>
  </div>
</section>

<script>
  import '../scripts/hero-collage.ts';
</script>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: -76px;
    padding-top: calc(76px + clamp(0.5rem, 2vw, 1.25rem));
    color: var(--on-dark);
    background:
      radial-gradient(40% 50% at 85% 0%, rgba(0, 255, 48, 0.12), transparent 70%),
      radial-gradient(35% 45% at 0% 10%, rgba(173, 255, 0, 0.07), transparent 70%), #000;
  }

  /* ---------- top strip ---------- */
  .hero__top {
    display: grid;
    gap: var(--space-4);
    align-items: end;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.4em 1em;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--on-dark-line);
    font-size: 0.78rem;
    font-weight: 500;
  }

  .hero__pulse {
    position: relative;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--neon);
    box-shadow: 0 0 10px var(--neon);
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--neon);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .hero__title {
    font-size: clamp(1.8rem, 3.3vw, 3rem);
    line-height: 0.95;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    max-width: 17em;
    animation: rise 0.9s var(--ease-out) both;
  }

  .hero__accent {
    background: var(--neon-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.3em);
    }
  }

  .hero__side {
    display: grid;
    gap: var(--space-3);
    max-width: 30rem;
  }

  .hero__lede {
    color: #b3b9c1;
    font-size: 0.98rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  /* ---------- chips ---------- */
  .hero__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(1.5rem, 3.5vw, 2.5rem);
    margin-bottom: 0.75rem;
  }

  .hero__chips {
    display: flex;
    gap: 0.4rem;
    overflow-x: auto;
    scrollbar-width: none;
    max-width: 100%;
  }

  .hero__chips::-webkit-scrollbar {
    display: none;
  }

  .hero__chip {
    flex: none;
    min-height: 40px;
    padding: 0.45em 1.1em;
    border-radius: var(--radius-sm);
    border: 1px solid transparent;
    background: rgba(255, 255, 255, 0.07);
    color: #d6d9de;
    font: 600 0.85rem var(--font-sans);
    cursor: pointer;
    transition:
      background-color 0.2s,
      color 0.2s;
  }

  .hero__chip:hover {
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
  }

  .hero__chip[aria-pressed='true'] {
    background: var(--neon);
    color: var(--ink);
    box-shadow: 0 6px 20px -8px rgba(0, 255, 48, 0.9);
  }

  .hero__key {
    display: flex;
    align-items: flex-start;
    gap: 0.4rem 0.5rem;
    font-size: 0.78rem;
    color: var(--on-dark-muted);
  }

  /* ---------- collage ---------- */
  .hero__collage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 6px;
    padding-inline: 6px;
    max-height: 150vw;
    overflow: hidden;
  }

  /* Mobile: rows dissolve into a two-column grid. */
  .hero__row {
    display: contents;
  }

  .hero__tile {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: 4px;
    background: var(--graphite-2);
    aspect-ratio: 3 / 4;
    cursor: pointer;
  }

  .hero__tile[hidden] {
    display: none;
  }

  .hero__tile :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      transform 0.9s var(--ease-out),
      filter 0.5s;
  }

  .hero__tile:hover :global(img) {
    transform: scale(1.06);
  }

  /* Slow drift so the wall is never still. */
  .hero__tile.is-zoom :global(img) {
    animation: drift 14s ease-in-out infinite alternate;
    animation-delay: var(--delay);
  }

  @keyframes drift {
    from {
      transform: scale(1.02) translate(0, 0);
    }
    to {
      transform: scale(1.12) translate(-2%, -1.5%);
    }
  }

  /* Screen-recording style pan through a full live homepage. */
  .hero__tile.is-scroll :global(img) {
    height: auto;
    object-fit: initial;
    animation: pan 20s ease-in-out infinite;
    animation-delay: var(--delay);
  }

  .hero__tile.is-scroll:hover :global(img) {
    animation-play-state: paused;
    transform: none;
  }

  @keyframes pan {
    0%,
    10% {
      transform: translateY(0);
    }
    50%,
    60% {
      transform: translateY(var(--scroll-end-m));
    }
    100% {
      transform: translateY(0);
    }
  }

  @keyframes pan-desktop {
    0%,
    10% {
      transform: translateY(0);
    }
    50%,
    60% {
      transform: translateY(var(--scroll-end));
    }
    100% {
      transform: translateY(0);
    }
  }

  .hero__tile.is-live::before {
    content: '';
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 2;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--neon);
    box-shadow:
      0 0 0 3px rgba(0, 0, 0, 0.55),
      0 0 14px var(--neon);
  }

  /* Visible label on design work that isn't live. */
  .hero__tag {
    position: absolute;
    left: 8px;
    bottom: 8px;
    z-index: 2;
    padding: 0.25em 0.6em;
    border-radius: var(--radius-pill);
    background: rgba(7, 8, 10, 0.78);
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 600;
    line-height: 1.3;
    backdrop-filter: blur(6px);
  }

  .hero__key-dot {
    flex: none;
    margin-top: 0.35em;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--neon);
    box-shadow: 0 0 10px var(--neon);
  }

  .hero__tile.is-live {
    box-shadow: inset 0 0 0 1px rgba(0, 255, 48, 0.5);
  }

  .hero__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 42%;
    display: grid;
    place-items: end center;
    padding-bottom: clamp(1.25rem, 3vw, 2rem);
    background: linear-gradient(180deg, transparent 0%, rgba(0, 0, 0, 0.7) 45%, #07080a 100%);
    pointer-events: none;
  }

  /* Filtered: an even grid of uniform tiles, so a lone tile never balloons. */
  .hero__collage.is-filtered {
    grid-template-columns: repeat(auto-fill, minmax(min(46%, 15rem), 1fr));
    max-height: none;
    padding-bottom: 6px;
  }

  .hero__collage.is-filtered .hero__row {
    display: contents;
  }

  .hero__collage.is-filtered .hero__tile {
    flex: none;
    aspect-ratio: 3 / 4;
  }

  .hero__collage.is-filtered .hero__fade {
    display: none;
  }

  @media (min-width: 48rem) {
    .hero__top {
      grid-template-columns: 1.3fr 1fr;
    }

    .hero__side {
      justify-self: end;
    }

    /* Desktop: justified rows; width follows each tile's ratio so a row shares one height. */
    .hero__collage {
      display: grid;
      grid-template-columns: 1fr;
      max-height: min(78vh, 60vw);
    }

    .hero__row {
      display: flex;
      gap: 6px;
    }

    .hero__tile {
      flex: var(--r) 1 0;
      aspect-ratio: var(--r);
    }

    .hero__tile.is-scroll :global(img) {
      animation-name: pan-desktop;
    }

    .hero__collage.is-filtered .hero__tile.is-scroll :global(img) {
      animation-name: pan;
    }

    .hero__collage.is-filtered {
      grid-template-columns: repeat(3, 1fr);
    }

    .hero__collage.is-filtered .hero__tile {
      aspect-ratio: 4 / 3;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__tile.is-zoom :global(img),
    .hero__tile.is-scroll :global(img) {
      animation: none;
    }
  }
</style>
