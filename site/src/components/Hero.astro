---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Arrow from './Arrow.astro';

// "See, don't explain": a moving wall of real and concept work. Real projects
// are tagged "Live"; everything else is tagged "Concept" (fictional brands).
// Images live in src/assets so Astro serves them as resized WebP.
const images = import.meta.glob<{ default: ImageMetadata }>('../assets/{concepts,work}/*.jpg', {
  eager: true,
});
const img = (path: string) => {
  const found = images[`../assets/${path}`];
  if (!found) throw new Error(`Missing wall image: ${path}`);
  return found.default;
};
type Tile = { src: string; label: string; live?: boolean; tall?: boolean };
const t = (id: string, label: string): Tile => ({ src: `concepts/${id}.jpg`, label });
const columns: Tile[][] = [
  [
    t('salon', 'Salon website'),
    { src: 'work/calculator-thumb.jpg', label: 'The Calculator App', live: true },
    t('barber', 'Barber booking app'),
    t('physio', 'Physio clinic website'),
  ],
  [
    { src: 'work/essence-mobile.jpg', label: 'Essence Hair Treatment', live: true, tall: true },
    t('restaurant', 'Restaurant ordering app'),
    t('digest', 'Owner dashboard'),
    t('florist', 'Florist shop'),
  ],
  [
    t('ceramics', 'Ceramics shop app'),
    { src: 'work/essence-thumb.jpg', label: 'Essence Hair Treatment', live: true },
    t('assistant', 'AI enquiry assistant'),
    { src: 'work/calculator-mobile.jpg', label: 'The Calculator App', live: true, tall: true },
    t('walks', 'Walks booking app'),
  ],
];
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__orb hero__orb--1"></span>
    <span class="hero__orb hero__orb--2"></span>
  </div>

  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="hero__status">
        <span class="hero__pulse" aria-hidden="true"></span>
        Taking on new projects across West Yorkshire
      </p>

      <h1 id="hero-title" class="hero__title">
        <span class="hero__line">The software agency</span>
        <span class="hero__line hero__line--accent">of the future.</span>
      </h1>

      <p class="hero__lede">
        Websites, booking apps and AI assistants that turn local searches into bookings. Designed,
        built and looked after in Bradford.
      </p>

      <div class="hero__actions">
        <a href="#real-work" class="btn btn--lime">
          See the work
          <span class="btn__icon">
            <Arrow />
          </span>
        </a>
        <a href="#audit" class="btn btn--ghost">
          Get your free presence audit
        </a>
      </div>

      <p class="hero__live">
        <span>Live now</span>
        <a href="https://www.thecalculatorapp.org" rel="noopener">
          The Calculator App <Arrow />
        </a>
        <a href="https://www.essencehairtreatment.com" rel="noopener">
          Essence Hair Treatment <Arrow />
        </a>
      </p>
    </div>

    <div class="hero__wall" aria-hidden="true">
      <div class="hero__plane">
        {columns.map((col, c) => (
          <div class={`hero__col hero__col--${c + 1}`}>
            <div class="hero__track">
              {[...col, ...col].map((tile, i) => (
                <figure class:list={['hero__tile', { 'hero__tile--tall': tile.tall }]}>
                  <Image
                    src={img(tile.src)}
                    alt=""
                    width={tile.tall ? 260 : 440}
                    format="webp"
                    quality={62}
                    loading={i < 2 ? 'eager' : 'lazy'}
                    decoding="async"
                  />
                  <figcaption class:list={['hero__tag', { 'hero__tag--live': tile.live }]}>
                    {tile.live ? 'Live' : 'Concept'} · {tile.label}
                  </figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    margin-top: -76px;
    padding-top: 76px;
    color: var(--on-dark);
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.03) 0 1px, transparent 1px 88px),
      radial-gradient(45% 55% at 78% 50%, rgba(0, 255, 48, 0.14), transparent 70%),
      radial-gradient(35% 40% at 10% 20%, rgba(173, 255, 0, 0.08), transparent 70%),
      linear-gradient(180deg, #000 0%, var(--black) 100%);
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    animation: orb 18s ease-in-out infinite alternate;
  }

  .hero__orb--1 {
    width: 40vw;
    height: 40vw;
    left: -14vw;
    top: 10%;
    background: var(--neon);
    opacity: 0.1;
  }

  .hero__orb--2 {
    width: 30vw;
    height: 30vw;
    right: 10vw;
    bottom: -10vw;
    background: var(--acid);
    opacity: 0.1;
    animation-duration: 22s;
    animation-direction: alternate-reverse;
  }

  @keyframes orb {
    to {
      transform: translate(6vw, 5vh) scale(1.12);
    }
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 5vw, 3rem);
    padding-top: clamp(2.5rem, 7vw, 4rem);
  }

  .hero__copy {
    display: grid;
    justify-items: start;
    align-content: center;
    gap: clamp(1.25rem, 2.4vw, 1.75rem);
    position: relative;
    z-index: 2;
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.45em 1.1em;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.06);
    border: 1px solid var(--on-dark-line);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .hero__pulse {
    position: relative;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--neon);
    box-shadow: 0 0 10px var(--neon);
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--neon);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .hero__title {
    display: grid;
    font-size: clamp(2.6rem, 5.4vw, 5.25rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .hero__line {
    display: block;
    animation: rise 1s var(--ease-out) both;
  }

  .hero__line--accent {
    background: var(--neon-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 40px rgba(0, 255, 48, 0.25));
    animation-delay: 0.12s;
    padding-bottom: 0.05em;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
  }

  .hero__lede {
    max-width: 34rem;
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    color: #b3b9c1;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__live {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    font-size: 0.85rem;
    color: var(--on-dark-muted);
  }

  .hero__live > span {
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: 0.72rem;
  }

  .hero__live a {
    display: inline-flex;
    align-items: center;
    gap: 0.35em;
    min-height: 32px;
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid rgba(0, 255, 48, 0.5);
    transition: color 0.2s;
  }

  .hero__live a:hover {
    color: var(--neon);
  }

  .hero__live :global(svg) {
    width: 0.9em;
    height: 0.9em;
  }

  /* ---------- the wall ---------- */
  .hero__wall {
    position: relative;
    height: clamp(26rem, 70vw, 34rem);
    margin-inline: calc(var(--gutter) * -1);
    overflow: hidden;
    mask-image: linear-gradient(180deg, transparent 0%, #000 14%, #000 86%, transparent 100%);
    perspective: 1600px;
  }

  .hero__plane {
    position: absolute;
    inset: -20% -10%;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    transform: rotateX(18deg) rotateY(-16deg) rotateZ(-8deg);
    transform-style: preserve-3d;
  }

  .hero__col {
    overflow: hidden;
  }

  .hero__track {
    display: grid;
    gap: clamp(0.75rem, 1.5vw, 1.25rem);
    animation: wall-up 48s linear infinite;
  }

  .hero__col--2 .hero__track {
    animation-name: wall-down;
    animation-duration: 56s;
  }

  .hero__col--3 .hero__track {
    animation-duration: 62s;
  }

  .hero__wall:hover .hero__track {
    animation-play-state: paused;
  }

  @keyframes wall-up {
    from {
      transform: translateY(0);
    }
    to {
      transform: translateY(calc(-50% - clamp(0.375rem, 0.75vw, 0.625rem)));
    }
  }

  @keyframes wall-down {
    from {
      transform: translateY(calc(-50% - clamp(0.375rem, 0.75vw, 0.625rem)));
    }
    to {
      transform: translateY(0);
    }
  }

  .hero__tile {
    position: relative;
    margin: 0;
    border-radius: var(--radius-md);
    overflow: hidden;
    background: var(--graphite-2);
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.08),
      0 30px 60px -30px rgba(0, 0, 0, 0.9);
  }

  .hero__tile :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: top;
  }

  .hero__tile--tall :global(img) {
    aspect-ratio: 390 / 700;
  }

  .hero__tag {
    position: absolute;
    left: 0.6rem;
    bottom: 0.6rem;
    padding: 0.3em 0.8em;
    border-radius: var(--radius-pill);
    background: rgba(7, 8, 10, 0.78);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    color: #fff;
    font-size: 0.68rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .hero__tag--live {
    background: var(--neon);
    color: var(--ink);
    box-shadow: 0 0 18px -2px rgba(0, 255, 48, 0.8);
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 1fr 1.05fr;
      align-items: center;
      min-height: calc(100svh - 76px);
      padding-top: 0;
    }

    .hero__wall {
      height: min(100svh, 56rem);
      margin: 0 calc(var(--gutter) * -1 - max(0px, (100vw - var(--content-max)) / 2)) 0 0;
      mask-image:
        linear-gradient(90deg, transparent 0%, #000 16%),
        linear-gradient(180deg, transparent 0%, #000 12%, #000 88%, transparent 100%);
      mask-composite: intersect;
      -webkit-mask-composite: source-in;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__track {
      animation: none;
    }
  }
</style>
