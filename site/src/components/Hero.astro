---
import { site } from '../config/site';
import RenderBarberApp from './renders/RenderBarberApp.astro';
import RenderSalonSite from './renders/RenderSalonSite.astro';
import RenderTradesDashboard from './renders/RenderTradesDashboard.astro';
import RenderCeramicsShop from './renders/RenderCeramicsShop.astro';

const disciplines = [
  { label: 'Design', href: '#design', tone: 'a' },
  { label: 'Development', href: '#development', tone: 'b' },
  { label: 'AI and automation', href: '#ai', tone: 'c' },
  { label: 'Visibility', href: '#visibility', tone: 'd' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>
  <div class="wrap hero__inner">
    <h1 id="hero-title" class="hero__title">
      <span class="t-bold t-silver">{site.wordmark}</span>
      <span class="t-thin t-silver">{site.descriptor}</span>
    </h1>

    <div class="hero__row">
      <ul class="hero__pills" aria-label="Disciplines">
        {disciplines.map((d) => (
          <li>
            <a href={d.href} class={`hero__pill hero__pill--${d.tone}`}>
              {d.label}
            </a>
          </li>
        ))}
      </ul>
      <a href="#services" class="pill-btn hero__all">
        <svg
          viewBox="0 0 24 24"
          aria-hidden="true"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
        >
          <path d="M7 17 17 7M9 7h8v8"></path>
        </svg>
        All services
      </a>
    </div>

    <div class="hero__intro">
      <p class="hero__lede">
        Websites, apps and AI assistants that turn local searches into bookings. Designed, built and
        looked after in Bradford.
      </p>
      <a href="#audit" class="pill-btn">
        Get your free presence audit
      </a>
    </div>

    <p class="hero__concept">
      <span aria-hidden="true"></span>Concept designs for fictional businesses
    </p>
    <div class="hero__grid">
      <RenderBarberApp label="Concept · Barber booking app" ratio="16 / 11" />
      <RenderSalonSite label="Concept · Salon website" ratio="16 / 11" />
      <RenderTradesDashboard label="Concept · Electrician quotes dashboard" ratio="16 / 11" />
      <RenderCeramicsShop label="Concept · Ceramics shop app" ratio="16 / 11" />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    padding-top: clamp(2rem, 6vw, 4.5rem);
    padding-bottom: var(--space-6);
  }

  .hero__glow {
    position: absolute;
    left: 50%;
    top: -140px;
    width: min(1400px, 150vw);
    height: 1250px;
    transform: translateX(-50%);
    background:
      radial-gradient(
        38% 34% at 50% 44%,
        rgba(194, 26, 156, 0.95),
        rgba(156, 13, 124, 0.7) 45%,
        transparent 100%
      ),
      radial-gradient(55% 45% at 50% 42%, rgba(120, 8, 96, 0.55), transparent 100%);
    filter: blur(20px);
    pointer-events: none;
    z-index: -1;
  }

  .hero__inner {
    position: relative;
  }

  .hero__title {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: 0.12em;
    font-size: clamp(3.4rem, 11.4vw, 10.75rem);
    line-height: 0.9;
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .hero__title .t-thin {
    padding-right: 0.08em;
  }

  .hero__row {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-3);
    padding-bottom: clamp(1.5rem, 3vw, 2.25rem);
    border-bottom: 1px solid rgba(255, 255, 255, 0.7);
  }

  .hero__pills {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
  }

  .hero__pill {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0.55em 1.9em;
    border-radius: var(--radius-pill);
    color: #fff;
    text-decoration: none;
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
    font-weight: 500;
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    transition:
      transform 0.25s var(--ease-out),
      background-color 0.25s;
  }

  .hero__pill:hover {
    transform: translateY(-2px);
  }

  .hero__pill--a {
    background: rgba(98, 98, 108, 0.85);
  }

  .hero__pill--b {
    background: rgba(140, 66, 118, 0.85);
  }

  .hero__pill--c {
    background: rgba(164, 58, 140, 0.9);
  }

  .hero__pill--d {
    background: rgba(118, 44, 160, 0.9);
  }

  .hero__all {
    font-size: clamp(0.95rem, 1.4vw, 1.15rem);
  }

  .hero__intro {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    padding-block: clamp(2rem, 5vw, 3.5rem) clamp(2.5rem, 6vw, 4.5rem);
  }

  .hero__lede {
    font-size: clamp(1.25rem, 2.2vw, 1.75rem);
    line-height: 1.45;
    letter-spacing: -0.015em;
    max-width: 26em;
  }

  .hero__concept {
    display: flex;
    align-items: center;
    gap: 0.6em;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: var(--space-3);
  }

  .hero__concept span {
    width: 0.5em;
    height: 0.5em;
    border-radius: 50%;
    background: #ff6fd8;
  }

  .hero__grid {
    display: grid;
    gap: clamp(0.75rem, 2vw, 1.75rem);
  }

  @media (min-width: 48rem) {
    .hero__grid {
      grid-template-columns: 1fr 1fr;
    }

    .hero__intro {
      padding-left: 30%;
    }
  }
</style>
