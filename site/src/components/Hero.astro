---
import { Image } from 'astro:assets';
import fingerprint from '../assets/brand/fingerprint.webp?url';
import { projectImage } from '../data/projects';

// The hero mosaic (2026-10-17 agency redesign, refs in reference/agency-redesign/): the brand's
// fingerprint scan in Paper, cut into square cells. Signal blocks sit over it like the pixel
// posters, a few cells drop out to Ink, and real project frames fill some edge cells: the
// human and the work, in pieces. Only live projects appear here: the frames carry no label, so
// unofficial or concept work (Tesla, Spider-Man, Eldeva) stays in the labelled work grid. Decorative only (aria-hidden); the headline is the content.
//
// Grid: 9 columns by 8 rows of square cells. Each cell is [column, row, width, height].
type Cell = {
  at: [number, number, number?, number?];
  kind: 'signal' | 'ink' | 'paper' | 'frame';
  src?: string;
  blink?: boolean;
};

const cells: Cell[] = [
  { at: [8, 1, 2, 2], kind: 'frame', src: 'work/calculator-desktop' },
  { at: [1, 6, 2, 2], kind: 'frame', src: 'work/essence-thumb' },
  { at: [9, 5, 1, 2], kind: 'frame', src: 'work/essence-mobile' },
  { at: [1, 2, 1, 1], kind: 'frame', src: 'work/calculator-compound' },
  { at: [3, 1], kind: 'signal' },
  { at: [5, 1], kind: 'signal', blink: true },
  { at: [4, 2], kind: 'signal' },
  { at: [5, 2], kind: 'signal' },
  { at: [6, 2], kind: 'signal', blink: true },
  { at: [7, 2], kind: 'paper' },
  { at: [3, 3], kind: 'signal' },
  { at: [5, 3], kind: 'ink' },
  { at: [6, 3], kind: 'signal' },
  { at: [7, 3], kind: 'signal' },
  { at: [2, 4], kind: 'signal', blink: true },
  { at: [4, 4], kind: 'signal' },
  { at: [5, 4], kind: 'signal' },
  { at: [3, 5], kind: 'ink' },
  { at: [5, 5], kind: 'signal' },
  { at: [6, 5], kind: 'signal' },
  { at: [8, 5], kind: 'signal' },
  { at: [3, 6], kind: 'signal' },
  { at: [4, 6], kind: 'signal', blink: true },
  { at: [7, 6], kind: 'signal' },
  { at: [3, 7], kind: 'ink' },
  { at: [5, 7], kind: 'signal' },
  { at: [6, 7], kind: 'signal' },
  { at: [2, 8], kind: 'paper' },
  { at: [4, 8], kind: 'signal' },
  { at: [7, 8], kind: 'signal', blink: true },
];

// A scattered (but fixed) order for the cells to cut on in.
const order = (c: Cell) => (c.at[0] * 7 + c.at[1] * 3) % 11;
const area = ([x, y, w = 1, h = 1]: Cell['at']) => `${y} / ${x} / span ${h} / span ${w}`;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="wrap hero__grid">
    <div class="hero__copy">
      <p class="label hero__label">Your human in the loop</p>
      <h1 id="hero-title" class="hero__title">
        Your site, rebuilt and found.
      </h1>
      <p class="hero__lede">
        We rebuild websites for local businesses, add booking, payments and AI enquiry assistants,
        and help you get found on Google and in AI search. Built in Bradford, and we stay to look
        after it.
      </p>
      <div class="hero__actions">
        <a href="#audit" class="btn btn--primary">
          Get your free audit
        </a>
        <a href="#work" class="btn btn--secondary">
          See the work
        </a>
      </div>
      <p class="hero__status">
        <span class="tag tag--signal tag--status">
          <span aria-hidden="true">●</span> Open
        </span>
        <span class="label">Taking on new projects across West Yorkshire</span>
      </p>
    </div>

    <div class="hero__mosaic" aria-hidden="true" style={`--print:url(${fingerprint})`}>
      <span class="hero__print"></span>
      {cells.map((c) => (
        <span
          class:list={['hero__cell', `hero__cell--${c.kind}`, { 'is-blink': c.blink }]}
          style={`grid-area:${area(c.at)};--i:${order(c)}`}
        >
          {c.src && (
            <Image
              src={projectImage(c.src)}
              alt=""
              width={320}
              format="webp"
              quality={60}
              loading="lazy"
              decoding="async"
            />
          )}
        </span>
      ))}
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    margin-top: -73px;
    padding-top: calc(73px + clamp(1.5rem, 4vw, 3.5rem));
    padding-bottom: clamp(3rem, 7vw, 6rem);
    background: var(--brand-ink);
    color: var(--ink-text);
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  .hero__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
  }

  .hero__label {
    color: var(--signal-text);
  }

  .hero__title {
    font-size: clamp(2.75rem, 9.5vw, 5.75rem);
    line-height: 0.92;
    letter-spacing: -0.025em;
  }

  .hero__lede {
    max-width: 34rem;
    font-size: 1.125rem;
    line-height: 1.55;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .hero__status {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
  }

  .hero__status .label {
    color: var(--ink-text);
  }

  /* ---------- mosaic ---------- */
  .hero__mosaic {
    position: relative;
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    grid-template-rows: repeat(8, 1fr);
    aspect-ratio: 9 / 8;
    width: 100%;
    border: var(--border-hairline) solid var(--line);
  }

  /* The scan is white ridges on black, used as a luminance mask, so it paints in Paper. */
  .hero__print {
    grid-area: 1 / 1 / -1 / -1;
    background: var(--brand-paper);
    -webkit-mask: var(--print) center / auto 100% no-repeat;
    mask: var(--print) center / auto 100% no-repeat luminance;
  }

  .hero__cell {
    position: relative;
    overflow: hidden;
    animation: cell-on 1ms steps(1, end) both;
    animation-delay: calc(150ms + var(--i) * 90ms);
  }

  .hero__cell--signal {
    background: var(--signal);
  }

  .hero__cell--ink {
    background: var(--brand-ink);
  }

  .hero__cell--paper {
    background: var(--brand-paper);
  }

  .hero__cell--frame {
    background: var(--surface-raised);
    box-shadow: inset 0 0 0 1px var(--brand-ink);
  }

  /* Frames stay black and white: colour enters through the blocks (graphic language). */
  .hero__cell :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: left top;
    filter: grayscale(1) contrast(1.1);
  }

  /* After the cut-on, a few blocks drop out for a beat now and then: a quiet glitch. */
  .hero__cell.is-blink {
    animation:
      cell-on 1ms steps(1, end) both calc(150ms + var(--i) * 90ms),
      blink 9s steps(1, end) infinite calc(2.5s + var(--i) * 0.7s);
  }

  @keyframes cell-on {
    from {
      opacity: 0;
    }
    to {
      opacity: 1;
    }
  }

  @keyframes blink {
    0%,
    100% {
      opacity: 1;
    }
    90% {
      opacity: 0;
    }
    93% {
      opacity: 1;
    }
    95% {
      opacity: 0;
    }
    97% {
      opacity: 1;
    }
  }

  @media (min-width: 64rem) {
    .hero__grid {
      grid-template-columns: 5fr 6fr;
    }

    .hero__title {
      font-size: clamp(3.5rem, 5.6vw, 5.75rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero__cell,
    .hero__cell.is-blink {
      animation: none;
    }
  }
</style>
