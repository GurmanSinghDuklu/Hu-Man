---
import Arrow from './Arrow.astro';
import RenderBarberApp from './renders/RenderBarberApp.astro';
import RenderSalonSite from './renders/RenderSalonSite.astro';
import RenderCeramicsShop from './renders/RenderCeramicsShop.astro';
---

<section class="hero on-dark" aria-labelledby="hero-title">
  <div class="hero__bg" aria-hidden="true">
    <span class="hero__orb hero__orb--1"></span>
    <span class="hero__orb hero__orb--2"></span>
  </div>

  <div class="wrap hero__inner">
    <p class="hero__status">
      <span class="hero__pulse" aria-hidden="true"></span>
      Taking on new projects across West Yorkshire
    </p>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__line">Design. Build.</span>
      <span class="hero__line hero__line--accent">Grow.</span>
    </h1>

    <p class="hero__lede">
      Websites, booking apps and AI assistants that turn local searches into bookings. Designed,
      built and looked after in Bradford.
    </p>

    <div class="hero__actions">
      <a href="#work" class="btn btn--lime">
        See concept work
        <span class="btn__icon">
          <Arrow />
        </span>
      </a>
      <a href="#audit" class="btn btn--ghost">
        Get your free presence audit
      </a>
    </div>
  </div>

  <div class="wrap hero__stage">
    <a href="#work" class="hero__side hero__side--left">
      Concept work
    </a>
    <div class="hero__cards">
      <div class="hero__card hero__card--1">
        <RenderCeramicsShop ratio="1 / 1" />
      </div>
      <div class="hero__card hero__card--2">
        <RenderBarberApp ratio="4 / 3.4" label="Concept · fictional businesses" />
      </div>
      <div class="hero__card hero__card--3">
        <RenderSalonSite ratio="1 / 1" />
      </div>
    </div>
    <a href="#tools" class="hero__side hero__side--right">
      Scroll down
      <span class="hero__down" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 5v14M6 13l6 6 6-6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow-x: clip;
    margin-top: -76px;
    padding-top: calc(76px + clamp(2.5rem, 7vw, 5.5rem));
    color: var(--on-dark);
  }

  .hero__bg {
    position: absolute;
    inset: 0 0 0 0;
    z-index: -1;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 88px),
      radial-gradient(55% 40% at 50% 80%, rgba(0, 255, 48, 0.16), transparent 70%),
      radial-gradient(40% 30% at 50% 0%, rgba(173, 255, 0, 0.08), transparent 70%),
      linear-gradient(180deg, #000 0%, var(--black) 100%);
    overflow: hidden;
  }

  .hero__orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    animation: orb 18s ease-in-out infinite alternate;
  }

  .hero__orb--1 {
    width: 46vw;
    height: 46vw;
    left: -12vw;
    top: 4%;
    background: var(--neon);
    opacity: 0.14;
  }

  .hero__orb--2 {
    width: 34vw;
    height: 34vw;
    right: -8vw;
    top: 18%;
    background: var(--acid);
    opacity: 0.12;
    animation-duration: 22s;
    animation-direction: alternate-reverse;
  }

  @keyframes orb {
    to {
      transform: translate(8vw, 6vh) scale(1.12);
    }
  }

  .hero__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: clamp(1.25rem, 2.5vw, 1.75rem);
  }

  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    padding: 0.45em 1.1em;
    border-radius: var(--radius-pill);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid var(--on-dark-line);
    font-size: 0.8rem;
    font-weight: 500;
  }

  .hero__pulse {
    position: relative;
    width: 0.55em;
    height: 0.55em;
    border-radius: 50%;
    background: var(--neon);
    box-shadow: 0 0 10px var(--neon);
  }

  .hero__pulse::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: var(--neon);
    animation: pulse 2s ease-out infinite;
  }

  @keyframes pulse {
    to {
      transform: scale(3.2);
      opacity: 0;
    }
  }

  .hero__title {
    display: grid;
    font-size: clamp(3rem, 10.5vw, 9.5rem);
    line-height: 0.9;
    letter-spacing: -0.055em;
    text-transform: uppercase;
  }

  .hero__line {
    display: block;
    animation: rise 1s var(--ease-out) both;
  }

  .hero__line--accent {
    background: var(--neon-gradient);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 0 40px rgba(0, 255, 48, 0.25));
    animation-delay: 0.12s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.35em);
    }
  }

  .hero__lede {
    max-width: 36rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    color: #b3b9c1;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }

  .hero__stage {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    align-items: end;
    margin-top: clamp(3rem, 7vw, 5rem);
    padding-bottom: clamp(3rem, 6vw, 4.5rem);
  }

  .hero__cards {
    display: grid;
    grid-template-columns: 0.8fr 1.5fr 0.8fr;
    align-items: end;
    gap: clamp(0.5rem, 1.6vw, 1.25rem);
  }

  .hero__card {
    border-radius: var(--radius-md);
    overflow: hidden;
    box-shadow: var(--shadow-card);
    animation: float 7s ease-in-out infinite;
  }

  .hero__card :global(.tile) {
    border-radius: var(--radius-md);
  }

  .hero__card--1 {
    transform: rotate(-4deg);
    animation-delay: -2s;
    margin-bottom: 1.5rem;
  }

  .hero__card--3 {
    transform: rotate(4deg);
    animation-delay: -4s;
    margin-bottom: 2.5rem;
  }

  @keyframes float {
    0%,
    100% {
      translate: 0 0;
    }
    50% {
      translate: 0 -14px;
    }
  }

  .hero__side {
    display: none;
    color: var(--color-text-muted);
    text-decoration: none;
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .hero__side:hover {
    color: var(--neon);
  }

  .hero__down {
    display: inline-grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    margin-left: 0.6rem;
    border-radius: 50%;
    background: var(--neon);
    color: var(--ink);
    vertical-align: middle;
    animation: nudge 2.4s ease-in-out infinite;
  }

  .hero__down svg {
    width: 1rem;
    height: 1rem;
  }

  @keyframes nudge {
    50% {
      transform: translateY(4px);
    }
  }

  @media (min-width: 60rem) {
    .hero__stage {
      grid-template-columns: 9rem 1fr 9rem;
    }

    .hero__side {
      display: block;
      padding-bottom: 1rem;
    }

    .hero__side--right {
      text-align: right;
    }
  }

  @media (max-width: 40rem) {
    .hero__cards {
      grid-template-columns: 1fr;
    }

    .hero__card--1,
    .hero__card--3 {
      display: none;
    }
  }
</style>
