---
/**
 * A moving picture cut from our own reels (src/data/clips.ts; `npm run cut-clips`). The still
 * shows straight away; the loop loads once the page has settled and the frame is near the screen,
 * plays only while it is on screen (at most three at once), and fades in over the still once it
 * is actually playing (scripts/clips.ts). Reduced motion and Data Saver keep the still.
 *
 * Decorative: hidden from screen readers, so never put meaning in a clip that the text around it
 * doesn't already say. The frame fills its box (object-fit: cover); without a box size it takes the
 * clip's own shape. `zoom` (on by default) eases the picture from a slight zoom as you scroll.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { clips, type ClipId } from '../data/clips';
import { withBase } from '../config/paths';

interface Props {
  id: ClipId;
  class?: string;
  /** How wide the frame shows, for choosing the still's size (CSS `sizes`). */
  sizes?: string;
  zoom?: boolean;
  /** Fill the parent (which sets the size and shape) instead of taking the clip's own shape. */
  fill?: boolean;
}

const {
  id,
  class: className,
  sizes = '(min-width: 64rem) 40vw, 100vw',
  zoom = true,
  fill = false,
} = Astro.props;
const spec = clips.find((c) => c.id === id)!;
const stills = import.meta.glob<{ default: ImageMetadata }>('../assets/clips/*.jpg', {
  eager: true,
});
const still = stills[`../assets/clips/${id}.jpg`]!.default;
const widths = [360, 640, 960, 1280].filter((w) => w < still.width).concat(still.width);
const images = await Promise.all(
  widths.map((w) => getImage({ src: still, width: w, format: 'webp', quality: 70 })),
);
const srcset = images.map((img, i) => `${img.src} ${widths[i]}w`).join(', ');
const [, , cw, ch] = spec.crop;
---

<div
  class:list={['clip', { 'clip--fill': fill }, className]}
  data-zoom={zoom ? '' : undefined}
  style={`--clip-ratio:${cw} / ${ch}`}
  aria-hidden="true"
>
  <img
    src={images.at(-1)!.src}
    srcset={srcset}
    sizes={sizes}
    alt=""
    width={still.width}
    height={still.height}
    loading="lazy"
    decoding="async"
  />
  {!('still' in spec && spec.still) && (
    <video
      muted
      playsinline
      loop
      preload="none"
      disablepictureinpicture
      data-clip-src={withBase(`/clips/${id}.mp4`)}
    />
  )}
</div>

<script>
  import '../scripts/clips.ts';
</script>

<style>
  .clip {
    position: relative;
    overflow: hidden;
    aspect-ratio: var(--clip-ratio);
    background: var(--ink);
  }

  .clip--fill {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    aspect-ratio: auto;
  }

  .clip img,
  .clip video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    scale: var(--zoom, 1);
  }

  .clip video {
    opacity: 0;
    transition: opacity 0.7s var(--ease-out);
  }

  .clip.is-playing video {
    opacity: 1;
  }
</style>
