---
/**
 * Stands in for the "trusted clients" logo row common on agency sites.
 * These are tools and platforms I build with (docs/02 and docs/01), shown as
 * plain text, never as client logos or endorsements.
 */
const tools = [
  'Stripe',
  'Square',
  'SumUp',
  'Google Business Profile',
  'WhatsApp',
  'React',
  'TypeScript',
  'Astro',
  'Claude',
  'Docker',
];
---

<section class="tools" id="tools" aria-labelledby="tools-title">
  <h2 id="tools-title" class="tools__title">
    Built with tools you and your customers already use
  </h2>
  <div class="tools__track">
    <ul class="tools__list">
      {tools.map((t) => (
        <li>{t}</li>
      ))}
    </ul>
    <ul class="tools__list" aria-hidden="true">
      {tools.map((t) => (
        <li>{t}</li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* A ruled strip: hairlines above and below, names in Montserrat capitals. No fade masks. */
  .tools {
    padding-block: clamp(2.5rem, 6vw, 4rem);
  }

  .tools__title {
    font: 500 0.75rem/1.4 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    margin-bottom: var(--space-3);
    padding-inline: var(--gutter);
    max-width: var(--content-max);
    margin-inline: auto;
  }

  .tools__track {
    display: flex;
    overflow: hidden;
    border-block: var(--border-hairline) solid var(--line);
  }

  .tools__track:hover .tools__list {
    animation-play-state: paused;
  }

  .tools__list {
    list-style: none;
    display: flex;
    flex: none;
    margin: 0;
    padding: 0;
    animation: tools 40s linear infinite;
  }

  .tools__list li {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    padding: 1.1rem 1.25rem 1.1rem 0;
    white-space: nowrap;
    font: 800 clamp(1.1rem, 2vw, 1.5rem) / 1 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    color: var(--ink-text);
  }

  /* A small Signal square between names. */
  .tools__list li::before {
    content: '';
    width: 0.4em;
    height: 0.4em;
    background: var(--signal);
  }

  @keyframes tools {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tools__list {
      animation: none;
      flex-wrap: wrap;
      flex: 1;
      justify-content: center;
      column-gap: 1.25rem;
    }

    .tools__list[aria-hidden='true'] {
      display: none;
    }
  }
</style>
