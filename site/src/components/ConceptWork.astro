---
import { realProjects } from '../data/content';
import RenderPhysioSite from './renders/RenderPhysioSite.astro';
import RenderRestaurant from './renders/RenderRestaurant.astro';
import RenderOwnerDigest from './renders/RenderOwnerDigest.astro';
import RenderFlorist from './renders/RenderFlorist.astro';
import RenderWalks from './renders/RenderWalks.astro';
import RenderAssistant from './renders/RenderAssistant.astro';
---

<section class="work" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="work__head">
      <h2 id="work-title" class="section-title">
        <span class="t-thin">Concept</span> <span class="t-bold">work</span>
      </h2>
      <p class="work__note">
        These are concept designs for fictional businesses. They show what I would build, not past
        client work.
      </p>
    </div>

    <div class="work__feature">
      <figure class="work__item">
        <RenderPhysioSite ratio="4 / 3" />
      </figure>
      <div class="work__feature-cap">
        <h3>Physio clinic website</h3>
        <p>Concept · Design, development, online booking</p>
      </div>
    </div>

    <div class="work__row work__row--2">
      <figure class="work__item">
        <RenderRestaurant ratio="1 / 1.02" />
        <figcaption>
          <b>Restaurant ordering app</b>
          <span>Concept · Design, online ordering</span>
        </figcaption>
      </figure>
      <figure class="work__item">
        <RenderOwnerDigest ratio="4 / 3" />
        <figcaption>
          <b>Owner digest dashboard</b>
          <span>Concept · Automation, reporting</span>
        </figcaption>
      </figure>
    </div>

    <div class="work__row work__row--3">
      <figure class="work__item">
        <RenderFlorist ratio="1 / 1" />
        <figcaption>
          <b>Florist website and shop</b>
          <span>Concept · Design, payments</span>
        </figcaption>
      </figure>
      <figure class="work__item">
        <RenderWalks ratio="1 / 1" />
        <figcaption>
          <b>Guided walks booking app</b>
          <span>Concept · Booking, payments</span>
        </figcaption>
      </figure>
      <figure class="work__item">
        <RenderAssistant ratio="1 / 1" />
        <figcaption>
          <b>AI enquiry assistant</b>
          <span>Concept · AI, testing, handover</span>
        </figcaption>
      </figure>
    </div>

    <div class="work__real">
      <h3>Real projects</h3>
      <ul>
        {realProjects.map((project) => (
          <li>
            <span class="work__real-name">
              {project.href ? (
                <a href={project.href} rel="noopener">
                  {project.name}
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.6"
                  >
                    <path d="M7 17 17 7M9 7h8v8" />
                  </svg>
                </a>
              ) : (
                project.name
              )}
            </span>
            <span class="work__real-desc">{project.description}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .work {
    background: var(--paper);
    color: var(--paper-text);
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .work__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }

  .work__note {
    color: var(--paper-muted);
    max-width: 36rem;
  }

  .work__feature {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(1rem, 2vw, 1.5rem);
  }

  .work__feature-cap h3 {
    font-size: clamp(1.75rem, 3.2vw, 2.6rem);
    font-weight: 500;
    letter-spacing: -0.035em;
    line-height: 1.08;
    max-width: 10em;
  }

  .work__feature-cap p,
  .work__item figcaption span {
    color: var(--paper-muted);
    font-size: 0.85rem;
    margin-top: 0.6rem;
  }

  .work__item {
    margin: 0;
  }

  .work__item figcaption {
    display: grid;
    gap: 0.2rem;
    padding-top: 1rem;
  }

  .work__item figcaption b {
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    font-size: 0.95rem;
  }

  .work__item figcaption span {
    margin-top: 0;
  }

  .work__row {
    display: grid;
    gap: clamp(1rem, 2vw, 1.5rem);
    margin-bottom: clamp(1.5rem, 3vw, 2.5rem);
  }

  .work__real {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: var(--space-4);
  }

  .work__real h3 {
    font-size: clamp(1.75rem, 3vw, 2.4rem);
    font-weight: 500;
    letter-spacing: -0.035em;
  }

  .work__real ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--paper-line);
  }

  .work__real li {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--paper-line);
  }

  .work__real-name {
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .work__real-name a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    min-height: 24px;
  }

  .work__real-name a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .work__real-name svg {
    width: 0.9em;
    height: 0.9em;
  }

  .work__real-desc {
    color: var(--paper-muted);
  }

  @media (min-width: 48rem) {
    .work__head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .work__note {
      max-width: 22rem;
      text-align: right;
    }

    .work__feature {
      grid-template-columns: 1.55fr 1fr;
    }

    .work__row--2 {
      grid-template-columns: 1fr 1.36fr;
      margin-left: 18%;
    }

    .work__row--3 {
      grid-template-columns: repeat(3, 1fr);
    }

    .work__real {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }

    .work__real li {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-4);
      align-items: baseline;
    }
  }
</style>
