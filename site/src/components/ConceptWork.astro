---
import { realProjects } from '../data/content';
import Arrow from './Arrow.astro';
import RenderPhysioSite from './renders/RenderPhysioSite.astro';
import RenderRestaurant from './renders/RenderRestaurant.astro';
import RenderOwnerDigest from './renders/RenderOwnerDigest.astro';
import RenderFlorist from './renders/RenderFlorist.astro';
import RenderWalks from './renders/RenderWalks.astro';
import RenderAssistant from './renders/RenderAssistant.astro';
import RenderBarberApp from './renders/RenderBarberApp.astro';
import RenderSalonSite from './renders/RenderSalonSite.astro';
import RenderTradesDashboard from './renders/RenderTradesDashboard.astro';

type Category = 'websites' | 'apps' | 'dashboards' | 'ai';
const filters: { id: 'all' | Category; label: string }[] = [
  { id: 'all', label: 'All' },
  { id: 'websites', label: 'Websites' },
  { id: 'apps', label: 'Apps' },
  { id: 'dashboards', label: 'Dashboards' },
  { id: 'ai', label: 'AI' },
];

const work = [
  {
    Render: RenderPhysioSite,
    title: 'Physio clinic website',
    tags: 'Design · Development · Booking',
    cat: 'websites',
    size: 'wide',
    ratio: '16 / 10',
  },
  {
    Render: RenderRestaurant,
    title: 'Restaurant ordering app',
    tags: 'Design · Online ordering',
    cat: 'apps',
    size: 'tall',
    ratio: '4 / 5',
  },
  {
    Render: RenderBarberApp,
    title: 'Barber booking app',
    tags: 'Booking · Deposits',
    cat: 'apps',
    size: 'std',
    ratio: '4 / 3',
  },
  {
    Render: RenderOwnerDigest,
    title: 'Owner digest dashboard',
    tags: 'Automation · Reporting',
    cat: 'dashboards',
    size: 'std',
    ratio: '4 / 3',
  },
  {
    Render: RenderFlorist,
    title: 'Florist website and shop',
    tags: 'Design · Payments',
    cat: 'websites',
    size: 'std',
    ratio: '4 / 3',
  },
  {
    Render: RenderAssistant,
    title: 'AI enquiry assistant',
    tags: 'AI · Testing · Handover',
    cat: 'ai',
    size: 'wide',
    ratio: '16 / 10',
  },
  {
    Render: RenderWalks,
    title: 'Guided walks booking app',
    tags: 'Booking · Payments',
    cat: 'apps',
    size: 'std',
    ratio: '4 / 3',
  },
  {
    Render: RenderTradesDashboard,
    title: 'Electrician quotes dashboard',
    tags: 'Quotes · Follow-ups',
    cat: 'dashboards',
    size: 'std',
    ratio: '4 / 3',
  },
  {
    Render: RenderSalonSite,
    title: 'Salon website',
    tags: 'Design · Booking',
    cat: 'websites',
    size: 'std',
    ratio: '4 / 3',
  },
] as const;
---

<section class="work light" id="work" aria-labelledby="work-title" data-work>
  <div class="wrap">
    <div class="work__head">
      <div class="work__titles">
        <p class="eyebrow" data-reveal>
          Portfolio
        </p>
        <h2 id="work-title" class="section-title" data-reveal>
          Concept <span class="hl">work</span>
        </h2>
      </div>
      <p class="work__note" data-reveal>
        These are concept designs for fictional businesses. They show what I would build, not past
        client work.
      </p>
    </div>

    <div class="work__filters" role="group" aria-label="Filter concept work" data-reveal>
      {filters.map((f, i) => (
        <button
          type="button"
          class="work__filter"
          data-filter={f.id}
          aria-pressed={i === 0 ? 'true' : 'false'}
        >
          {f.label}
        </button>
      ))}
    </div>

    <ul class="work__grid">
      {work.map(({ Render, title, tags, cat, size, ratio }, i) => (
        <li
          class={`work__card work__card--${size}`}
          data-cat={cat}
          data-reveal
          style={`--reveal-delay:${(i % 3) * 0.08}s`}
        >
          <figure>
            <div class="work__media">
              <Render ratio={ratio} />
            </div>
            <figcaption>
              <span>
                <b>{title}</b>
                <span class="work__tags">Concept · {tags}</span>
              </span>
            </figcaption>
          </figure>
        </li>
      ))}
    </ul>
    <p class="work__empty" hidden data-work-empty>
      No concepts in this category yet.
    </p>

    <div class="work__real" data-reveal>
      <h3>Real projects</h3>
      <ul>
        {realProjects.map((project) => (
          <li>
            <span class="work__real-name">
              {project.href ? (
                <a href={project.href} rel="noopener">
                  {project.name}
                  <Arrow class="work__real-arrow" />
                </a>
              ) : (
                project.name
              )}
            </span>
            <span class="work__real-desc">{project.description}</span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<script>
  import '../scripts/work-filter.ts';
</script>

<style>
  /* A Paper band: the brand's document theme. Cards sit in a flush, hairline-ruled grid. */
  .work {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .work__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: var(--space-4);
  }

  .work__titles {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .work__note {
    color: var(--color-text-muted);
    max-width: 26rem;
  }

  .work__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .work__filter {
    min-height: 44px;
    padding: 0.4em 1em;
    border: var(--border-hairline) solid var(--line-strong);
    border-radius: 0;
    background: transparent;
    color: var(--ink-text);
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      background-color 0.15s linear,
      color 0.15s linear,
      border-color 0.15s linear;
  }

  .work__filter:hover {
    border-color: var(--ink-text);
  }

  .work__filter[aria-pressed='true'] {
    background: var(--brand-ink);
    color: var(--brand-paper);
    border-color: var(--brand-ink);
  }

  .work__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--border-hairline);
    background: var(--line);
    border: var(--border-hairline) solid var(--line);
  }

  .work__card {
    background: var(--surface);
  }

  .work__card[hidden] {
    display: none;
  }

  .work__card figure {
    margin: 0;
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .work__media {
    overflow: hidden;
    flex: 1;
    display: grid;
  }

  .work__media :global(.tile) {
    border-radius: 0;
    height: 100%;
    transition: transform 0.8s var(--ease-out);
  }

  .work__media :global(.tile__stage) {
    height: 100%;
  }

  .work__card:hover .work__media :global(.tile) {
    transform: scale(1.03);
  }

  .work__card figcaption {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1rem 1.25rem 1.25rem;
    border-top: var(--border-hairline) solid var(--line);
  }

  .work__card figcaption > span:first-child {
    display: grid;
    gap: 0.35rem;
  }

  .work__card b {
    font: 800 1.0625rem/1.1 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .work__tags {
    font: 500 0.6875rem/1.4 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .work__empty {
    color: var(--color-text-muted);
  }

  .work__real {
    margin-top: clamp(3rem, 6vw, 5rem);
    display: grid;
    gap: var(--space-4);
  }

  .work__real h3 {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
  }

  .work__real ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-rule) solid var(--brand-ink);
  }

  .work__real li {
    display: grid;
    gap: 0.25rem;
    padding-block: 1.25rem;
    border-bottom: var(--border-hairline) solid var(--line);
  }

  .work__real-name {
    font: 700 1.2rem/1.3 var(--font-text);
  }

  .work__real-name a {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    text-decoration: none;
    min-height: 24px;
  }

  .work__real-name a:hover {
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }

  .work__real-name :global(.work__real-arrow) {
    width: 0.9em;
    height: 0.9em;
  }

  .work__real-desc {
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .work__head {
      grid-template-columns: 1fr auto;
      align-items: end;
    }

    .work__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .work__card--wide {
      grid-column: span 2;
    }

    .work__real {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }

    .work__real li {
      grid-template-columns: 1fr 1.4fr;
      gap: var(--space-4);
      align-items: baseline;
    }
  }

  @media (min-width: 64rem) {
    .work__grid {
      grid-template-columns: repeat(3, 1fr);
    }

    .work__card--tall {
      grid-row: span 2;
    }
  }
</style>
