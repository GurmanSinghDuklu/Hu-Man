---
/** #get: the 14 deliverables as tiles, each a crop of a real asset from the Pura or Latte case study. */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { deliverables } from '../../data/brandPage';
import { caseStudies } from '../../data/brandStudio';
import Shape from '../play/Shape.astro';

const photos = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/brand-studio/{pura,latte}/*.jpg',
  {
    eager: true,
  },
);
const logos = import.meta.glob<string>('../../assets/brand-studio/{pura,latte}/*-logo.svg', {
  eager: true,
  query: '?raw',
  import: 'default',
});
const ph = (id: string, n: string) =>
  photos[`../../assets/brand-studio/${id}/${id}-${n}.jpg`].default;
const logo = (id: string, box?: string) => {
  let o = logos[`../../assets/brand-studio/${id}/${id}-logo.svg`].replace(
    / role="img" aria-label="[^"]*"/,
    ' aria-hidden="true" focusable="false"',
  );
  if (box) o = o.replace(/viewBox="[^"]+"/, `viewBox="${box}"`);
  return o;
};
const pura = caseStudies[0];
const latte = caseStudies[1];
const photoFor: Record<string, [ImageMetadata, string]> = {
  imagery: [ph('pura', 'hero'), '70% 20%'],
  social: [ph('latte', 'iced'), '50% 40%'],
  mockups: [ph('pura', 'bottle'), '50% 50%'],
  cards: [ph('pura', 'cards'), '50% 50%'],
  signage: [ph('pura', 'billboard'), '50% 50%'],
  merch: [ph('latte', 'reusable'), '50% 40%'],
};
---

<section id="get" class="band band--ink bs-get" aria-labelledby="get-title">
  <div class="sheet">
    <p class="label" data-reveal>
      What you get · 14 deliverables
    </p>
    <h2 id="get-title" class="display display--s" data-reveal="lines">
      The whole kit, <Shape kind="arch" tone="lilac" /> not just a logo.
    </h2>
    <ul class="bs-gettiles">
      {deliverables.map((d, i) => (
        <li
          class={`bs-gt bs-gt--${d.asset}`}
          data-reveal
          style={`--reveal-delay:${(i % 4) * 0.06}s`}
        >
          <div class="bs-gt__art" aria-hidden="true">
            {d.asset === 'logo' && (
              <span
                class="bs-gt__logo"
                style={`color:${pura.roles.light};background:${pura.roles.primary}`}
                set:html={logo('pura')}
              />
            )}
            {d.asset === 'mark' && (
              <span
                class="bs-gt__mark"
                style={`color:${latte.roles.light};background:${latte.roles.dark}`}
                set:html={logo('latte', latte.markBox)}
              />
            )}
            {d.asset === 'space' && (
              <span class="bs-gt__space" style={`color:${pura.roles.primary}`}>
                <span set:html={logo('pura')} />
              </span>
            )}
            {d.asset === 'typeface' && (
              <span
                class="bs-gt__aa"
                style="font-family:'bs-fredoka',var(--font-display);font-weight:700"
              >
                Aa
              </span>
            )}
            {d.asset === 'hierarchy' && (
              <span class="bs-gt__hier" style="font-family:'bs-bricolage',var(--font-display)">
                <b>Good mornings</b>
                <i>Made here</i>
                <em>Caption text, small</em>
              </span>
            )}
            {d.asset === 'palette' && (
              <span class="bs-gt__pal">
                {latte.palette.map((c) => (
                  <span style={`background:${c.hex}`} />
                ))}
              </span>
            )}
            {d.asset === 'pattern' && (
              <svg viewBox="0 0 200 140" preserveAspectRatio="xMidYMid slice" focusable="false">
                <defs>
                  <pattern id="gt-pat" width="70" height="70" patternUnits="userSpaceOnUse">
                    <g fill={pura.roles.soft}>
                      <path d="M18 30C18 16 26 8 38 6c1 13-6 23-20 24z" />
                      <path d="M18 30C16 17 8 10 -2 9c-1 12 5 20 20 21z" />
                      <circle cx="54" cy="50" r="4" />
                    </g>
                  </pattern>
                </defs>
                <rect width="200" height="140" fill={pura.roles.primary} />
                <rect width="200" height="140" fill="url(#gt-pat)" />
              </svg>
            )}
            {d.asset === 'banner' && (
              <span
                class="bs-gt__banner"
                style={`background:${latte.roles.primary};color:${latte.roles.light}`}
              >
                <span set:html={logo('latte')} />
              </span>
            )}
            {photoFor[d.asset] && (
              <Image
                src={photoFor[d.asset][0]}
                alt=""
                widths={[300, 480]}
                sizes="(min-width: 64rem) 22vw, 46vw"
                format="webp"
                loading="lazy"
                style={`object-position:${photoFor[d.asset][1]}`}
              />
            )}
          </div>
          <p class="label">{String(i + 1).padStart(2, '0')}</p>
          <h3>{d.title}</h3>
          <p class="bs-gt__text">{d.text}</p>
        </li>
      ))}
    </ul>
    <p class="bs-get__note">Exact deliverables are agreed on your call.</p>
  </div>
</section>
