---
/**
 * Search and sharing tags for one page, all from src/data/pages.ts: canonical, robots, Open Graph,
 * Twitter card, the schema graph (src/data/schema.ts), and links to the sitemap, llms.txt and the
 * web manifest so crawlers and AI tools find them from any page.
 */
import { site } from '../config/site';
import { withBase } from '../config/paths';
import { pages, type PageKey } from '../data/pages';
import { buildSchema } from '../data/schema';

interface Props {
  page: PageKey;
}

const { page: key } = Astro.props;
const page = pages[key];

// Preview builds (e.g. GitHub Pages) set PUBLIC_NOINDEX so the unlaunched site isn't indexed under
// a temporary address. The 404 page is never indexed.
const index = key !== '404' && !import.meta.env.PUBLIC_NOINDEX;

const abs = (path: string) => new URL(withBase(path), site.url).toString();
const canonicalUrl = abs(page.path);
const ogImage = abs(`/og/${key === '404' ? 'index' : key}.png`);
const ogAlt = `${page.ogHeadline} ${site.fullName}, Leeds.`;
const schema = key === '404' ? undefined : buildSchema(key, abs);
---

{index && <link rel="canonical" href={canonicalUrl} />}
<meta
  name="robots"
  content={
    index
      ? 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'
      : 'noindex, follow'
  }
/>
<link rel="sitemap" type="application/xml" href={withBase('/sitemap-index.xml')} />
{key !== '404' && (
  <link
    rel="alternate"
    type="text/markdown"
    title="This page as Markdown"
    href={withBase(`${page.path}index.html.md`)}
  />
)}
<link rel="alternate" type="text/plain" title="llms.txt" href={withBase('/llms.txt')} />
<link rel="manifest" href={withBase('/site.webmanifest')} />
<link rel="icon" href={withBase('/favicon.ico')} sizes="48x48" />
<link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />

<!-- Open Graph -->
<meta property="og:type" content="website" />
<meta property="og:site_name" content={site.fullName} />
<meta property="og:locale" content="en_GB" />
<meta property="og:title" content={page.title} />
<meta property="og:description" content={page.description} />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:image" content={ogImage} />
<meta property="og:image:type" content="image/png" />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={ogAlt} />

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={page.title} />
<meta name="twitter:description" content={page.description} />
<meta name="twitter:image" content={ogImage} />
<meta name="twitter:image:alt" content={ogAlt} />

<!-- Business details, the same everywhere they appear -->
<meta name="geo.region" content="GB-LDS" />
<meta name="geo.placename" content={`${site.location.town}, ${site.location.region}`} />
<meta name="format-detection" content="telephone=no" />

{schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}
