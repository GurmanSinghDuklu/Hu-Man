---
/**
 * A strip of square modules from the brand's module kit (docs/brand/3-graphic-language.md), used as
 * a band between sections, like the brand's modular posters. Patterns only, never poster wording:
 * the posters' sample copy (offices, scores, offers) isn't true of the business.
 *
 * Cells cut on one after another when the band scrolls into view, then a few of them glitch now
 * and then: a flat block of another brand colour flashes over them in hard steps. Opacity only;
 * nothing moves under reduced motion. The Ridge cells use the real fingerprint scan.
 */
import Module, { type ModuleKind, type ModuleColour } from './Module.astro';

type Preset = 'kit' | 'poster' | 'signal';

interface Props {
  preset?: Preset;
  class?: string;
}

const { preset = 'kit', class: className } = Astro.props;

type Cell = [ModuleKind, ModuleColour, ModuleColour];

// Twelve cells per band; narrow screens show the first six (two rows of three).
const presets: Record<Preset, Cell[]> = {
  kit: [
    ['rings', 'signal', 'ink'],
    ['checker', 'ink', 'paper'],
    ['hex', 'pulse', 'ink'],
    ['ridge', 'ink', 'signal'],
    ['stripes', 'flare', 'ink'],
    ['half', 'paper', 'ink'],
    ['burst', 'volt', 'ink'],
    ['squares', 'ink', 'paper'],
    ['linearcs', 'scan', 'ink'],
    ['hourglass', 'paper', 'ink'],
    ['dots', 'signal', 'ink'],
    ['arc', 'pulse', 'ink'],
  ],
  poster: [
    ['slash', 'signal', 'ink'],
    ['ridge', 'paper', 'ink'],
    ['squares', 'flare', 'ink'],
    ['sparkle', 'ink', 'paper'],
    ['checker', 'signal', 'ink'],
    ['rings', 'ink', 'pulse'],
    ['arrow', 'paper', 'ink'],
    ['half', 'ink', 'signal'],
    ['stripes', 'pulse', 'ink'],
    ['hex', 'ink', 'paper'],
    ['burst', 'scan', 'ink'],
    ['field', 'signal', 'ink'],
  ],
  signal: [
    ['field', 'signal', 'ink'],
    ['hourglass', 'ink', 'signal'],
    ['rings', 'volt', 'ink'],
    ['dots', 'paper', 'ink'],
    ['arc', 'ink', 'flare'],
    ['squares', 'signal', 'ink'],
    ['linearcs', 'pulse', 'ink'],
    ['checker', 'ink', 'signal'],
    ['hex', 'scan', 'ink'],
    ['slash', 'paper', 'ink'],
    ['ridge', 'signal', 'ink'],
    ['sparkle', 'flare', 'ink'],
  ],
};

// Glitch colours cycle through the brand neons and Paper, so no band glitches in one colour.
const flashes = ['pulse', 'flare', 'volt', 'scan', 'paper', 'signal'];
const cells = presets[preset];
---

<div class:list={['mb', className]} aria-hidden="true" data-cells>
  {cells.map(([kind, fg, bg], i) => (
    <span
      class:list={['mb__cell', { 'is-glitch': i % 3 === 1 }]}
      style={`--flash:var(--${flashes[i % flashes.length]});--d:${((i * 1.7) % 6).toFixed(1)}s`}
    >
      <Module kind={kind} fg={fg} bg={bg} spin={kind === 'hex' || kind === 'rings'} />
    </span>
  ))}
</div>

<style>
  .mb {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    border-block: var(--border-hairline) solid var(--line);
    background: var(--brand-ink);
  }

  .mb__cell {
    position: relative;
    overflow: hidden;
  }

  .mb__cell:nth-child(n + 7) {
    display: none;
  }

  /* The glitch: a block of another colour flashes over the module, twice, then it's back. */
  .mb__cell.is-glitch::after {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--flash);
    opacity: 0;
    animation: mb-flash 7s steps(1, end) infinite var(--d);
  }

  @keyframes mb-flash {
    0%,
    100% {
      opacity: 0;
      transform: none;
    }
    86% {
      opacity: 1;
      transform: translateX(-6%);
    }
    88% {
      opacity: 0;
    }
    91% {
      opacity: 1;
      transform: translateX(4%) scaleY(0.5);
    }
    93% {
      opacity: 0;
      transform: none;
    }
  }

  @media (min-width: 40rem) {
    .mb {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .mb {
      grid-template-columns: repeat(12, 1fr);
    }

    .mb__cell:nth-child(n + 7) {
      display: block;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .mb__cell.is-glitch::after {
      animation: none;
    }
  }
</style>
