---
import { chatExchanges, chatGreeting } from '../data/chat-demo';
import Phone from './devices/Phone.astro';

// Pixel fragments around the phone (the "glitch between two hands" reference): Ink and Paper
// squares only, since Pulse on the Signal block would put two neons together. [x%, y%, size px]
const fragments: [number, number, number, boolean?][] = [
  [8, 12, 18],
  [14, 26, 10, true],
  [6, 58, 22],
  [17, 74, 12],
  [10, 88, 8, true],
  [86, 10, 12],
  [91, 30, 20, true],
  [82, 52, 10],
  [90, 70, 16],
  [84, 90, 22, true],
];
---

<section class="chat plum" aria-labelledby="chat-title" data-chat-demo>
  <div class="wrap chat__inner">
    <div class="chat__copy">
      <h2 id="chat-title" class="section-title" data-reveal>
        Try the enquiry assistant
      </h2>
      <p>
        This is a scripted demo for a fictional barbershop. A real assistant answers from your own
        information, hands over to a person when it isn't sure, and is tested before it goes live.
      </p>
      <div class="chat__chips" role="group" aria-label="Suggested questions">
        {chatExchanges.map((exchange) => (
          <button
            type="button"
            class="chat__chip"
            data-chat-chip={exchange.chip}
            data-chat-reply={exchange.reply}
          >
            {exchange.chip}
          </button>
        ))}
      </div>
    </div>

    <div class="chat__stage">
      {fragments.map(([x, y, size, blink], i) => (
        <i
          class:list={['chat__frag', { 'is-blink': blink, 'is-paper': i % 3 === 0 }]}
          style={`left:${x}%;top:${y}%;--s:${size}px;--d:${i * 0.9}s`}
          aria-hidden="true"
        />
      ))}
      <Phone class="chat__phone" bg="#f7f4ee" fg="#141414">
        <div class="chat__head">
          <span class="chat__avatar" aria-hidden="true">
            N
          </span>
          <span>
            <b>Northgate Barbers</b>
            <span>Demo assistant</span>
          </span>
        </div>
        <div class="chat__log" data-chat-log aria-live="polite" aria-label="Chat conversation">
          <p class="chat__msg chat__msg--assistant">{chatGreeting}</p>
        </div>
        <p class="chat__typing" data-chat-typing hidden aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </p>
        <div class="chat__input" aria-hidden="true">
          <span>Message</span>
          <i>↑</i>
        </div>
      </Phone>
    </div>
  </div>
</section>

<script>
  import '../scripts/chat-demo.ts';
</script>

<style is:global>
  /* The phone is the fictional barbershop's own UI; only the section around it is Hu/man. */
  .chat {
    position: relative;
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .chat__inner {
    position: relative;
    display: grid;
    gap: var(--space-5);
    align-items: center;
  }

  .chat__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 34rem;
  }

  .chat__copy > p {
    color: var(--ink-text);
    font-size: 1.0625rem;
  }

  .chat__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .chat__chip {
    min-height: 44px;
    padding: 0.6em 1.1em;
    border: var(--border-hairline) solid var(--line-strong);
    border-radius: 0;
    background: none;
    color: var(--ink-text);
    font: 400 0.9375rem var(--font-text);
    cursor: pointer;
    transition:
      background-color 0.15s linear,
      color 0.15s linear,
      border-color 0.15s linear;
  }

  .chat__chip:hover {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
  }

  /* The phone stands in a Signal block, poster style. */
  .chat__stage {
    position: relative;
    overflow: hidden;
    display: grid;
    place-items: center;
    padding: clamp(2rem, 5vw, 3.5rem) 1rem;
    background: var(--signal);
  }

  .chat__frag {
    position: absolute;
    width: var(--s);
    height: var(--s);
    background: var(--brand-ink);
  }

  .chat__frag.is-paper {
    background: var(--brand-paper);
  }

  .chat__frag.is-blink {
    animation: chat-frag 6s steps(1, end) infinite var(--d);
  }

  @keyframes chat-frag {
    0%,
    100% {
      opacity: 1;
      transform: none;
    }
    80% {
      opacity: 0;
    }
    86% {
      opacity: 1;
      transform: translate(calc(var(--s) * -1), var(--s));
    }
  }

  .chat__phone {
    width: min(320px, 78vw);
    position: relative;
    font-family: var(--font-render);
  }

  .chat__head {
    display: flex;
    gap: 0.9em;
    align-items: center;
    padding: 0.4em 1.6em 1em;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    font-size: 1.15em;
  }

  .chat__head > span:last-child {
    display: grid;
    line-height: 1.25;
  }

  .chat__head > span:last-child span {
    font-size: 0.85em;
    color: #5a5a5a;
  }

  .chat__avatar {
    width: 2.8em;
    height: 2.8em;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #f26b3a;
    color: #fff;
    font-weight: 700;
  }

  .chat__log {
    flex: 1;
    min-height: 0;
    overflow-y: auto;
    padding: 1.2em 1.4em 1em;
    display: flex;
    flex-direction: column;
    gap: 0.8em;
  }

  .chat__msg {
    margin: 0;
    max-width: 85%;
    padding: 0.9em 1.2em;
    border-radius: 1.4em;
    font-size: 1.3em;
    line-height: 1.4;
  }

  .chat__msg--assistant {
    background: #fff;
    align-self: flex-start;
    border-bottom-left-radius: 0.4em;
    box-shadow: 0 0.2em 0.6em rgba(0, 0, 0, 0.05);
  }

  .chat__msg--user {
    background: #141414;
    color: #fff;
    align-self: flex-end;
    border-bottom-right-radius: 0.4em;
  }

  .chat__typing {
    position: absolute;
    left: 1.4em;
    bottom: 8.4em;
    display: flex;
    gap: 0.4em;
    margin: 0;
    padding: 1em 1.2em;
    border-radius: 1.4em;
    background: #fff;
  }

  .chat__input {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin: 0 1.2em 2.6em;
    padding: 0.6em 0.6em 0.6em 1.4em;
    border-radius: 2em;
    background: #fff;
    color: #6b6b6b;
    font-size: 1.2em;
    box-shadow: 0 0.2em 0.6em rgba(0, 0, 0, 0.05);
  }

  .chat__input i {
    width: 2.2em;
    height: 2.2em;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #141414;
    color: #fff;
    font-style: normal;
  }

  .chat__typing[hidden] {
    display: none;
  }

  .chat__typing span {
    width: 0.7em;
    height: 0.7em;
    border-radius: 50%;
    background: #777;
    animation: chat-typing 1s infinite ease-in-out;
  }

  .chat__typing span:nth-child(2) {
    animation-delay: 0.15s;
  }

  .chat__typing span:nth-child(3) {
    animation-delay: 0.3s;
  }

  @keyframes chat-typing {
    0%,
    60%,
    100% {
      transform: translateY(0);
      opacity: 0.5;
    }
    30% {
      transform: translateY(-0.3em);
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .chat__typing span {
      animation: none;
      opacity: 0.7;
    }
  }

  @media (min-width: 60rem) {
    .chat__inner {
      grid-template-columns: 1.1fr 1fr;
    }
  }
</style>
