---
/**
 * One of our four videos (public/landing/, the same ones the contact and /start/ landing plays)
 * behind a page's hero, like the contact page (Gurman, 2026-11-13): Home, About, Work and Pricing
 * get one each, with the hero's text in white over it and no frame around the video.
 *
 * Desktop: the hero is Ink and the video sits on its right, shown whole, with no frame: a wide
 * video's edges fade into the Ink, a tall one runs the hero's full height (the hero gives this
 * component's wrapper `position: absolute; inset: 0` behind the text). Phones and tablets: a block
 * in the hero's stack, edge to edge.
 *
 * Plays muted and on a loop once the page has loaded, and pauses while it is off screen
 * (scripts/hero-video.ts). Pause and Sound buttons sit on the frame. Under reduced motion or Data
 * Saver nothing loads until Play is pressed. The poster is a strong frame from the video, and
 * playback starts from that moment (`start`), so the swap from poster to video doesn't jump.
 * The frame takes the video's own shape: wide or tall, never cropped.
 */
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { withBase } from '../config/paths';
import reelPoster from '../assets/hero-video/reel.jpg';
import foundPoster from '../assets/hero-video/found.jpg';
import seenPoster from '../assets/hero-video/portfolio-seen.jpg';
import adPoster from '../assets/hero-video/portfolio-ad.jpg';

interface Video {
  src: string;
  w: number;
  h: number;
  poster: ImageMetadata;
  /** Seconds: where playback starts (the poster's moment). Loops go back to 0. */
  start: number;
  label: string;
}

const videos = {
  reel: {
    src: '/landing/reel.mp4',
    w: 1920,
    h: 1080,
    poster: reelPoster,
    start: 9.3,
    label: 'The Hu/man showreel',
  },
  found: {
    src: '/landing/found.mp4',
    w: 1920,
    h: 1080,
    poster: foundPoster,
    start: 0,
    label: 'Built to be found, by Hu/man',
  },
  'portfolio-seen': {
    src: '/landing/portfolio-seen.mp4',
    w: 1080,
    h: 1920,
    poster: seenPoster,
    start: 0,
    label: 'Be seen: portfolio sites by Hu/man, from £156',
  },
  'portfolio-ad': {
    src: '/landing/portfolio-ad.mp4',
    w: 1080,
    h: 1920,
    poster: adPoster,
    start: 2.3,
    label: 'Portfolio pages by Hu/man, from £156',
  },
} satisfies Record<string, Video>;

interface Props {
  video: keyof typeof videos;
  class?: string;
  /** Opens with an intro over the frame: true or 'tiles' (About, scripts/hero-intro.ts) or 'cv' (Portfolio, scripts/hero-intro-cv.ts). */
  intro?: boolean | 'tiles' | 'cv';
}

const { video, class: className, intro = false } = Astro.props;
const introVariant = intro === 'cv' ? 'cv' : intro ? 'tiles' : undefined;
const v: Video = videos[video];
const poster = await getImage({
  src: v.poster,
  width: v.w > v.h ? 1280 : 720,
  format: 'webp',
  quality: 72,
});
---

<figure
  class:list={['hv', v.w > v.h ? 'hv--wide' : 'hv--tall', className]}
  style={`--ar:${(v.w / v.h).toFixed(4)}`}
  data-hv
  data-hv-intro={introVariant}
>
  <div class="hv__frame">
    <video
      class="hv__video"
      muted
      loop
      playsinline
      preload="none"
      disablepictureinpicture
      poster={poster.src}
      width={v.w}
      height={v.h}
      aria-label={v.label}
      data-hv-src={withBase(v.src)}
      data-hv-start={v.start}
    ></video>
    <div class="hv__controls">
      <button type="button" class="hv__btn" data-hv-play aria-label="Pause video">
        <svg
          class="hv__icon hv__icon--pause"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M8 5h3v14H8zM13 5h3v14h-3z"></path>
        </svg>
        <svg
          class="hv__icon hv__icon--play"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M8 5l11 7-11 7z"></path>
        </svg>
      </button>
      <button type="button" class="hv__btn" data-hv-sound aria-label="Turn sound on">
        <svg
          class="hv__icon hv__icon--muted"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M4 9h4l5-4v14l-5-4H4z"></path>
          <path d="M16 9l5 6M21 9l-5 6" fill="none" stroke="currentColor" stroke-width="2"></path>
        </svg>
        <svg
          class="hv__icon hv__icon--sound"
          viewBox="0 0 24 24"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M4 9h4l5-4v14l-5-4H4z"></path>
          <path
            d="M16 8.5a5 5 0 0 1 0 7M18.5 6a8.5 8.5 0 0 1 0 12"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
          ></path>
        </svg>
      </button>
    </div>
  </div>
</figure>

<script>
  import '../scripts/hero-video.ts';
</script>

<style>
  .hv {
    position: relative;
    margin: 0;
    background: var(--ink);
  }

  /* The video's own shape: wide ones full width, tall ones at --hv-h high (phones, tablets). */
  .hv__frame {
    position: relative;
    aspect-ratio: var(--ar);
  }

  .hv--wide .hv__frame {
    width: 100%;
  }

  .hv--tall .hv__frame {
    height: var(--hv-h, 56svh);
    margin-inline: auto;
  }

  .hv__video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hv__controls {
    position: absolute;
    right: 12px;
    bottom: 12px;
    display: flex;
    gap: 8px;
  }

  @media (min-width: 64rem) {
    /* Behind the whole hero; the video sits at the right, level with the page's right edge. */
    .hv {
      position: absolute;
      inset: 0;
    }

    .hv__frame {
      position: absolute;
      right: var(--pad);
    }

    .hv--wide .hv__frame {
      top: 50%;
      width: var(--hv-dw, 52vw);
      translate: 0 -50%;
    }

    /* No box: the picture fades into the Ink on every side, most on the left (towards the text). */
    .hv--wide .hv__video,
    .hv--wide :global(.hv-intro) {
      mask-image:
        linear-gradient(90deg, transparent 0%, #000 28%, #000 94%, transparent 100%),
        linear-gradient(transparent 0%, #000 12%, #000 88%, transparent 100%);
      mask-composite: intersect;
    }

    .hv--tall .hv__frame {
      top: 0;
      height: 100%;
    }

    .hv__controls {
      bottom: 16px;
    }

    /* Just under the picture, so they never cover the video's own words. */
    .hv--wide .hv__controls {
      top: calc(100% + 8px);
      right: 6%;
      bottom: auto;
    }
  }

  /* The opening tiles (scripts/hero-intro.ts) sit over the video, under the buttons: Ink with a
     grid of square tiles; no shadows, glows or gradients. */
  :global(.hv-intro) {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(var(--cols), 1fr);
    grid-template-rows: repeat(var(--rows), 1fr);
    overflow: clip;
    background: var(--ink);
    pointer-events: none;
  }

  /* The CV opening (scripts/hero-intro-cv.ts): a plain Paper sheet over the frame, then cut into
     strips that fall. Sized in container units so each strip's copy lines up; square, flat, no
     shadows, glows or gradients. The poster shows through behind it. */
  :global(.hv-cv) {
    position: absolute;
    inset: 0;
    overflow: clip;
    container-type: size;
    pointer-events: none;
  }

  :global(.hv-cv__strip) {
    position: absolute;
    top: 0;
    bottom: 0;
    overflow: clip;
  }

  :global(.cv-sheet) {
    position: absolute;
    top: 0;
    width: 100cqw;
    height: 100cqh;
    box-sizing: border-box;
    border: 2px solid var(--ink);
    background: var(--paper);
  }

  :global(.cv-sheet > .cv-bar) {
    position: absolute;
    left: 10cqw;
    display: block;
    height: 1.3cqh;
    background: #bdbfb5;
    transform-origin: left;
  }

  :global(.cv-sheet > .cv-bar--name) {
    height: 3.4cqh;
    background: var(--ink);
  }

  :global(.cv-sheet > .cv-bar--head) {
    height: 1.6cqh;
    background: #6b6e66;
  }

  :global(.hv-cv__scan) {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 3px;
    background: #39ff14;
    opacity: 0;
  }

  :global(.hv-cell) {
    scale: 0.93;
  }

  :global(.hv-tile) {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  :global(.hv-tile__face) {
    position: absolute;
    inset: 0;
    backface-visibility: hidden;
    background-repeat: no-repeat;
  }

  :global(.hv-tile__back) {
    /* A half pixel over, so no hairline shows between slices once the seams close. */
    inset: -0.5px;
    transform: rotateY(180deg);
  }

  :global(.hv-scan) {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    width: 3px;
    background: #39ff14;
    opacity: 0;
  }

  .hv__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: rgb(241 242 236 / 0.92);
    color: var(--ink);
    cursor: pointer;
  }

  .hv__btn:hover {
    background: var(--paper);
  }

  .hv__btn:focus-visible {
    outline: 2px solid var(--paper);
    outline-offset: 3px;
  }

  .hv__icon {
    width: 20px;
    height: 20px;
    fill: currentColor;
  }

  /* Which icon shows follows the state the script sets on the figure. */
  .hv__icon--play,
  .hv__icon--sound,
  .hv.is-paused .hv__icon--pause,
  .hv.has-sound .hv__icon--muted {
    display: none;
  }

  .hv.is-paused .hv__icon--play,
  .hv.has-sound .hv__icon--sound {
    display: block;
  }
</style>
