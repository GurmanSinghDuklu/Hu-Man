---
import { site } from '../config/site';

// Section anchors only exist on the homepage. From any other page (privacy,
// 404), link back to "/" plus the anchor so the link actually goes
// somewhere, instead of a dead "#services" with no matching element.
const isHome = Astro.url.pathname === '/';
const prefix = isHome ? '' : '/';

const navLinks = [
  { href: `${prefix}#work`, label: 'Work' },
  { href: `${prefix}#services`, label: 'Services' },
  { href: `${prefix}#pricing`, label: 'Pricing' },
  { href: `${prefix}#about`, label: 'About' },
  { href: `${prefix}#faq`, label: 'FAQ' },
];
const auditHref = `${prefix}#audit`;
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__name" aria-label={`${site.name} home`}>
      {site.wordmark}
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={auditHref} class="pill-btn site-header__cta">
        Get your free presence audit
      </a>
      <details class="site-header__menu">
        <summary aria-label="Menu">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <circle cx="8" cy="8" r="2.4"></circle>
            <circle cx="16" cy="8" r="2.4"></circle>
            <circle cx="8" cy="16" r="2.4"></circle>
            <circle cx="16" cy="16" r="2.4"></circle>
          </svg>
        </summary>
        <div class="site-header__panel">
          <ul>
            {navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
          <a href={auditHref} class="pill-btn pill-btn--solid">
            Get your free presence audit
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the menu after following one of its links (same-page anchors
  // would otherwise leave the panel open over the section).
  document.querySelectorAll<HTMLDetailsElement>('.site-header__menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: relative;
    z-index: 20;
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 88px;
  }

  .site-header__name {
    font-weight: 800;
    font-size: 1.05rem;
    letter-spacing: -0.02em;
    text-decoration: none;
    color: var(--color-text);
    justify-self: start;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav ul {
    list-style: none;
    display: flex;
    gap: 2.4rem;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
    padding-block: 0.6rem;
    opacity: 0.85;
    transition: opacity 0.2s;
  }

  .site-header__nav a:hover {
    opacity: 1;
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: end;
  }

  .site-header__cta {
    display: none;
    min-height: 44px;
    padding-block: 0.5em;
    font-size: 0.875rem;
  }

  .site-header__menu {
    position: relative;
  }

  .site-header__menu summary {
    list-style: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--color-line-strong);
    display: grid;
    place-items: center;
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__menu summary svg {
    width: 22px;
    height: 22px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.4;
  }

  .site-header__menu[open] summary,
  .site-header__menu summary:hover {
    background: rgba(255, 255, 255, 0.1);
  }

  .site-header__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    width: min(20rem, calc(100vw - 2rem));
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: rgba(18, 23, 38, 0.92);
    backdrop-filter: blur(18px);
    -webkit-backdrop-filter: blur(18px);
    border: 1px solid var(--color-line);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  }

  .site-header__panel ul {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .site-header__panel li a {
    display: block;
    padding: 0.65rem 0;
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: -0.03em;
    text-decoration: none;
    border-bottom: 1px solid var(--color-line);
  }

  .site-header__panel .pill-btn {
    width: 100%;
    justify-content: center;
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }
  }
</style>
