---
import { site } from '../config/site';
import { withBase } from '../config/paths';
import Logo from './Logo.astro';

// The FAQ lives on the pricing page, so that link carries the page path and works from anywhere.
const navLinks = [
  { href: withBase('/services/'), label: 'Services' },
  { href: withBase('/work/'), label: 'Work' },
  { href: withBase('/pricing/'), label: 'Pricing' },
  { href: withBase('/about/'), label: 'About' },
  { href: withBase('/how-we-build/'), label: 'How we build' },
  { href: `${withBase('/pricing/')}#faq`, label: 'FAQ' },
];
---

<header class="site-header">
  <div class="sheet site-header__inner">
    <a href={withBase('/')} class="site-header__home" aria-label={`${site.name} home`}>
      <!-- Two extra copies of the real artwork are the hover glitch bands (never retyped). -->
      <span class="site-header__logo">
        <Logo variant="ink" label="" />
        <Logo variant="ink" label="" class="site-header__band site-header__band--a" />
        <Logo variant="ink" label="" class="site-header__band site-header__band--b" />
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <a href={withBase('/free-ai-check/')} class="btn site-header__cta">
      Free audit
    </a>

    <details class="site-header__menu">
      <summary aria-label="Menu">
        <span class="site-header__burger" aria-hidden="true">
          <i></i>
          <i></i>
        </span>
      </summary>
      <div class="site-header__panel">
        <ul>
          {navLinks.map((link) => (
            <li>
              <a href={link.href}>{link.label}</a>
            </li>
          ))}
        </ul>
        <a href={withBase('/free-ai-check/')} class="btn">
          Free audit
        </a>
      </div>
    </details>
  </div>
</header>

<script>
  // Close the menu after following one of its links (same-page anchors would otherwise leave
  // the panel open over the section).
  document.querySelectorAll<HTMLDetailsElement>('.site-header__menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--paper);
    border-bottom: 1px solid var(--grid-line);
  }

  .site-header__inner {
    display: flex;
    align-items: center;
    gap: var(--space-4);
    min-height: 72px;
  }

  .site-header__home {
    display: flex;
    margin-right: auto;
    padding-block: 0.75rem;
  }

  .site-header__logo {
    position: relative;
    display: block;
    line-height: 0;
  }

  .site-header__logo :global(.logo) {
    width: clamp(96px, calc(var(--u) * 1.25), 120px);
    min-width: 0;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav ul {
    display: flex;
    gap: clamp(1.25rem, calc(var(--u) * 0.3), 1.75rem);
  }

  .site-header__nav a {
    display: inline-block;
    padding-block: 0.75rem;
    font: 400 0.8125rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-header__nav a:hover {
    text-decoration: underline;
    text-underline-offset: 0.4em;
  }

  .site-header__cta {
    display: none;
  }

  /* Hover glitch: Pink and Indigo bands of the artwork jump sideways for a beat, every 2 s. */
  .site-header__logo :global(.site-header__band) {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .site-header__logo :global(.site-header__band--a) {
    clip-path: inset(12% 0 55% 0);
  }

  .site-header__logo :global(.site-header__band--a path) {
    fill: var(--pink);
  }

  .site-header__logo :global(.site-header__band--b) {
    clip-path: inset(58% 0 14% 0);
  }

  .site-header__logo :global(.site-header__band--b path) {
    fill: var(--indigo);
  }

  .site-header__home:hover :global(.site-header__band--a),
  .site-header__home:focus-visible :global(.site-header__band--a) {
    animation: logo-band-a 2s steps(1, end) infinite;
  }

  .site-header__home:hover :global(.site-header__band--b),
  .site-header__home:focus-visible :global(.site-header__band--b) {
    animation: logo-band-b 2s steps(1, end) infinite;
  }

  @keyframes logo-band-a {
    0% {
      opacity: 1;
      transform: translateX(-5px);
    }
    5% {
      transform: translateX(4px);
    }
    15%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes logo-band-b {
    0% {
      opacity: 1;
      transform: translateX(4px);
    }
    6% {
      transform: translateX(-6px);
    }
    15%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  /* ---------- mobile menu ---------- */
  .site-header__menu {
    position: relative;
  }

  .site-header__menu summary {
    list-style: none;
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border: 1px solid var(--ink);
    cursor: pointer;
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__menu[open] summary {
    background: var(--ink);
    color: var(--paper);
  }

  .site-header__burger {
    display: grid;
    gap: 6px;
  }

  .site-header__burger i {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
  }

  .site-header__menu[open] .site-header__burger i:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .site-header__menu[open] .site-header__burger i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .site-header__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    width: min(20rem, calc(100vw - 2.5rem));
    padding: var(--space-4);
    background: var(--paper);
    border: 1px solid var(--ink);
  }

  .site-header__panel li a {
    display: block;
    padding: 0.7rem 0;
    border-bottom: 1px solid var(--line-soft);
    font: 800 1.5rem/1.1 var(--font-display);
    text-transform: uppercase;
    text-decoration: none;
  }

  .site-header__panel .btn {
    width: 100%;
    margin-top: var(--space-4);
  }

  @media (min-width: 64rem) {
    .site-header__inner {
      min-height: var(--u);
      gap: calc(var(--u) * 0.3);
    }

    .site-header__nav,
    .site-header__cta {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
      min-height: max(36px, calc(var(--u) * 0.48));
      padding: 0 calc(var(--u) * 0.2);
      font-size: calc(var(--u) * 0.135);
    }

    .site-header__nav a {
      font-size: calc(var(--u) * 0.133);
    }

    .site-header__menu {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__logo :global(.site-header__band) {
      animation: none !important;
    }
  }
</style>
