---
import { site } from '../config/site';
import { isHomePath, withBase } from '../config/paths';
import Logo from './Logo.astro';

// Section anchors only exist on the homepage. From any other page (privacy,
// 404), link back to "/" plus the anchor so the link actually goes
// somewhere, instead of a dead "#services" with no matching element.
const isHome = isHomePath(Astro.url.pathname);
const prefix = isHome ? '' : withBase('/');

const navLinks = [
  { href: `${prefix}#services`, label: 'Services' },
  { href: withBase('/work/'), label: 'Work' },
  { href: `${prefix}#process`, label: 'Process' },
  { href: `${prefix}#pricing`, label: 'Pricing' },
  { href: `${prefix}#faq`, label: 'FAQ' },
];
const auditHref = `${prefix}#audit`;
---

<header class:list={['site-header on-dark', { 'site-header--solid': !isHome }]}>
  <div class="wrap site-header__inner">
    <a href={withBase('/')} class="site-header__home" aria-label={`${site.name} home`}>
      <!-- Two extra copies of the real artwork are the glitch bands (the logo is never retyped). -->
      <span class="site-header__logo">
        <Logo label="" />
        <Logo variant="paper" label="" class="site-header__band site-header__band--a" />
        <Logo variant="paper" label="" class="site-header__band site-header__band--b" />
      </span>
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={auditHref} class="btn btn--primary site-header__cta">
        Free audit
      </a>
      <details class="site-header__menu">
        <summary aria-label="Menu">
          <span class="site-header__burger" aria-hidden="true">
            <i></i>
            <i></i>
          </span>
        </summary>
        <div class="site-header__panel">
          <ul>
            {navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
          <a href={auditHref} class="btn btn--primary">
            Get your free presence audit
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the menu after following one of its links (same-page anchors
  // would otherwise leave the panel open over the section).
  document.querySelectorAll<HTMLDetailsElement>('.site-header__menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--on-dark);
    border-bottom: var(--border-hairline) solid transparent;
    transition:
      background-color 0.15s linear,
      border-color 0.15s linear;
  }

  /* Solid Ink with a hairline once the page scrolls: no blur, no shadow. */
  .site-header:global(.is-scrolled),
  .site-header--solid {
    background: var(--brand-ink);
    border-bottom-color: var(--line);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 72px;
  }

  .site-header__home {
    display: flex;
    align-items: center;
    justify-self: start;
    padding-block: 0.75rem;
  }

  .site-header__home :global(.logo) {
    width: 7rem;
  }

  /* Hover or focus glitches the logo: a Pulse band and a Paper band of the same artwork jump
     sideways while the logo itself shakes, in hard steps. Clips are fixed; only transform and
     opacity animate. It repeats every 2 s while the pointer stays on it. */
  .site-header__logo {
    position: relative;
    display: block;
    line-height: 0;
  }

  .site-header__logo :global(.site-header__band) {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
  }

  .site-header__logo :global(.site-header__band--a) {
    clip-path: inset(12% 0 55% 0);
  }

  .site-header__logo :global(.site-header__band--a path) {
    fill: var(--pulse);
  }

  .site-header__logo :global(.site-header__band--b) {
    clip-path: inset(58% 0 14% 0);
  }

  .site-header__logo :global(.site-header__band--b path) {
    fill: var(--brand-paper);
  }

  .site-header__home:hover .site-header__logo > :global(.logo:first-child),
  .site-header__home:focus-visible .site-header__logo > :global(.logo:first-child) {
    animation: logo-shake 2s steps(1, end) infinite;
  }

  .site-header__home:hover :global(.site-header__band--a),
  .site-header__home:focus-visible :global(.site-header__band--a) {
    animation: logo-band-a 2s steps(1, end) infinite;
  }

  .site-header__home:hover :global(.site-header__band--b),
  .site-header__home:focus-visible :global(.site-header__band--b) {
    animation: logo-band-b 2s steps(1, end) infinite;
  }

  @keyframes logo-shake {
    0% {
      transform: translateX(2px);
    }
    5% {
      transform: translateX(-2px);
    }
    10% {
      transform: translateX(1px);
    }
    15%,
    100% {
      transform: none;
    }
  }

  @keyframes logo-band-a {
    0% {
      opacity: 1;
      transform: translateX(-6px);
    }
    5% {
      transform: translateX(5px);
    }
    10% {
      transform: translateX(-3px);
    }
    15%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes logo-band-b {
    0% {
      opacity: 1;
      transform: translateX(5px);
    }
    6% {
      transform: translateX(-7px);
    }
    11% {
      transform: translateX(3px);
    }
    15%,
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header__home :global(.logo) {
      animation: none !important;
    }
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    gap: 2rem;
    margin: 0;
    padding: 0;
  }

  .site-header__nav a {
    display: inline-block;
    color: var(--on-dark);
    text-decoration: none;
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    padding-block: 0.9rem;
    transition: color 0.15s linear;
  }

  .site-header__nav a:hover {
    color: var(--signal);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: end;
  }

  .site-header__cta {
    display: none;
  }

  .site-header__menu {
    position: relative;
  }

  .site-header__menu summary {
    list-style: none;
    width: 48px;
    height: 48px;
    border: var(--border-hairline) solid var(--line-strong);
    display: grid;
    place-items: center;
    cursor: pointer;
  }

  .site-header__menu[open] summary {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__burger {
    display: grid;
    gap: 6px;
  }

  .site-header__burger i {
    display: block;
    width: 18px;
    height: 2px;
    background: currentColor;
  }

  .site-header__menu[open] .site-header__burger i:first-child {
    transform: translateY(4px) rotate(45deg);
  }

  .site-header__menu[open] .site-header__burger i:last-child {
    transform: translateY(-4px) rotate(-45deg);
  }

  .site-header__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    width: min(21rem, calc(100vw - 2rem));
    padding: var(--space-4);
    background: var(--brand-ink);
    border: var(--border-hairline) solid var(--line-strong);
  }

  .site-header__panel ul {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .site-header__panel li a {
    display: block;
    padding: 0.7rem 0;
    font: 800 1.5rem/1.1 var(--font-display);
    letter-spacing: -0.01em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: var(--border-hairline) solid var(--line);
  }

  .site-header__panel li a:hover {
    color: var(--signal);
  }

  .site-header__panel .btn {
    width: 100%;
  }

  @media (min-width: 68rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }

    .site-header__menu {
      display: none;
    }
  }
</style>
