---
import { site } from '../config/site';
import Logo from './Logo.astro';
import Arrow from './Arrow.astro';

// Section anchors only exist on the homepage. From any other page (privacy,
// 404), link back to "/" plus the anchor so the link actually goes
// somewhere, instead of a dead "#services" with no matching element.
const isHome = Astro.url.pathname === '/';
const prefix = isHome ? '' : '/';

const navLinks = [
  { href: `${prefix}#services`, label: 'Services' },
  { href: `${prefix}#real-work`, label: 'Work' },
  { href: `${prefix}#work`, label: 'Concepts' },
  { href: `${prefix}#pricing`, label: 'Pricing' },
  { href: `${prefix}#about`, label: 'About' },
  { href: `${prefix}#faq`, label: 'FAQ' },
];
const auditHref = `${prefix}#audit`;
---

<header class:list={['site-header on-dark', { 'site-header--solid': !isHome }]}>
  <div class="wrap site-header__inner">
    <a href="/" class="site-header__home" aria-label={`${site.name} home`}>
      <Logo />
    </a>

    <nav class="site-header__nav" aria-label="Primary">
      <ul>
        {navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="site-header__actions">
      <a href={auditHref} class="btn btn--lime site-header__cta">
        Free audit
        <span class="btn__icon">
          <Arrow />
        </span>
      </a>
      <details class="site-header__menu">
        <summary aria-label="Menu">
          <span class="site-header__burger" aria-hidden="true">
            <i></i>
            <i></i>
          </span>
        </summary>
        <div class="site-header__panel">
          <ul>
            {navLinks.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
          <a href={auditHref} class="btn btn--lime">
            Get your free presence audit
            <span class="btn__icon">
              <Arrow />
            </span>
          </a>
        </div>
      </details>
    </div>
  </div>
</header>

<script>
  // Close the menu after following one of its links (same-page anchors
  // would otherwise leave the panel open over the section).
  document.querySelectorAll<HTMLDetailsElement>('.site-header__menu').forEach((menu) => {
    menu.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).closest('a')) menu.open = false;
    });
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    color: var(--on-dark);
    transition:
      background-color 0.35s var(--ease-out),
      box-shadow 0.35s var(--ease-out);
  }

  .site-header:global(.is-scrolled) {
    background: rgba(7, 8, 10, 0.72);
    backdrop-filter: blur(16px) saturate(1.3);
    -webkit-backdrop-filter: blur(16px) saturate(1.3);
    box-shadow: 0 1px 0 var(--on-dark-line);
  }

  .site-header--solid {
    background: var(--black);
    box-shadow: 0 1px 0 var(--on-dark-line);
  }

  .site-header__inner {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    min-height: 76px;
  }

  .site-header__home {
    display: flex;
    align-items: center;
    text-decoration: none;
    font-size: 1.05rem;
    justify-self: start;
  }

  .site-header__nav {
    display: none;
  }

  .site-header__nav ul {
    list-style: none;
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
  }

  .site-header__nav li + li::before {
    content: '';
    display: inline-block;
    width: 4px;
    height: 4px;
    margin-inline: 0.9rem;
    border-radius: 50%;
    background: var(--on-dark-muted);
    vertical-align: middle;
  }

  .site-header__nav a {
    color: var(--on-dark);
    text-decoration: none;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding-block: 0.8rem;
    opacity: 0.85;
    transition:
      opacity 0.2s,
      color 0.2s;
  }

  .site-header__nav a:hover {
    opacity: 1;
    color: var(--neon);
  }

  .site-header__actions {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    justify-self: end;
  }

  .site-header__cta {
    display: none;
  }

  .site-header__menu {
    position: relative;
  }

  .site-header__menu summary {
    list-style: none;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    border: 1px solid var(--on-dark-line);
    display: grid;
    place-items: center;
    cursor: pointer;
    background: rgba(255, 255, 255, 0.06);
  }

  .site-header__menu summary::-webkit-details-marker {
    display: none;
  }

  .site-header__burger {
    display: grid;
    gap: 6px;
  }

  .site-header__burger i {
    display: block;
    width: 18px;
    height: 1.6px;
    background: currentColor;
    transition: transform 0.3s var(--ease-out);
  }

  .site-header__menu[open] .site-header__burger i:first-child {
    transform: translateY(3.8px) rotate(45deg);
  }

  .site-header__menu[open] .site-header__burger i:last-child {
    transform: translateY(-3.8px) rotate(-45deg);
  }

  .site-header__panel {
    position: absolute;
    right: 0;
    top: calc(100% + 0.75rem);
    width: min(21rem, calc(100vw - 2rem));
    padding: var(--space-4);
    border-radius: var(--radius-md);
    background: var(--forest-900);
    border: 1px solid var(--on-dark-line);
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.6);
  }

  .site-header__panel ul {
    list-style: none;
    margin: 0 0 var(--space-4);
    padding: 0;
  }

  .site-header__panel li a {
    display: block;
    padding: 0.7rem 0;
    font-size: 1.4rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    text-decoration: none;
    border-bottom: 1px solid var(--on-dark-line);
  }

  .site-header__panel .btn {
    width: 100%;
    justify-content: space-between;
  }

  @media (min-width: 68rem) {
    .site-header__inner {
      grid-template-columns: 1fr auto 1fr;
    }

    .site-header__nav {
      display: block;
    }

    .site-header__cta {
      display: inline-flex;
    }

    .site-header__menu {
      display: none;
    }
  }
</style>
