---
import { credentials } from '../data/content';
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="wrap about__inner">
    <div class="about__photo" data-reveal role="img" aria-label="Photo of Gurman not yet added">
      <div class="about__photo-glow" aria-hidden="true"></div>
      <span class="about__photo-label">Photo to follow</span>
    </div>

    <div class="about__copy">
      <p class="eyebrow" data-reveal>
        About
      </p>
      <h2 id="about-title" class="section-title" data-reveal>
        Hi, I'm <span class="hl">Gurman</span>
      </h2>
      <p class="about__intro">
        I'm Gurman, a developer based in Bradford. I've shipped live customer pages inside a major
        bank's Agile team, written open-source documentation for Arm, and built and launched a live
        website for a family business. I started this studio because local businesses deserve
        websites as good as national brands', and I'd rather be judged on your bookings than my
        hours.
      </p>

      <h3 class="about__sub">Credentials</h3>
      <ul class="about__creds">
        {credentials.map((credential) => (
          <li>
            <span>{credential.text}</span>
            {credential.inProgress && <span class="about__badge">In progress</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .about__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .about__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 30rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--forest-900);
    border: 1.5px dashed rgba(0, 255, 48, 0.55);
  }

  .about__photo-glow {
    position: absolute;
    inset: 18%;
    border-radius: 50%;
    background: radial-gradient(circle, var(--acid), var(--neon) 50%, transparent 72%);
    filter: blur(40px);
    opacity: 0.35;
    animation: breathe 8s ease-in-out infinite alternate;
  }

  @keyframes breathe {
    to {
      transform: scale(1.15) translate(4%, -3%);
    }
  }

  .about__photo-label {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.4em 1em;
    border-radius: var(--radius-pill);
    background: var(--paper);
    color: var(--ink);
    font-size: 0.8rem;
    font-weight: 600;
  }

  .about__copy {
    display: grid;
    gap: var(--space-4);
  }

  .about__intro {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.65;
    max-width: 40rem;
  }

  .about__sub {
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    margin-top: var(--space-3);
  }

  .about__creds {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.5);
  }

  .about__creds li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.925rem;
  }

  .about__badge {
    flex: none;
    padding: 0.2em 0.8em;
    border-radius: var(--radius-pill);
    background: var(--lime);
    color: var(--ink);
    font-size: 0.72rem;
    font-weight: 700;
  }

  @media (min-width: 60rem) {
    .about__inner {
      grid-template-columns: 0.8fr 1.2fr;
    }

    .about__photo {
      position: sticky;
      top: 100px;
    }
  }
</style>
