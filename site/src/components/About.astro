---
import { credentials } from '../data/content';
---

<section class="about" id="about" aria-labelledby="about-title">
  <div class="wrap about__inner">
    <div class="about__photo" role="img" aria-label="Photo of Gurman not yet added">
      <div class="about__photo-glow" aria-hidden="true"></div>
      <span class="about__photo-label">Photo to follow</span>
    </div>

    <div class="about__copy">
      <h2 id="about-title" class="section-title">
        <span class="t-bold t-silver">About</span>
      </h2>
      <p class="about__intro">
        I'm Gurman, a developer based in Bradford. I've shipped live customer pages inside a major
        bank's Agile team, written open-source documentation for Arm, and built and launched a live
        website for a family business. I started this studio because local businesses deserve
        websites as good as national brands', and I'd rather be judged on your bookings than my
        hours.
      </p>

      <h3 class="about__sub">Credentials</h3>
      <ul class="about__creds">
        {credentials.map((credential) => (
          <li>
            <span>{credential.text}</span>
            {credential.inProgress && <span class="about__badge">In progress</span>}
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

<style>
  .about {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .about__inner {
    display: grid;
    gap: clamp(2.5rem, 5vw, 4rem);
    align-items: start;
  }

  .about__photo {
    position: relative;
    aspect-ratio: 4 / 5;
    width: 100%;
    max-width: 30rem;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--ink-800);
    border: 1px dashed rgba(255, 255, 255, 0.3);
  }

  .about__photo-glow {
    position: absolute;
    inset: 15%;
    border-radius: 30%;
    background: radial-gradient(circle, var(--magenta-bright), var(--blue) 60%, transparent 75%);
    filter: blur(40px);
    opacity: 0.7;
  }

  .about__photo-label {
    position: absolute;
    left: 1rem;
    bottom: 1rem;
    padding: 0.4em 1em;
    border-radius: var(--radius-pill);
    background: rgba(5, 8, 16, 0.75);
    font-size: 0.8rem;
  }

  .about__copy {
    display: grid;
    gap: var(--space-4);
  }

  .about__intro {
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.55;
    max-width: 38rem;
  }

  .about__sub {
    font-size: 1.1rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    margin-top: var(--space-3);
  }

  .about__creds {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-line);
  }

  .about__creds li {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-3);
    padding-block: 0.8rem;
    border-bottom: 1px solid var(--color-line);
    font-size: 0.925rem;
    color: rgba(255, 255, 255, 0.88);
  }

  .about__badge {
    flex: none;
    padding: 0.2em 0.8em;
    border-radius: var(--radius-pill);
    border: 1px solid #ff9ae3;
    color: #ffc2ee;
    font-size: 0.72rem;
  }

  @media (min-width: 60rem) {
    .about__inner {
      grid-template-columns: 0.8fr 1.2fr;
    }

    .about__photo {
      position: sticky;
      top: 2rem;
    }
  }
</style>
