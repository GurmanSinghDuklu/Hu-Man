---
import { getImage } from 'astro:assets';
import { projects, projectImage, metaLine, statusLabel } from '../data/projects';
import { withBase } from '../config/paths';

interface Props {
  /** Tile heading level: h3 under the home page's h2, h2 on /work/. */
  heading?: 'h2' | 'h3';
}

const { heading = 'h3' } = Astro.props;
const Heading = heading;

const filters = [
  { id: 'all', label: 'All' },
  { id: 'live', label: 'Live' },
  { id: 'concept', label: 'Concepts' },
];

// Where each tile's Signal blocks sit at rest, on a 6 x 4 grid over the image ([column, row]).
const blockSets: [number, number][][] = [
  [
    [5, 1],
    [6, 2],
    [2, 4],
  ],
  [
    [1, 1],
    [5, 3],
    [6, 4],
  ],
  [
    [6, 1],
    [1, 3],
    [2, 4],
  ],
  [
    [2, 1],
    [6, 3],
    [5, 4],
  ],
  [
    [1, 2],
    [5, 1],
    [6, 4],
  ],
];

// Block colour and the two glitch-band colours, per tile: the glitches aren't all green.
const palettes = [
  { block: 'signal', a: 'pulse', b: 'scan' },
  { block: 'flare', a: 'signal', b: 'pulse' },
  { block: 'volt', a: 'pulse', b: 'scan' },
  { block: 'scan', a: 'flare', b: 'signal' },
  { block: 'pulse', a: 'volt', b: 'signal' },
];

const tiles = await Promise.all(
  projects.map(async (p, i) => ({
    ...p,
    image: await getImage({
      src: projectImage(p.cover),
      width: 960,
      format: 'webp',
      quality: 64,
    }),
    blocks: blockSets[i % blockSets.length],
    colours: palettes[i % palettes.length],
    // Each tile glitches by itself now and then, on its own clock.
    idle: `${(6 + i * 1.3).toFixed(1)}s`,
    idleDelay: `${(1 + i * 1.7).toFixed(1)}s`,
    wide: i < 2,
  })),
);
---

<div class="wg" data-filter-root>
  <div class="wg__filters" role="group" aria-label="Filter the work">
    {filters.map((f, i) => (
      <button
        type="button"
        class="wg__filter"
        data-filter={f.id}
        aria-pressed={i === 0 ? 'true' : 'false'}
      >
        {f.label}
      </button>
    ))}
  </div>

  <ul class="wg__grid">
    {tiles.map((t) => (
      <li
        class:list={['wt', { 'wt--wide': t.wide }]}
        data-cat={t.status === 'live' ? 'live' : 'concept'}
      >
        <a class="wt__link" href={withBase(`/work/${t.slug}/`)}>
          <div
            class="wt__media"
            style={`--img:url(${t.image.src});--pos:${t.coverPos ?? 'center'};--block:var(--${t.colours.block});--ga:var(--${t.colours.a});--gb:var(--${t.colours.b});--idle:${t.idle};--idle-d:${t.idleDelay}`}
          >
            <img
              class="wt__img"
              src={t.image.src}
              width={t.image.attributes.width}
              height={t.image.attributes.height}
              alt=""
              loading="lazy"
              decoding="async"
            />
            <span class="wt__slice wt__slice--a" aria-hidden="true" />
            <span class="wt__slice wt__slice--b" aria-hidden="true" />
            <span class="wt__blocks" aria-hidden="true">
              {t.blocks.map(([x, y], k) => (
                <i style={`grid-area:${y} / ${x};--k:${k}`} />
              ))}
            </span>
            <span
              class:list={['wt__status', { 'wt__status--live': t.status === 'live' }]}
              aria-hidden="true"
            >
              {t.status === 'live' && '● '}
              {statusLabel[t.status]}
            </span>
          </div>
          <div class="wt__meta">
            <p class="wt__line">{metaLine(t)}</p>
            <Heading class="wt__name">{t.name}</Heading>
            <p class="wt__summary">{t.summary}</p>
            {t.disclaimer && <p class="wt__disclaimer">{t.disclaimer}</p>}
          </div>
        </a>
      </li>
    ))}
  </ul>
  <p class="wg__empty" hidden data-filter-empty>
    Nothing in this category yet.
  </p>
</div>

<script>
  import '../scripts/filter.ts';
</script>

<style>
  .wg__filters {
    display: flex;
    gap: 0.4rem;
    margin-bottom: var(--space-4);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .wg__filter {
    flex: none;
    min-height: 44px;
    padding: 0.4em 1em;
    border: var(--border-hairline) solid var(--line-strong);
    border-radius: 0;
    background: none;
    color: var(--ink-text);
    font: 500 0.75rem var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .wg__filter:hover {
    border-color: var(--ink-text);
  }

  .wg__filter[aria-pressed='true'] {
    background: var(--signal);
    border-color: var(--signal);
    color: var(--on-signal);
  }

  .wg__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(2rem, 4vw, 2.5rem) var(--space-4);
  }

  .wt[hidden] {
    display: none;
  }

  .wt__link {
    display: grid;
    gap: var(--space-3);
    text-decoration: none;
    color: inherit;
  }

  .wt__link:focus-visible {
    outline-offset: 6px;
  }

  .wt__media {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    background: var(--surface-raised);
  }

  /* Black and white at rest; colour snaps in on hover or focus. */
  .wt__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: var(--pos);
    filter: grayscale(1) contrast(1.08);
    transition: transform 0.6s var(--ease-out);
  }

  /* The glitch: two bands of the same image, tinted in the tile's two glitch colours, jump
     sideways for a third of a second, on hover or focus and by themselves now and then. Their
     clip is fixed; only transform and opacity animate. */
  .wt__slice {
    position: absolute;
    inset: 0;
    background: var(--img) var(--pos) / cover no-repeat;
    background-blend-mode: multiply;
    opacity: 0;
    pointer-events: none;
  }

  .wt__slice--a {
    background-color: var(--ga);
    clip-path: inset(18% 0 62% 0);
    animation: wt-idle var(--idle) steps(1, end) infinite var(--idle-d);
  }

  .wt__slice--b {
    background-color: var(--gb);
    clip-path: inset(58% 0 26% 0);
    animation: wt-idle var(--idle) steps(1, end) infinite calc(var(--idle-d) + 0.12s);
  }

  @keyframes wt-idle {
    0%,
    100% {
      opacity: 0;
      transform: none;
    }
    90% {
      opacity: 1;
      transform: translateX(-3%);
    }
    92% {
      transform: translateX(2%);
    }
    94% {
      opacity: 0;
      transform: none;
    }
  }

  .wt__blocks {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    grid-template-rows: repeat(4, 1fr);
    pointer-events: none;
  }

  .wt__blocks i {
    background: var(--block);
    transition: opacity 0s linear calc(var(--k) * 60ms);
  }

  .wt__status {
    position: absolute;
    left: 0.6rem;
    top: 0.6rem;
    padding: 0.3em 0.6em;
    background: var(--brand-ink);
    color: var(--brand-paper);
    font: 500 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .wt__status--live {
    background: var(--signal);
    color: var(--on-signal);
    border-radius: var(--radius-pill);
  }

  .wt__link:hover .wt__img,
  .wt__link:focus-visible .wt__img {
    filter: none;
    transform: scale(1.03);
  }

  .wt__link:hover .wt__blocks i,
  .wt__link:focus-visible .wt__blocks i {
    opacity: 0;
  }

  .wt__link:hover .wt__slice--a,
  .wt__link:focus-visible .wt__slice--a {
    animation: glitch-a 0.36s steps(1, end);
  }

  .wt__link:hover .wt__slice--b,
  .wt__link:focus-visible .wt__slice--b {
    animation: glitch-b 0.36s steps(1, end);
  }

  @keyframes glitch-a {
    0% {
      opacity: 1;
      transform: translateX(-4%);
    }
    33% {
      transform: translateX(3%);
    }
    66% {
      transform: translateX(-1.5%);
    }
    100% {
      opacity: 0;
      transform: none;
    }
  }

  @keyframes glitch-b {
    0% {
      opacity: 1;
      transform: translateX(3%);
    }
    40% {
      transform: translateX(-5%);
    }
    75% {
      transform: translateX(2%);
    }
    100% {
      opacity: 0;
      transform: none;
    }
  }

  .wt__meta {
    display: grid;
    gap: 0.5rem;
    justify-items: start;
  }

  .wt__line {
    font: 500 0.75rem/1.35 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-muted);
  }

  .wt__name {
    font-size: clamp(1.5rem, 2.6vw, 2rem);
    transition: color 0.15s linear;
  }

  .wt__link:hover .wt__name {
    color: var(--signal-text);
  }

  .wt__summary {
    max-width: 36rem;
    color: var(--ink-muted);
  }

  .wt__disclaimer {
    font-size: 0.875rem;
    color: var(--ink-muted);
  }

  @media (min-width: 40rem) {
    .wg__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .wt:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }

    .wt:last-child:nth-child(odd) .wt__media {
      aspect-ratio: 16 / 7;
    }
  }

  @media (min-width: 64rem) {
    .wg__grid {
      grid-template-columns: repeat(6, 1fr);
    }

    .wt {
      grid-column: span 2;
    }

    .wt--wide {
      grid-column: span 3;
    }

    .wt:last-child:nth-child(odd) {
      grid-column: span 2;
    }

    .wt:last-child:nth-child(odd) .wt__media {
      aspect-ratio: 4 / 3;
    }
  }

  /* One block per tile drops out and back now and then. */
  .wt__blocks i:nth-child(2) {
    animation: wt-block var(--idle) steps(1, end) infinite calc(var(--idle-d) + 0.2s);
  }

  .wt__link:hover .wt__blocks i,
  .wt__link:focus-visible .wt__blocks i {
    animation: none;
  }

  @keyframes wt-block {
    0%,
    100% {
      opacity: 1;
    }
    90% {
      opacity: 0;
    }
    93% {
      opacity: 1;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wt__slice {
      display: none;
    }

    .wt__blocks i {
      animation: none;
    }
  }
</style>
