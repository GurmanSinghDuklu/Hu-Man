---
import { faqItems } from '../data/content';
---

<section class="faq light" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__inner">
    <div class="faq__head">
      <p class="eyebrow" data-reveal>
        FAQ
      </p>
      <h2 id="faq-title" class="section-title" data-reveal>
        Good <span class="hl">questions</span>
      </h2>
    </div>
    <ul class="faq__list">
      {faqItems.map((item) => (
        <li>
          <details>
            <summary>
              <span>{item.question}</span>
              <span class="faq__plus" aria-hidden="true" />
            </summary>
            <p>{item.answer}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* A Paper band. */
  .faq {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .faq__head {
    display: grid;
    gap: var(--space-3);
    align-content: start;
    justify-items: start;
  }

  .faq__inner {
    display: grid;
    gap: var(--space-5);
  }

  .faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: var(--border-rule) solid var(--brand-ink);
  }

  .faq__list li {
    border-bottom: var(--border-hairline) solid var(--line);
  }

  .faq__list summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: 1.25rem;
    cursor: pointer;
    font: 700 clamp(1.1rem, 1.8vw, 1.3rem) / 1.3 var(--font-text);
  }

  .faq__list summary::-webkit-details-marker {
    display: none;
  }

  /* A square plus that fills Ink when open. */
  .faq__plus {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border: var(--border-hairline) solid var(--line-strong);
  }

  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 2px;
    background: currentColor;
    transform: translate(-50%, -50%);
  }

  .faq__plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  summary:hover .faq__plus {
    border-color: var(--brand-ink);
  }

  details[open] .faq__plus {
    background: var(--brand-ink);
    border-color: var(--brand-ink);
    color: var(--brand-paper);
  }

  details[open] .faq__plus::after {
    transform: translate(-50%, -50%);
  }

  .faq__list details p {
    padding-bottom: 1.5rem;
    max-width: 44rem;
    color: var(--color-text-muted);
    font-size: 1.0625rem;
  }

  @media (min-width: 60rem) {
    .faq__inner {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }
</style>
