---
import { faqItems } from '../data/content';
---

<section class="faq" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq__inner">
    <h2 id="faq-title" class="section-title">
      <span class="t-thin">Questions</span>
    </h2>
    <ul class="faq__list">
      {faqItems.map((item) => (
        <li>
          <details>
            <summary>
              <span>{item.question}</span>
              <span class="faq__plus" aria-hidden="true" />
            </summary>
            <p>{item.answer}</p>
          </details>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .faq {
    background: var(--paper);
    color: var(--paper-text);
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .faq__inner {
    display: grid;
    gap: var(--space-5);
  }

  .faq__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--paper-text);
  }

  .faq__list li {
    border-bottom: 1px solid var(--paper-line);
  }

  .faq__list summary {
    list-style: none;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-block: 1.4rem;
    cursor: pointer;
    font-size: clamp(1.1rem, 1.8vw, 1.35rem);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .faq__list summary::-webkit-details-marker {
    display: none;
  }

  .faq__plus {
    position: relative;
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1px solid var(--paper-line);
    transition: background-color 0.2s;
  }

  .faq__plus::before,
  .faq__plus::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 14px;
    height: 1.5px;
    background: currentColor;
    transform: translate(-50%, -50%);
    transition: transform 0.3s var(--ease-out);
  }

  .faq__plus::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  details[open] .faq__plus {
    background: var(--paper-text);
    color: var(--paper);
  }

  details[open] .faq__plus::after {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  .faq__list details p {
    padding-bottom: 1.5rem;
    max-width: 44rem;
    color: var(--paper-muted);
  }

  @media (min-width: 60rem) {
    .faq__inner {
      grid-template-columns: 1fr 2fr;
      align-items: start;
    }
  }
</style>
