---
/** Slow ticker of what the studio makes. Pauses on hover, static under reduced motion. */
const items = [
  'Websites',
  'Booking apps',
  'Online shops',
  'Dashboards',
  'AI enquiry assistants',
  'Automations',
  'Local SEO',
  'Care plans',
];
---

<section class="marquee" aria-label="What I make">
  <ul class="marquee__list">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
  <ul class="marquee__list" aria-hidden="true">
    {items.map((item) => (
      <li>{item}</li>
    ))}
  </ul>
</section>

<style>
  .marquee {
    display: flex;
    overflow: hidden;
    padding-block: clamp(1.25rem, 3vw, 2rem);
    border-block: 1px solid var(--color-line);
    mask-image: linear-gradient(90deg, transparent, #000 8%, #000 92%, transparent);
  }

  .marquee:hover .marquee__list {
    animation-play-state: paused;
  }

  .marquee__list {
    list-style: none;
    display: flex;
    flex: none;
    gap: clamp(1.5rem, 3vw, 3rem);
    margin: 0;
    padding: 0 clamp(0.75rem, 1.5vw, 1.5rem);
    animation: marquee 40s linear infinite;
  }

  .marquee__list li {
    display: flex;
    align-items: center;
    gap: clamp(1.5rem, 3vw, 3rem);
    font-size: clamp(1.5rem, 3.4vw, 2.75rem);
    font-weight: 200;
    font-style: italic;
    letter-spacing: -0.03em;
    white-space: nowrap;
  }

  .marquee__list li:nth-child(odd) {
    font-weight: 700;
    font-style: normal;
  }

  .marquee__list li::after {
    content: '';
    width: 0.4em;
    height: 0.4em;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--magenta-bright), var(--blue));
  }

  @keyframes marquee {
    to {
      transform: translateX(-100%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee__list {
      animation: none;
      flex-wrap: wrap;
      flex: 1;
      row-gap: 0.5rem;
    }

    .marquee__list[aria-hidden='true'] {
      display: none;
    }

    .marquee {
      mask-image: none;
    }
  }
</style>
