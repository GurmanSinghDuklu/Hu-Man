---
/**
 * The one named method, Talk / Shape / Build / Launch / Stay, with its timings. The same block
 * sits on the home page (inside the indigo "From idea to online business" panel) and on
 * /how-we-build/; `tone` only changes the card edge for the pale page.
 */
import { method, methodNote } from '../../data/process';

interface Props {
  tone?: 'on-block' | 'on-page';
}

const { tone = 'on-block' } = Astro.props;
---

<div class:list={['method', `method--${tone}`]}>
  <ol class="method__steps" data-pin-steps>
    {method.map((s, i) => (
      <li
        class:list={['method__step', `method__step--${s.shape}`]}
        data-reveal
        style={`--reveal-delay:${i * 0.08}s`}
      >
        <span class="method__n">{String(i + 1).padStart(2, '0')}</span>
        <p class="method__when">{s.when}</p>
        <h3>{s.title}</h3>
        <p class="method__text">{s.text}</p>
      </li>
    ))}
  </ol>
  <p class="method__note">{methodNote}</p>
</div>

<style>
  .method__steps {
    display: grid;
    gap: max(12px, calc(var(--u) * 0.33));
  }

  .method__step {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    min-height: 11rem;
    padding: clamp(1.1rem, calc(var(--u) * 0.29), 1.75rem);
    background: var(--paper);
    color: var(--ink);
  }

  .method--on-page .method__step {
    border: 1px solid var(--ink);
  }

  .method__step--curve {
    border-top-right-radius: calc(var(--u) * 0.85);
  }

  .method__step--lilac {
    background: var(--grad-lilac);
  }

  .method__n {
    margin-bottom: clamp(0.5rem, calc(var(--u) * 0.2), 1.25rem);
    font: 800 clamp(2rem, calc(var(--u) * 0.55), 3.3rem) / 1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .method__when {
    font: 400 0.6875rem/1.3 var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .method__step h3 {
    font-size: clamp(1.1rem, calc(var(--u) * 0.28), 1.7rem);
    line-height: 0.95;
  }

  .method__text {
    font-size: clamp(0.9rem, calc(var(--u) * 0.165), 1rem);
    line-height: 1.45;
  }

  .method__note {
    margin-top: 1rem;
    font-size: 0.875rem;
  }

  .method--on-block .method__note {
    color: var(--paper);
  }

  .method--on-page .method__note {
    color: var(--muted);
  }

  @media (min-width: 40rem) {
    .method__steps {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .method__steps {
      grid-template-columns: repeat(5, 1fr);
      gap: calc(var(--u) * 0.2);
    }

    .method__step {
      min-height: calc(var(--u) * 2.7);
      gap: calc(var(--u) * 0.1);
      padding: calc(var(--u) * 0.22);
    }

    .method__when {
      font-size: max(0.6875rem, calc(var(--u) * 0.1));
    }

    .method__text {
      font-size: calc(var(--u) * 0.155);
    }

    .method__note {
      font-size: calc(var(--u) * 0.15);
    }
  }
</style>
