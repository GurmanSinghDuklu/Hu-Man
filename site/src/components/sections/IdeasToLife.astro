---
/**
 * "From idea to online business" (home 01, services 02): one wide indigo block with the ringed star,
 * and the method (Talk, Shape, Build, Launch, Stay) as cards along its foot.
 */
import Sparkle from '../Sparkle.astro';
import Arrow from '../Arrow.astro';
import BookingLink from '../BookingLink.astro';
import MethodSteps from './MethodSteps.astro';

interface Props {
  n: string;
}

const { n } = Astro.props;
---

<section class="band ideas" aria-labelledby={`ideas-title-${n}`}>
  <div class="sheet">
    <div class="ideas__block fill--indigo">
      <span class="shader-layer" data-shader="ideas" aria-hidden="true"></span>
      <span class="ideas__rings" aria-hidden="true">
        <Sparkle class="ideas__star amb-spin" color="var(--paper)" />
      </span>
      <div class="ideas__copy">
        <p class="label" data-reveal>
          {n} / From idea to online business
        </p>
        <h2 id={`ideas-title-${n}`} class="ideas__title" data-reveal="lines">
          Talk. Shape. Build.
          <br />
          Launch. Stay.
        </h2>
        <p class="ideas__text" data-reveal>
          That idea you’ve had on your mind for years? The one you can’t quite put together? Speak
          to us. We specialise in turning ideas into real, working online businesses.
        </p>
        <BookingLink class="pill-btn ideas__btn" data-reveal>
          Book a free 1-hour call <Arrow class="ideas__arrow" />
        </BookingLink>
      </div>

      <MethodSteps />
    </div>
  </div>
</section>

<style>
  .ideas {
    padding-block: clamp(3rem, calc(var(--u) * 0.89), 5.5rem);
  }

  .ideas__block {
    position: relative;
    isolation: isolate;
    display: grid;
    gap: clamp(2rem, calc(var(--u) * 0.66), 4rem);
    padding: clamp(1.75rem, calc(var(--u) * 0.66), 4rem) clamp(1.25rem, calc(var(--u) * 0.33), 2rem)
      clamp(1.25rem, calc(var(--u) * 0.33), 2rem);
    border-top-right-radius: calc(var(--u) * 2.56);
    color: var(--paper);
    overflow: hidden;
  }

  .ideas__copy {
    position: relative;
    min-width: 0;
    display: grid;
    justify-items: start;
    gap: 1rem;
  }

  .ideas__title {
    font-size: clamp(min(8.5vw, 2.25rem), calc(var(--u) * 1.07), 6.7rem);
    line-height: 0.88;
  }

  .ideas__text {
    max-width: 42rem;
    font-size: clamp(1rem, calc(var(--u) * 0.21), 1.3rem);
    line-height: 1.55;
  }

  .ideas__copy :global(.ideas__btn) {
    gap: 0.75rem;
    margin-top: 0.75rem;
    border-color: var(--paper);
    background: var(--paper);
    color: var(--ink);
  }

  .ideas__copy :global(.ideas__btn:hover) {
    background: transparent;
    color: var(--paper);
  }

  .ideas__copy :global(.ideas__btn .ideas__arrow) {
    width: 0.9rem;
  }

  /* The two thin rings and the star, top right. */
  .ideas__rings {
    display: none;
  }

  @media (min-width: 64rem) {
    .ideas__block {
      gap: calc(var(--u) * 0.66);
      min-height: calc(var(--u) * 8.67);
      padding: calc(var(--u) * 0.66) calc(var(--u) * 0.33) calc(var(--u) * 0.33);
    }

    .ideas__copy {
      padding-left: calc(var(--u) * 0.33);
      gap: calc(var(--u) * 0.2);
    }

    .ideas__copy .label {
      font-size: calc(var(--u) * 0.135);
    }

    .ideas__text {
      max-width: calc(var(--u) * 7.8);
      margin-top: calc(var(--u) * 0.45);
    }

    .ideas__copy :global(.ideas__btn) {
      margin-top: 0;
      min-height: calc(var(--u) * 0.56);
      padding: 0 calc(var(--u) * 0.33);
      font-size: calc(var(--u) * 0.135);
    }

    .ideas__rings {
      display: grid;
      place-items: center;
      position: absolute;
      left: calc(var(--u) * 10.78);
      top: calc(var(--u) * 0.67);
      width: calc(var(--u) * 4.22);
      aspect-ratio: 1;
      border: 1px solid rgba(241, 242, 236, 0.35);
      border-radius: 50%;
    }

    .ideas__rings::before {
      content: '';
      position: absolute;
      inset: 17%;
      border: 1px solid rgba(241, 242, 236, 0.35);
      border-radius: 50%;
    }

    .ideas__rings :global(.ideas__star) {
      width: calc(var(--u) * 1.2);
    }
  }
</style>
