---
import { site } from '../config/site';

const auditMailto = (() => {
  const subject = encodeURIComponent('Free presence audit');
  const body = encodeURIComponent('Hi Gurman,\n\nBusiness name:\nWebsite:\nMain service:\n\n');
  return `mailto:${site.contact.email}?subject=${subject}&body=${body}`;
})();

const auditTel = `tel:${site.contact.phone.replace(/\s+/g, '')}`;
---

<section class="audit" id="audit" aria-labelledby="audit-title">
  <div class="wrap">
    <div class="audit__top">
      <h2 id="audit-title" class="audit__title">
        <span class="t-thin">Get your</span> <span class="t-bold">free</span>
        <span class="t-thin">presence</span> <span class="t-bold">audit.</span>
      </h2>
      <svg class="audit__badge" viewBox="0 0 100 100" aria-hidden="true">
        <path
          d="M50 3c5 0 7 5 12 6s9-3 13 0 2 9 5 13 9 4 10 9-4 8-4 13 5 9 3 13-8 4-11 8-2 10-7 12-9-2-13 0-7 9-12 9-7-6-12-6-9 4-13 1-2-9-5-13-9-4-10-9 4-8 4-13-5-9-3-13 8-4 11-8 2-10 7-12 9 2 13 0 7-9 12-9z"
          fill="#fff"
          class="audit__scallop"
        ></path>
        <path
          d="M36 64 64 36M42 36h22v22"
          fill="none"
          stroke="#9c0d7c"
          stroke-width="5"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </div>

    <p class="audit__text">
      Send me your website address and I'll review it on a phone, check your speed and your Google
      Business Profile, and see whether Google and ChatGPT recommend you for your main search. You
      get a short video and a written list of fixes. It's free and there's no obligation.
    </p>

    <div class="audit__actions">
      <a class="pill-btn pill-btn--solid" href={auditMailto}>
        Email me your website
      </a>
      <a class="pill-btn" href={auditTel}>
        Call {site.contact.phone}
      </a>
      <a class="pill-btn" href={site.contact.whatsapp} rel="noopener">
        Message on WhatsApp
      </a>
    </div>

    <div class="audit__shapes" aria-hidden="true">
      <span class="s-circle"></span>
      <span class="s-pill"></span>
      <span class="s-eye">
        <i></i>
      </span>
      <span class="s-circle"></span>
      <span class="s-pill"></span>
    </div>
  </div>
</section>

<style>
  .audit {
    padding-block: clamp(4rem, 10vw, 8rem) clamp(3rem, 6vw, 5rem);
  }

  .audit__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .audit__title {
    font-size: clamp(3rem, 9vw, 8rem);
    line-height: 0.98;
    max-width: 11em;
  }

  .audit__title .t-thin {
    font-weight: 200;
  }

  .audit__badge {
    flex: none;
    width: clamp(80px, 16vw, 220px);
  }

  .audit__scallop {
    transform-box: fill-box;
    transform-origin: center;
    animation: spin 24s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .audit__text {
    margin-top: var(--space-5);
    max-width: 40rem;
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    color: rgba(255, 255, 255, 0.88);
  }

  .audit__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-5);
  }

  .audit__shapes {
    display: grid;
    grid-template-columns: 1fr 2.8fr 2.7fr 1fr 2.6fr;
    gap: clamp(0.4rem, 1vw, 0.9rem);
    margin-top: clamp(3rem, 8vw, 6rem);
    height: clamp(56px, 10vw, 140px);
  }

  .audit__shapes > span {
    border-radius: 999px;
  }

  .s-circle {
    background: #fff;
    aspect-ratio: 1;
    height: 100%;
    justify-self: center;
  }

  .s-pill {
    background: var(--magenta);
  }

  .s-eye {
    background: #fff;
    border-radius: 50% !important;
    display: grid;
    place-items: center;
  }

  .s-eye i {
    height: 80%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(circle, #000 0 45%, var(--magenta) 46% 100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .audit__scallop {
      animation: none;
    }
  }
</style>
