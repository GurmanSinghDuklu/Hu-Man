---
import { site } from '../config/site';
import Arrow from './Arrow.astro';
import Module from './Module.astro';

const auditMailto = (() => {
  const subject = encodeURIComponent('Free presence audit');
  const body = encodeURIComponent('Hi,\n\nBusiness name:\nWebsite:\nMain service:\n\n');
  return `mailto:${site.contact.email}?subject=${subject}&body=${body}`;
})();

const auditTel = `tel:${site.contact.phone.replace(/\s+/g, '')}`;
const ticker = ['Free presence audit', 'Short video', 'Written list of fixes', 'No obligation'];
---

<section class="audit plum" id="audit" aria-labelledby="audit-title">
  <div class="audit__ticker" aria-hidden="true">
    <div class="audit__ticker-row">
      {[...ticker, ...ticker, ...ticker].map((t) => (
        <span>
          {t}
          <i />
        </span>
      ))}
    </div>
  </div>

  <div class="wrap audit__inner">
    <div class="audit__main">
      <div class="audit__top">
        <div>
          <h2 id="audit-title" class="audit__title" data-reveal>
            Get your free presence audit
          </h2>
        </div>
      </div>

      <p class="audit__text" data-reveal>
        Send us your website address and we'll review it on a phone, check your speed and your
        Google Business Profile, and see whether Google and ChatGPT recommend you for your main
        search. You get a short video and a written list of fixes. It's free and there's no
        obligation.
      </p>

      <div class="audit__actions" data-reveal>
        <a class="btn btn--primary" href={auditMailto}>
          Email us your website
          <span class="btn__icon">
            <Arrow />
          </span>
        </a>
        <a class="btn btn--secondary" href={auditTel}>
          Call {site.contact.phone}
        </a>
        <a class="btn btn--secondary" href={site.contact.whatsapp} rel="noopener">
          Message on WhatsApp
        </a>
      </div>
    </div>

    <div class="audit__modules" data-cells aria-hidden="true">
      <Module kind="ridge" fg="ink" bg="signal" />
      <Module kind="arrow" fg="paper" bg="ink" />
      <Module kind="stripes" fg="signal" bg="ink" />
      <Module kind="rings" fg="ink" bg="paper" />
    </div>
  </div>
</section>

<style>
  .audit {
    position: relative;
    overflow: hidden;
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  /* A Signal label strip, Ink mono capitals. */
  .audit__ticker {
    display: flex;
    overflow: hidden;
    padding-block: 0.9rem;
    background: var(--signal);
    color: var(--on-signal);
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .audit__ticker-row {
    display: flex;
    flex: none;
    animation: ticker 30s linear infinite;
  }

  .audit__ticker span {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    white-space: nowrap;
    font: 500 0.875rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .audit__ticker i {
    width: 0.5rem;
    height: 0.5rem;
    background: var(--brand-ink);
  }

  @keyframes ticker {
    to {
      transform: translateX(-33.333%);
    }
  }

  .audit__inner {
    display: grid;
    gap: var(--space-5);
    align-items: end;
  }

  .audit__top > div {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .audit__title {
    font-size: clamp(2.6rem, 7vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    max-width: 10em;
  }

  .audit__text {
    margin-top: var(--space-5);
    max-width: 40rem;
    font-size: clamp(1.05rem, 1.4vw, 1.15rem);
    color: var(--ink-text);
  }

  .audit__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-5);
  }

  /* A 2 x 2 module block beside the copy: Ridge on Signal, the 68-degree arrow, stripes, rings. */
  .audit__modules {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border: var(--border-hairline) solid var(--line);
  }

  @media (min-width: 60rem) {
    .audit__inner {
      grid-template-columns: 1fr minmax(18rem, 26rem);
    }

    .audit__modules {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .audit__ticker-row {
      animation: none;
    }
  }
</style>
