---
import { site } from '../config/site';
import Arrow from './Arrow.astro';

const auditMailto = (() => {
  const subject = encodeURIComponent('Free presence audit');
  const body = encodeURIComponent('Hi Gurman,\n\nBusiness name:\nWebsite:\nMain service:\n\n');
  return `mailto:${site.contact.email}?subject=${subject}&body=${body}`;
})();

const auditTel = `tel:${site.contact.phone.replace(/\s+/g, '')}`;
const ticker = ['Free presence audit', 'Short video', 'Written list of fixes', 'No obligation'];
---

<section class="audit on-dark" id="audit" aria-labelledby="audit-title">
  <div class="audit__ticker" aria-hidden="true">
    <div class="audit__ticker-row">
      {[...ticker, ...ticker, ...ticker].map((t) => (
        <span>
          {t}
          <i />
        </span>
      ))}
    </div>
  </div>

  <div class="wrap audit__inner">
    <div class="audit__top">
      <div>
        <p class="eyebrow" data-reveal>
          Start here
        </p>
        <h2 id="audit-title" class="audit__title" data-reveal>
          Get your free <span class="hl">presence audit</span>
        </h2>
      </div>
      <svg class="audit__badge" viewBox="0 0 120 120" aria-hidden="true">
        <defs>
          <path id="audit-circle" d="M60 60m-44 0a44 44 0 1 1 88 0a44 44 0 1 1-88 0"></path>
        </defs>
        <circle cx="60" cy="60" r="58" fill="#00ff30"></circle>
        <g class="audit__badge-text">
          <text font-size="11" font-weight="700" fill="#0b100d">
            <textPath href="#audit-circle" textLength="272" lengthAdjust="spacing">
              FREE AUDIT · NO OBLIGATION ·
            </textPath>
          </text>
        </g>
        <path
          d="M48 72 72 48M54 48h18v18"
          fill="none"
          stroke="#0b100d"
          stroke-width="4"
          stroke-linecap="round"
          stroke-linejoin="round"
        ></path>
      </svg>
    </div>

    <p class="audit__text" data-reveal>
      Send me your website address and I'll review it on a phone, check your speed and your Google
      Business Profile, and see whether Google and ChatGPT recommend you for your main search. You
      get a short video and a written list of fixes. It's free and there's no obligation.
    </p>

    <div class="audit__actions" data-reveal>
      <a class="btn btn--lime" href={auditMailto}>
        Email me your website
        <span class="btn__icon">
          <Arrow />
        </span>
      </a>
      <a class="btn btn--ghost" href={auditTel}>
        Call {site.contact.phone}
      </a>
      <a class="btn btn--ghost" href={site.contact.whatsapp} rel="noopener">
        Message on WhatsApp
      </a>
    </div>
  </div>
</section>

<style>
  .audit {
    position: relative;
    margin: clamp(2rem, 5vw, 4rem) clamp(0.5rem, 1.5vw, 1.25rem) 0;
    border-radius: var(--radius-xl);
    overflow: hidden;
    color: var(--on-dark);
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.035) 0 1px, transparent 1px 88px),
      radial-gradient(60% 80% at 88% 110%, rgba(0, 255, 48, 0.3), transparent 65%),
      radial-gradient(45% 60% at 5% 0%, rgba(173, 255, 0, 0.1), transparent 70%), var(--graphite-1);
    border: 1px solid var(--color-line);
    padding-bottom: clamp(3.5rem, 8vw, 6rem);
  }

  .audit__ticker {
    display: flex;
    overflow: hidden;
    padding-block: 1rem;
    background: var(--acid);
    color: var(--ink);
    margin-bottom: clamp(3rem, 7vw, 5rem);
  }

  .audit__ticker-row {
    display: flex;
    flex: none;
    animation: ticker 30s linear infinite;
  }

  .audit__ticker span {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    padding-right: 1.5rem;
    white-space: nowrap;
    font-weight: 800;
    font-size: 1.1rem;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .audit__ticker i {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--ink);
  }

  @keyframes ticker {
    to {
      transform: translateX(-33.333%);
    }
  }

  .audit__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .audit__top > div {
    display: grid;
    gap: var(--space-3);
  }

  .audit__title {
    font-size: clamp(2.6rem, 7.5vw, 6.5rem);
    line-height: 0.92;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    max-width: 10em;
  }

  .audit__badge {
    flex: none;
    width: clamp(88px, 13vw, 170px);
  }

  .audit__badge-text {
    transform-origin: 60px 60px;
    animation: spin 18s linear infinite;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .audit__text {
    margin-top: var(--space-5);
    max-width: 40rem;
    font-size: clamp(1.02rem, 1.4vw, 1.15rem);
    color: #b3b9c1;
  }

  .audit__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: var(--space-5);
  }

  @media (prefers-reduced-motion: reduce) {
    .audit__ticker-row,
    .audit__badge-text {
      animation: none;
    }
  }
</style>
