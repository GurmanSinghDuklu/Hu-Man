---
/**
 * A line drawing that builds itself as you scroll (scripts/motion/scroll-story.ts, [data-draw]):
 * a wireframe on the left, a line carrying across, and the finished page on the right, its blocks
 * filling with brand colours and labelled with what search engines and AI agents read from it
 * (business, services, prices, hours, contact). Decorative: the section's text says the same.
 * Without JavaScript, or under reduced motion, it shows complete.
 */
interface Props {
  class?: string;
}

const { class: className } = Astro.props;

/** One browser window's wireframe, drawn at an x offset. */
const frame = (x: number) => ({
  window: { x: x + 20, y: 20, w: 440, h: 320 },
  dots: [46, 66, 86].map((cx) => x + cx),
  bar: `M${x + 20} 60 H${x + 460}`,
  nav: { x: x + 50, y: 80, w: 80, h: 14 },
  navLine: `M${x + 300} 87 H${x + 430}`,
  hero: { x: x + 50, y: 112, w: 180, h: 112 },
  cross: `M${x + 50} 112 L${x + 230} 224 M${x + 230} 112 L${x + 50} 224`,
  text: [
    `M${x + 255} 128 H${x + 430}`,
    `M${x + 255} 150 H${x + 410}`,
    `M${x + 255} 172 H${x + 380}`,
  ],
  button: { x: x + 255, y: 196, w: 96, h: 28 },
  cards: [50, 183, 316].map((cx) => ({ x: x + cx, y: 248, w: 114, h: 70 })),
});

const before = frame(0);
const after = frame(720);
const labels = [
  { x: after.hero.x + 14, y: after.hero.y + 24, text: 'BUSINESS', ink: '#fff' },
  { x: after.cards[0]!.x + 12, y: after.cards[0]!.y + 22, text: 'SERVICES', ink: '#0b0d0a' },
  { x: after.cards[1]!.x + 12, y: after.cards[1]!.y + 22, text: 'PRICES', ink: '#0b0d0a' },
  { x: after.cards[2]!.x + 12, y: after.cards[2]!.y + 22, text: 'HOURS', ink: '#0b0d0a' },
  { x: after.button.x + 14, y: after.button.y + 18, text: 'CONTACT', ink: '#fff' },
];
const cardFills = ['#cea4ee', '#fad5a8', '#93aee0'];
---

<svg
  class:list={['draw-wire', className]}
  viewBox="0 0 1200 360"
  aria-hidden="true"
  focusable="false"
  data-draw
>
  <!-- The finished page's colour, under its lines: fades in once the lines are down. -->
  <g data-draw-fill>
    <rect
      x={after.hero.x}
      y={after.hero.y}
      width={after.hero.w}
      height={after.hero.h}
      rx="10"
      fill="#4e28df"
    ></rect>
  </g>
  {after.cards.map((c, i) => (
    <rect data-draw-fill x={c.x} y={c.y} width={c.w} height={c.h} rx="10" fill={cardFills[i]} />
  ))}
  <rect
    data-draw-fill
    x={after.button.x}
    y={after.button.y}
    width={after.button.w}
    height={after.button.h}
    rx="14"
    fill="#e85e8f"
  ></rect>

  <g class="draw-wire__lines">
    {[before, after].map((f) => (
      <g>
        <rect
          x={f.window.x}
          y={f.window.y}
          width={f.window.w}
          height={f.window.h}
          rx="18"
          pathLength="1"
        />
        <path d={f.bar} pathLength="1" />
        {f.dots.map((cx) => (
          <circle cx={cx} cy="40" r="5" pathLength="1" />
        ))}
        <rect x={f.nav.x} y={f.nav.y} width={f.nav.w} height={f.nav.h} rx="4" pathLength="1" />
        <path d={f.navLine} pathLength="1" />
        <rect x={f.hero.x} y={f.hero.y} width={f.hero.w} height={f.hero.h} rx="10" pathLength="1" />
        {f === before && <path d={f.cross} pathLength="1" />}
        {f.text.map((d) => (
          <path d={d} pathLength="1" />
        ))}
        <rect
          x={f.button.x}
          y={f.button.y}
          width={f.button.w}
          height={f.button.h}
          rx="14"
          pathLength="1"
        />
        {f.cards.map((c) => (
          <rect x={c.x} y={c.y} width={c.w} height={c.h} rx="10" pathLength="1" />
        ))}
      </g>
    ))}
    <!-- The line from the sketch to the finished page. -->
    <path d="M470 180 C 560 96, 630 264, 730 180" pathLength="1" />
    <circle cx="600" cy="180" r="7" pathLength="1" />
  </g>

  <g class="draw-wire__labels" data-draw-fill>
    {labels.map((l) => (
      <text x={l.x} y={l.y} fill={l.ink}>
        {l.text}
      </text>
    ))}
  </g>
</svg>

<style>
  .draw-wire {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .draw-wire__lines {
    fill: none;
    stroke: var(--ink);
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .draw-wire__labels {
    font: 500 11px var(--font-mono);
    letter-spacing: 0.14em;
  }
</style>
