---
import type { Sector } from '../data/sectors';

interface Props {
  sector: Sector;
  mode: 'before' | 'after';
}

const { sector, mode } = Astro.props;
---

<div class="mock-frame">
  {mode === 'before' ? (
    <div
      class="mock mock--before"
      aria-hidden="true"
      style={`--before-header: ${sector.beforeHeaderColor};`}
    >
      <div class="mock-before__header">
        <span class="mock-before__name">{sector.name}</span>
      </div>
      <nav class="mock-before__nav">
        <span>Home</span>
        <span>About Us</span>
        <span>Services</span>
        <span>Gallery</span>
        <span>Links</span>
        <span>Contact Us</span>
      </nav>
      <div class="mock-before__banner">WELCOME TO {sector.name.toUpperCase()}</div>
      <p class="mock-before__paragraph">
        {sector.name} is a family run business established in 2004. We offer a wide range of
        services at competitive prices. Please call for prices and availability.
      </p>
      <div class="mock-before__photo">photo coming soon</div>
      <p class="mock-before__tel">Tel: 01234 567890</p>
      <footer class="mock-before__footer">
        Copyright 2014 {sector.name}. Site last updated 2016.
      </footer>
    </div>
  ) : (
    <div
      class="mock mock--after"
      aria-hidden="true"
      style={`--after-bg: ${sector.palette.bg}; --after-fg: ${sector.palette.fg}; --after-accent: ${sector.palette.accent}; --after-ink-on-accent: ${sector.palette.inkOnAccent};`}
    >
      <nav class="mock-after__nav">
        <span class="mock-after__logo">{sector.name}</span>
        <span class="mock-after__navlinks">
          <span>Home</span>
          <span>Services</span>
          <span>Prices</span>
          <span>Contact</span>
        </span>
        <span class="mock-after__book-btn">{sector.button}</span>
      </nav>

      <div class={`mock-after__hero mock-after__hero--${sector.heroVariant}`}>
        <div class="mock-after__hero-copy">
          <p class="mock-after__headline">{sector.headline}</p>
          <p class="mock-after__sub">{sector.sub}</p>
          <span class="mock-after__cta">{sector.button}</span>
        </div>
        {sector.heroVariant === 'split' && <div class="mock-after__art mock-after__art--blob" />}
        {sector.heroVariant === 'trust' && (
          <div class="mock-after__quote-panel">
            <p class="mock-after__quote">“Fixed price, no surprises.”</p>
            <div class="mock-after__badges">
              <span>Certified</span>
              <span>Insured</span>
            </div>
          </div>
        )}
      </div>

      <div class="mock-after__cards">
        {sector.services.map((service) => (
          <div class="mock-after__card">
            <p class="mock-after__card-name">{service.name}</p>
            <p class="mock-after__card-price">{service.price}</p>
          </div>
        ))}
        <div class="mock-after__card mock-after__card--booking">
          <p class="mock-after__card-name">Booking</p>
          <p class="mock-after__card-price">{sector.bookingCard}</p>
        </div>
      </div>

      <div class="mock-after__chat-bubble">
        <span>Hi! Ask me anything about booking.</span>
      </div>
    </div>
  )}
</div>

<style>
  /*
   * The frame establishes the inline-size container; font-size: 1.25cqw is
   * set one level down on .mock. Setting cqw font-size on the same element
   * that establishes containment is disallowed by spec (it would create a
   * circular dependency: font-size -> em-based size -> container size ->
   * cqw -> font-size), so the browser silently falls back to the inherited
   * size (16px) instead of scaling. Splitting frame/mock avoids that.
   */
  .mock-frame {
    container-type: inline-size;
    aspect-ratio: 16 / 10;
    width: 100%;
    overflow: hidden;
    position: relative;
  }

  .mock {
    width: 100%;
    height: 100%;
    overflow: hidden;
    position: relative;
    font-size: 1.25cqw;
    font-family: var(--font-display);
  }

  /* ===== Before mock ===== */
  .mock--before {
    background: #e7e4dc;
    color: #2a2a2a;
  }

  .mock-before__header {
    background: var(--before-header);
    color: #f2efe8;
    padding: 1.5em 2em;
    font-family: Georgia, serif;
    font-size: 2em;
  }

  .mock-before__nav {
    background: #cfcfc9;
    display: flex;
    gap: 1.5em;
    padding: 0.6em 2em;
    font-size: 0.9em;
  }

  .mock-before__nav span {
    color: #1a3d7c;
    text-decoration: underline;
  }

  .mock-before__banner {
    background: #9fa8b8;
    color: #1c2431;
    text-align: center;
    padding: 1.5em;
    font-weight: 700;
    font-size: 1.3em;
    letter-spacing: 0.03em;
  }

  .mock-before__paragraph {
    padding: 1em 2em;
    font-family: Georgia, serif;
    font-size: 0.85em;
    line-height: 1.5;
    max-width: 45em;
  }

  .mock-before__photo {
    margin: 0 2em 1em;
    background: #c6c6c6;
    color: #6b6b6b;
    height: 8em;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.8em;
    border: 1px solid #a8a8a8;
  }

  .mock-before__tel {
    padding: 0 2em 1em;
    font-family: Georgia, serif;
    font-size: 0.85em;
    font-weight: 700;
  }

  .mock-before__footer {
    background: #4a4a4a;
    color: #cfcfcf;
    text-align: center;
    padding: 0.8em;
    font-size: 0.7em;
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
  }

  /* ===== After mock ===== */
  .mock--after {
    background: var(--after-bg);
    color: var(--after-fg);
    display: flex;
    flex-direction: column;
  }

  .mock-after__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1em 2em;
    gap: 1em;
  }

  .mock-after__logo {
    font-weight: 700;
    font-size: 1.1em;
  }

  .mock-after__navlinks {
    display: flex;
    gap: 1.2em;
    font-size: 0.8em;
    opacity: 0.85;
  }

  .mock-after__book-btn {
    background: var(--after-accent);
    color: var(--after-ink-on-accent);
    padding: 0.5em 1.1em;
    border-radius: 0.3em;
    font-weight: 700;
    font-size: 0.8em;
    white-space: nowrap;
  }

  .mock-after__hero {
    flex: 1;
    display: flex;
    align-items: center;
    padding: 1em 2em;
    gap: 2em;
    position: relative;
  }

  .mock-after__hero-copy {
    max-width: 26em;
  }

  .mock-after__headline {
    font-weight: 700;
    font-size: 2em;
    line-height: 1.1;
    margin: 0 0 0.4em;
  }

  .mock-after__sub {
    font-family: var(--font-body);
    font-size: 0.95em;
    opacity: 0.9;
    margin: 0 0 0.8em;
    max-width: 24em;
  }

  .mock-after__cta {
    display: inline-block;
    background: var(--after-accent);
    color: var(--after-ink-on-accent);
    padding: 0.5em 1.2em;
    border-radius: 0.3em;
    font-weight: 700;
    font-size: 0.85em;
  }

  .mock-after__hero--split {
    justify-content: space-between;
  }

  .mock-after__art {
    flex-shrink: 0;
    width: 14em;
    height: 14em;
    border-radius: 50%;
    background:
      radial-gradient(circle at 30% 30%, var(--after-accent), transparent 70%),
      conic-gradient(from 90deg, var(--after-accent), transparent, var(--after-fg), transparent);
    opacity: 0.5;
  }

  .mock-after__hero--center {
    flex-direction: column;
    text-align: center;
    justify-content: center;
    background: radial-gradient(
      ellipse at center,
      color-mix(in srgb, var(--after-accent) 20%, transparent),
      transparent 70%
    );
  }

  .mock-after__hero--center .mock-after__hero-copy {
    max-width: 30em;
  }

  .mock-after__hero--center .mock-after__sub {
    max-width: none;
  }

  .mock-after__hero--trust {
    justify-content: space-between;
  }

  .mock-after__quote-panel {
    flex-shrink: 0;
    background: color-mix(in srgb, var(--after-fg) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--after-fg) 20%, transparent);
    border-radius: 0.5em;
    padding: 1.2em;
    width: 14em;
  }

  .mock-after__quote {
    font-style: italic;
    margin: 0 0 0.8em;
    font-size: 0.9em;
  }

  .mock-after__badges {
    display: flex;
    gap: 0.5em;
    flex-wrap: wrap;
  }

  .mock-after__badges span {
    background: var(--after-accent);
    color: var(--after-ink-on-accent);
    font-size: 0.65em;
    font-weight: 700;
    padding: 0.3em 0.6em;
    border-radius: 0.25em;
  }

  .mock-after__cards {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 0.8em;
    padding: 1em 2em 1.5em;
  }

  .mock-after__card {
    background: color-mix(in srgb, var(--after-fg) 6%, transparent);
    border: 1px solid color-mix(in srgb, var(--after-fg) 15%, transparent);
    border-radius: 0.4em;
    padding: 0.8em;
  }

  .mock-after__card--booking {
    background: var(--after-accent);
    color: var(--after-ink-on-accent);
    border-color: transparent;
  }

  .mock-after__card-name {
    font-weight: 700;
    font-size: 0.8em;
    margin: 0 0 0.3em;
  }

  .mock-after__card-price {
    font-size: 0.75em;
    margin: 0;
    color: color-mix(in srgb, var(--after-fg) 85%, var(--after-bg));
  }

  .mock-after__card--booking .mock-after__card-price {
    /* Full-strength ink on the accent background: muting it with opacity or
         color-mix risks dropping below AA on some sector palettes. */
    color: var(--after-ink-on-accent);
  }

  .mock-after__chat-bubble {
    position: absolute;
    bottom: 1.2em;
    right: 1.5em;
    background: var(--after-accent);
    color: var(--after-ink-on-accent);
    border-radius: 1.2em 1.2em 0.2em 1.2em;
    padding: 0.6em 1em;
    font-size: 0.75em;
    font-weight: 600;
    max-width: 12em;
    box-shadow: 0 0.2em 0.6em rgba(0, 0, 0, 0.2);
  }
</style>
