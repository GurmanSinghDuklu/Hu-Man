---
/**
 * The five headline cards (Essential, Start, Launch, Growth and Custom) with a price and a timeline on each.
 * Home page and /pricing show the same cards, read from `tiers` in src/data/pricing.ts
 * (which mirrors docs/02-offer-and-pricing.md). Launch carries "Our pick", never "Most picked".
 */
import { tiers } from '../data/pricing';
import { contactPath } from '../config/links';
import { withBase } from '../config/paths';
---

<ul class="hcards">
  {tiers.map((c, i) => (
    <li class:list={['hcard', `hcard--${c.id}`]} data-reveal style={`--reveal-delay:${i * 0.08}s`}>
      <p class="hcard__name">
        {c.name}
        {c.tag && <span class="hcard__tag">{c.tag}</span>}
      </p>
      <p class="hcard__price">{c.price}</p>
      <p class="hcard__what">{c.what}</p>
      <ul class="hcard__list">
        {c.includes.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
      <p class="hcard__time">{c.timeline}</p>
      <a class="pill-btn hcard__btn" href={withBase(contactPath({ tier: c.name }))}>
        Choose<span class="visually-hidden"> {c.name}</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .hcards {
    display: grid;
    gap: max(12px, calc(var(--u) * 0.2));
  }

  .hcard {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 15rem;
    padding: clamp(1.25rem, calc(var(--u) * 0.3), 1.75rem);
    border: 1px solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .hcard--essential {
    background: var(--paper);
    border-top-left-radius: calc(var(--u) * 0.9);
  }

  .hcard--start {
    background: var(--paper-2);
    border-top-right-radius: calc(var(--u) * 0.9);
  }

  .hcard--launch {
    background: var(--peach);
    border-radius: calc(var(--u) * 1.2) calc(var(--u) * 1.2) 0 0;
    padding-top: clamp(2.25rem, calc(var(--u) * 0.7), 3.5rem);
  }

  .hcard--growth {
    background: var(--grad-lilac);
  }

  .hcard--custom {
    background: var(--ink);
    color: var(--paper);
    border-top-right-radius: calc(var(--u) * 0.9);
  }

  .hcard__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font: 400 0.8125rem var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hcard__tag {
    padding: 0.2rem 0.6rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .hcard__price {
    font: 800 clamp(2.4rem, calc(var(--u) * 0.62), 3.6rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .hcard__what {
    font-size: clamp(0.95rem, calc(var(--u) * 0.165), 1.05rem);
    line-height: 1.4;
  }

  .hcard__list {
    display: grid;
    gap: 0.35rem;
    font-size: clamp(0.85rem, calc(var(--u) * 0.15), 0.95rem);
    line-height: 1.35;
  }

  .hcard__list li {
    position: relative;
    padding-left: 1rem;
  }

  .hcard__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4rem;
    height: 1.5px;
    background: currentColor;
  }

  .hcard__what {
    font-weight: 700;
  }

  .hcard__btn {
    align-self: flex-start;
    margin-top: 0.5rem;
  }

  .hcard--launch .hcard__btn {
    border-color: var(--ink);
  }

  .hcard--custom .hcard__btn {
    border-color: var(--paper);
  }

  .hcard__time {
    margin-top: auto;
    padding-top: 0.75rem;
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  @media (min-width: 40rem) {
    .hcards {
      grid-template-columns: repeat(2, 1fr);
    }

    /* Five cards in two columns: the last one spans so no card sits alone beside a gap. */
    .hcard:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .hcards {
      grid-template-columns: repeat(5, 1fr);
    }

    .hcard:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .hcard {
      min-height: calc(var(--u) * 3.2);
    }

    .hcard__name,
    .hcard__btn {
      align-self: flex-start;
      margin-top: 0.5rem;
    }

    .hcard--launch .hcard__btn {
      border-color: var(--ink);
    }

    .hcard--custom .hcard__btn {
      border-color: var(--paper);
    }

    .hcard__time {
      font-size: calc(var(--u) * 0.115);
    }

    .hcard__tag {
      font-size: calc(var(--u) * 0.095);
    }
  }
</style>
