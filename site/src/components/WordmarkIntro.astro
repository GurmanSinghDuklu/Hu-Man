---
/**
 * Hero wordmark animation. The separator between HU and MAN cycles through
 * brand variants (Hu/Man, Hu.Man, Hu*Man...), slows like a slot machine,
 * lands on one, then vanishes as HU and MAN close up and turn extra bold.
 * Pure CSS/JS (no video file): sharp at any size, ~1 kB. Decorative:
 * the heading below carries the meaning. Driven by scripts/wordmark-intro.ts.
 */
---

<div class="wm" aria-hidden="true" data-wordmark>
  <p class="wm__word">
    <span class="wm__part">HU</span>
    <span class="wm__slot">
      <span class="wm__sep" data-wordmark-sep>
        /
      </span>
    </span>
    <span class="wm__part">MAN</span>
  </p>
</div>

<script>
  import '../scripts/wordmark-intro.ts';
</script>

<style>
  /* Size container: the word scales to the width of the hero column. */
  .wm {
    container-type: inline-size;
    margin-block: clamp(0.5rem, 2vw, 1.25rem) clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .wm__word {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: baseline;
    font-size: min(22cqw, 30svh);
    line-height: 0.82;
    font-weight: 560;
    letter-spacing: -0.05em;
    color: #fff;
    white-space: nowrap;
    transition:
      font-weight 1.1s var(--ease-out),
      letter-spacing 1.1s var(--ease-out);
  }

  .wm__part {
    display: inline-block;
    background: linear-gradient(180deg, #ffffff 30%, #c9cdd3 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.05em;
    transition: filter 1.1s var(--ease-out);
  }

  /* Fixed-width slot so the word never jitters while glyphs change. */
  .wm__slot {
    display: inline-flex;
    justify-content: center;
    width: 0.62em;
    overflow: visible;
    transition:
      width 0.9s var(--ease-out) 0.15s,
      margin 0.9s var(--ease-out) 0.15s;
  }

  .wm__sep {
    display: inline-block;
    color: var(--neon);
    font-weight: inherit;
    filter: drop-shadow(0 0 0.12em rgba(0, 255, 48, 0.55));
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.4s var(--ease-out),
      filter 0.4s var(--ease-out);
  }

  .wm__sep.is-tick {
    animation: tick 0.18s var(--ease-out);
  }

  @keyframes tick {
    from {
      transform: translateY(-0.18em) scale(0.8);
      opacity: 0.4;
    }
  }

  .wm.is-landed .wm__sep {
    filter: drop-shadow(0 0 0.3em rgba(0, 255, 48, 0.95));
  }

  /* Final state: separator gone, gap closed, extra bold. */
  .wm.is-merged .wm__slot {
    width: 0;
    margin-inline: -0.01em;
  }

  .wm.is-merged .wm__sep {
    transform: scale(0.1) rotate(90deg);
    opacity: 0;
  }

  .wm.is-merged .wm__word {
    font-weight: 800;
    letter-spacing: -0.065em;
  }

  .wm.is-merged .wm__part {
    filter: drop-shadow(0 0 0.35em rgba(0, 255, 48, 0.18));
  }

  @media (prefers-reduced-motion: reduce) {
    .wm__word,
    .wm__slot,
    .wm__sep,
    .wm__part {
      transition: none;
    }
  }
</style>
