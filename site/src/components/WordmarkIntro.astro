---
/**
 * Hero wordmark loop. The separator between HU and MAN steps through brand
 * variants (Hu.Man, Hu*Man, Hu_Man...), ~2 s each, then settles on "/" as the
 * gap tightens and the word turns extra bold and sweeps from white to neon
 * green (HU/MAN); then it reopens on the first separator and repeats.
 * Pure CSS/JS (no video file): sharp at any size, ~1 kB. Decorative:
 * the heading below carries the meaning. Driven by scripts/wordmark-intro.ts.
 */
---

<div class="wm" aria-hidden="true" data-wordmark>
  <p class="wm__word">
    <span class="wm__part">HU</span>
    <span class="wm__slot">
      <span class="wm__sep" data-wordmark-sep>
        /
      </span>
    </span>
    <span class="wm__part">MAN</span>
  </p>
</div>

<script>
  import '../scripts/wordmark-intro.ts';
</script>

<style>
  /* Size container: the word scales to the width of the hero column. */
  .wm {
    container-type: inline-size;
    margin-block: clamp(0.5rem, 2vw, 1.25rem) clamp(1.75rem, 3.5vw, 2.5rem);
  }

  .wm__word {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: baseline;
    font-size: min(22cqw, 30svh);
    line-height: 0.82;
    font-weight: 560;
    letter-spacing: -0.05em;
    color: #fff;
    white-space: nowrap;
    transition:
      font-weight 1.2s var(--ease-out),
      letter-spacing 1.2s var(--ease-out);
  }

  /* Top half white, bottom half neon; sliding the background swaps colour. */
  .wm__part {
    display: inline-block;
    background-image: linear-gradient(
      180deg,
      #ffffff 0%,
      #c9cdd3 50%,
      var(--acid) 50%,
      var(--neon) 100%
    );
    background-size: 100% 200%;
    background-position: 0 0;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.05em;
    transition:
      background-position 1.2s var(--ease-out),
      filter 1.2s var(--ease-out);
  }

  /* Fixed-width slot so the word never jitters while glyphs change. */
  .wm__slot {
    display: inline-flex;
    justify-content: center;
    width: 0.62em;
    overflow: visible;
    transition:
      width 0.9s var(--ease-out) 0.15s,
      margin 0.9s var(--ease-out) 0.15s;
  }

  .wm__sep {
    display: inline-block;
    color: var(--neon);
    font-weight: inherit;
    filter: drop-shadow(0 0 0.12em rgba(0, 255, 48, 0.55));
    transition:
      transform 0.5s var(--ease-out),
      opacity 0.4s var(--ease-out),
      filter 0.4s var(--ease-out);
  }

  /* Separator swap: slide up and out, new glyph drops back in. */
  .wm__sep.is-out {
    transform: translateY(-0.25em);
    opacity: 0;
    transition-duration: 0.26s;
  }

  /* Final state: separator gone, gap closed, extra bold. */
  /* Final state: "/" tightens into the word, bold, same green as the letters. */
  .wm.is-merged .wm__slot {
    width: 0.46em;
  }

  .wm.is-merged .wm__sep {
    color: transparent;
    background-image: linear-gradient(180deg, var(--acid), var(--neon));
    -webkit-background-clip: text;
    background-clip: text;
    filter: drop-shadow(0 0 0.3em rgba(0, 255, 48, 0.3));
  }

  .wm.is-merged .wm__word {
    font-weight: 800;
    letter-spacing: -0.065em;
  }

  .wm.is-merged .wm__part {
    background-position: 0 100%;
    filter: drop-shadow(0 0 0.3em rgba(0, 255, 48, 0.3));
  }

  @media (prefers-reduced-motion: reduce) {
    .wm__word,
    .wm__slot,
    .wm__sep,
    .wm__part {
      transition: none;
    }
  }
</style>
