---
/**
 * Hero wordmark, modelled on the Spider-Verse opening logos. HU/MAN jumps
 * through 20 "alternate universes", one a second: each has its own typeface,
 * treatment, background world (comic dots, Marvel-red rays, paper, lens flare,
 * neon grid...) and camera (close-up crops, tilts). Between them it glitches:
 * halftone plates slip, strips tear, colour bars datamosh across the frame, a
 * light streak smears it, all stuttering at ~12 fps. Then it glitches back to
 * the brand logo on the plain hero and holds it, clean, for ~30 s.
 *
 * The background bleeds to the edges of the hero as a full-width band. Fonts
 * are self-hosted (Plus Jakarta Sans, Newsreader) or common system faces with
 * generic fallbacks, so no extra downloads; each universe also differs in
 * fill, background and framing, so it still reads as new if a font is missing.
 * The script scales each version to fit the column.
 *
 * Only transforms and opacity change per frame; every clip-path is static.
 * Decorative: the heading below carries the meaning. Driven by
 * scripts/wordmark-intro.ts.
 */

interface Universe {
  font: string;
  weight?: number;
  italic?: boolean;
  tracking?: string;
  case?: 'uppercase' | 'lowercase' | 'none';
  fill: string; // CSS background, clipped to the text
  stroke?: string; // -webkit-text-stroke
  sep?: string; // separate colour for the slash
  effect?: string; // filter
  stretch?: number; // vertical stretch
  bg?: string; // background of the full-width band
  cam?: { zoom?: number; x?: string; y?: string; tilt?: string }; // framing
  echo?: boolean; // outlined copies stacked out of register
}

const JAKARTA = "'Plus Jakarta Sans Variable', system-ui, sans-serif";
const solid = (c: string) => `linear-gradient(${c}, ${c})`;
const WHITE = solid('#fff');
const INK = solid('#07080a');
const NEON = solid('#00ff30');
const ACID = solid('#adff00');
const BRAND = 'linear-gradient(180deg, #adff00, #00ff30)';

// Background worlds, all drawn in CSS.
const BG = {
  black: '#07080a',
  sunset: 'linear-gradient(180deg, #2c2f7a 0%, #7c5aa6 45%, #e0896b 80%, #f3c48f 100%)',
  grid: 'linear-gradient(rgba(0, 255, 48, 0.16) 1px, transparent 1px) 0 0 / 28px 28px, linear-gradient(90deg, rgba(0, 255, 48, 0.16) 1px, transparent 1px) 0 0 / 28px 28px, #07080a',
  rays: 'repeating-conic-gradient(from 0deg at 50% 50%, #d0142f 0 5deg, #a80f26 5deg 10deg)',
  comic:
    'radial-gradient(circle, #ff4d1a 0 32%, transparent 36%) 0 0 / 16px 16px, linear-gradient(135deg, #ffb000, #ff7a00)',
  paper:
    'radial-gradient(circle, rgba(90, 50, 20, 0.12) 0 20%, transparent 24%) 0 0 / 7px 7px, radial-gradient(ellipse at 50% 50%, #f5e6cc 0%, #dcbc8c 70%, #a97a4b 100%)',
  violet: 'linear-gradient(120deg, #5b21b6, #db2777)',
  storm:
    'radial-gradient(circle, rgba(255, 255, 255, 0.22) 0 30%, transparent 34%) 0 0 / 9px 9px, linear-gradient(180deg, #16181c, #4b4f57)',
  flare:
    'linear-gradient(180deg, transparent 48.5%, rgba(255, 255, 255, 0.95) 50%, transparent 51.5%), radial-gradient(ellipse 70% 120% at 50% 50%, #e3f1ff 0%, #6a9be0 35%, #0d1d40 80%)',
  teal: '#2de2d0',
  disc: 'radial-gradient(circle closest-side at 50% 50%, #ffe600 0 45%, #1d4ed8 46% 99%, transparent 100%), radial-gradient(circle, #00ff30 0 26%, transparent 30%) 0 0 / 22px 22px, #07080a',
  cmy: 'radial-gradient(circle, #00e5ff 0 26%, transparent 30%) 0 0 / 18px 18px, radial-gradient(circle, #ff2bd6 0 26%, transparent 30%) 6px 6px / 18px 18px, radial-gradient(circle, #ffe600 0 26%, transparent 30%) 12px 12px / 18px 18px, #f6f2ea',
  graffiti:
    'linear-gradient(160deg, transparent 0 55%, rgba(139, 92, 246, 0.55) 55% 57%, transparent 57%), linear-gradient(20deg, transparent 0 30%, rgba(0, 229, 255, 0.35) 30% 31%, transparent 31%), radial-gradient(circle, rgba(255, 255, 255, 0.06) 0 25%, transparent 30%) 0 0 / 5px 5px, #1c1c22',
  acid: '#adff00',
};

const UNIVERSES: Universe[] = [
  {
    font: "'Newsreader Variable', Georgia, serif",
    weight: 300,
    italic: true,
    tracking: '-0.03em',
    case: 'none',
    fill: WHITE,
    sep: '#adff00',
    effect: 'drop-shadow(0 0.03em 0 rgba(20, 10, 40, 0.45))',
    bg: BG.sunset,
  },
  {
    font: "Menlo, Consolas, 'Courier New', monospace",
    weight: 700,
    tracking: '-0.02em',
    case: 'lowercase',
    fill: NEON,
    effect: 'drop-shadow(0 0 0.12em rgba(0, 255, 48, 0.6))',
    bg: BG.grid,
  },
  {
    font: "'Helvetica Neue', Arial, sans-serif",
    weight: 700,
    fill: 'none',
    stroke: '0.012em #fff',
    bg: BG.black,
    echo: true,
  },
  {
    font: "Impact, Haettenschweiler, 'Arial Narrow Bold', sans-serif",
    weight: 400,
    tracking: '0',
    fill: WHITE,
    bg: BG.rays,
    cam: { zoom: 1.12 },
  },
  {
    font: "Didot, 'Bodoni 72', 'Bodoni MT', 'Times New Roman', serif",
    weight: 400,
    tracking: '0.06em',
    fill: WHITE,
    sep: '#00ff30',
    bg: BG.black,
    cam: { zoom: 2.3, x: '1.5em', y: '0.04em' },
  },
  {
    font: "'Comic Sans MS', 'Chalkboard SE', 'Comic Neue', cursive",
    weight: 700,
    tracking: '-0.02em',
    case: 'none',
    fill: WHITE,
    stroke: '0.012em #07080a',
    effect: 'drop-shadow(0.05em 0.05em 0 #ff2bd6)',
    bg: BG.comic,
    cam: { tilt: '-5deg' },
  },
  {
    font: "'American Typewriter', 'Courier New', Courier, monospace",
    weight: 400,
    tracking: '-0.02em',
    case: 'none',
    fill: solid('#2b1a10'),
    sep: '#d62828',
    bg: BG.paper,
    cam: { tilt: '3deg', zoom: 1.05 },
  },
  {
    font: "'Snell Roundhand', 'Brush Script MT', 'Segoe Script', cursive",
    weight: 700,
    tracking: '0',
    case: 'none',
    fill: BRAND,
    sep: '#fff',
    bg: BG.violet,
  },
  {
    font: "Copperplate, 'Copperplate Gothic Bold', 'Engravers MT', serif",
    weight: 700,
    tracking: '0.08em',
    fill: 'linear-gradient(180deg, #ffffff, #b9c0c8)',
    stroke: '0.004em #16181c',
    sep: '#adff00',
    bg: BG.storm,
  },
  {
    font: "Futura, 'Century Gothic', 'Avenir Next', sans-serif",
    weight: 500,
    tracking: '-0.04em',
    case: 'lowercase',
    fill: INK,
    bg: BG.flare,
  },
  {
    font: JAKARTA,
    weight: 200,
    tracking: '0.18em',
    fill: WHITE,
    sep: '#00ff30',
    bg: BG.black,
    cam: { zoom: 2.2, x: '-1.6em', y: '-0.03em' },
  },
  {
    font: JAKARTA,
    weight: 800,
    italic: true,
    tracking: '-0.05em',
    fill: 'linear-gradient(180deg, #fff 0%, #9aa3ad 45%, #2b3138 50%, #e6eaee 56%, #7d8690 100%)',
    bg: BG.black,
    cam: { tilt: '-4deg' },
  },
  {
    font: "'Arial Black', 'Helvetica Neue', Arial, sans-serif",
    weight: 900,
    tracking: '-0.04em',
    fill: 'radial-gradient(circle, #d9d9d9 0 45%, transparent 50%) 0 0 / 0.05em 0.05em',
    bg: BG.black,
    cam: { zoom: 1.6, x: '0.6em' },
  },
  {
    font: "Rockwell, 'Rockwell Extra Bold', 'Roboto Slab', serif",
    weight: 700,
    tracking: '-0.01em',
    fill: INK,
    bg: BG.teal,
  },
  {
    font: "'Arial Rounded MT Bold', ui-rounded, Nunito, sans-serif",
    weight: 700,
    tracking: '-0.03em',
    case: 'lowercase',
    fill: solid('#ff2a2a'),
    stroke: '0.01em #fff',
    bg: BG.disc,
  },
  {
    font: 'Menlo, Consolas, monospace',
    weight: 700,
    tracking: '0.04em',
    fill: 'repeating-linear-gradient(180deg, #00ff30 0 0.03em, transparent 0.03em 0.05em)',
    bg: BG.black,
    cam: { zoom: 1.9, x: '-0.9em', tilt: '2deg' },
  },
  {
    font: 'Georgia, serif',
    weight: 700,
    italic: true,
    tracking: '-0.03em',
    case: 'none',
    fill: INK,
    sep: '#ff2bd6',
    bg: BG.cmy,
  },
  {
    font: "'Avenir Next Condensed', 'Arial Narrow', sans-serif-condensed, sans-serif",
    weight: 800,
    tracking: '-0.02em',
    fill: ACID,
    stroke: '0.008em #8b5cf6',
    stretch: 1.3,
    bg: BG.graffiti,
  },
  {
    font: "'Marker Felt', 'Permanent Marker', 'Segoe Print', fantasy",
    weight: 700,
    tracking: '-0.02em',
    case: 'none',
    fill: INK,
    bg: BG.acid,
    cam: { tilt: '-3deg' },
  },
  {
    font: "'Times New Roman', Times, serif",
    weight: 700,
    italic: true,
    tracking: '-0.02em',
    fill: 'linear-gradient(90deg, #00e5ff, #ff2bd6, #ffe600, #00ff30)',
    bg: BG.black,
    echo: true,
    cam: { zoom: 1.15, tilt: '3deg' },
  },
];

const universeCss = UNIVERSES.map((u, i) => {
  const sel = `.wm[data-style='${i + 1}']`;
  const vars = [
    `--ff: ${u.font}`,
    `--fw: ${u.weight ?? 800}`,
    `--fs: ${u.italic ? 'italic' : 'normal'}`,
    `--tr: ${u.tracking ?? '-0.04em'}`,
    `--tt: ${u.case ?? 'uppercase'}`,
    `--fill: ${u.fill}`,
    `--stroke: ${u.stroke ?? '0 transparent'}`,
    `--sep: ${u.sep ?? 'transparent'}`,
    `--fx: ${u.effect ?? 'none'}`,
    `--stretch: ${u.stretch ?? 1}`,
    `--bg: ${u.bg ?? 'transparent'}`,
    `--cam: ${u.cam?.zoom ?? 1}`,
    `--camx: ${u.cam?.x ?? '0em'}`,
    `--camy: ${u.cam?.y ?? '0em'}`,
    `--tilt: ${u.cam?.tilt ?? '0deg'}`,
  ];
  const echo = u.echo
    ? `${sel}:not(.is-glitch) .wm__plate { opacity: 1; mix-blend-mode: normal; }
${sel} .wm__plate .wm__inner { background: none; -webkit-text-stroke: 0.008em var(--ink); }
${sel} .wm__plate--c { translate: -0.05em -0.09em; }
${sel} .wm__plate--m { translate: 0.05em 0.09em; }
${sel} .wm__plate--y { translate: 0.1em 0.18em; }`
    : '';
  return `${sel} { ${vars.join('; ')}; }\n${echo}`;
}).join('\n');

// Horizontal strips (top %, bottom %) that tile the word. During a glitch the
// clean base layer hides and these strips shift independently.
const STRIPS: [number, number][] = [
  [0, 16],
  [16, 29],
  [29, 47],
  [47, 58],
  [58, 76],
  [76, 88],
  [88, 100],
];
const PLATES = ['c', 'm', 'y'] as const;
---

<div class="wm" aria-hidden="true" data-wordmark data-styles={UNIVERSES.length}>
  <div class="wm__bg"></div>
  <div class="wm__stage">
    {PLATES.map((p) => (
      <p class={`wm__word wm__plate wm__plate--${p}`}>
        <span class="wm__inner">
          Hu<span class="wm__sep">/</span>Man
        </span>
      </p>
    ))}
    <p class="wm__word wm__base">
      <span class="wm__inner" data-wordmark-measure>
        Hu<span class="wm__sep">/</span>Man
      </span>
    </p>
    {STRIPS.map(([top, bottom]) => (
      <p
        class="wm__word wm__strip"
        style={`clip-path: inset(${top}% 0 ${100 - bottom}% 0)`}
        data-wordmark-strip
      >
        <span class="wm__inner">
          Hu<span class="wm__sep">/</span>Man
        </span>
      </p>
    ))}
  </div>
  <div class="wm__bars" data-wordmark-bars></div>
  <div class="wm__streak"></div>
</div>

<style is:global set:html={universeCss}></style>

<script>
  import '../scripts/wordmark-intro.ts';
</script>

<style>
  /* A full-width band (the "screen") that clips close-up crops. Negative
     margins pull it to the viewport edges and matching padding keeps its
     content box, and so the word size, at the hero column width. */
  .wm {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    margin: 0 calc(50% - 50vw) clamp(0.75rem, 2vw, 1.25rem);
    padding: clamp(1.25rem, 4vw, 2.75rem) calc(50vw - 50%);
    overflow: clip;
    /* Brand logo (no data-style): bold green HU/MAN on the plain hero. */
    --ff: 'Plus Jakarta Sans Variable', system-ui, sans-serif;
    --fw: 800;
    --fs: normal;
    --tr: -0.065em;
    --tt: uppercase;
    --fill: linear-gradient(180deg, var(--acid), var(--neon));
    --stroke: 0 transparent;
    --sep: transparent;
    --fx: drop-shadow(0 0 0.3em rgba(0, 255, 48, 0.3));
    --stretch: 1;
    --bg: transparent;
    --cam: 1;
    --camx: 0em;
    --camy: 0em;
    --tilt: 0deg;
    --fit: 1;
    /* Per-frame glitch offsets, written by the script. */
    --jx: 0em;
    --jy: 0em;
    --sk: 0deg;
    --sx: 1;
    --sy: 1;
    --zp: 1;
    --ps: 1;
    --cx: 0em;
    --cy: 0em;
    --mx: 0em;
    --my: 0em;
    --yx: 0em;
    --yy: 0em;
  }

  .wm__bg,
  .wm__bars,
  .wm__streak {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .wm__bg {
    z-index: 0;
    background: var(--bg);
  }

  /* Fixed height, so swapping universes never shifts the page below. */
  .wm__stage {
    position: relative;
    z-index: 1;
    isolation: isolate;
    height: 0.82em;
    font-size: min(22cqw, 30svh);
    transform: translate(calc(var(--jx) + var(--camx)), calc(var(--jy) + var(--camy)))
      rotate(var(--tilt)) skewX(var(--sk))
      scale(calc(var(--sx) * var(--cam) * var(--zp)), calc(var(--sy) * var(--cam) * var(--zp)));
  }

  /* Print scanlines over the word, only during a glitch. */
  .wm__stage::after {
    content: '';
    position: absolute;
    inset: -0.05em -0.1em;
    background: repeating-linear-gradient(180deg, rgba(7, 8, 10, 0.55) 0 2px, transparent 2px 5px);
    opacity: 0;
    pointer-events: none;
  }

  /* Datamosh: vertical colour bars smeared across the frame. */
  .wm__bars {
    z-index: 2;
    background: repeating-linear-gradient(
      90deg,
      #ff2bd6 0 2.5%,
      transparent 2.5% 4%,
      #00e5ff 4% 5.5%,
      #ffe600 5.5% 8%,
      transparent 8% 11%,
      #00ff30 11% 12.5%,
      transparent 12.5% 17%,
      #ffffff 17% 17.6%,
      transparent 17.6% 21%
    );
    mix-blend-mode: screen;
    opacity: 0;
  }

  /* Lens streak: a hot horizontal line through the middle of the band. */
  .wm__streak {
    z-index: 2;
    background:
      linear-gradient(180deg, transparent 47%, #fff 50%, transparent 53%),
      radial-gradient(ellipse 60% 18% at 50% 50%, rgba(160, 220, 255, 0.85), transparent 70%);
    opacity: 0;
  }

  /* Every layer is the same word, centred in a box taller than the stage so
     strip clipping never cuts off tall or low glyphs. */
  .wm__word {
    position: absolute;
    inset: -0.3em 0;
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    white-space: nowrap;
  }

  .wm__inner {
    display: inline-block;
    padding-inline: 0.04em;
    font-family: var(--ff);
    font-weight: var(--fw);
    font-style: var(--fs);
    letter-spacing: var(--tr);
    text-transform: var(--tt);
    line-height: 1;
    background: var(--fill);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-stroke: var(--stroke);
    filter: var(--fx);
    transform: scale(var(--fit), calc(var(--fit) * var(--stretch)));
  }

  .wm__sep {
    color: var(--sep);
  }

  .wm__base,
  .wm__strip {
    z-index: 2;
  }

  .wm__strip {
    opacity: 0;
  }

  /* Colour plates: halftone dots in one ink each, only seen while glitching
     (or as outlined echoes in some universes). */
  .wm__plate {
    z-index: 1;
    mix-blend-mode: screen;
    opacity: 0;
  }

  .wm__plate .wm__inner {
    background: radial-gradient(circle, var(--ink) 0 46%, transparent 52%) 0 0 / 0.04em 0.04em;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-stroke: 0 transparent;
    filter: none;
  }

  .wm__plate .wm__sep {
    color: transparent;
  }

  .wm__plate--c {
    --ink: #00e5ff;
    transform: translate(var(--cx), var(--cy)) scale(var(--ps));
  }

  .wm__plate--m {
    --ink: #ff2bd6;
    transform: translate(var(--mx), var(--my)) scale(var(--ps));
  }

  .wm__plate--y {
    --ink: var(--acid);
    transform: translate(var(--yx), var(--yy)) scale(var(--ps));
  }

  /* Glitching: strips replace the clean layer, plates fully inked. */
  .wm.is-glitch .wm__base {
    opacity: 0;
  }

  .wm.is-glitch .wm__strip,
  .wm.is-glitch .wm__plate,
  .wm.is-glitch .wm__stage::after {
    opacity: 1;
  }

  /* Effect variants: dots only, tears without the plates, outlined echoes,
     colour bars, light streak. */
  .wm[data-fx='plates'].is-glitch .wm__strip {
    opacity: 0;
  }

  .wm[data-fx='clean'].is-glitch .wm__plate {
    opacity: 0;
  }

  .wm[data-fx='echo'].is-glitch .wm__plate {
    mix-blend-mode: normal;
  }

  .wm[data-fx='echo'].is-glitch .wm__plate .wm__inner {
    background: none;
    -webkit-text-stroke: 0.008em var(--ink);
  }

  .wm[data-bars] .wm__bars {
    opacity: 0.85;
  }

  .wm[data-fx='streak'].is-glitch .wm__streak {
    opacity: 1;
  }
</style>
