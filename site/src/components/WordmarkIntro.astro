---
/**
 * Hero wordmark, Spider-Verse misprint style. HU?MAN sits in white with an
 * alternate separator (Hu.Man, Hu*Man...), then glitches: halftone colour
 * plates (cyan, magenta, acid) slip out of register, horizontal strips tear
 * sideways and the frame stutters at ~12 fps, before it snaps into the bold
 * green brand form HU/MAN. A short glitch takes it back to white on the next
 * separator, and it repeats.
 *
 * Pure CSS/JS (no video file): sharp at any size, ~2 kB. Only transforms and
 * opacity change per frame; every clip-path is static. Decorative: the heading
 * below carries the meaning. Driven by scripts/wordmark-intro.ts.
 */

// Horizontal strips (top %, bottom %) that tile the word. During a glitch the
// clean base layer hides and these strips shift independently.
const STRIPS: [number, number][] = [
  [0, 16],
  [16, 29],
  [29, 47],
  [47, 58],
  [58, 76],
  [76, 88],
  [88, 100],
];
const PLATES = ['c', 'm', 'y'] as const;
---

<div class="wm" aria-hidden="true" data-wordmark>
  <div class="wm__stage">
    {PLATES.map((p) => (
      <p class={`wm__word wm__plate wm__plate--${p}`} data-wordmark-plate>
        <span class="wm__part">HU</span>
        <span class="wm__slot">
          <span class="wm__sep" data-wordmark-sep>
            /
          </span>
        </span>
        <span class="wm__part">MAN</span>
      </p>
    ))}
    <p class="wm__word wm__base">
      <span class="wm__part">HU</span>
      <span class="wm__slot">
        <span class="wm__sep" data-wordmark-sep>
          /
        </span>
      </span>
      <span class="wm__part">MAN</span>
    </p>
    {STRIPS.map(([top, bottom]) => (
      <p
        class="wm__word wm__strip"
        style={`clip-path: inset(${top}% 0 ${100 - bottom}% 0)`}
        data-wordmark-strip
      >
        <span class="wm__part">HU</span>
        <span class="wm__slot">
          <span class="wm__sep" data-wordmark-sep>
            /
          </span>
        </span>
        <span class="wm__part">MAN</span>
      </p>
    ))}
  </div>
</div>

<script>
  import '../scripts/wordmark-intro.ts';
</script>

<style>
  /* Size container: the word scales to the width of the hero column. */
  .wm {
    container-type: inline-size;
    margin-block: clamp(0.5rem, 2vw, 1.25rem) clamp(1.75rem, 3.5vw, 2.5rem);
    /* Per-frame offsets, written by the script. */
    --jx: 0em;
    --jy: 0em;
    --sk: 0deg;
    --sy: 1;
    --cx: 0.012em;
    --cy: 0em;
    --mx: -0.012em;
    --my: 0.006em;
    --yx: 0em;
    --yy: -0.008em;
  }

  .wm__stage {
    position: relative;
    isolation: isolate;
    font-size: min(22cqw, 30svh);
    transform: translate(var(--jx), var(--jy)) skewX(var(--sk)) scaleY(var(--sy));
  }

  /* Print scanlines over the stage, only during a glitch. */
  .wm__stage::after {
    content: '';
    position: absolute;
    inset: -0.05em -0.1em;
    background: repeating-linear-gradient(180deg, rgba(7, 8, 10, 0.55) 0 2px, transparent 2px 5px);
    opacity: 0;
    pointer-events: none;
  }

  .wm__word {
    margin: 0;
    display: flex;
    justify-content: center;
    align-items: baseline;
    font-size: 1em;
    line-height: 0.82;
    font-weight: 560;
    letter-spacing: -0.05em;
    white-space: nowrap;
  }

  /* Clean layer: white over a faint Ben-Day dot texture. */
  .wm__base,
  .wm__strip {
    position: relative;
    z-index: 2;
  }

  .wm__base .wm__part,
  .wm__strip .wm__part {
    display: inline-block;
    background-image:
      radial-gradient(circle, rgba(7, 8, 10, 0.22) 0 28%, transparent 33%),
      linear-gradient(180deg, #ffffff 0%, #c9cdd3 100%);
    background-size:
      0.045em 0.045em,
      100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.05em;
  }

  .wm__base .wm__sep,
  .wm__strip .wm__sep {
    color: var(--neon);
  }

  .wm__strip {
    position: absolute;
    inset: 0;
    opacity: 0;
  }

  /* Colour plates: halftone dots in one ink each, slightly off register. */
  .wm__plate {
    position: absolute;
    inset: 0;
    z-index: 1;
    mix-blend-mode: screen;
    opacity: 0.55;
  }

  .wm__plate .wm__part,
  .wm__plate .wm__sep {
    display: inline-block;
    background-image: radial-gradient(circle, var(--ink) 0 46%, transparent 52%);
    background-size: 0.04em 0.04em;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.05em;
  }

  .wm__plate--c {
    --ink: #00e5ff;
    transform: translate(var(--cx), var(--cy));
  }

  .wm__plate--m {
    --ink: #ff2bd6;
    transform: translate(var(--mx), var(--my));
  }

  .wm__plate--y {
    --ink: var(--acid);
    transform: translate(var(--yx), var(--yy));
  }

  /* Fixed-width slot so the word never jitters while glyphs change. */
  .wm__slot {
    display: inline-flex;
    justify-content: center;
    width: 0.62em;
  }

  .wm__sep {
    display: inline-block;
  }

  /* Glitching: strips replace the clean layer, plates fully inked. */
  .wm.is-glitch .wm__base {
    opacity: 0;
  }

  .wm.is-glitch .wm__strip,
  .wm.is-glitch .wm__plate,
  .wm.is-glitch .wm__stage::after {
    opacity: 1;
  }

  /* Brand state: bold green HU/MAN, slash tightened into the word. */
  .wm.is-merged .wm__word {
    font-weight: 800;
    letter-spacing: -0.065em;
  }

  .wm.is-merged .wm__slot {
    width: 0.46em;
  }

  .wm.is-merged .wm__base .wm__part,
  .wm.is-merged .wm__strip .wm__part,
  .wm.is-merged .wm__base .wm__sep,
  .wm.is-merged .wm__strip .wm__sep {
    background-image:
      radial-gradient(circle, rgba(7, 8, 10, 0.18) 0 28%, transparent 33%),
      linear-gradient(180deg, var(--acid), var(--neon));
    background-size:
      0.045em 0.045em,
      100% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .wm.is-merged .wm__base {
    filter: drop-shadow(0 0 0.3em rgba(0, 255, 48, 0.3));
  }

  .wm.is-merged:not(.is-glitch) .wm__plate {
    opacity: 0.35;
  }

  @media (prefers-reduced-motion: reduce) {
    .wm__plate {
      display: none;
    }
  }
</style>
