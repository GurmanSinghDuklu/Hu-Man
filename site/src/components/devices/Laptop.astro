---
/** Laptop frame. The screen is ~97em wide; size screen content in em. */
interface Props {
  class?: string;
  style?: string;
  bg?: string;
  fg?: string;
  silver?: boolean;
}
const { class: className = '', style = '', bg = '#fff', fg = '#111', silver = false } = Astro.props;
---

<div class:list={['dev-laptop', { 'dev-laptop--silver': silver }, className]} style={style}>
  <div class="dev-laptop__body">
    <div class="dev-laptop__lid">
      <div class="dev-laptop__screen" style={`--scr-bg:${bg};--scr-fg:${fg}`}>
        <slot />
      </div>
    </div>
    <div class="dev-laptop__base"></div>
  </div>
</div>
