---
/**
 * Sign in or create an account, in one panel (script: src/scripts/account/auth-panel.ts). Used two
 * ways: `dialog` on /contact/, opened when someone sends the portfolio form while logged out (their
 * answers stay on the page underneath), and `inline` on /login/. Views: create an account, log in,
 * the emailed 6-digit code, forgotten password. The panel is always light, whatever the page.
 */
interface Props {
  mode?: 'dialog' | 'inline';
  /** Which view opens first. */
  start?: 'signup' | 'login';
}
const { mode = 'inline', start = 'signup' } = Astro.props;
const Tag = mode === 'dialog' ? 'dialog' : 'div';
---

<Tag
  class:list={['auth', `auth--${mode}`]}
  data-auth
  data-auth-start={start}
  aria-labelledby="auth-title"
>
  {mode === 'dialog' && (
    <button type="button" class="auth__close" data-auth-close aria-label="Close">
      ×
    </button>
  )}
  <h2 class="auth__title" id="auth-title" tabindex="-1" data-auth-title>
    Create your account
  </h2>
  <p class="auth__lede" data-auth-lede>
    So you can see your request, your portfolio and anything we send back.
  </p>
  <p class="auth__status" role="status" aria-live="polite" data-auth-status></p>

  <form class="auth__form" data-auth-view="signup" novalidate>
    <div class="auth__field" data-field="name">
      <label for="auth-name">Your name</label>
      <input id="auth-name" name="name" autocomplete="name" required maxlength="100" />
      <p class="auth__error" data-error-for="name"></p>
    </div>
    <div class="auth__field" data-field="email">
      <label for="auth-email">Email</label>
      <input
        id="auth-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        maxlength="200"
      />
      <p class="auth__error" data-error-for="email"></p>
    </div>
    <div class="auth__field" data-field="password">
      <label for="auth-password">Choose a password</label>
      <input
        id="auth-password"
        name="password"
        type="password"
        autocomplete="new-password"
        required
        minlength="10"
        maxlength="200"
        aria-describedby="auth-password-hint"
      />
      <p class="auth__hint" id="auth-password-hint">
        At least 10 characters.
      </p>
      <p class="auth__error" data-error-for="password"></p>
    </div>
    <button class="auth__go" type="submit">
      Create my account
    </button>
    <p class="auth__switch">
      Already have an account?{' '}
      <button type="button" data-auth-show="login">
        Log in
      </button>
    </p>
  </form>

  <form class="auth__form" data-auth-view="login" novalidate hidden>
    <div class="auth__field">
      <label for="auth-login-email">Email</label>
      <input
        id="auth-login-email"
        name="email"
        type="email"
        autocomplete="username"
        inputmode="email"
        required
        maxlength="200"
      />
    </div>
    <div class="auth__field">
      <label for="auth-login-password">Password</label>
      <input
        id="auth-login-password"
        name="password"
        type="password"
        autocomplete="current-password"
        required
        maxlength="200"
      />
    </div>
    <button class="auth__go" type="submit">
      Log in
    </button>
    <p class="auth__switch">
      <button type="button" data-auth-show="forgot">
        Forgotten your password?
      </button>
    </p>
    <p class="auth__switch">
      New here?{' '}
      <button type="button" data-auth-show="signup">
        Create an account
      </button>
    </p>
  </form>

  <form class="auth__form" data-auth-view="code" novalidate hidden>
    <p class="auth__hint" data-auth-code-note></p>
    <div class="auth__field" data-field="code">
      <label for="auth-code">6-digit code</label>
      <input
        id="auth-code"
        name="code"
        inputmode="numeric"
        autocomplete="one-time-code"
        pattern="[0-9]*"
        maxlength="6"
        required
      />
      <p class="auth__error" data-error-for="code"></p>
    </div>
    <button class="auth__go" type="submit">
      Confirm my email
    </button>
    <p class="auth__switch">
      No email? Check your spam, or{' '}
      <button type="button" data-auth-resend>
        send a new code
      </button>
      .
    </p>
  </form>

  <form class="auth__form" data-auth-view="forgot" novalidate hidden>
    <div class="auth__field">
      <label for="auth-forgot-email">Email</label>
      <input
        id="auth-forgot-email"
        name="email"
        type="email"
        autocomplete="email"
        inputmode="email"
        required
        maxlength="200"
      />
    </div>
    <button class="auth__go" type="submit">
      Email me a reset link
    </button>
    <p class="auth__switch">
      <button type="button" data-auth-show="login">
        Back to log in
      </button>
    </p>
  </form>

  <p class="auth__trust">
    Your details and CV are encrypted, stored privately in Europe and only seen by our team. You can
    delete them any time from your account.
  </p>
</Tag>

<style is:global>
  .auth {
    --auth-ink: #0b0d0a;
    display: grid;
    gap: 1rem;
    width: min(100%, 30rem);
    padding: clamp(1.25rem, 4vw, 2rem);
    border: 1px solid var(--auth-ink);
    border-radius: 18px;
    background: #fbfbf7;
    color: var(--auth-ink);
  }

  .auth--dialog {
    margin: auto;
    max-height: calc(100dvh - 2rem);
    overflow-y: auto;
  }

  .auth--dialog::backdrop {
    background: rgb(11 13 10 / 0.72);
  }

  .auth__close {
    justify-self: end;
    width: 44px;
    height: 44px;
    margin: -0.5rem -0.5rem -1.5rem 0;
    border: 1px solid var(--auth-ink);
    border-radius: 50%;
    background: transparent;
    color: var(--auth-ink);
    font-size: 1.4rem;
    cursor: pointer;
  }

  .auth__title {
    font: 800 clamp(1.5rem, 4vw, 2rem) / 1.05 var(--font-display);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .auth__title:focus {
    outline: none;
  }

  .auth__lede,
  .auth__hint,
  .auth__trust,
  .auth__switch {
    font-size: 0.95rem;
    line-height: 1.5;
    color: #45473f;
  }

  .auth__trust {
    padding-top: 0.75rem;
    border-top: 1px solid #d9d9d0;
    font-size: 0.85rem;
  }

  .auth__status:empty {
    display: none;
  }

  .auth__status {
    padding: 0.75rem 0.9rem;
    border: 1px solid var(--auth-ink);
    background: #eeeee6;
    line-height: 1.45;
  }

  .auth__status[data-tone='warn'] {
    border-color: #b3261e;
    background: #fdecea;
    color: #6e140f;
  }

  .auth__status[data-tone='ok'] {
    border-color: #1f6b3a;
    background: #e8f4ec;
    color: #12401f;
  }

  .auth__form {
    display: grid;
    gap: 0.9rem;
  }

  .auth__form[hidden] {
    display: none;
  }

  .auth__field {
    display: grid;
    gap: 0.35rem;
  }

  .auth__field label {
    font: 500 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .auth__field input {
    width: 100%;
    min-height: 48px;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--auth-ink);
    border-radius: 999px;
    background: #fff;
    color: var(--auth-ink);
    font: 400 1rem var(--font-text);
  }

  .auth__field input:focus-visible,
  .auth button:focus-visible {
    outline: 3px solid var(--btn);
    outline-offset: 2px;
  }

  .auth__field[data-invalid] input {
    border: 2px solid #b3261e;
  }

  .auth__error {
    color: #b3261e;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .auth__error:empty {
    display: none;
  }

  .auth__go {
    min-height: 48px;
    padding: 0.75rem 1.25rem;
    border: 0;
    border-radius: 999px;
    background: var(--btn);
    color: #fff;
    font: 500 0.8rem/1 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .auth__go:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .auth__switch button {
    padding: 0;
    border: 0;
    background: none;
    color: var(--auth-ink);
    font: inherit;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }
</style>

<script>
  import { setupAuth } from '../../scripts/account/auth-panel';
  document.querySelectorAll<HTMLElement>('[data-auth]').forEach((root) => setupAuth(root));
</script>
