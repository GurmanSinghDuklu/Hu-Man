---
/**
 * The portfolio request form, the left half of /contact/ (script: src/scripts/account/request-
 * form.ts). Fields come from src/data/portfolioRequest.ts. Two routes: choose a design + upload a CV
 * (built straight away) or a custom made portfolio. Sending needs an account: logged out, Send opens
 * the sign-in panel (AuthPanel, dialog) over the page and carries on once they're in, with nothing
 * re-typed and nothing stored in the browser. Styled for the Ink ground.
 */
import {
  requestFields,
  requestRoutes,
  requestSections,
  type RequestField,
} from '../../data/portfolioRequest';
import { portfolioConcepts } from '../../data/portfolioConcepts';
import { withBase } from '../../config/paths';
import AuthPanel from './AuthPanel.astro';
import PrivacyShort from './PrivacyShort.astro';

const id = (name: string) => `rq-${name}`;
const inputType = (f: RequestField) =>
  f.kind === 'email' ? 'email' : f.kind === 'tel' ? 'tel' : f.kind === 'url' ? 'url' : 'text';
const maxOf = (f: { kind: string; max?: number }) =>
  f.max ?? (f.kind === 'textarea' ? 2000 : f.kind === 'url' ? 300 : 200);
---

<form class="rq" data-request novalidate>
  <fieldset class="rq__routes" data-field="route">
    <legend class="rq__legend">How would you like it made?</legend>
    {requestRoutes.map((r, i) => (
      <label class="rq__route">
        <input type="radio" name="route" value={r.value} checked={i === 0} />
        <span>
          <strong>{r.label}</strong>
          <span>{r.text}</span>
        </span>
      </label>
    ))}
  </fieldset>

  <div class="rq__field" data-field="concept">
    <label for={id('concept')}>
      Design <span>(optional)</span>
    </label>
    <select id={id('concept')} name="concept">
      <option value="">Not sure yet</option>
      {portfolioConcepts.map((c) => (
        <option value={c.name} data-slug={c.slug}>
          {c.name}, {c.role}
        </option>
      ))}
    </select>
    <p class="rq__hint">
      Every design is a starting point: we make it yours. See them all on{' '}
      <a href={withBase('/portfolio/#concepts')}>CV portfolio</a>.
    </p>
    <p class="rq__error" data-error-for="concept"></p>
  </div>

  <div class="rq__panel" data-panel="chat" hidden>
    <div class="rq__grid">
      <div class="rq__field" data-field="chatName">
        <label for={id('chat-name')}>
          Your name <span class="rq__req">(required)</span>
        </label>
        <input id={id('chat-name')} autocomplete="name" maxlength="100" />
        <p class="rq__error" data-error-for="chatName"></p>
      </div>
      <div class="rq__field" data-field="chatEmail">
        <label for={id('chat-email')}>
          Email <span class="rq__req">(required)</span>
        </label>
        <input
          id={id('chat-email')}
          type="email"
          inputmode="email"
          autocomplete="email"
          maxlength="200"
        />
        <p class="rq__error" data-error-for="chatEmail"></p>
      </div>
      <div class="rq__field" data-field="chatPhone">
        <label for={id('chat-phone')}>
          Phone <span>(optional)</span>
        </label>
        <input id={id('chat-phone')} type="tel" autocomplete="tel" maxlength="40" />
      </div>
      <div class="rq__field rq__wide" data-field="chatMessage">
        <label for={id('chat-message')}>
          What would you like to talk about? <span class="rq__req">(required)</span>
        </label>
        <textarea id={id('chat-message')} rows="4" maxlength="2000"></textarea>
        <p class="rq__error" data-error-for="chatMessage"></p>
      </div>
    </div>
    <p class="rq__wa">
      Or{' '}
      <a href="https://wa.me/447988450280" target="_blank" rel="noopener noreferrer" data-rq-wa>
        message us on WhatsApp<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
      . No account needed either way.
    </p>
  </div>

  <div class="rq__panel" data-panel="details">
    <div class="rq__field rq__cv" data-field="cv">
      <label for={id('cv')}>
        Your CV <span>(optional)</span>
      </label>
      <input
        id={id('cv')}
        type="file"
        accept=".pdf,.docx,application/pdf,application/vnd.openxmlformats-officedocument.wordprocessingml.document"
        data-cv-input
      />
      <p class="rq__hint">PDF or Word (.docx), up to 10 MB.</p>
      <div class="rq__read" data-cv-read hidden>
        <label class="rq__check">
          <input type="checkbox" data-cv-consent />
          <span>
            Read my CV to fill this in. It’s read by Cloudflare’s AI only to fill in this form, and
            never used to train anything.
          </span>
        </label>
        <button type="button" class="rq__ghost" data-cv-read-button>
          Fill in from my CV
        </button>
      </div>
      <p class="rq__error" data-error-for="cv"></p>
    </div>

    {requestSections.map((section) => (
      <fieldset class="rq__section" data-section={section.id} hidden={section.id === 'design'}>
        <legend class="rq__legend">{section.title}</legend>
        {section.id === 'design' && (
          <p class="rq__hint rq__wide">
            The parts of this design your CV doesn’t cover. All optional: anything left empty is
            left off your page, never filled with sample words.
          </p>
        )}
        <div class="rq__grid">
          {requestFields
            .filter((f) => f.section === section.id)
            .map((f) => {
              const req = f.required && <span class="rq__req"> (required)</span>;
              const hintId = f.hint ? id(`${f.id}-hint`) : undefined;
              const designs = f.designs?.join(' ');
              if (f.kind === 'image') {
                return (
                  <div
                    class="rq__field rq__wide"
                    data-field={f.id}
                    data-kind="image"
                    data-designs={designs}
                    hidden={Boolean(designs)}
                  >
                    <label for={id(f.id)}>{f.label}</label>
                    <div class="rq__image" data-image>
                      <input type="hidden" data-image-id />
                      <img alt="" width="72" height="72" data-image-thumb hidden />
                      <input
                        id={id(f.id)}
                        type="file"
                        accept="image/jpeg,image/png,image/webp"
                        aria-describedby={hintId}
                        data-image-input
                      />
                      <button type="button" class="rq__ghost" data-image-clear hidden>
                        Remove picture
                      </button>
                    </div>
                    {f.hint && (
                      <p class="rq__hint" id={hintId}>
                        {f.hint}
                      </p>
                    )}
                    <p class="rq__error" data-error-for={f.id} />
                  </div>
                );
              }
              if (f.kind === 'consent') {
                return (
                  <div class="rq__field rq__wide" data-field={f.id} data-kind="consent">
                    <label class="rq__check">
                      <input type="checkbox" name={f.id} id={id(f.id)} />
                      <span>
                        {f.label}
                        {req}
                      </span>
                    </label>
                    <p class="rq__error" data-error-for={f.id} />
                  </div>
                );
              }
              if (f.kind === 'repeat') {
                return (
                  <div
                    class="rq__field rq__wide"
                    data-field={f.id}
                    data-kind="repeat"
                    data-max={f.maxItems}
                    data-noun={f.noun}
                    data-designs={designs}
                    hidden={Boolean(designs)}
                  >
                    {f.designs && <p class="rq__sub">{f.label}</p>}
                    <div class="rq__entries" data-entries />
                    <template data-entry-template>
                      <div class="rq__entry" data-entry>
                        <p class="rq__entry-title" data-entry-number />
                        <div class="rq__grid">
                          {f.parts?.map((p) =>
                            p.kind === 'image' ? (
                              <div class="rq__field rq__wide">
                                <label data-part-label={p.id}>{p.label}</label>
                                <div class="rq__image" data-image>
                                  <input type="hidden" data-part={p.id} data-image-id />
                                  <img alt="" width="72" height="72" data-image-thumb hidden />
                                  <input
                                    type="file"
                                    accept="image/jpeg,image/png,image/webp"
                                    data-image-input
                                    data-part-file={p.id}
                                  />
                                  <button type="button" class="rq__ghost" data-image-clear hidden>
                                    Remove picture
                                  </button>
                                </div>
                                {p.hint && <p class="rq__hint">{p.hint}</p>}
                              </div>
                            ) : p.kind === 'check' ? (
                              <label class="rq__check rq__wide">
                                <input type="checkbox" data-part={p.id} />
                                <span>{p.label}</span>
                              </label>
                            ) : (
                              <div class:list={['rq__field', { rq__wide: p.kind === 'textarea' }]}>
                                <label data-part-label={p.id}>{p.label}</label>
                                {p.kind === 'textarea' ? (
                                  <textarea
                                    data-part={p.id}
                                    rows="4"
                                    maxlength={maxOf(p)}
                                  ></textarea>
                                ) : (
                                  <input
                                    type={p.kind === 'month' ? 'month' : 'text'}
                                    data-part={p.id}
                                    maxlength={p.kind === 'month' ? undefined : maxOf(p)}
                                    placeholder={p.kind === 'month' ? 'YYYY-MM' : undefined}
                                  />
                                )}
                                {p.hint && <p class="rq__hint">{p.hint}</p>}
                              </div>
                            ),
                          )}
                        </div>
                        <button type="button" class="rq__ghost" data-entry-remove>
                          Remove
                        </button>
                      </div>
                    </template>
                    <button type="button" class="rq__ghost" data-entry-add>
                      {f.add ?? 'Add another'}
                    </button>
                    <p class="rq__error" data-error-for={f.id} />
                  </div>
                );
              }
              return (
                <div
                  class:list={['rq__field', { rq__wide: f.kind === 'textarea' }]}
                  data-field={f.id}
                  data-kind={f.kind}
                  data-designs={designs}
                  hidden={Boolean(designs)}
                >
                  <label for={id(f.id)}>
                    {f.label}
                    {req}
                  </label>
                  {f.kind === 'textarea' ? (
                    <textarea
                      id={id(f.id)}
                      name={f.id}
                      rows="4"
                      maxlength={maxOf(f)}
                      aria-describedby={hintId}
                    ></textarea>
                  ) : (
                    <input
                      id={id(f.id)}
                      name={f.id}
                      type={inputType(f)}
                      inputmode={
                        f.kind === 'url' ? 'url' : f.kind === 'email' ? 'email' : undefined
                      }
                      autocomplete={f.autocomplete}
                      maxlength={maxOf(f)}
                      aria-describedby={hintId}
                    />
                  )}
                  {f.hint && (
                    <p class="rq__hint" id={hintId}>
                      {f.hint}
                    </p>
                  )}
                  <p class="rq__error" data-error-for={f.id} />
                </div>
              );
            })}
        </div>
      </fieldset>
    ))}
  </div>

  <p class="rq__status" role="status" aria-live="polite" data-rq-status></p>
  <div class="rq__actions">
    <button type="submit" class="rq__send" data-rq-send>
      Send my details
    </button>
    <p class="rq__hint" data-rq-who>
      You’ll be asked to sign in or create an account first (Google and Microsoft work too), so you
      can see your request afterwards. Nothing you’ve typed is lost.
    </p>
  </div>
  <p class="rq__trust">
    Your details and CV are encrypted, stored privately in Europe and only seen by our team. Delete
    them any time from your account.
  </p>
  <PrivacyShort tone="ink" />
</form>

<div class="rq__done" data-rq-done hidden tabindex="-1"></div>

<dialog class="rq-pop" data-rq-pop aria-labelledby="rq-pop-title">
  <p class="rq-pop__mark" aria-hidden="true">
    ✓
  </p>
  <h2 id="rq-pop-title" class="rq-pop__title" data-rq-pop-title>
    Thanks, we’ve got it
  </h2>
  <p data-rq-pop-reply>A real person will read it and reply by email within 48 hours.</p>
  <p data-rq-pop-extra></p>
  <p class="rq-pop__small" data-rq-pop-mail></p>
  <div class="rq-pop__actions">
    <a class="rq__send" href={withBase('/account/')} data-rq-pop-dash>
      Go to my dashboard
    </a>
    <button type="button" class="rq__ghost" data-rq-pop-close>
      Close
    </button>
  </div>
</dialog>

<AuthPanel mode="dialog" />

<style is:global>
  .rq {
    display: grid;
    gap: 1.6rem;
    color: var(--paper);
  }

  .rq__legend,
  .rq__field > label:not(.rq__check),
  .rq__entry-title {
    font: 500 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted-on-ink);
  }

  .rq__legend {
    margin-bottom: 0.85rem;
    color: var(--paper);
    font-size: 0.8rem;
  }

  .rq fieldset {
    border: 0;
    padding: 0;
    margin: 0;
    min-width: 0;
  }

  .rq__section[hidden],
  .rq__field[hidden] {
    display: none;
  }

  .rq__section > .rq__hint {
    margin: -0.35rem 0 1rem;
  }

  .rq__sub {
    margin: 0.4rem 0 0.6rem;
    font: 700 1.05rem/1.2 var(--font-text);
    color: var(--paper);
  }

  .rq__image {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
  }

  .rq__image img {
    width: 72px;
    height: 72px;
    object-fit: cover;
    border: 1px solid rgb(241 242 236 / 0.4);
  }

  .rq__image img[hidden] {
    display: none;
  }

  .rq__section {
    padding-top: 1.4rem;
    border-top: 1px solid rgb(241 242 236 / 0.16);
  }

  .rq__grid {
    display: grid;
    gap: 1rem 1.1rem;
  }

  @media (min-width: 40rem) {
    .rq__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .rq__wide {
      grid-column: 1 / -1;
    }
  }

  .rq__field {
    display: grid;
    gap: 0.4rem;
    align-content: start;
    min-width: 0;
  }

  .rq__field > label:not(.rq__check) span,
  .rq__req {
    color: var(--muted-on-ink);
    letter-spacing: 0.06em;
  }

  .rq input[type='text'],
  .rq input[type='email'],
  .rq input[type='tel'],
  .rq input[type='url'],
  .rq input[type='month'],
  .rq select,
  .rq textarea {
    width: 100%;
    min-height: 50px;
    padding: 0.75rem 1.1rem;
    border: 1px solid rgb(241 242 236 / 0.28);
    border-radius: 999px;
    background: var(--ink-2);
    color: var(--paper);
    font: 400 1rem/1.4 var(--font-text);
    color-scheme: dark;
  }

  .rq textarea {
    border-radius: 18px;
    resize: vertical;
  }

  .rq select {
    appearance: none;
  }

  .rq input[type='file'] {
    color: var(--muted-on-ink);
    font: inherit;
    max-width: 100%;
  }

  .rq input::placeholder,
  .rq textarea::placeholder {
    color: var(--muted-on-ink);
  }

  .rq :is(input, select, textarea, button):focus-visible {
    outline: 3px solid var(--lilac, #c9b6ff);
    outline-offset: 2px;
  }

  .rq__field[data-invalid] :is(input, select, textarea) {
    border-color: #ff8fb1;
    box-shadow: inset 0 0 0 1px #ff8fb1;
  }

  .rq__hint {
    color: var(--muted-on-ink);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .rq__hint a {
    color: var(--paper);
  }

  .rq__error {
    color: #ff8fb1;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .rq__error:empty {
    display: none;
  }

  .rq__routes {
    display: grid;
    gap: 0.6rem;
  }

  .rq__route,
  .rq__check {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    line-height: 1.45;
    cursor: pointer;
  }

  .rq__route {
    padding: 0.9rem 1.1rem;
    border: 1px solid rgb(241 242 236 / 0.28);
    border-radius: 18px;
  }

  .rq__route:has(input:checked) {
    border-color: var(--paper);
    background: rgb(241 242 236 / 0.06);
  }

  .rq__route > span {
    display: grid;
    gap: 0.2rem;
  }

  .rq__route > span span {
    color: var(--muted-on-ink);
    font-size: 0.92rem;
  }

  .rq__route input,
  .rq__check input {
    flex: none;
    width: 1.2rem;
    height: 1.2rem;
    margin-top: 0.15rem;
    accent-color: #c9b6ff;
  }

  .rq__read {
    display: grid;
    gap: 0.6rem;
    margin-top: 0.4rem;
  }

  .rq__entries {
    display: grid;
    gap: 1rem;
  }

  .rq__entry {
    display: grid;
    gap: 0.9rem;
    padding: 1rem;
    border: 1px solid rgb(241 242 236 / 0.16);
    border-radius: 18px;
  }

  .rq__ghost {
    justify-self: start;
    min-height: 44px;
    padding: 0.55rem 1rem;
    border: 1px solid rgb(241 242 236 / 0.5);
    border-radius: 999px;
    background: transparent;
    color: var(--paper);
    font: 500 0.75rem/1 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .rq__ghost:hover {
    background: var(--paper);
    color: var(--ink);
  }

  .rq__ghost[hidden] {
    display: none;
  }

  .rq__actions {
    display: grid;
    gap: 0.7rem;
  }

  .rq__send {
    justify-self: start;
    min-height: 54px;
    padding: 0.9rem 2rem;
    border: 0;
    border-radius: 999px;
    background: linear-gradient(90deg, #e6a3c8, #c9b6ff);
    color: var(--ink);
    font: 800 1rem/1 var(--font-display);
    text-transform: uppercase;
    cursor: pointer;
  }

  .rq__send:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .rq__status:empty {
    display: none;
  }

  .rq__status {
    padding: 0.8rem 1rem;
    border-radius: 14px;
    background: rgb(241 242 236 / 0.08);
    line-height: 1.45;
  }

  .rq__status[data-tone='warn'] {
    background: #3a1420;
    color: #ffd3e0;
  }

  .rq__trust {
    color: var(--muted-on-ink);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .rq__panel {
    display: grid;
    gap: 1.6rem;
  }

  .rq__panel[hidden] {
    display: none;
  }

  .rq__wa {
    margin-top: 1rem;
    color: var(--muted-on-ink);
  }

  .rq__wa a {
    color: var(--paper);
    font-weight: 700;
    text-underline-offset: 0.2em;
  }

  .rq-pop {
    width: min(100% - 2rem, 32rem);
    margin: auto;
    padding: clamp(1.5rem, 4vw, 2.25rem);
    border: 1px solid var(--ink);
    border-radius: 18px;
    background: #fbfbf7;
    color: var(--ink);
    line-height: 1.5;
  }

  .rq-pop:not([open]) {
    display: none;
  }

  .rq-pop[open] {
    display: grid;
    gap: 0.85rem;
  }

  .rq-pop::backdrop {
    background: rgb(11 13 10 / 0.72);
  }

  .rq-pop__mark {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    background: var(--ink);
    color: #39ff14;
    font: 800 1.5rem/1 var(--font-display);
  }

  .rq-pop__title {
    font: 800 clamp(1.5rem, 4vw, 2rem) / 1.05 var(--font-display);
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .rq-pop__title:focus {
    outline: none;
  }

  .rq-pop__small {
    font-size: 0.9rem;
    color: #45473f;
  }

  .rq-pop__small:empty {
    display: none;
  }

  .rq-pop__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: center;
    margin-top: 0.5rem;
  }

  .rq-pop .rq__send[hidden],
  .rq-pop [hidden] {
    display: none;
  }

  .rq-pop .rq__send {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
  }

  .rq-pop .rq__ghost {
    color: var(--ink);
    border-color: var(--ink);
  }

  .rq__done {
    display: grid;
    gap: 1rem;
    color: var(--paper);
  }

  .rq__done[hidden] {
    display: none;
  }

  .rq__done h2 {
    font: 800 clamp(1.8rem, 4vw, 2.6rem) / 1 var(--font-display);
    text-transform: uppercase;
  }

  .rq__done a {
    justify-self: start;
  }
</style>

<script>
  import '../../scripts/account/request-form';
</script>
