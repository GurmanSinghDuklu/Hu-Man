---
/** Hero for the Services and Pricing pages: label, headline, lede and the "inner" collage. */
import Collage from './Collage.astro';

interface Props {
  label: string;
  lens: string;
  /** The title has a very long word ("recommending"): set it smaller on phones so it fits. */
  longWords?: boolean;
}

const { label, lens, longWords = false } = Astro.props;
---

<section class="band grid ihero" aria-labelledby="ihero-title">
  <div class="sheet ihero__sheet">
    <div class="ihero__copy">
      <p class="label">{label}</p>
      <h1 id="ihero-title" class:list={['ihero__title', { 'ihero__title--long': longWords }]}>
        <slot name="title" />
      </h1>
      <p class="ihero__lede">
        <slot name="lede" />
      </p>
    </div>
    <div class="ihero__collage">
      <Collage variant="inner" lens={lens} />
    </div>
  </div>
</section>

<style>
  /* Fits one window, like the home hero: a tight stack on phones with the collage capped by the window height; on desktop the layout shrinks with the window (see the media query). */
  .ihero {
    --collage-h: 26svh;
  }

  .ihero__sheet {
    display: grid;
    gap: var(--space-4);
    padding-block: var(--space-4) var(--space-5);
  }

  .ihero__copy {
    display: grid;
    gap: 1rem;
  }

  .ihero__title {
    font-size: clamp(2.6rem, 11vw, 5.4rem);
    line-height: 0.88;
  }

  @media (max-width: 39.99rem) {
    .ihero__title--long {
      font-size: min(8.8vw, 2.6rem);
    }
  }

  .ihero__lede {
    max-width: 34rem;
    font-size: clamp(1rem, calc(var(--u) * 0.21), 1.3rem);
    line-height: 1.5;
  }

  @media (min-width: 64rem) {
    /* The hero's own grid unit, as on the home hero: shrinks so the 7.5 rows fit under the header, never below 70% of the page unit. Grid lines centred on the sheet. */
    .ihero {
      --page-u: min(100vw / 16, 100px);
      --u: clamp(var(--page-u) * 0.7, (100svh - var(--page-u) - 1px) * 0.96 / 7.5, var(--page-u));
      --pad: calc(var(--u) / 2);
      --sheet: calc(var(--u) * 16);
      background-position: calc(50% - var(--u) / 2) 0;
    }

    .ihero__sheet {
      display: block;
      height: calc(var(--u) * 7.5);
      padding: 0;
    }

    .ihero__copy {
      position: absolute;
      left: var(--pad);
      top: calc(var(--u) * 0.92);
      width: calc(var(--u) * 7.6);
      gap: calc(var(--u) * 0.2);
    }

    .ihero__copy .label {
      font-size: calc(var(--u) * 0.135);
    }

    .ihero__title {
      font-size: calc(var(--u) * 0.9);
    }

    .ihero__lede {
      max-width: calc(var(--u) * 5.9);
      font-size: max(0.9375rem, calc(var(--u) * 0.2));
    }

    .ihero__collage {
      position: absolute;
      left: calc(var(--u) * 9);
      top: 0;
    }
  }
</style>
