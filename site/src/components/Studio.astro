---
import RenderFlorist from './renders/RenderFlorist.astro';
import RenderWalks from './renders/RenderWalks.astro';
import RenderRestaurant from './renders/RenderRestaurant.astro';
---

<section class="studio" aria-labelledby="studio-title">
  <div class="wrap studio__inner">
    <div class="studio__collage" aria-hidden="true">
      <svg class="studio__curve" viewBox="0 0 400 700" fill="none">
        <path
          d="M330 0C330 70 250 90 210 110M80 330c-50 20-40 80 20 90s180-10 190 60M230 560c-40 60-90 100-110 140"
          stroke="#fff"
          stroke-opacity=".7"
        ></path>
      </svg>
      <div class="studio__card studio__card--1">
        <RenderFlorist />
      </div>
      <div class="studio__card studio__card--2">
        <RenderWalks />
      </div>
      <div class="studio__card studio__card--3">
        <RenderRestaurant />
      </div>
      <svg class="studio__hex" viewBox="0 0 100 100">
        <path d="M50 4 90 27v46L50 96 10 73V27z" fill="#c21a9c"></path>
      </svg>
      <svg class="studio__burst" viewBox="0 0 100 100">
        <path
          d="M50 0l5 33 17-28-7 32 26-20-17 28 31-9-26 19 31 4-31 8 28 15-31-3 21 24-28-15 9 31-19-26v32l-8-31-15 28 3-31-24 21 15-28-31 9 26-19-31-4 31-8-28-15 31 3-21-24 28 15-9-31 19 26z"
          fill="#1c6cdc"
        ></path>
      </svg>
      <svg class="studio__spark" viewBox="0 0 100 100">
        <path
          d="M50 2c4 30 18 44 48 48-30 4-44 18-48 48-4-30-18-44-48-48 30-4 44-18 48-48z"
          fill="none"
          stroke="#fff"
          stroke-width="1.6"
        ></path>
      </svg>
    </div>

    <div class="studio__copy">
      <h2 id="studio-title" class="studio__title">
        <span class="t-bold t-silver">Local businesses,</span>
        <span class="t-thin t-silver">found online, booked in and followed up.</span>
      </h2>
      <p>
        I've shipped live customer pages inside Lloyds Banking Group's Agile team, completed
        Harvard's CS50x, and finished a T Level in Digital Production, Design and Development.
      </p>
      <p>
        Every site, app and assistant is designed, built and tested by me, then looked after month
        by month.
      </p>
      <a href="#about" class="pill-btn">
        More about the studio
      </a>
    </div>
  </div>
</section>

<style>
  .studio {
    padding-block: clamp(4rem, 10vw, 8rem);
    overflow: hidden;
  }

  .studio__inner {
    display: grid;
    gap: clamp(3rem, 6vw, 5rem);
    align-items: center;
  }

  .studio__collage {
    position: relative;
    aspect-ratio: 5 / 6;
    max-width: 560px;
    width: 100%;
    margin-inline: auto;
  }

  .studio__collage > * {
    position: absolute;
  }

  .studio__curve {
    inset: -4% 0 -4% 4%;
    width: 92%;
    height: 108%;
  }

  .studio__card {
    width: 66%;
    box-shadow: 0 30px 60px -20px rgba(0, 0, 0, 0.8);
    border-radius: var(--radius-sm);
  }

  .studio__card--1 {
    left: 0;
    top: 4%;
    transform: rotate(-7deg);
  }

  .studio__card--2 {
    left: 30%;
    top: 34%;
    width: 50%;
    transform: rotate(9deg);
  }

  .studio__card--3 {
    left: 6%;
    top: 62%;
    transform: rotate(-12deg);
  }

  .studio__hex {
    width: 17%;
    left: 2%;
    top: 40%;
  }

  .studio__burst {
    width: 22%;
    left: 66%;
    top: 60%;
  }

  .studio__spark {
    width: 13%;
    left: 70%;
    top: 22%;
  }

  .studio__copy {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 34rem;
  }

  .studio__title {
    display: grid;
    font-size: clamp(2.5rem, 5.4vw, 4.5rem);
    line-height: 1;
    margin-bottom: var(--space-3);
  }

  .studio__copy p {
    color: rgba(255, 255, 255, 0.86);
    font-size: 1.05rem;
    max-width: 30rem;
  }

  @media (min-width: 60rem) {
    .studio__inner {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
