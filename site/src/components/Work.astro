---
import WorkGrid from './WorkGrid.astro';
---

<section class="work-sec" id="work" aria-labelledby="work-title">
  <div class="wrap">
    <div class="work-sec__head">
      <h2 id="work-title" class="section-title" data-reveal>
        Selected work
      </h2>
      <p data-reveal>
        Live sites we've designed and built, and concept work that isn't live. Every tile says
        which. Open one to see how it was made.
      </p>
    </div>
    <WorkGrid />
  </div>
</section>

<style>
  .work-sec {
    padding-block: clamp(4rem, 9vw, 7rem);
    background: var(--brand-ink);
  }

  .work-sec__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .work-sec__head p {
    max-width: 36rem;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }

  @media (min-width: 48rem) {
    .work-sec__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }
</style>
