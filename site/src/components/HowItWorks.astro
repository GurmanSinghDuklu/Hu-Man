---
import { processSteps } from '../data/content';
---

<section class="process" id="process" aria-labelledby="process-title">
  <div class="wrap">
    <div class="process__head">
      <p class="eyebrow" data-reveal>
        Process
      </p>
      <h2 id="process-title" class="section-title" data-reveal>
        How it <span class="hl">works</span>
      </h2>
    </div>

    <div class="process__track">
      <div class="process__line" aria-hidden="true">
        <span></span>
      </div>
      <ol class="process__list">
        {processSteps.map((step, i) => (
          <li class="process__step" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
            <span class="process__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .process__head {
    display: grid;
    gap: var(--space-3);
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  .process__track {
    position: relative;
  }

  .process__line {
    display: none;
  }

  .process__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--space-4);
  }

  .process__step {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.5rem, 2.4vw, 1.75rem);
    border-radius: var(--radius-lg);
    background: var(--paper);
    transition:
      transform 0.4s var(--ease-out),
      box-shadow 0.4s var(--ease-out);
  }

  .process__step:hover {
    transform: translateY(-4px);
    box-shadow: var(--shadow-card);
  }

  .process__num {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    border-radius: 50%;
    background: var(--forest-900);
    color: var(--lime);
    font-size: 0.85rem;
    font-weight: 700;
    margin-bottom: var(--space-3);
    position: relative;
    z-index: 1;
  }

  .process__step h3 {
    font-size: 1.2rem;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .process__step p {
    color: var(--color-text-muted);
    font-size: 0.925rem;
  }

  @media (min-width: 40rem) {
    .process__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .process__list {
      grid-template-columns: repeat(5, 1fr);
      gap: 1rem;
    }

    .process__line {
      display: block;
      position: absolute;
      left: 3.25rem;
      right: 3.25rem;
      top: calc(clamp(1.5rem, 2.4vw, 1.75rem) + 1.5rem);
      height: 2px;
      background: var(--color-line);
      z-index: 1;
      pointer-events: none;
    }

    .process__line span {
      display: block;
      height: 100%;
      background: var(--forest-600);
      transform-origin: left;
    }

    @supports (animation-timeline: view()) {
      .process__line span {
        animation: fill linear both;
        animation-timeline: view();
        animation-range: entry 20% cover 55%;
      }
    }
  }

  @keyframes fill {
    from {
      transform: scaleX(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .process__line span {
      animation: none !important;
    }
  }
</style>
