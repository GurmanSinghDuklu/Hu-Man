---
import { processSteps } from '../data/content';
---

<section class="process" id="process" aria-labelledby="process-title">
  <div class="wrap">
    <div class="process__head">
      <p class="eyebrow" data-reveal>
        Process
      </p>
      <h2 id="process-title" class="section-title" data-reveal>
        How it <span class="hl">works</span>
      </h2>
    </div>

    <div class="process__track">
      <ol class="process__list" data-cells>
        {processSteps.map((step, i) => (
          <li class="process__step">
            <span class="process__num" aria-hidden="true">
              {String(i + 1).padStart(2, '0')}
            </span>
            <h3>{step.title}</h3>
            <p>{step.description}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .process {
    padding-block: clamp(4rem, 9vw, 7rem);
    border-top: var(--border-hairline) solid var(--line);
  }

  .process__head {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    margin-bottom: clamp(2.5rem, 5vw, 4rem);
  }

  /* A real sequence: flush, hairline-ruled cells that cut on one after another. */
  .process__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--border-hairline);
    background: var(--line);
    border: var(--border-hairline) solid var(--line);
  }

  .process__step {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.25rem, 2.4vw, 1.75rem);
    background: var(--brand-ink);
  }

  /* Step numbers are graphic numerals; the first step (the free audit) is the Signal block. */
  .process__num {
    font: 800 clamp(3.5rem, 6vw, 5rem) / 0.8 var(--font-display);
    letter-spacing: -0.04em;
    color: var(--signal);
    margin-bottom: var(--space-3);
  }

  .process__step:first-child {
    background: var(--signal);
    color: var(--on-signal);
  }

  .process__step:first-child .process__num {
    color: var(--on-signal);
  }

  .process__step:first-child p {
    color: var(--on-signal);
  }

  .process__step h3 {
    font-size: 1.25rem;
    line-height: 1.05;
  }

  .process__step p {
    color: var(--color-text-muted);
    font-size: 0.9375rem;
  }

  @media (min-width: 40rem) {
    .process__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .process__list {
      grid-template-columns: repeat(5, 1fr);
    }

    .process__step {
      min-height: 20rem;
    }
  }
</style>
