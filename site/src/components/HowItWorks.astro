---
import { processSteps } from '../data/content';
---

<section class="process" aria-labelledby="process-title">
  <div class="wrap">
    <h2 id="process-title" class="section-title">
      <span class="t-thin t-silver">How it</span> <span class="t-bold t-silver">works</span>
    </h2>
    <ol class="process__list">
      {processSteps.map((step, i) => (
        <li class="process__step">
          <span class="process__num" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <h3>{step.title}</h3>
          <p>{step.description}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process {
    padding-block: clamp(4rem, 9vw, 7rem);
  }

  .process__list {
    list-style: none;
    margin: clamp(2rem, 5vw, 3.5rem) 0 0;
    padding: 0;
    display: grid;
    gap: 1px;
    background: var(--color-line);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-md);
    overflow: hidden;
  }

  .process__step {
    background: var(--color-bg);
    padding: clamp(1.5rem, 2.4vw, 2rem);
    display: grid;
    align-content: start;
    gap: 0.75rem;
    transition: background-color 0.3s;
  }

  .process__step:hover {
    background: var(--ink-900);
  }

  .process__num {
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid var(--color-line-strong);
    font-size: 0.85rem;
    margin-bottom: var(--space-4);
  }

  .process__step:first-child .process__num {
    background: linear-gradient(135deg, var(--magenta-bright), var(--blue));
    border-color: transparent;
  }

  .process__step h3 {
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.03em;
  }

  .process__step p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
  }

  @media (min-width: 40rem) {
    .process__list {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (min-width: 64rem) {
    .process__list {
      grid-template-columns: repeat(5, 1fr);
    }

    .process__step {
      min-height: 17rem;
    }
  }
</style>
