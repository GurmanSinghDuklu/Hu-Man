---
/** Flat ceramic vessel illustration, used as product "photography". */
interface Props {
  shape?: 'jug' | 'vase' | 'bowl' | 'cup';
  body?: string;
  glaze?: string;
  class?: string;
  style?: string;
}
const {
  shape = 'vase',
  body = '#c9794f',
  glaze = '#efe4d2',
  class: className = '',
  style = '',
} = Astro.props;
const paths: Record<string, string> = {
  vase: 'M38 10h24v8c0 6 14 14 14 34 0 26-12 40-26 40S24 78 24 52c0-20 14-28 14-34z',
  jug: 'M30 16h36l-4 10c10 8 14 20 14 34 0 22-12 32-26 32S24 82 24 60c0-14 4-26 12-34z M74 34c10 0 14 8 12 18s-10 14-14 12',
  bowl: 'M10 44h80c0 26-18 42-40 42S10 70 10 44z',
  cup: 'M24 30h46v34c0 14-10 24-23 24S24 78 24 64z M70 40c10 0 14 6 13 13s-7 11-13 10',
};
---

<svg class={className} style={style} viewBox="0 0 100 100" preserveAspectRatio="xMidYMax meet">
  <ellipse cx="50" cy="94" rx="30" ry="4" fill="rgba(0,0,0,.18)"></ellipse>
  <path d={paths[shape]} fill={body} stroke={body} stroke-width="3" stroke-linejoin="round"></path>
  <path d={paths[shape]} fill={glaze} clip-path="inset(0 0 58% 0)"></path>
</svg>
