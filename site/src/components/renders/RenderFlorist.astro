---
import Tile from './Tile.astro';
import Browser from '../devices/Browser.astro';
import Tulips from './Tulips.astro';
interface Props {
  label?: string;
  ratio?: string;
}
const { label, ratio = '4 / 3' } = Astro.props;
---

<Tile bg="#cfcfd1" ratio={ratio} label={label}>
  <Browser class="fl-b1" bg="#1b1512" fg="#f5ede6" url="petal-and-stem.example" ratio="16 / 12">
    <div class="fl-dark">
      <div class="fl-nav">
        <span>Shop</span>
        <span>Weddings</span>
        <span>Workshops</span>
        <span>Visit</span>
      </div>
      <span class="fl-script">Petal &amp; Stem</span>
      <span class="fl-sub">Seasonal flowers, delivered across Bradford and Leeds.</span>
      <Tulips class="fl-t1" petal="#f5f0ea" petal2="#e8ddd2" />
    </div>
  </Browser>
  <Browser
    class="fl-b2"
    bg="#ffffff"
    fg="#1b1512"
    url="petal-and-stem.example/tulips"
    light
    ratio="16 / 11"
  >
    <div class="fl-light">
      <div class="fl-photo">
        <Tulips class="fl-t2" />
      </div>
      <div class="fl-info">
        <span class="fl-script fl-script--sm">Tulip Dawn</span>
        <span class="fl-p">
          Twenty pink tulips, hand-tied with eucalyptus. Same-day delivery before 1 pm.
        </span>
        <span class="fl-price">£32</span>
        <span class="fl-sizes">
          <span class="on">Classic</span>
          <span>Grand</span>
          <span>Luxe</span>
        </span>
        <span class="fl-btn">Add to basket</span>
      </div>
    </div>
  </Browser>
</Tile>

<style is:global>
  .fl-b1 {
    left: 4%;
    top: 6%;
    width: 60%;
  }
  .fl-b2 {
    left: 30%;
    top: 36%;
    width: 66%;
  }
  .fl-dark {
    position: relative;
    height: 100%;
    padding: 2.6em 3.4em;
    background: radial-gradient(60% 70% at 75% 60%, #3a2a22, #1b1512 70%);
    overflow: hidden;
  }
  .fl-nav {
    display: flex;
    gap: 2em;
    justify-content: flex-end;
    font-size: 1.1em;
    opacity: 0.7;
  }
  .fl-script {
    display: block;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 300;
    font-size: 8em;
    line-height: 1;
    letter-spacing: -0.03em;
    margin-top: 0.5em;
  }
  .fl-script--sm {
    font-size: 5em;
    margin-top: 0;
  }
  .fl-sub {
    display: block;
    font-size: 1.3em;
    opacity: 0.7;
    max-width: 20em;
    margin-top: 1em;
  }
  .fl-t1 {
    position: absolute;
    right: 2em;
    bottom: -4em;
    width: 40em;
  }
  .fl-light {
    display: grid;
    grid-template-columns: 1fr 1fr;
    height: 100%;
  }
  .fl-photo {
    position: relative;
    background: #2a211c;
    overflow: hidden;
  }
  .fl-t2 {
    position: absolute;
    left: 50%;
    bottom: -2em;
    width: 42em;
    transform: translateX(-50%);
  }
  .fl-info {
    padding: 3em;
    display: flex;
    flex-direction: column;
    gap: 1.2em;
  }
  .fl-p {
    font-size: 1.3em;
    opacity: 0.7;
  }
  .fl-price {
    font-size: 2.6em;
    font-weight: 600;
    letter-spacing: -0.03em;
  }
  .fl-sizes {
    display: flex;
    gap: 0.6em;
  }
  .fl-sizes span {
    padding: 0.6em 1.4em;
    border: 1px solid #ddd;
    border-radius: 2em;
    font-size: 1.1em;
  }
  .fl-sizes .on {
    background: #1b1512;
    color: #fff;
    border-color: #1b1512;
  }
  .fl-btn {
    margin-top: auto;
    background: #1b1512;
    color: #fff;
    text-align: center;
    padding: 1.2em;
    border-radius: 0.6em;
    font-weight: 600;
    font-size: 1.2em;
  }
</style>
