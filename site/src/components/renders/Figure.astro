---
/** Flat illustrated person (no photos). Fills its box; bottom-anchored. */
interface Props {
  skin?: string;
  hair?: string;
  top?: string;
  class?: string;
  style?: string;
  variant?: 'short' | 'long' | 'bun';
}
const {
  skin = '#c68b64',
  hair = '#1d1410',
  top = '#1f3bd6',
  class: className = '',
  style = '',
  variant = 'short',
} = Astro.props;
---

<svg class={className} style={style} viewBox="0 0 100 100" preserveAspectRatio="xMidYMax meet">
  {variant === 'long' && <path d="M29 40c0-18 9-28 21-28s21 10 21 28v34H29z" fill={hair} />}
  <path d="M14 100c0-22 16-34 36-34s36 12 36 34z" fill={top} />
  <path d="M43 58h14v12a7 7 0 0 1-14 0z" fill={skin} />
  <ellipse cx="50" cy="42" rx="15" ry="18" fill={skin} />
  {variant === 'short' && (
    <path d="M34 40c-1-13 7-20 16-20s18 6 16 20c-3-7-9-9-16-9s-13 2-16 9z" fill={hair} />
  )}
  {variant === 'long' && (
    <path d="M34 42c0-14 7-21 16-21s16 7 16 21c-4-9-10-11-16-11s-12 2-16 11z" fill={hair} />
  )}
  {variant === 'bun' && (
    <>
      <circle cx="50" cy="17" r="8" fill={hair} />
      <path d="M34 40c-1-13 7-20 16-20s18 6 16 20c-3-7-9-9-16-9s-13 2-16 9z" fill={hair} />
    </>
  )}
</svg>
