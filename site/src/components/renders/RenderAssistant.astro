---
import Tile from './Tile.astro';
import Phone from '../devices/Phone.astro';
interface Props {
  label?: string;
  ratio?: string;
}
const { label, ratio = '4 / 3' } = Astro.props;
const cream = '#f7efe6';
const coral = '#cf3535';
const ink = '#1b1b1f';
---

<Tile bg="#8b8b90" ratio={ratio} label={label}>
  <Phone class="as-p1" bg={cream} fg={ink}>
    <div class="ui-pad ui-col as-s">
      <div class="ui-between">
        <span class="ui-h as-h">Hello!</span>
        <span class="ui-avatar" style={`background:${coral};color:#fff`}>
          B
        </span>
      </div>
      <span class="ui-small ui-muted">Bright Square Dental · assistant</span>
      <div class="ui-row as-days">
        {['M', 'T', 'W', 'T', 'F', 'S'].map((d, i) => (
          <span class:list={{ on: i === 2 }}>{d}</span>
        ))}
      </div>
      <span class="ui-h as-h2">Today</span>
      {[
        ['New patient enquiries', '6'],
        ['Bookings made', '4'],
        ['Handed to reception', '2'],
      ].map(([a, b], i) => (
        <div class:list={['as-stat', { hot: i === 0 }]}>
          <span>{a}</span>
          <b>{b}</b>
        </div>
      ))}
      <div class="as-card">
        <span class="ui-small">At the front desk</span>
        <span class="as-bigw">Handover</span>
      </div>
    </div>
  </Phone>
  <Phone class="as-p2" bg={ink} fg="#fff">
    <div class="ui-pad ui-col as-s">
      <span class="ui-small ui-muted">Tested before launch</span>
      <span class="ui-h as-h">Answer accuracy</span>
      {[
        ['Prices', 100],
        ['Opening hours', 100],
        ['Booking rules', 96],
        ['Handover triggers', 100],
      ].map(([a, b]) => (
        <div class="as-bar">
          <span>{a}</span>
          <i>
            <em style={`width:${b}%`} />
          </i>
        </div>
      ))}
      <div class="as-wave">
        {Array.from({ length: 28 }, (_, i) => (
          <span style={`height:${20 + ((i * 37) % 70)}%`} />
        ))}
      </div>
      <span class="ui-small ui-muted">Sample test report</span>
    </div>
  </Phone>
  <Phone class="as-p3" bg={cream} fg={ink}>
    <div class="ui-pad ui-col as-s">
      <div class="as-top">
        <span class="ui-avatar" style={`background:${coral};color:#fff`}>
          B
        </span>
        <span>
          <b>Assistant</b>
          <br />
          <span class="ui-small ui-muted">Replies instantly</span>
        </span>
      </div>
      <p class="as-msg as-msg--b">
        Hi! I'm the assistant for Bright Square Dental. How can I help?
      </p>
      <p class="as-msg as-msg--u">Do you take new NHS patients?</p>
      <p class="as-msg as-msg--b">
        I'll check that with reception for you. Can I take your name and number?
      </p>
      <p class="as-msg as-msg--u">Sam, 07700 900123</p>
      <p class="as-msg as-msg--b">Thanks Sam. The team will call you today.</p>
      <div class="as-input">
        Type a message…<i>↑</i>
      </div>
    </div>
  </Phone>
</Tile>

<style is:global>
  .as-p1 {
    left: 3%;
    top: 10%;
    width: 30%;
  }
  .as-p2 {
    left: 35%;
    top: 16%;
    width: 30%;
  }
  .as-p3 {
    left: 67%;
    top: 8%;
    width: 30%;
  }
  .as-s {
    gap: 0.9em;
    padding-top: 0.6em;
  }
  .as-h {
    font-size: 2.2em;
  }
  .as-h2 {
    font-size: 1.4em;
  }
  .as-days {
    justify-content: space-between;
  }
  .as-days span {
    width: 2.6em;
    height: 2.6em;
    border-radius: 50%;
    border: 0.12em solid rgba(0, 0, 0, 0.2);
    display: grid;
    place-items: center;
    font-weight: 600;
  }
  .as-days span.on {
    background: #cf3535;
    border-color: #cf3535;
    color: #fff;
  }
  .as-stat {
    display: flex;
    justify-content: space-between;
    padding: 1em 1.2em;
    border-radius: 1.2em;
    background: #fff;
  }
  .as-stat.hot {
    background: #cf3535;
    color: #fff;
  }
  .as-card {
    border-radius: 1.4em;
    background: #cf3535;
    color: #fff;
    padding: 1.4em;
    display: flex;
    flex-direction: column;
    gap: 0.3em;
  }
  .as-bigw {
    font-size: 3.2em;
    font-weight: 300;
    letter-spacing: -0.04em;
  }
  .as-bar {
    display: flex;
    flex-direction: column;
    gap: 0.4em;
    font-size: 0.95em;
  }
  .as-bar i {
    height: 0.7em;
    border-radius: 1em;
    background: #2c2c33;
    display: block;
  }
  .as-bar em {
    display: block;
    height: 100%;
    border-radius: 1em;
    background: linear-gradient(90deg, #ee5a5a, #f7a26b);
  }
  .as-wave {
    display: flex;
    gap: 0.25em;
    align-items: center;
    height: 5em;
    margin-top: 0.6em;
  }
  .as-wave span {
    flex: 1;
    border-radius: 1em;
    background: #f7efe6;
    opacity: 0.85;
  }
  .as-top {
    display: flex;
    gap: 0.8em;
    align-items: center;
    padding-bottom: 0.8em;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .as-msg {
    margin: 0;
    padding: 0.9em 1.1em;
    border-radius: 1.3em;
    max-width: 85%;
    font-size: 1em;
    line-height: 1.35;
  }
  .as-msg--b {
    background: #fff;
    border-bottom-left-radius: 0.3em;
  }
  .as-msg--u {
    background: #cf3535;
    color: #fff;
    align-self: flex-end;
    border-bottom-right-radius: 0.3em;
  }
  .as-input {
    margin-top: 0.4em;
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.6em 0.6em 0.6em 1.2em;
    border-radius: 2em;
    background: #fff;
    opacity: 0.9;
  }
  .as-input i {
    width: 2.4em;
    height: 2.4em;
    border-radius: 50%;
    background: #1b1b1f;
    color: #fff;
    display: grid;
    place-items: center;
    font-style: normal;
  }
</style>
