---
/** Illustrated bunch of tulips in a vase. */
interface Props {
  class?: string;
  style?: string;
  petal?: string;
  petal2?: string;
}
const { class: className = '', style = '', petal = '#f2a7b8', petal2 = '#e57f9a' } = Astro.props;
const heads = [
  [30, 30, -18],
  [44, 18, -6],
  [58, 22, 8],
  [70, 34, 20],
  [38, 44, -10],
  [52, 38, 2],
  [64, 48, 14],
  [24, 50, -24],
];
---

<svg class={className} style={style} viewBox="0 0 100 120">
  {heads.map(([x, y]) => (
    <path d={`M${x} ${y + 6} Q ${50} 80 50 88`} stroke="#4f7a3a" stroke-width="1.6" fill="none" />
  ))}
  <path
    d="M40 60 Q 30 70 36 82 M60 60 Q 72 70 64 84"
    stroke="#5f8f45"
    stroke-width="5"
    fill="none"
    stroke-linecap="round"
  />
  {heads.map(([x, y, r], i) => (
    <g transform={`rotate(${r} ${x} ${y})`}>
      <path
        d={`M${x - 6} ${y} Q ${x - 7} ${y - 10} ${x - 3} ${y - 11} L ${x} ${y - 7} L ${x + 3} ${y - 11} Q ${x + 7} ${y - 10} ${x + 6} ${y} Q ${x} ${y + 7} ${x - 6} ${y}z`}
        fill={i % 2 ? petal : petal2}
      />
    </g>
  ))}
  <path d="M34 84h32l-4 34H38z" fill="#9aa3a8" />
  <path d="M34 84h32l-1 6H35z" fill="#c9d0d4" />
</svg>
