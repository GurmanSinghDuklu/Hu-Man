---
/**
 * Before and after of a sample site (the electrician from docs/03), under "Agentic AI-ready, as
 * standard". Numbered markers on both windows match the numbered changes below; picking a change
 * (card-pick.ts, [data-pick]) or hovering it lights its markers in both windows.
 * The windows are decorative (aria-hidden): the list of changes carries the content. The after
 * window is a sample page that plays itself while on screen (scripts/before-after.ts).
 * Draft copy, awaiting Gurman's sign-off. Every change listed is standard on every tier.
 */
interface Change {
  title: string;
  before: string;
  after: string;
}

const changes: Change[] = [
  {
    title: 'A secure address',
    before: 'The browser warns visitors the site is "Not secure".',
    after: 'A secure https address, with security headers set.',
  },
  {
    title: 'Built for phones',
    before: 'A desktop page you have to pinch and zoom on a phone.',
    after: 'Laid out for phones first, then scaled up for bigger screens.',
  },
  {
    title: 'A clear next step',
    before: '"Please call for prices", and a phone number at the bottom.',
    after: 'One button to ask for a quote, and a short enquiry form.',
  },
  {
    title: 'Services and prices in plain view',
    before: '"A wide range of services at competitive prices."',
    after: 'Each service named, with its starting price.',
  },
  {
    title: 'Quick to load',
    before: 'An oversized photo that holds up the rest of the page.',
    after: 'Images compressed and sized for the screen, with very little code.',
  },
  {
    title: 'Readable by AI agents',
    before: 'The business name lives inside a banner image, with nothing structured.',
    after: 'Structured data names the business, services, prices, hours and area.',
  },
];

/** Marker 1 sits at the right end of the address bar, whatever the window's width. */
const CHROME_X = 'calc(100% - 1.3rem)';
const CHROME_Y = '1.1rem';
const pos = (v: number | string) => (typeof v === 'number' ? `${v}%` : v);

/** Marker positions (% of each window), keyed by change number. The pages inside scale with
 * the window, so these hold at every width (measured at 1280px). */
const beforeMarks: Record<number, [number | string, number | string]> = {
  1: [CHROME_X, CHROME_Y],
  2: [96, 19.5],
  3: [34, 89],
  4: [93, 72],
  5: [33, 54],
  6: [95, 41.8],
};
---

<div class="ba">
  <div class="ba__stage">
    <!-- Before: a typical dated small-business site (docs/03's before mock). -->
    <div class="ba__col ba__col--before" data-reveal>
      <p class="ba__tag" aria-hidden="true">
        Before
      </p>
      <div class="ba__win ba__win--before" aria-hidden="true">
        <div class="ba__chrome">
          <span class="ba__dots">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span class="ba__url ba__url--bad">
            <b>Not secure</b> ashby-electrical.example
          </span>
        </div>
        <div class="ba__screen">
          <div class="old">
            <div class="old__head">Ashby Electrical</div>
            <div class="old__nav">
              <u>Home</u>
              <u>About Us</u>
              <u>Services</u>
              <u>Gallery</u>
              <u>Links</u>
              <u>Contact Us</u>
            </div>
            <div class="old__banner">WELCOME TO ASHBY ELECTRICAL</div>
            <div class="old__body">
              <div class="old__photo">
                <span>Loading image...</span>
                <span class="old__bar">
                  <span></span>
                </span>
              </div>
              <p class="old__text">
                Ashby Electrical is a family run business established in 2004. We offer a wide range
                of services at competitive prices. Please call for prices and availability.
              </p>
            </div>
            <p class="old__tel">Tel: 01234 567890</p>
            <p class="old__foot">Copyright 2014 Ashby Electrical. Site last updated 2016.</p>
          </div>
        </div>
        {Object.entries(beforeMarks).map(([n, [x, y]]) => (
          <span class="ba__mark" data-mark={n} style={`--x:${pos(x)};--y:${pos(y)};--i:${n}`}>
            {n}
          </span>
        ))}
      </div>
      <p class="ba__caption">
        <span class="ba__concept">Concept</span>A sample electrician's site, before and after a
        rebuild. Pick a change below to see it in both.
      </p>
    </div>

    <!-- After: the same business rebuilt, with a phone view and what an AI agent reads. -->
    <div class="ba__col ba__col--after" data-reveal style="--reveal-delay:0.12s">
      <p class="ba__tag ba__tag--after" aria-hidden="true">
        After
      </p>
      <div class="ba__win ba__win--after" aria-hidden="true">
        <div class="ba__chrome">
          <span class="ba__dots">
            <i></i>
            <i></i>
            <i></i>
          </span>
          <span class="ba__url">
            <span class="ba__lock"></span> https://ashby-electrical.example
          </span>
        </div>
        <div class="ba__screen am">
          <div class="am__view">
            <div class="am__nav">
              <span class="am__logo">
                Ashby<b>.</b>
              </span>
              <span class="am__links">
                <span>Services</span>
                <span>Prices</span>
                <span>Areas</span>
                <span>Contact</span>
              </span>
              <span class="am__btn am__btn--sm">Get a fixed quote</span>
            </div>
            <div class="am__page" data-am-page>
              <div class="am__hero" data-am-at="hero">
                <div>
                  <span class="am__pill" data-am-fade>
                    Electricians in Leeds
                  </span>
                  <p class="am__h">
                    <span class="am__line">
                      <span data-am-line>Certified electricians.</span>
                    </span>
                    <span class="am__line">
                      <span data-am-line>Fixed quotes</span>
                    </span>
                    <span class="am__line">
                      <span data-am-line>within 24 hours.</span>
                    </span>
                  </p>
                  <p class="am__sub" data-am-fade>
                    Tell us about the job and send a photo. We reply with a fixed price, not a
                    guess.
                  </p>
                  <div class="am__ctas" data-am-fade>
                    <span class="am__btn" data-am-cta>
                      Get a fixed quote
                      <span
                        class="ba__mark"
                        data-mark="3"
                        style="--x:calc(100% - 0.2rem);--y:0;--i:3"
                      >
                        3
                      </span>
                    </span>
                    <span class="am__btn am__btn--ghost">See prices</span>
                  </div>
                  <ul class="am__ticks" data-am-fade>
                    <li>Fixed prices</li>
                    <li>Tidy work</li>
                    <li>Replies within 24 hours</li>
                  </ul>
                </div>
                <div class="am__art">
                  <span class="am__sun" data-am-sun></span>
                  <span class="am__hill" data-am-hill></span>
                  <svg class="am__bolt" viewBox="0 0 100 100">
                    <path
                      data-am-draw
                      pathLength="1"
                      d="M58 6 L26 54 H50 L40 94 L76 40 H52 Z"
                    ></path>
                  </svg>
                  <svg class="am__wires" viewBox="0 0 200 60" preserveAspectRatio="none">
                    <path
                      data-am-draw
                      pathLength="1"
                      d="M0 40 H40 Q52 40 56 28 T76 16 H120 Q132 16 136 28 T156 44 H200"
                    ></path>
                  </svg>
                  <span class="am__float" data-am-float>
                    <i></i>Fixed price, no surprises
                  </span>
                  <span class="ba__mark" data-mark="5" style="--x:90%;--y:9%;--i:5">
                    5
                  </span>
                </div>
              </div>

              <div class="am__section" data-am-at="services">
                <p class="am__eyebrow">
                  Services and prices
                  <span
                    class="ba__mark"
                    data-mark="4"
                    style="--x:calc(100% + 1.1rem);--y:50%;--i:4"
                  >
                    4
                  </span>
                </p>
                <p class="am__h2">Clear prices, before we start.</p>
                <div class="am__cards">
                  <div class="am__card" data-am-card>
                    <span class="am__ico am__ico--check"></span>
                    <b>Safety inspection</b>
                    <p>A full check of your wiring, with a written report.</p>
                    <span class="am__price">
                      <small>from</small>£<span data-am-count="120">120</span>
                    </span>
                  </div>
                  <div class="am__card" data-am-card>
                    <span class="am__ico am__ico--box"></span>
                    <b>Consumer unit upgrade</b>
                    <p>A new fuse box, fitted and tested in a day.</p>
                    <span class="am__price am__price--quote">Fixed quote</span>
                  </div>
                  <div class="am__card" data-am-card>
                    <span class="am__ico am__ico--plug"></span>
                    <b>EV charger install</b>
                    <p>Home charging, fitted and registered for you.</p>
                    <span class="am__price">
                      <small>from</small>£<span data-am-count="799">799</span>
                    </span>
                  </div>
                </div>
              </div>

              <div class="am__section" data-am-at="steps">
                <p class="am__eyebrow">How it works</p>
                <p class="am__h2">Three steps, no guesswork.</p>
                <div class="am__track">
                  <svg class="am__path" viewBox="0 0 300 4" preserveAspectRatio="none">
                    <path data-am-draw pathLength="1" d="M0 2 H300"></path>
                  </svg>
                  <div class="am__step" data-am-step>
                    <span class="am__dot">1</span>
                    <b>Send a photo</b>
                    <p>Tell us what's wrong and where you are.</p>
                  </div>
                  <div class="am__step" data-am-step>
                    <span class="am__dot">2</span>
                    <b>Get a fixed price</b>
                    <p>We reply within 24 hours with one price.</p>
                  </div>
                  <div class="am__step" data-am-step>
                    <span class="am__dot">3</span>
                    <b>We do the job</b>
                    <p>On the day we agree, and we tidy up after.</p>
                  </div>
                </div>
              </div>

              <div class="am__section am__quote" data-am-at="form">
                <div>
                  <p class="am__eyebrow">Get a fixed quote</p>
                  <p class="am__h2">Three questions and a photo.</p>
                  <p class="am__sub">No call needed. We reply with one fixed price.</p>
                </div>
                <div class="am__form">
                  <div class="am__field">
                    <span>Name</span>
                    <span class="am__input" data-am-type="Priya Sharma">
                      Priya Sharma
                    </span>
                  </div>
                  <div class="am__field">
                    <span>Postcode</span>
                    <span class="am__input" data-am-type="LS6">
                      LS6
                    </span>
                  </div>
                  <div class="am__field">
                    <span>The job</span>
                    <span class="am__input" data-am-type="Fuse box keeps tripping">
                      Fuse box keeps tripping
                    </span>
                  </div>
                  <span class="am__chip" data-am-chip>
                    fusebox.jpg added
                  </span>
                  <span class="am__btn am__send" data-am-send>
                    Send for a quote
                  </span>
                  <span class="am__toast" data-am-toast>
                    Sent. We'll reply within 24 hours.
                  </span>
                </div>
              </div>

              <div class="am__foot" data-am-at="foot">
                <div>
                  <p class="am__k">Areas</p>
                  <span class="am__chips">
                    <span data-am-area>Leeds</span>
                    <span data-am-area>Bradford</span>
                    <span data-am-area>Wakefield</span>
                    <span data-am-area>Harrogate</span>
                  </span>
                </div>
                <div>
                  <p class="am__k">Hours</p>
                  <p>Mon to Fri, 8am to 6pm</p>
                </div>
                <div>
                  <p class="am__k">Contact</p>
                  <p>Quote form, replies within 24 hours</p>
                </div>
              </div>
            </div>
          </div>
        </div>
        <span class="ba__mark" data-mark="1" style="--x:calc(100% - 1.3rem);--y:1.1rem;--i:1">
          1
        </span>
      </div>

      <div class="ba__extras" aria-hidden="true">
        <div class="ba__phone">
          <div class="ba__phone-screen">
            <div class="ba__phone-body" data-am-phone>
              <span class="am__logo">
                Ashby<b>.</b>
              </span>
              <span class="am__pill">Electricians in Leeds</span>
              <p class="am__h">Certified electricians. Fixed quotes within 24 hours.</p>
              <span class="am__btn">Get a fixed quote</span>
              <p class="am__k am__k--dark">Prices</p>
              <div class="am__row">
                <b>Safety inspection</b>
                <span>from £120</span>
              </div>
              <div class="am__row">
                <b>Consumer unit</b>
                <span>fixed quote</span>
              </div>
              <div class="am__row">
                <b>EV charger</b>
                <span>from £799</span>
              </div>
              <p class="am__k am__k--dark">How it works</p>
              <div class="am__row">
                <b>1 Send a photo</b>
              </div>
              <div class="am__row">
                <b>2 Get a fixed price</b>
              </div>
              <div class="am__row">
                <b>3 We do the job</b>
              </div>
              <span class="am__btn">Send for a quote</span>
            </div>
          </div>
          <span class="ba__mark" data-mark="2" style="--x:50%;--y:-4%;--i:2">
            2
          </span>
        </div>

        <div class="ba__data">
          <p class="ba__data-title">What an AI agent reads</p>
          <dl>
            <div class="ba__row" data-am-row="hero">
              <dt>Business</dt>
              <dd>Ashby Electrical</dd>
            </div>
            <div class="ba__row" data-am-row="services">
              <dt>Service</dt>
              <dd>EV charger install, from £799</dd>
            </div>
            <div class="ba__row" data-am-row="services">
              <dt>Service</dt>
              <dd>Safety inspection, from £120</dd>
            </div>
            <div class="ba__row" data-am-row="foot">
              <dt>Area</dt>
              <dd>Leeds, Bradford, Wakefield, Harrogate</dd>
            </div>
            <div class="ba__row" data-am-row="foot">
              <dt>Hours</dt>
              <dd>Mon to Fri, 8am to 6pm</dd>
            </div>
            <div class="ba__row" data-am-row="form">
              <dt>Contact</dt>
              <dd>Quote form, replies within 24 hours</dd>
            </div>
          </dl>
          <span class="ba__mark" data-mark="6" style="--x:97%;--y:-6%;--i:6">
            6
          </span>
        </div>
      </div>
    </div>
  </div>

  <ol class="ba__changes" data-pick>
    {changes.map((c, i) => (
      <li data-mark={i + 1} data-reveal style={`--reveal-delay:${(i % 3) * 0.06}s`}>
        <span class="ba__num" aria-hidden="true">
          {i + 1}
        </span>
        <h3 class="ba__title">{c.title}</h3>
        <p class="ba__line">
          <span class="ba__when">Before</span> {c.before}
        </p>
        <p class="ba__line">
          <span class="ba__when ba__when--after">After</span> {c.after}
        </p>
      </li>
    ))}
  </ol>
</div>

<script>
  import '../scripts/before-after';
</script>

<style>
  .ba {
    --win-radius: 14px;
    --sample-navy: #0b2545;
    --sample-amber: #ffb703;
    --sample-bg: #f3f6fa;
    /* The sample business's palette, shared by the after window and the phone. */
    --am-navy: var(--sample-navy);
    --am-amber: var(--sample-amber);
    --am-mid: #1d4f8a;
    --am-muted: #3d5470;
    --am-line: #d5dde8;
    --am-tint: #e2e9f3;
    display: grid;
    gap: var(--space-4);
  }

  .ba__stage {
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  .ba__col {
    position: relative;
    min-width: 0;
  }

  .ba__tag {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ba__tag--after {
    color: var(--ink);
  }

  /* ---------- browser windows ---------- */
  .ba__win {
    position: relative;
    border: 2px solid var(--ink);
    border-radius: var(--win-radius);
    background: #fff;
  }

  .ba__win--before {
    background: #fff;
  }

  .ba__chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 2.6rem 0.5rem 0.75rem;
    border-bottom: 2px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .ba__dots {
    display: flex;
    gap: 0.3rem;
    flex: none;
  }

  .ba__dots i {
    width: 0.55rem;
    aspect-ratio: 1;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
  }

  .ba__url {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    background: var(--paper);
    color: var(--ink);
  }

  .ba__url--bad b {
    color: #a3102f;
    font-weight: 600;
    margin-right: 0.35rem;
  }

  .ba__lock {
    display: inline-block;
    width: 0.55rem;
    height: 0.45rem;
    margin-right: 0.2rem;
    border-radius: 1px;
    background: var(--ink);
    position: relative;
    top: 0.05rem;
  }

  .ba__lock::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 0.35rem;
    height: 0.3rem;
    translate: -50% 0;
    border: 1.5px solid var(--ink);
    border-bottom: 0;
    border-radius: 0.3rem 0.3rem 0 0;
  }

  /* The page inside each window scales with the window: 40em across. */
  .ba__screen {
    container-type: inline-size;
    overflow: hidden;
    border-radius: 0 0 calc(var(--win-radius) - 2px) calc(var(--win-radius) - 2px);
  }

  .old {
    font-size: 2.5cqw;
  }

  /* ---------- before: dated site ---------- */
  .old {
    background: #fff;
    color: #111;
    font-family: 'Times New Roman', Times, serif;
    padding-bottom: 0.8em;
  }

  .old__head {
    background: #1a3d7c;
    color: #fff;
    font-size: 1.9em;
    padding: 0.35em 0.5em;
    font-style: italic;
  }

  .old__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 0.9em;
    padding: 0.45em 0.9em;
    background: #e6e6e6;
    color: #0000cc;
    font-size: 0.85em;
  }

  .old__banner {
    margin: 0.8em 0.9em 0;
    padding: 0.9em;
    background: #c5d3e0;
    color: #1a3d7c;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .old__body {
    display: grid;
    grid-template-columns: 13em 1fr;
    gap: 0.9em;
    margin: 0.9em 0.9em 0;
  }

  .old__photo {
    display: grid;
    place-content: center;
    gap: 0.5em;
    aspect-ratio: 4 / 3;
    background: #d4d4d4;
    color: #333;
    font-size: 0.8em;
    text-align: center;
  }

  .old__bar {
    display: block;
    width: 9em;
    height: 0.5em;
    border: 1px solid #555;
    background: #fff;
  }

  .old__bar span {
    display: block;
    width: 18%;
    height: 100%;
    background: #555;
  }

  .old__text {
    margin: 0;
    font-size: 0.85em;
    line-height: 1.35;
  }

  .old__tel {
    margin: 0.9em 0.9em 0;
    font-size: 0.95em;
    font-weight: 700;
  }

  .old__foot {
    margin: 0.7em 0.9em 0;
    font-size: 0.7em;
    color: #444;
  }

  /* ---------- after: the rebuilt site, a page that plays itself (scripts/before-after.ts) ---------- */
  /* A sketch, not a site to click through: nothing inside reacts to the pointer. */
  .ba__win--after,
  .ba__extras {
    pointer-events: none;
  }

  .am {
    position: relative;
    aspect-ratio: 16 / 10.5;
    background: var(--sample-bg);
  }

  /* 40em across, so everything inside scales with the window. */
  .am__view {
    position: absolute;
    inset: 0;
    overflow: hidden;
    font-size: 2.5cqw;
    font-family: var(--font-text);
    color: var(--am-navy);
  }

  .am__nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 2;
    display: flex;
    align-items: center;
    gap: 1.2em;
    height: 3.4em;
    padding: 0 1.4em;
    background: rgb(243 246 250 / 0.94);
    border-bottom: 1px solid var(--am-line);
  }

  .am__logo {
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.15em;
    letter-spacing: -0.02em;
  }

  .am__logo b {
    color: #b97f00;
  }

  .am__links {
    display: flex;
    gap: 1.4em;
    margin-left: auto;
    font-size: 0.72em;
    font-weight: 500;
  }

  .am__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0.62em 1.15em;
    border-radius: 99px;
    background: var(--am-amber);
    color: var(--am-navy);
    font-weight: 700;
    font-size: 0.76em;
    white-space: nowrap;
  }

  .am__btn--sm {
    font-size: 0.66em;
  }

  .am__btn--ghost {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px var(--am-navy);
  }

  /* The page scrolls inside the window by a CSS variable in em, so it holds at every width. */
  .am__page {
    position: relative;
    padding: 3.4em 1.4em 0;
    translate: 0 calc(var(--sy, 0) * -1em);
  }

  .am__hero {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 1.4em;
    align-items: center;
    min-height: 22.85em;
    padding: 1em 0;
  }

  .am__pill {
    display: inline-block;
    padding: 0.4em 0.85em;
    border-radius: 99px;
    background: var(--am-tint);
    font-size: 0.64em;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .am__h {
    margin: 0.5em 0 0.55em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.95em;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .am__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }

  .am__line > span {
    display: block;
  }

  .am__sub {
    margin: 0;
    max-width: 24em;
    font-size: 0.8em;
    line-height: 1.45;
