              <dt>Contact</dt>
              <dd>Quote form, replies within 24 hours</dd>
            </div>
          </dl>
          <span class="ba__mark" data-mark="6" style="--x:97%;--y:-6%;--i:6">
            6
          </span>
        </div>
      </div>
    </div>
  </div>

  <ol class="ba__changes" data-pick>
    {changes.map((c, i) => (
      <li data-mark={i + 1} data-reveal style={`--reveal-delay:${(i % 3) * 0.06}s`}>
        <span class="ba__num" aria-hidden="true">
          {i + 1}
        </span>
        <h3 class="ba__title">{c.title}</h3>
        <p class="ba__line">
          <span class="ba__when">Before</span> {c.before}
        </p>
        <p class="ba__line">
          <span class="ba__when ba__when--after">After</span> {c.after}
        </p>
      </li>
    ))}
  </ol>
</div>

<script>
  import '../scripts/before-after';
</script>

<style>
  .ba {
    --win-radius: 14px;
    /* The sample business's "Live wire" palette, shared by the after window and the phone. */
    --lw-black: #0e0f0d;
    --lw-panel: #171917;
    --lw-line: #2b2e2a;
    --lw-grid: rgb(242 239 230 / 0.045);
    --lw-hivis: #e4ff1a;
    --lw-copper: #d9783f;
    --lw-copper-hi: #f0a274;
    --lw-paper: #f2efe6;
    --lw-mute: #a7ada3;
    --lw-live: #2be0c4;
    display: grid;
    gap: var(--space-4);
  }

  .ba__stage {
    margin: 0;
    display: grid;
    gap: var(--space-5);
  }

  .ba__col {
    position: relative;
    min-width: 0;
  }

  .ba__tag {
    margin: 0 0 0.6rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .ba__tag--after {
    color: var(--ink);
  }

  /* ---------- browser windows ---------- */
  .ba__win {
    position: relative;
    border: 2px solid var(--ink);
    border-radius: var(--win-radius);
    background: #fff;
  }

  .ba__win--before {
    background: #fff;
  }

  .ba__chrome {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 2.6rem 0.5rem 0.75rem;
    border-bottom: 2px solid var(--ink);
    font-family: var(--font-mono);
    font-size: 0.7rem;
  }

  .ba__dots {
    display: flex;
    gap: 0.3rem;
    flex: none;
  }

  .ba__dots i {
    width: 0.55rem;
    aspect-ratio: 1;
    border: 1.5px solid var(--ink);
    border-radius: 50%;
  }

  .ba__url {
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    padding: 0.2rem 0.6rem;
    border-radius: 99px;
    background: var(--paper);
    color: var(--ink);
  }

  .ba__url--bad b {
    color: #a3102f;
    font-weight: 600;
    margin-right: 0.35rem;
  }

  .ba__lock {
    display: inline-block;
    width: 0.55rem;
    height: 0.45rem;
    margin-right: 0.2rem;
    border-radius: 1px;
    background: var(--ink);
    position: relative;
    top: 0.05rem;
  }

  .ba__lock::before {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 100%;
    width: 0.35rem;
    height: 0.3rem;
    translate: -50% 0;
    border: 1.5px solid var(--ink);
    border-bottom: 0;
    border-radius: 0.3rem 0.3rem 0 0;
  }

  /* The page inside each window scales with the window: 40em across. */
  .ba__screen {
    container-type: inline-size;
    overflow: hidden;
    border-radius: 0 0 calc(var(--win-radius) - 2px) calc(var(--win-radius) - 2px);
  }

  .old {
    font-size: 2.5cqw;
  }

  /* ---------- before: dated site ---------- */
  .old {
    background: #fff;
    color: #111;
    font-family: 'Times New Roman', Times, serif;
    padding-bottom: 0.8em;
  }

  .old__head {
    background: #1a3d7c;
    color: #fff;
    font-size: 1.9em;
    padding: 0.35em 0.5em;
    font-style: italic;
  }

  .old__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3em 0.9em;
    padding: 0.45em 0.9em;
    background: #e6e6e6;
    color: #0000cc;
    font-size: 0.85em;
  }

  .old__banner {
    margin: 0.8em 0.9em 0;
    padding: 0.9em;
    background: #c5d3e0;
    color: #1a3d7c;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-align: center;
  }

  .old__body {
    display: grid;
    grid-template-columns: 13em 1fr;
    gap: 0.9em;
    margin: 0.9em 0.9em 0;
  }

  .old__photo {
    display: grid;
    place-content: center;
    gap: 0.5em;
    aspect-ratio: 4 / 3;
    background: #d4d4d4;
    color: #333;
    font-size: 0.8em;
    text-align: center;
  }

  .old__bar {
    display: block;
    width: 9em;
    height: 0.5em;
    border: 1px solid #555;
    background: #fff;
  }

  .old__bar span {
    display: block;
    width: 18%;
    height: 100%;
    background: #555;
  }

  .old__text {
    margin: 0;
    font-size: 0.85em;
    line-height: 1.35;
  }

  .old__tel {
    margin: 0.9em 0.9em 0;
    font-size: 0.95em;
    font-weight: 700;
  }

  .old__foot {
    margin: 0.7em 0.9em 0;
    font-size: 0.7em;
    color: #444;
  }

  /* ---------- after: "Live wire", the rebuilt site, a page that plays itself (scripts/before-after.ts) ---------- */
  /* Cable black, hi-vis and copper, with a fuse board for a hero. */
  /* The default state is the finished page (switches on, wires drawn): reduced motion shows it complete. */
  /* A sketch, not a site to click through: nothing inside reacts to the pointer. */
  .ba__win--after,
  .ba__extras {
    pointer-events: none;
  }

  .am {
    position: relative;
    aspect-ratio: 16 / 10.5;
    background: var(--lw-black);
  }

  /* 40em across, so everything inside scales with the window. */
  .am__view {
    position: absolute;
    inset: 0;
    overflow: hidden;
    font-size: 2.5cqw;
    font-family: var(--font-text);
    color: var(--lw-paper);
  }

  /* A faint wiring-diagram grid behind the page. */
  .am__view::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--lw-grid) 1px, transparent 1px) 0 0 / 2em 2em,
      linear-gradient(90deg, var(--lw-grid) 1px, transparent 1px) 0 0 / 2em 2em;
  }

  .am__nav {
    position: absolute;
    inset: 0 0 auto;
    z-index: 3;
    display: flex;
    align-items: center;
    gap: 1.2em;
    height: 3.4em;
    padding: 0 1.4em;
    background: rgb(14 15 13 / 0.94);
    border-bottom: 1px solid var(--lw-line);
  }

  .lw-logo {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.05em;
    letter-spacing: 0.03em;
  }

  .lw-logo small {
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.48em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lw-mute);
  }

  .lw-logo__mark {
    position: relative;
    width: 1.15em;
    aspect-ratio: 1;
    background: var(--lw-hivis);
  }

  .lw-logo__mark::after {
    content: '';
    position: absolute;
    inset: 16%;
    background: var(--lw-black);
    clip-path: polygon(58% 0, 14% 58%, 46% 58%, 38% 100%, 86% 38%, 55% 38%);
  }

  .am__links {
    display: flex;
    gap: 1.4em;
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: 0.56em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lw-mute);
  }

  .am__btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.55em;
    padding: 0.75em 1.2em;
    border-radius: 0.2em;
    background: var(--lw-hivis);
    color: var(--lw-black);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 0.62em;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .am__btn--sm {
    font-size: 0.52em;
  }

  .am__btn--ghost {
    background: transparent;
    color: var(--lw-paper);
    box-shadow: inset 0 0 0 1.5px rgb(242 239 230 / 0.45);
  }

  .lw-arrow {
    width: 0.85em;
    height: 0.85em;
    background: currentColor;
    clip-path: polygon(0 42%, 56% 42%, 56% 12%, 100% 50%, 56% 88%, 56% 58%, 0 58%);
  }

  /* The page scrolls inside the window by a CSS variable in em, so it holds at every width. */
  .am__page {
    position: relative;
    z-index: 1;
    padding: 3.4em 1.4em 0;
    translate: 0 calc(var(--sy, 0) * -1em);
  }

  /* ---------- the live ticker, edged with hazard tape ---------- */
  .lw-ticker {
    display: flex;
    align-items: stretch;
    height: 1.7em;
    margin: 0 -1.4em;
    border-bottom: 1px solid var(--lw-line);
    background: var(--lw-panel);
  }

  .lw-ticker::before,
  .lw-ticker::after {
    content: '';
    flex: none;
    width: 1.4em;
    background: repeating-linear-gradient(
      -45deg,
      var(--lw-hivis) 0 0.32em,
      var(--lw-black) 0.32em 0.64em
    );
  }

  .lw-ticker__live {
    flex: none;
    display: flex;
    align-items: center;
    gap: 0.5em;
    padding: 0 0.9em;
    border-right: 1px solid var(--lw-line);
    color: var(--lw-hivis);
    font-family: var(--font-mono);
    font-size: 0.5em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .lw-ticker__live i {
    width: 0.6em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--lw-live);
  }

  .lw-ticker__run {
    flex: 1;
    min-width: 0;
    display: flex;
    align-items: center;
    overflow: hidden;
  }

  .lw-ticker__track {
    display: flex;
    flex: none;
    white-space: nowrap;
    color: var(--lw-mute);
    font-family: var(--font-mono);
    font-size: 0.5em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .lw-ticker__track span {
    padding: 0 1.4em;
    border-right: 1px solid var(--lw-line);
  }

  /* ---------- hero ---------- */
  .am__hero {
    display: grid;
    grid-template-columns: 1.45fr 1fr;
    gap: 1.6em;
    align-items: center;
    min-height: 21.15em;
    padding: 0.8em 0;
  }

  .lw-kicker,
  .am__eyebrow {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.7em;
    margin: 0;
    font-family: var(--font-mono);
    font-size: 0.54em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lw-mute);
  }

  .lw-kicker b,
  .am__eyebrow b {
    padding: 0.15em 0.45em;
    background: var(--lw-hivis);
    color: var(--lw-black);
    font-weight: 500;
  }

  .am__h {
    margin: 0.45em 0 0.5em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.72em;
    line-height: 0.98;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .lw-hot {
    color: var(--lw-hivis);
  }

  .am__line {
    display: block;
    overflow: hidden;
    padding-bottom: 0.05em;
  }

  .am__line > span {
    display: block;
  }

  .am__sub {
    margin: 0;
    max-width: 23em;
    font-size: 0.72em;
    line-height: 1.5;
    color: var(--lw-mute);
  }

  .am__ctas {
    display: flex;
    gap: 0.6em;
    margin-top: 1em;
  }

  .am__ticks {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4em 1.1em;
    margin: 1.1em 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 0.5em;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lw-mute);
  }

  .am__ticks li::before {
    content: '';
    display: inline-block;
    width: 0.65em;
    height: 0.35em;
    margin-right: 0.6em;
    border-left: 2px solid var(--lw-hivis);
    border-bottom: 2px solid var(--lw-hivis);
    rotate: -45deg;
    translate: 0 -0.2em;
  }

  /* ---------- the fuse board, the wire and the bulb ---------- */
  .am__art {
    position: relative;
    aspect-ratio: 1 / 1.08;
  }

  .lw-board {
    position: absolute;
    left: 0;
    right: 0;
    top: 3%;
    display: grid;
    gap: 0.55em;
    padding: 0.8em 0.8em 0.95em;
    background: var(--lw-panel);
    border: 1px solid var(--lw-line);
    border-radius: 0.3em;
  }

  .lw-board__label {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.44em;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--lw-mute);
  }

  .lw-board__row {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: 0.3em;
    padding: 0.5em 0.4em;
    background: #090a09;
    border-radius: 0.2em;
    box-shadow: inset 0 0 0 1px var(--lw-line);
  }

  .lw-brk {
    display: grid;
    justify-items: center;
    gap: 0.35em;
    padding: 0.4em 0 0.3em;
    background: #e9e6dc;
    border-radius: 0.15em;
  }

  /* The lever sits up (on) by default; the tour drops it and flips it back up. */
  .lw-brk__t {
    width: 46%;
    height: 1.05em;
    background: var(--lw-black);
    border-radius: 0.12em;
    box-shadow: 0 0.18em 0 #a9a59a;
  }

  .lw-brk i {
    width: 0.42em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--lw-hivis);
    box-shadow: 0 0 0.5em 0 rgb(228 255 26 / 0.9);
  }

  .lw-brk small {
    font-family: var(--font-mono);
    font-size: 0.28em;
    letter-spacing: 0.02em;
    text-transform: uppercase;
    color: #2d302b;
  }

  .lw-board__screws i {
    position: absolute;
    width: 0.32em;
    aspect-ratio: 1;
    border-radius: 50%;
    background: #3a3d37;
  }

  .lw-board__screws i:nth-child(1) {
    left: 0.3em;
    top: 0.3em;
  }

  .lw-board__screws i:nth-child(2) {
    right: 0.3em;
    top: 0.3em;
  }

  .lw-board__screws i:nth-child(3) {
    left: 0.3em;
    bottom: 0.3em;
  }

  .lw-board__screws i:nth-child(4) {
    right: 0.3em;
    bottom: 0.3em;
  }

  /* Strokes scale with their drawing: non-scaling-stroke plus pathLength measured dashes in mismatched units and lines only half-drew. */
  .am svg path {
    fill: none;
    stroke-dasharray: 1;
  }

  .lw-wire {
    position: absolute;
    left: 0;
    top: 45%;
    width: 100%;
    height: 30%;
    overflow: visible;
  }

  .lw-wire path {
    stroke: var(--lw-copper);
    stroke-width: 1.3;
    stroke-linecap: round;
  }

  /* Current: a short hi-vis dash that runs along the wire while the window plays. */
  .am svg .lw-wire__pulse {
    stroke: var(--lw-hivis);
    stroke-width: 1.3;
    stroke-dasharray: 0.12 0.88;
    stroke-dashoffset: 0.4;
  }

  .lw-bulb {
    position: absolute;
    left: 78%;
    top: 75%;
    display: grid;
    justify-items: center;
    translate: -50% 0;
  }

  .lw-bulb__cap {
    width: 0.9em;
    height: 0.6em;
    background: var(--lw-copper);
    border-radius: 0.1em 0.1em 0 0;
  }

  .lw-bulb__glass {
    width: 2em;
    aspect-ratio: 1;
    margin-top: -0.1em;
    border-radius: 50%;
    background: var(--lw-hivis);
    box-shadow: inset -0.3em -0.3em 0 rgb(14 15 13 / 0.18);
  }

  .lw-bulb__glow {
    position: absolute;
    left: 50%;
    top: 1.5em;
    z-index: -1;
    width: 6.5em;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(228 255 26 / 0.55), rgb(228 255 26 / 0) 65%);
  }

  /* A paper job tag, hung at an angle. */
  .am__float {
    position: absolute;
    left: 0;
    bottom: 3%;
    display: flex;
    align-items: center;
    gap: 0.65em;
    padding: 0.6em 0.9em 0.6em 0.6em;
    border-radius: 0.2em;
    background: var(--lw-paper);
    color: var(--lw-black);
    font-size: 0.56em;
    font-weight: 700;
    line-height: 1.2;
    rotate: -4deg;
  }

  .am__float small {
    display: block;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.75em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #4b4f47;
  }

  .lw-tag__hole {
    flex: none;
    width: 0.75em;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 0.18em solid var(--lw-black);
  }

  /* ---------- sections ---------- */
  .am__section {
    padding: 2.6em 0 0.6em;
  }

  .am__h2 {
    margin: 0.4em 0 1em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.4em;
    line-height: 1.04;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .am__cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.8em;
  }

  /* Service cards look like cable tags: copper top edge, a code, and a scan line on arrival. */
  .am__card {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: 0.45em;
    align-content: start;
    padding: 1em;
    border: 1px solid var(--lw-line);
    border-top: 0.28em solid var(--lw-copper);
    border-radius: 0.25em;
    background: var(--lw-panel);
  }

  .lw-scan {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, rgb(228 255 26 / 0.24), transparent);
    transform: translateX(-110%);
  }

  .lw-code {
    font-family: var(--font-mono);
    font-size: 0.46em;
    letter-spacing: 0.18em;
    color: var(--lw-copper-hi);
  }

  .lw-ico {
    width: 1.6em;
    height: 1.6em;
  }

  .am svg.lw-ico path {
    stroke: var(--lw-hivis);
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: none;
  }

  .am__card b {
    font-size: 0.74em;
  }

  .am__card p {
    margin: 0;
    font-size: 0.58em;
    line-height: 1.45;
    color: var(--lw-mute);
  }

  .am__price {
    margin-top: 0.2em;
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.3em;
    color: var(--lw-hivis);
  }

  .am__price small {
    margin-right: 0.4em;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 0.4em;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--lw-mute);
  }

  .am__price--quote {
    font-size: 0.95em;
  }

  /* How it works: a copper circuit, with a pulse that travels from step to step. */
  .am__track {
    position: relative;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1em;
  }

  .am__path {
    position: absolute;
    left: 1em;
    right: 1em;
    top: 0.9em;
    width: calc(100% - 2em);
    height: 0.25em;
  }

  .am__path path {
    stroke: var(--lw-copper);
    stroke-width: 3;
  }

  .lw-pulse {
    position: absolute;
    left: calc(1em + (100% - 2em) * var(--p, 0));
    top: 1.02em;
    z-index: 1;
    width: 0.75em;
    aspect-ratio: 1;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--lw-hivis);
    box-shadow: 0 0 0.9em 0.25em rgb(228 255 26 / 0.6);
    opacity: 0;
  }

  .am__step {
    position: relative;
    display: grid;
    gap: 0.4em;
    align-content: start;
  }

  .am__step b {
    margin-top: 0.3em;
    font-family: var(--font-display);
    font-size: 0.72em;
    letter-spacing: 0.02em;
    text-transform: uppercase;
  }

  .am__step p {
    margin: 0;
    font-size: 0.58em;
    line-height: 1.45;
    color: var(--lw-mute);
  }

  .am__dot {
    display: grid;
    place-items: center;
    width: 1.8em;
    aspect-ratio: 1;
    border: 2px solid var(--lw-hivis);
    border-radius: 0.2em;
    background: var(--lw-black);
    color: var(--lw-hivis);
    font-family: var(--font-mono);
    font-size: 0.78em;
    font-weight: 500;
  }

  /* The quote form is a paper job ticket with a punched top edge. */
  .am__quote {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    gap: 1.6em;
    align-items: start;
  }

  .am__form {
    position: relative;
    display: grid;
    gap: 0.45em;
    padding: 1.1em 1em 1em;
    border-radius: 0.25em;
    background: var(--lw-paper);
    color: var(--lw-black);
  }

  .am__form::before {
    content: '';
    position: absolute;
    inset: -0.35em 0.4em auto;
    height: 0.7em;
    background: radial-gradient(circle, var(--lw-black) 0.22em, transparent 0.25em) 0 50% / 0.9em
      100% repeat-x;
  }

  .lw-ticket {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.55em;
    border-bottom: 1.5px dashed rgb(14 15 13 / 0.35);
    font-family: var(--font-mono);
    font-size: 0.48em;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .lw-ticket span:last-child {
    padding: 0.1em 0.5em;
    background: var(--lw-black);
    color: var(--lw-hivis);
  }

  .am__field {
    display: grid;
    gap: 0.3em;
  }

  .am__field > span:first-child {
    font-family: var(--font-mono);
    font-size: 0.48em;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: #474a43;
  }

  .am__input {
    min-height: 2.1em;
    padding: 0.45em 0.7em;
    border: 1.5px solid var(--lw-black);
    border-radius: 0.15em;
    background: #fff;
    font-size: 0.68em;
  }

  /* A typing caret after the text. */
  .am__input::after {
    content: '';
    display: inline-block;
    width: 0.09em;
    height: 1em;
    margin-left: 0.12em;
    background: var(--lw-black);
    vertical-align: -0.12em;
  }

  .am__chip {
    justify-self: start;
    padding: 0.35em 0.7em;
    border-radius: 0.15em;
    background: var(--lw-black);
    color: var(--lw-hivis);
    font-family: var(--font-mono);
    font-size: 0.52em;
    letter-spacing: 0.06em;
  }

  .am__send {
    justify-self: stretch;
  }

  .am__toast {
    padding: 0.55em 0.8em;
    border-radius: 0.15em;
    background: var(--lw-black);
    color: var(--lw-live);
    font-family: var(--font-mono);
    font-size: 0.54em;
    letter-spacing: 0.04em;
  }

  /* The footer is edged with hazard tape. */
  .am__foot {
    position: relative;
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: 1.2em;
    margin: 2.6em -1.4em 0;
    padding: 2.3em 1.4em 2.2em;
    background: var(--lw-panel);
    color: var(--lw-paper);
  }

  .am__foot::before {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    height: 0.7em;
    background: repeating-linear-gradient(
      -45deg,
      var(--lw-hivis) 0 0.5em,
      var(--lw-black) 0.5em 1em
    );
  }

  .am__foot p {
    margin: 0;
    font-size: 0.66em;
    line-height: 1.45;
  }

  .am__k {
    margin: 0 0 0.6em !important;
    font-family: var(--font-mono);
    font-size: 0.48em !important;
    font-weight: 500;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--lw-hivis);
  }

  .am__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35em;
  }

  .am__chips span {
    padding: 0.3em 0.7em;
    border: 1px solid rgb(242 239 230 / 0.4);
    border-radius: 0.15em;
    font-family: var(--font-mono);
    font-size: 0.54em;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* ---------- loops that run only while the window plays (and never under reduced motion) ---------- */
  @media (prefers-reduced-motion: no-preference) {
