                    <span class="lw-brk__t"></span>
                    <i></i>
                  </span>
                  <span class="lw-brk">
                    <span class="lw-brk__t"></span>
                    <i></i>
                  </span>
                  <span class="lw-brk">
                    <span class="lw-brk__t"></span>
                    <i></i>
                  </span>
                </span>
              </span>
              <p class="am__k">Prices</p>
              <div class="am__row">
                <b>Safety inspection</b>
                <span>from £120</span>
              </div>
              <div class="am__row">
                <b>Consumer unit</b>
                <span>fixed quote</span>
              </div>
              <div class="am__row">
                <b>EV charger</b>
                <span>from £799</span>
              </div>
              <p class="am__k">How it works</p>
              <div class="am__row">
                <b>1 Send a photo</b>
              </div>
              <div class="am__row">
                <b>2 Get a fixed price</b>
              </div>
              <div class="am__row">
                <b>3 We do the job</b>
              </div>
              <span class="am__btn">Send for a quote</span>
            </div>
          </div>
          <span class="ba__mark" data-mark="2" style="--x:50%;--y:-4%;--i:2">
            2
          </span>
        </div>

        <div class="ba__data">
          <p class="ba__data-title">What an AI agent reads</p>
          <dl>
            <div class="ba__row" data-am-row="hero">
              <dt>Business</dt>
              <dd>Ashby Electrical</dd>
            </div>
            <div class="ba__row" data-am-row="services">
              <dt>Service</dt>
              <dd>EV charger install, from £799</dd>
