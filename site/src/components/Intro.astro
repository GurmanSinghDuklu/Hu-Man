---
import Arrow from './Arrow.astro';

// Every figure here is a fact from docs/02-offer-and-pricing.md or the
// site's own behaviour, never a client statistic.
const facts = [
  { value: 1125, prefix: '£', label: 'Introductory websites from' },
  { value: 2, label: 'Revision rounds included' },
  { value: 30, label: 'Days your quote stays valid' },
  { value: 0, label: 'Tracking cookies on this site' },
];
---

<section class="intro" aria-labelledby="intro-title">
  <div class="wrap intro__inner">
    <p class="eyebrow" data-reveal>
      The studio
    </p>
    <h2 id="intro-title" class="intro__title" data-reveal>
      A one-person studio for <span class="hl">local businesses</span>
    </h2>
    <p class="intro__text" data-reveal>
      Local businesses deserve websites as good as national brands'. I design, build and test every
      site, app and assistant myself, then look after it month by month.
    </p>
    <a href="#services" class="btn btn--dark" data-reveal>
      Explore services
      <span class="btn__icon">
        <Arrow />
      </span>
    </a>

    <ul class="intro__facts">
      {facts.map((fact, i) => (
        <li data-reveal style={`--reveal-delay:${i * 0.08}s`}>
          <span class="intro__num" data-count={fact.value} data-prefix={fact.prefix ?? ''}>
            {fact.prefix ?? ''}
            {fact.value.toLocaleString('en-GB')}
          </span>
          <span class="intro__label">{fact.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(3.5rem, 8vw, 6.5rem);
  }

  .intro__inner {
    display: grid;
    justify-items: center;
    text-align: center;
    gap: var(--space-4);
  }

  .intro__title {
    font-size: clamp(2.2rem, 5.2vw, 4.25rem);
    max-width: 14em;
    text-transform: uppercase;
    letter-spacing: -0.045em;
  }

  .intro__text {
    max-width: 36rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .intro__facts {
    list-style: none;
    margin: var(--space-5) 0 0;
    padding: 0;
    width: 100%;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1px;
    background: var(--color-line);
    box-shadow:
      0 0 0 1px rgba(0, 255, 48, 0.04),
      0 40px 80px -40px rgba(0, 255, 48, 0.18);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .intro__facts li {
    display: grid;
    gap: 0.35rem;
    padding: clamp(1.5rem, 3vw, 2.5rem) 1rem;
    background: var(--surface);
  }

  .intro__num {
    font-size: clamp(2.2rem, 4.6vw, 3.75rem);
    font-weight: 800;
    letter-spacing: -0.05em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .intro__label {
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  @media (min-width: 48rem) {
    .intro__facts {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
