---
import Module from './Module.astro';

// Every figure here is a fact from docs/02-offer-and-pricing.md or the
// site's own behaviour, never a client statistic.
// The introductory price is the one offer, so it takes the Pulse block (docs/brand: Pulse
// is for offers). Numerals are graphics in their own cells.
const facts = [
  { value: 1125, prefix: '£', label: 'Introductory websites from', offer: true },
  { value: 2, label: 'Revision rounds included' },
  { value: 30, label: 'Days your quote stays valid' },
  { value: 0, label: 'Tracking cookies on this site' },
];
---

<section class="intro" aria-labelledby="intro-title">
  <div class="wrap">
    <div class="intro__head">
      <div class="intro__lead">
        <p class="eyebrow" data-reveal>
          The studio
        </p>
        <h2 id="intro-title" class="intro__title" data-reveal>
          A one-person studio for <span class="hl">local businesses</span>
        </h2>
      </div>
      <div class="intro__side">
        <p class="intro__text" data-reveal>
          Local businesses deserve websites as good as national brands'. I design, build and test
          every site, app and assistant myself, then look after it month by month.
        </p>
        <a href="#services" class="btn btn--secondary" data-reveal>
          Explore services
        </a>
      </div>
    </div>

    <ul class="intro__facts" data-cells>
      {facts.map((fact) => (
        <li class:list={['intro__fact', { 'intro__fact--offer': fact.offer }]}>
          <span class="intro__label">{fact.label}</span>
          <span class="intro__num" data-count={fact.value} data-prefix={fact.prefix ?? ''}>
            {`${fact.prefix ?? ''}${fact.value.toLocaleString('en-GB')}`}
          </span>
        </li>
      ))}
      <li class="intro__module" aria-hidden="true">
        <Module kind="rings" fg="signal" bg="ink" />
      </li>
    </ul>
  </div>
</section>

<style>
  .intro {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .intro__head {
    display: grid;
    gap: var(--space-4);
    align-items: end;
    margin-bottom: var(--space-5);
  }

  .intro__lead {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
  }

  .intro__title {
    font-size: clamp(2.25rem, 5.2vw, 4.25rem);
    max-width: 12em;
  }

  .intro__side {
    display: grid;
    gap: var(--space-4);
    justify-items: start;
    max-width: 34rem;
  }

  .intro__text {
    color: var(--color-text-muted);
    font-size: 1.125rem;
  }

  /* A flush module row: square cells, hairline rules, one Pulse block for the offer. */
  .intro__facts {
    container-type: inline-size;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    grid-auto-rows: 50cqw;
    gap: var(--border-hairline);
    background: var(--line);
    border: var(--border-hairline) solid var(--line);
  }

  .intro__fact {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: 1rem;
    overflow: hidden;
    background: var(--brand-ink);
  }

  .intro__fact--offer {
    grid-column: span 2;
    background: var(--pulse);
    color: var(--on-pulse);
  }

  .intro__label {
    font: 500 0.75rem/1.35 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-muted);
    max-width: 14em;
  }

  .intro__fact--offer .intro__label {
    color: var(--on-pulse);
  }

  /* Numerals are graphics: huge, tight, sitting on the cell's bottom edge. */
  .intro__num {
    font: 800 24cqw/0.8 var(--font-display);
    letter-spacing: -0.04em;
    font-variant-numeric: tabular-nums;
    color: var(--signal);
    margin-bottom: -0.06em;
    white-space: nowrap;
  }

  .intro__fact--offer .intro__num {
    color: var(--on-pulse);
  }

  .intro__module {
    display: block;
    background: var(--brand-ink);
  }

  .intro__module :global(.mod) {
    height: 100%;
  }

  @media (min-width: 48rem) {
    .intro__head {
      grid-template-columns: 1.2fr 1fr;
    }

    .intro__facts {
      grid-template-columns: repeat(6, 1fr);
      grid-auto-rows: calc(100cqw / 6);
    }

    .intro__fact {
      padding: 1.25rem;
    }

    .intro__num {
      font-size: 8.5cqw;
    }
  }
</style>
