---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InnerHero from '../components/InnerHero.astro';
import PrettyEnough from '../components/sections/PrettyEnough.astro';
import IdeasToLife from '../components/sections/IdeasToLife.astro';
import AgentReady from '../components/sections/AgentReady.astro';
import AtTheCentre from '../components/sections/AtTheCentre.astro';
import TalkBanner from '../components/TalkBanner.astro';
import Sparkle from '../components/Sparkle.astro';
import { serviceAreas } from '../data/services';

// "Projects and care": what is paid once and what a care plan covers (from the design).
const projects = [
  'New websites and stores',
  'Redesigns and moves',
  'Mobile apps',
  'Branding and design',
  'Custom software',
  'Domain registration',
];

const care = [
  'Hosting + SSL certificates',
  'Security updates + backups',
  'Site, store and app maintenance',
  'Small fixes, no extra bill',
  'Technical support from a real person',
];

// The darker header bands carry paper type, as in the design.
const lightNumber = new Set(['indigo', 'dusk']);
---

<BaseLayout page="services">
  <SiteHeader slot="header" />

  <InnerHero label="What we do" lens="Lens 02 / What we do">
    <Fragment slot="title">
      Got an idea?
      <br />
      Let’s build it.
    </Fragment>
    <Fragment slot="lede">
      From a first website to custom software, we design it, build it and look after it. A real
      person works it through with you, start to finish.
    </Fragment>
  </InnerHero>

  <PrettyEnough n="01" />
  <IdeasToLife n="02" />

  <section class="band grid svc section" aria-labelledby="svc-title">
    <div class="sheet">
      <p class="label" data-reveal>
        03 / Our services
      </p>
      <h2 id="svc-title" class="display display--m" data-reveal>
        Everything under one roof.
      </h2>
      <p class="svc__legend" data-reveal>
        <span class="care-pill">Care plan</span>
        <span class="label">Ongoing, covered by a monthly care plan</span>
      </p>

      <ul class="svc__cards">
        {serviceAreas.map((s, i) => (
          <li
            class:list={['svc__card', `svc__card--${i + 1}`]}
            data-reveal
            style={`--reveal-delay:${(i % 2) * 0.08}s`}
          >
            <div
              class:list={[
                'svc__head',
                `fill--${s.style}`,
                { 'svc__head--light': lightNumber.has(s.style) },
              ]}
            >
              <span class="svc__n">{String(i + 1).padStart(2, '0')}</span>
              <Sparkle class="svc__star" />
            </div>
            <div class="svc__body">
              <h3>{s.title}</h3>
              <p class="svc__short">{s.short}</p>
              <ul class="svc__items">
                {s.items.map((item) => (
                  <li>
                    <span>{item.text}</span>
                    {item.care && <span class="care-pill">Care plan</span>}
                  </li>
                ))}
              </ul>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--paper-2 paid section" aria-labelledby="paid-title">
    <div class="sheet">
      <p class="label" data-reveal>
        04 / How it’s paid for
      </p>
      <h2 id="paid-title" class="display" data-reveal>
        Projects and care.
      </h2>

      <div class="paid__cards">
        <div class="paid__col">
          <div class="paid__card paid__card--projects" data-reveal>
            <p class="label">Pay once · You own it</p>
            <h3>Projects</h3>
            <ul>
              {projects.map((p) => (
                <li>
                  <Sparkle class="paid__star" />
                  {p}
                </li>
              ))}
            </ul>
          </div>
          <p class="paid__note">Not sure which you need? Ask us. We’ll tell you straight.</p>
        </div>
        <div class="paid__col">
          <div class="paid__card paid__card--care" data-reveal style="--reveal-delay:0.08s">
            <p class="label">Monthly · We look after it</p>
            <h3>Care plans</h3>
            <ul>
              {care.map((c) => (
                <li>
                  <Sparkle class="paid__star" />
                  {c}
                </li>
              ))}
            </ul>
          </div>
          <p>
            <span class="care-pill paid__pill">Care plan prices being finalised</span>
          </p>
        </div>
      </div>
    </div>
  </section>

  <AgentReady n="05" />
  <AtTheCentre n="06" />
  <TalkBanner />

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* Peach mono pill marking care-plan work (and the "prices being finalised" note). */
  .care-pill {
    display: inline-flex;
    align-items: center;
    flex: none;
    padding: 0.3rem 0.75rem;
    border: 1px solid var(--ink);
    border-radius: 999px;
    background: var(--peach);
    font: 500 0.625rem/1.2 var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* ---------- service cards ---------- */
  .svc__legend {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
    margin-top: clamp(1.5rem, calc(var(--u) * 0.55), 3rem);
  }

  .svc__legend .label {
    font-size: 0.75rem;
  }

  .svc__cards {
    display: grid;
    gap: max(16px, calc(var(--u) * 0.33));
    margin-top: clamp(1.5rem, calc(var(--u) * 0.45), 2.5rem);
  }

  .svc__card {
    --r: calc(var(--u) * 1);
    display: flex;
    flex-direction: column;
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  /* Which top corner each card rounds, as in the design. */
  .svc__card--1,
  .svc__card--4,
  .svc__card--5 {
    border-top-right-radius: var(--r);
  }

  .svc__card--2,
  .svc__card--3,
  .svc__card--6 {
    border-top-left-radius: var(--r);
  }

  .svc__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-height: max(76px, calc(var(--u) * 1.11));
    padding: 0 clamp(1.25rem, calc(var(--u) * 0.55), 3rem) 0
      clamp(1.1rem, calc(var(--u) * 0.33), 2rem);
    border-bottom: 1px solid var(--ink);
    border-radius: inherit;
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
  }

  .svc__head--light {
    color: var(--paper);
  }

  .svc__n {
    font: 800 clamp(2.2rem, calc(var(--u) * 0.63), 3.8rem) / 1 var(--font-display);
    letter-spacing: -0.02em;
  }

  .svc__head :global(.svc__star) {
    width: clamp(1.4rem, calc(var(--u) * 0.36), 2.1rem);
    fill: currentColor;
  }

  .svc__body {
    padding: clamp(1.25rem, calc(var(--u) * 0.36), 2.25rem)
      clamp(1.1rem, calc(var(--u) * 0.33), 2rem) clamp(1rem, calc(var(--u) * 0.2), 1.5rem);
  }

  .svc__body h3 {
    font-size: clamp(1.25rem, calc(var(--u) * 0.34), 2.1rem);
    line-height: 1;
  }

  .svc__short {
    margin-top: 0.5rem;
    color: #3b3d39;
    font-size: clamp(1rem, calc(var(--u) * 0.19), 1.15rem);
  }

  .svc__items {
    margin-top: clamp(1rem, calc(var(--u) * 0.22), 1.4rem);
  }

  .svc__items li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    min-height: max(40px, calc(var(--u) * 0.44));
    padding-block: 0.4rem;
    border-top: 1px solid var(--line-soft);
    font-size: clamp(0.95rem, calc(var(--u) * 0.172), 1.05rem);
  }

  /* ---------- projects and care ---------- */
  .paid__cards {
    display: grid;
    gap: 2rem max(16px, calc(var(--u) * 0.33));
    margin-top: clamp(2rem, calc(var(--u) * 0.8), 4.5rem);
  }

  .paid__col {
    display: grid;
    align-content: start;
    gap: 1rem;
  }

  .paid__card {
    padding: clamp(1.5rem, calc(var(--u) * 0.41), 2.5rem);
    border: 1px solid var(--ink);
  }

  .paid__card--projects {
    border-top-right-radius: calc(var(--u) * 1.6);
    background: var(--paper);
  }

  .paid__card--care {
    border-bottom-right-radius: calc(var(--u) * 1.1);
    background: var(--ink);
    color: var(--paper);
  }

  .paid__card h3 {
    margin: 0.4rem 0 clamp(1rem, calc(var(--u) * 0.28), 1.75rem);
    font-size: clamp(2.2rem, calc(var(--u) * 0.66), 4rem);
  }

  .paid__card li {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-height: max(44px, calc(var(--u) * 0.52));
    border-top: 1px solid var(--line-soft);
    font-size: clamp(1rem, calc(var(--u) * 0.19), 1.15rem);
  }

  .paid__card--care li {
    border-top-color: #2f312d;
  }

  .paid__card :global(.paid__star) {
    flex: none;
    width: 0.8rem;
  }

  .paid__note {
    font-size: clamp(1rem, calc(var(--u) * 0.19), 1.15rem);
  }

  .paid__pill {
    padding: 0.5rem 0.9rem;
    font-size: 0.6875rem;
  }

  @media (min-width: 48rem) {
    .svc__cards,
    .paid__cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .svc__legend .label,
    .care-pill {
      font-size: calc(var(--u) * 0.11);
    }

    .svc__legend .label {
      font-size: calc(var(--u) * 0.125);
    }

    .paid__card {
      min-height: calc(var(--u) * 5.2);
    }

    .paid__card .label {
      font-size: calc(var(--u) * 0.125);
    }

    .paid__pill {
      font-size: calc(var(--u) * 0.115);
    }
  }
</style>
