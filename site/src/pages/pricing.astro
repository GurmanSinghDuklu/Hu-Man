---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InnerHero from '../components/InnerHero.astro';
import HeadlineCards from '../components/HeadlineCards.astro';
import TalkBanner from '../components/TalkBanner.astro';
import { tiers, carePlans, careRules, careFixPromise, fromPrice, fastTrack } from '../data/pricing';
import { contactPath } from '../config/links';
import { withBase } from '../config/paths';
---

<BaseLayout page="pricing">
  <SiteHeader slot="header" />

  <InnerHero label="Pricing" lens="Lens 03 / Pricing" video="pricing" intro="receipt">
    <Fragment slot="title">
      Start at
      <br />
      {fromPrice}. Grow
      <br />
      from there.
    </Fragment>
    <Fragment slot="lede">
      Pick the tier you need today. Move up any time and only pay the difference.
    </Fragment>
  </InnerHero>

  <section class="band grid cards" aria-labelledby="tiers-title">
    <div class="sheet">
      <h2 id="tiers-title" class="label">
        {tiers.length} tiers · Pay once · Timelines on every card
      </h2>
      <p class="cards__text">
        Every tier includes a human from first call to launch, three revision rounds and full
        ownership.
      </p>
      <div class="cards__grid">
        <HeadlineCards />
      </div>
      <p class="cards__fast" data-reveal>
        <strong>{fastTrack.title}.</strong>
        {fastTrack.text}
      </p>
    </div>
  </section>

  <section class="band grid care" aria-labelledby="care-title">
    <div class="sheet">
      <p class="label" data-reveal>
        Support that stays
      </p>
      <h2 id="care-title" class="display care__title" data-reveal="lines">
        Care plans
      </h2>
      <p class="care__text" data-reveal data-scrub="words">
        Monthly plans for hosting, security, backups and fixes, with time for edits on top. Add one
        to any website we build.
      </p>
      <ul class="care__grid">
        {carePlans.map((plan, i) => (
          <li class:list={['plan', `plan--${plan.id}`]} data-rise={i % 5}>
            <p class="plan__for">{plan.forWho}</p>
            <h3 class="plan__name">{plan.name}</h3>
            <p class="plan__price">{plan.price}</p>
            <ul class="plan__list">
              {plan.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <a
              class="pill-btn plan__btn"
              href={withBase(contactPath({ tier: `Care plan: ${plan.name}` }))}
            >
              Ask about {plan.name}
            </a>
          </li>
        ))}
      </ul>
      <p class="care__rules" data-reveal>
        {careRules}
      </p>
      <p class="care__fix" data-reveal>
        <strong>Our fix promise.</strong>
        {careFixPromise}
        <a href={withBase('/terms/')}>Read what that covers</a>.
      </p>
    </div>
  </section>

  <section class="band band--paper-2 pricing-faq" aria-label="Questions">
    <div class="sheet">
      <p class="pricing-faq__line" data-reveal>
        Questions? <a href={withBase('/about/#faq')}>Read our FAQ</a>
      </p>
    </div>
  </section>

  <TalkBanner />

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* ---------- headline cards ---------- */
  .cards {
    padding-block: clamp(2.5rem, calc(var(--u) * 0.6), 3.5rem)
      clamp(3rem, calc(var(--u) * 0.66), 4rem);
    border-top: 1px solid var(--grid-line);
  }

  .cards__text {
    max-width: 38rem;
    margin-top: 0.5rem;
    font-size: clamp(1rem, calc(var(--u) * 0.18), 1.1rem);
  }

  .cards__grid {
    margin-top: clamp(2rem, calc(var(--u) * 0.6), 3.5rem);
  }

  /* Fast Track: a quiet line, not a card. */
  .cards__fast {
    max-width: 46rem;
    margin-top: clamp(1.5rem, calc(var(--u) * 0.4), 2.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .cards__fast strong {
    color: var(--ink);
  }

  /* ---------- care plans ---------- */
  .care {
    padding-block: clamp(3.5rem, calc(var(--u) * 0.66), 4rem)
      clamp(3rem, calc(var(--u) * 0.66), 4rem);
  }

  .care__title {
    margin-top: 0.3rem;
  }

  .care__text {
    max-width: 38rem;
    margin-top: 1rem;
    font-size: clamp(1rem, calc(var(--u) * 0.18), 1.1rem);
  }

  .care__grid {
    display: grid;
    gap: max(12px, calc(var(--u) * 0.2));
    margin-top: clamp(2rem, calc(var(--u) * 0.6), 3.5rem);
  }

  .plan {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 15rem;
    padding: clamp(1.25rem, calc(var(--u) * 0.3), 1.75rem);
    border: 1px solid var(--ink);
    border-top-left-radius: calc(var(--u) * 0.9);
    background: var(--paper);
    color: var(--ink);
  }

  .plan--care {
    background: var(--paper-2);
  }

  .plan--grow {
    background: var(--peach);
  }

  .plan--software-care {
    background: var(--grad-lilac);
  }

  .plan--software-care-plus {
    background: var(--ink);
    color: var(--paper);
  }

  .plan__for {
    font: 400 0.8125rem var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .plan__name {
    font-size: clamp(1.15rem, calc(var(--u) * 0.22), 1.4rem);
    line-height: 1;
  }

  .plan__price {
    font: 800 clamp(2.2rem, calc(var(--u) * 0.5), 3rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .plan__list {
    display: grid;
    gap: 0.35rem;
    font-size: clamp(0.85rem, calc(var(--u) * 0.15), 0.95rem);
    line-height: 1.35;
  }

  .plan__list li {
    position: relative;
    padding-left: 1rem;
  }

  .plan__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 0.4rem;
    height: 1.5px;
    background: currentColor;
  }

  .plan__btn {
    align-self: flex-start;
    margin-top: auto;
    border-color: currentColor;
  }

  .plan__list {
    margin-bottom: 0.75rem;
  }

  .care__rules,
  .care__fix {
    max-width: 46rem;
    margin-top: clamp(1.5rem, calc(var(--u) * 0.4), 2.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .care__fix {
    margin-top: 1rem;
  }

  .care__rules strong,
  .care__fix strong {
    color: var(--ink);
  }

  .care__fix a {
    color: var(--ink);
    font-weight: 600;
  }

  @media (min-width: 40rem) {
    .care__grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .plan:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 64rem) {
    .care__grid {
      grid-template-columns: repeat(5, 1fr);
    }

    .plan:last-child:nth-child(odd) {
      grid-column: auto;
    }

    .plan {
      min-height: calc(var(--u) * 3.6);
    }
  }

  /* ---------- the one-line FAQ pointer ---------- */
  .pricing-faq {
    padding-block: clamp(2rem, calc(var(--u) * 0.5), 3rem);
  }

  .pricing-faq__line {
    font: 800 clamp(1.05rem, calc(var(--u) * 0.225), 1.4rem) / 1.2 var(--font-display);
    text-transform: uppercase;
  }

  .pricing-faq__line a {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
</style>
