---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InnerHero from '../components/InnerHero.astro';
import HeadlineCards from '../components/HeadlineCards.astro';
import TalkBanner from '../components/TalkBanner.astro';
import { tiers, carePlansNote, fromPrice, fastTrack } from '../data/pricing';
import { faq } from '../data/faq';
---

<BaseLayout page="pricing">
  <SiteHeader slot="header" />

  <InnerHero label="Pricing" lens="Lens 03 / Pricing">
    <Fragment slot="title">
      Start at
      <br />
      {fromPrice}. Grow
      <br />
      from there.
    </Fragment>
    <Fragment slot="lede">
      Pick the tier you need today. Move up any time and only pay the difference.
    </Fragment>
  </InnerHero>

  <section class="band grid cards" aria-labelledby="tiers-title">
    <div class="sheet">
      <h2 id="tiers-title" class="label">
        {tiers.length} tiers · Pay once · Timelines on every card
      </h2>
      <p class="cards__text">
        Every tier includes a human from first call to launch, three revision rounds and full
        ownership.
      </p>
      <div class="cards__grid">
        <HeadlineCards />
      </div>
      <p class="cards__fast" data-reveal>
        <strong>{fastTrack.title}.</strong>
        {fastTrack.text}
      </p>
    </div>
  </section>

  <section class="band grid care" aria-labelledby="care-title">
    <div class="sheet">
      <p class="label" data-reveal>
        Support that stays
      </p>
      <div class="care__head" data-reveal>
        <h2 id="care-title" class="display care__title">
          Care plans
        </h2>
        <span class="pill care__draft">Launching soon</span>
      </div>
      <p class="care__text" data-reveal>
        {carePlansNote}
      </p>
    </div>
  </section>

  <section class="band band--paper-2 faq" id="faq" aria-labelledby="faq-title">
    <div class="sheet">
      <p class="label" data-reveal>
        Pricing questions
      </p>
      <h2 id="faq-title" class="display faq__title" data-reveal="lines">
        FAQ
      </h2>
      <ul class="faq__list">
        {faq.map((item) => (
          <li>
            <details class="faq__item" open>
              <summary>
                <span class="faq__q">{item.q}</span>
                <span class="faq__toggle" aria-hidden="true" />
              </summary>
              <p class="faq__a">{item.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <TalkBanner />

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* ---------- headline cards ---------- */
  .cards {
    padding-block: clamp(2.5rem, calc(var(--u) * 0.6), 3.5rem)
      clamp(3rem, calc(var(--u) * 0.66), 4rem);
    border-top: 1px solid var(--grid-line);
  }

  .cards__text {
    max-width: 38rem;
    margin-top: 0.5rem;
    font-size: clamp(1rem, calc(var(--u) * 0.18), 1.1rem);
  }

  .cards__grid {
    margin-top: clamp(2rem, calc(var(--u) * 0.6), 3.5rem);
  }

  /* Fast Track: a quiet line, not a card. */
  .cards__fast {
    max-width: 46rem;
    margin-top: clamp(1.5rem, calc(var(--u) * 0.4), 2.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--ink);
    font-size: 0.9375rem;
    line-height: 1.5;
    color: var(--muted);
  }

  .cards__fast strong {
    color: var(--ink);
  }

  /* ---------- care plans ---------- */
  .care {
    padding-block: clamp(3.5rem, calc(var(--u) * 0.66), 4rem)
      clamp(3rem, calc(var(--u) * 0.66), 4rem);
  }

  .care__head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem calc(var(--u) * 0.45);
    margin-top: 0.3rem;
  }

  .care__draft {
    background: var(--peach);
    white-space: normal;
  }

  .care__text {
    max-width: 38rem;
    margin-top: 1rem;
    font-size: clamp(1rem, calc(var(--u) * 0.18), 1.1rem);
  }

  /* ---------- FAQ ---------- */
  .faq {
    padding-block: clamp(3.5rem, calc(var(--u) * 0.9), 5.5rem)
      clamp(3rem, calc(var(--u) * 0.8), 5rem);
  }

  .faq__title {
    margin-top: 0.3rem;
  }

  .faq__list {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, calc(var(--u) * 0.6), 3.5rem);
  }

  .faq__item {
    position: relative;
    min-height: 100%;
    padding: clamp(1.25rem, calc(var(--u) * 0.38), 2.25rem);
    border: 1px solid var(--ink);
    border-radius: 0 calc(var(--u) * 0.72) calc(var(--u) * 0.72) 0;
    background: var(--paper);
  }

  .faq__item summary {
    display: block;
    padding-right: 3.5rem;
    list-style: none;
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font: 800 clamp(1.05rem, calc(var(--u) * 0.225), 1.4rem) / 1.05 var(--font-display);
    text-transform: uppercase;
  }

  /* The toggle sits centred on the card's right, as in the design. */
  .faq__toggle {
    position: absolute;
    right: clamp(1.25rem, calc(var(--u) * 0.34), 2.25rem);
    top: 50%;
    translate: 0 -50%;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item:not([open]) .faq__toggle {
    top: clamp(1.25rem, calc(var(--u) * 0.38), 2.25rem);
    translate: none;
  }

  /* Open shows the minus; the first card is pink, as in the design. */
  .faq__item[open] .faq__toggle::after {
    display: none;
  }

  .faq__list li:first-child .faq__toggle {
    background: var(--pink);
  }

  .faq__a {
    max-width: 36rem;
    margin-top: 0.5rem;
    padding-right: 3.5rem;
    font-size: clamp(0.9rem, calc(var(--u) * 0.165), 1rem);
    line-height: 1.5;
  }

  .faq__a a {
    font-weight: 600;
  }

  @media (min-width: 48rem) {
    .faq__list {
      grid-template-columns: repeat(2, 1fr);
      gap: calc(var(--u) * 0.22) calc(var(--u) * 0.33);
    }

    .faq__list li:nth-child(odd) .faq__item {
      border-radius: calc(var(--u) * 0.72) calc(var(--u) * 0.72) calc(var(--u) * 0.72) 0;
    }
  }

  @media (min-width: 64rem) {
    .faq__item {
      min-height: calc(var(--u) * 1.44);
    }

    .faq__toggle {
      width: calc(var(--u) * 0.49);
      height: calc(var(--u) * 0.49);
    }
  }
</style>
