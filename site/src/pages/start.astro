---
/**
 * /start/: the landing page for ads and links (indexed since 2026-11-11). It is the shared landing
 * screen (components/landing/Landing.astro) on its own, with no intro and no site footer; the
 * contact page uses the same screen behind its falling-tiles intro.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Landing from '../components/landing/Landing.astro';
---

<BaseLayout page="start">
  <Landing
    title="Your business starts with a human."
    lede="Websites, apps and software, built by real people. Tell us what you need and a person replies within 48 hours."
    via="Landing page"
  />
</BaseLayout>
