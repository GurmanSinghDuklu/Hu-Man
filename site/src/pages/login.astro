---
/**
 * Log in, create an account or reset a password (components/account/AuthPanel.astro). Anyone can
 * create an account since 2026-11-23 (self-serve portfolios); the team logs in here too.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import AccountShell from '../components/account/AccountShell.astro';
import AuthPanel from '../components/account/AuthPanel.astro';
---

<BaseLayout page="login">
  <SiteHeader slot="header" />

  <AccountShell label="Client area" title="Your account">
    <AuthPanel mode="inline" start="login" />
  </AccountShell>

  <SiteFooter slot="footer" />
</BaseLayout>
