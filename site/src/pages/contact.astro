---
/**
 * /contact/: the landing screen (videos, short form) with the full contact content below it, in
 * the landing's own look: Ink ground, rounded white and dark boxes, pill fields. Each visit by link
 * (not a refresh or Back/Forward) opens with the falling-tiles intro (components/landing/
 * ContactIntro.astro): the old contact page breaks into tiles that fall into black, then this
 * appears. No site header (it is a landing page); the logo links home and the footer has the nav.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ContactIntro from '../components/landing/ContactIntro.astro';
import BrandMark from '../components/BrandMark.astro';
import HeroVideo from '../components/HeroVideo.astro';
import RequestForm from '../components/account/RequestForm.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Sparkle from '../components/Sparkle.astro';
import { site } from '../config/site';
import { withBase } from '../config/paths';
import { contactFaq } from '../data/faq';
import Shape from '../components/play/Shape.astro';

// What happens after someone gets in touch (draft copy, 2026-10-27).
const steps = [
  { title: 'You send a message.', text: 'Use the form or email. A few lines is plenty.' },
  {
    title: 'A person reads it.',
    text: 'Not a bot, not a sales team. You get a reply by email within 48 hours.',
  },
  { title: 'A free call.', text: 'If it helps, we talk it through. No cost, no obligation.' },
  {
    title: 'A fixed price.',
    text: 'Want to go ahead? You get a fixed price before any work starts.',
  },
];

const lookAround = [
  { href: withBase('/pricing/'), label: 'See the prices' },
  { href: withBase('/about/#work'), label: 'See our work' },
  { href: withBase('/how-we-build/'), label: 'See how we build' },
];

const tel = `tel:${site.contact.phone.replace(/\s+/g, '')}`;
---

<BaseLayout page="contact">
  <ContactIntro slot="header" />

  <!-- The portfolio request (left) beside the video (right); phones: form first. The class "lp"
       is what the intro's TV switch-on opens (scripts/contact-intro.ts). -->
  <section class="lp cxs" aria-labelledby="rq-title">
    <div class="cxs__form">
      <a class="cxs__brand" href={withBase('/')} aria-label={`${site.name} home`}>
        <BrandMark class="cxs__mark" />
      </a>
      <p class="label cxs__label">CV portfolio</p>
      <h1 id="rq-title" class="cxs__title">
        Talk to a human.
      </h1>
      <p class="cxs__lede">
        Choose a design and send your CV, and we’ll build your portfolio. Or ask for one made from
        scratch. A real person reads every request.
      </p>
      <p class="cxs__other">
        Need a business website, an app, or just have a question?{' '}
        <a href="#contact-title">Write to us below</a>, no account needed.
      </p>
      <RequestForm />
    </div>
    <div class="cxs__video">
      <HeroVideo video="portfolio-ad" />
    </div>
  </section>

  <div class="cx">
    <section class="cx__band cx-write" aria-labelledby="contact-title">
      <div class="sheet cx-write__sheet">
        <div class="cx-box cx-box--dark" data-rise>
          <p class="label cx__label">01 / Write to us</p>
          <h2 id="contact-title" class="cx__title">
            Tell us more
          </h2>
          <p class="cx__intro">
            Got more to say than the short form takes? Write as much or as little as you like.
          </p>
          <EnquiryForm variant="contact" tone="ink" />
        </div>

        <aside class="cx-box cx-box--light cx-direct" aria-labelledby="other-title" data-rise="1">
          <h2 id="other-title" class="label">
            Or reach us directly
          </h2>
          <dl>
            <div>
              <dt>Email</dt>
              <dd>
                <a href={`mailto:${site.contact.email}`}>{site.contact.email}</a>
              </dd>
            </div>
            <div>
              <dt>Phone</dt>
              <dd>
                <a href={tel}>{site.contact.phone}</a>
              </dd>
            </div>
            <div>
              <dt>Instagram</dt>
              <dd>
                <a href={site.contact.instagram} target="_blank" rel="noopener noreferrer">
                  @humansoftwareagency<span class="visually-hidden"> (opens in a new tab)</span>
                </a>
              </dd>
            </div>
            <div>
              <dt>Where</dt>
              <dd>
                {site.location.town}, {site.location.region}. In person across West Yorkshire,
                remote across the UK and worldwide.
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </section>

    <section class="cx__band cx-next" aria-labelledby="next-title">
      <div class="sheet cx-next__sheet">
        <div>
          <p class="label cx__label" data-reveal>
            02 / What happens next
          </p>
          <h2 id="next-title" class="cx__title cx__title--big" data-reveal="lines">
            No forms <Shape kind="ring" tone="indigo" />
            <br />
            into the void.
          </h2>
          <ol class="cx-next__steps">
            {steps.map((step) => (
              <li data-reveal>
                <strong>{step.title}</strong> {step.text}
              </li>
            ))}
          </ol>
        </div>

        <aside class="cx-box cx-box--light cx-ready" aria-labelledby="ready-title" data-rise="1">
          <Sparkle class="cx-ready__star" />
          <h3 id="ready-title">Not ready to talk yet?</h3>
          <p>
            Start with a free AI check. Send your website address and a person checks whether AI
            assistants recommend you, and what to fix. Findings within 48 hours.
          </p>
          <a class="pill-btn cx-ready__cta" href={withBase('/free-ai-check/')}>
            Get your free AI check
          </a>
          <p class="cx-ready__or">Or look around first:</p>
          <ul class="cx-ready__links">
            {lookAround.map((link) => (
              <li>
                <a href={link.href}>{link.label}</a>
              </li>
            ))}
          </ul>
        </aside>
      </div>
    </section>

    <section class="cx__band cx-faq" aria-labelledby="faq-title">
      <div class="sheet">
        <p class="label cx__label">03 / Questions</p>
        <h2 id="faq-title" class="cx__title">
          Before you get in touch
        </h2>
        <dl class="cx-faq__list">
          {contactFaq.map((item, i) => (
            <div class="cx-box cx-box--dark cx-faq__item" data-rise={i % 2}>
              <dt>{item.q}</dt>
              <dd>{item.a}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </div>

  <SiteFooter slot="footer" />
</BaseLayout>

<style is:global>
  /* Dark behind the landing screen, so its edges never show the pale page as it shrinks away. */
  main:has(> .cx) {
    background: var(--ink);
  }
</style>

<style>
  .cxs {
    display: grid;
    background: var(--ink);
    color: var(--paper);
  }

  .cxs__form {
    display: grid;
    gap: 1.1rem;
    align-content: start;
    padding: clamp(1.5rem, 5vw, 3.5rem) var(--pad) clamp(2.5rem, 6vw, 4.5rem);
    min-width: 0;
  }

  .cxs__brand {
    justify-self: start;
    margin-bottom: 0.75rem;
    --led-colours: #cea4ee, #93aee0, #4a9bb0, #edd1a8, #f8cea2, #e79569, #e85e8f, #db92db, #cea4ee;
  }

  .cxs__brand :global(.cxs__mark) {
    --lw: clamp(110px, 10vw, 150px);
    --hh: clamp(32px, 3vw, 42px);
  }

  .cxs__label {
    color: var(--muted-on-ink);
  }

  .cxs__title {
    font: 800 clamp(2.6rem, 7vw, 5rem) / 0.92 var(--font-display);
    letter-spacing: -0.03em;
    text-transform: uppercase;
  }

  .cxs__lede {
    max-width: 46ch;
    font-size: 1.1rem;
    line-height: 1.5;
  }

  .cxs__other {
    max-width: 52ch;
    margin-bottom: 0.75rem;
    color: var(--muted-on-ink);
    line-height: 1.5;
  }

  .cxs__other a {
    color: var(--paper);
  }

  .cxs__video {
    position: relative;
    min-width: 0;
  }

  /* Wide screens: the form scrolls in the left half; the video stays put in the right half. */
  @media (min-width: 64rem) {
    .cxs {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      align-items: start;
    }

    .cxs__video {
      position: sticky;
      top: 0;
      height: 100svh;
    }
  }

  /* The landing screen's ground and boxes, carried on down the page. */
  /* Positioned, so it slides over the landing screen as that sinks (scroll story hand-off). */
  .cx {
    position: relative;
    background: var(--ink);
    color: var(--paper);
  }

  .cx__band {
    padding-block: clamp(2.5rem, 7vw, 5.5rem);
  }

  .cx__band + .cx__band {
    padding-top: 0;
  }

  .cx__label {
    color: var(--muted-on-ink);
  }

  .cx__title {
    margin-top: 0.5rem;
    font-size: clamp(1.75rem, 4vw, 3rem);
    line-height: 0.95;
    text-transform: uppercase;
  }

  .cx__title--big {
    font-size: clamp(2.2rem, 6vw, 4.6rem);
  }

  .cx__intro {
    max-width: 34rem;
    margin: 0.75rem 0 1.5rem;
    color: var(--muted-on-ink);
    line-height: 1.5;
  }

  /* The two boxes from the landing screen: white like the pitch, dark like the form. */
  .cx-box {
    border-radius: 22px;
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }

  .cx-box--light {
    background: var(--paper);
    color: var(--ink);
  }

  .cx-box--dark {
    border: 1px solid rgb(241 242 236 / 0.16);
    background: #121410;
  }

  /* ---------- write to us ---------- */
  .cx-write__sheet {
    display: grid;
    gap: 8px;
  }

  .cx-direct {
    align-self: start;
  }

  .cx-direct dl {
    display: grid;
    gap: 1.1rem;
    margin: 1.25rem 0 0;
  }

  .cx-direct dt {
    font: 500 0.75rem/1.3 var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  .cx-direct dd {
    margin: 0.25rem 0 0;
    overflow-wrap: anywhere;
    font-size: 1.05rem;
    line-height: 1.45;
  }

  /* ---------- what happens next ---------- */
  .cx-next__sheet {
    display: grid;
    gap: 2rem 8px;
  }

  .cx-next__steps {
    display: grid;
    gap: 1.1rem;
    max-width: 38rem;
    margin-top: clamp(1.5rem, 4vw, 2.5rem);
    counter-reset: step;
  }

  .cx-next__steps li {
    position: relative;
    padding-left: 3.25rem;
    font-size: clamp(1rem, 1.5vw, 1.15rem);
    line-height: 1.5;
    counter-increment: step;
  }

  .cx-next__steps li::before {
    content: counter(step, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0;
    display: grid;
    place-items: center;
    width: 2.25rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper);
    color: var(--ink);
    font: 500 0.75rem var(--font-mono);
  }

  .cx-ready {
    align-self: start;
  }

  .cx-ready :global(.cx-ready__star) {
    width: 1.5rem;
    margin-bottom: 1rem;
    fill: var(--indigo);
  }

  .cx-ready h3 {
    font-size: clamp(1.35rem, 2.4vw, 1.9rem);
    line-height: 1.05;
    text-transform: uppercase;
  }

  .cx-ready p {
    margin-top: 0.75rem;
    line-height: 1.55;
  }

  .cx-ready__cta {
    margin-top: 1.5rem;
  }

  .cx-ready__or {
    color: var(--muted);
    font-size: 0.9375rem;
  }

  .cx-ready__links {
    display: grid;
    gap: 0.35rem;
    margin-top: 0.5rem;
  }

  .cx-ready__links a {
    font-weight: 700;
    text-underline-offset: 0.25em;
  }

  /* ---------- FAQ ---------- */
  .cx-faq__list {
    display: grid;
    gap: 8px;
    margin: clamp(1.5rem, 4vw, 2.5rem) 0 0;
  }

  .cx-faq__item dt {
    font: 800 clamp(1.05rem, 1.6vw, 1.3rem) / 1.05 var(--font-display);
    text-transform: uppercase;
  }

  .cx-faq__item dd {
    margin: 0.6rem 0 0;
    color: #d6d7d1;
    font-size: 1rem;
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .cx-faq__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .cx-write__sheet {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
    }

    .cx-next__sheet {
      grid-template-columns: minmax(0, 1fr) minmax(0, 24rem);
      align-items: start;
    }
  }
</style>
