---
/** Where a form post lands without JavaScript (worker/enquiry.js redirects here). Noindex. */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { site } from '../config/site';
import { withBase } from '../config/paths';
---

<BaseLayout page="thanks">
  <SiteHeader slot="header" />

  <section class="wrap thanks">
    <p class="label">Message sent</p>
    <h1>Thanks. A human will be in touch.</h1>
    <p>
      Your message is with us. A real person will read it and reply by email. If it’s urgent,
      <a href={site.contact.whatsapp} rel="noopener">
        WhatsApp us
      </a>{' '}
      too.
    </p>
    <div class="thanks__actions">
      <a href={withBase('/')} class="btn">
        Back to the homepage
      </a>
      <a href={withBase('/work/')} class="btn btn--outline">
        See our work
      </a>
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .thanks {
    display: grid;
    gap: var(--space-4);
    padding-block: clamp(4rem, 12vw, 9rem);
    max-width: calc(44em + 2 * var(--gutter));
  }

  .thanks h1 {
    font-size: clamp(2.6rem, 8vw, 5.4rem);
  }

  .thanks p:not(.label) {
    font-size: 1.15rem;
    line-height: 1.55;
  }

  .thanks__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }
</style>
