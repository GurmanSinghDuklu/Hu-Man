---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InnerHero from '../components/InnerHero.astro';
import TalkBanner from '../components/TalkBanner.astro';
import { portfolioTiers, portfolioAddOns, portfolioExpress } from '../data/pricing';
import { contactPath } from '../config/links';
import { withBase } from '../config/paths';
import ScrollCue from '../components/ScrollCue.astro';
import ConceptWall from '../components/ConceptWall.astro';
import { portfolioConcepts, portfolioConceptsIntro } from '../data/portfolioConcepts';
import { ats } from '../data/ats';
import { portfolioFaq } from '../data/faq';
import Shape from '../components/play/Shape.astro';
import WordLine from '../components/play/WordLine.astro';

const choose = (name: string) => withBase(contactPath({ tier: `Portfolio: ${name}` }));
---

<BaseLayout page="portfolio">
  <SiteHeader slot="header" />

  <InnerHero
    label="Portfolio sites"
    lens="Lens 10 / Portfolio sites"
    video="portfolio-seen"
    intro="cv"
  >
    <Fragment slot="title">
      <span class="ptitle">A CV gets you past the screen. A portfolio gets you remembered.</span>
    </Fragment>
    <Fragment slot="lede">
      Personal portfolio and CV websites for job seekers, graduates, creatives and freelancers. For
      individuals, not businesses.
    </Fragment>
    <ScrollCue
      slot="after"
      href="#concepts"
      label={`See all ${portfolioConcepts.length} concepts below`}
    />
  </InnerHero>

  <section id="concepts" class="band pconcepts" aria-labelledby="concepts-title">
    <div class="sheet">
      <p class="label" data-reveal>
        {portfolioConceptsIntro.label} · {portfolioConcepts.length}
      </p>
      <h2 id="concepts-title" class="display display--s" data-reveal="lines">
        {portfolioConceptsIntro.title} <Shape kind="sparkle" tone="signal" />
      </h2>
      <p class="pconcepts__text">{portfolioConceptsIntro.text}</p>
      <ConceptWall />
    </div>
  </section>

  <section class="band grid ptiers" aria-labelledby="tiers-title">
    <div class="sheet">
      <h2 id="tiers-title" class="label">
        3 tiers · Pay once · Domain cost extra
      </h2>
      <p class="ptiers__text">
        A site you own, that works on a phone and that search and AI can read. We do not promise
        jobs, interviews or results with applicant tracking systems: a portfolio shows your work,
        and what happens next is up to you and the people reading it.
      </p>
      <p class="ptiers__text">
        Any of the concepts above can be the starting point for your site, and more than one person
        may pick the same one. A design that's yours alone comes with Portfolio Pro, or ask and
        we'll quote it.
      </p>
      <ul class="ptiers__list">
        {portfolioTiers.map((t, i) => (
          <li
            class:list={['ptier', `ptier--${t.id}`]}
            data-reveal
            style={`--reveal-delay:${i * 0.08}s`}
          >
            <p class="ptier__name">
              {t.name}
              {t.tag && <span class="ptier__tag">{t.tag}</span>}
            </p>
            <p class="ptier__price">{t.price}</p>
            <p class="ptier__what">{t.summary}</p>
            <ul class="ptier__includes">
              {t.includes.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
            <p class="ptier__time">{t.timeline}</p>
            <a class="pill-btn ptier__btn" href={choose(t.name)}>
              Choose<span class="visually-hidden"> {t.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="band band--paper-2 pextras" aria-labelledby="extras-title">
    <div class="sheet pextras__sheet">
      <div>
        <p class="label" data-reveal>
          Add-ons
        </p>
        <h2 id="extras-title" class="display display--s" data-reveal="lines">
          Add what <Shape kind="pill" tone="peach" /> you need.
        </h2>
        <ul class="pextras__list">
          {portfolioAddOns.map((a) => (
            <li class="pill">{a}</li>
          ))}
        </ul>
      </div>
      <div class="pextras__express" data-reveal>
        <p class="label">{portfolioExpress.title}</p>
        <p class="pextras__price">{portfolioExpress.price}</p>
        <p>{portfolioExpress.text}</p>
      </div>
    </div>
  </section>

  <section class="band grid ats" aria-labelledby="ats-title">
    <div class="sheet ats__sheet">
      <div class="ats__intro">
        <p class="label" data-reveal>
          {ats.label}
        </p>
        <h2 id="ats-title" class="display display--s" data-reveal="lines">
          {ats.title} <Shape kind="orb" tone="indigo" />
        </h2>
        {ats.text.map((p) => (
          <p class="ats__text">{p}</p>
        ))}
      </div>

      <div class="ats__side">
        <ul class="ats__offers" data-pin-steps>
          {ats.offers.map((o, i) => (
            <li
              class:list={['ats__offer', `ats__offer--${i + 1}`]}
              data-reveal
              style={`--reveal-delay:${i * 0.08}s`}
            >
              <p class="ats__tag">{o.tag}</p>
              <h3>{o.title}</h3>
              <p>{o.text}</p>
            </li>
          ))}
        </ul>
        <p class="ats__note">{ats.note}</p>
        <a class="pill-btn ats__btn" href={withBase(contactPath({ topic: 'other' }))}>
          {ats.button}
        </a>
      </div>

      <div class="ats__guide">
        <h3 class="ats__sub">{ats.guideTitle}</h3>
        <ol class="ats__stages">
          {ats.stages.map((st, i) => (
            <li class="ats__stage" data-reveal style={`--reveal-delay:${i * 0.08}s`}>
              <p class="ats__stage-n">
                {String(i + 1).padStart(2, '0')} · {st.stage}
              </p>
              <h4>{st.title}</h4>
              <ul class="ats__tips">
                {st.tips.map((t) => (
                  <li>
                    <strong>{t.title}.</strong> {t.text}
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ol>
        <div class="ats__check" data-reveal>
          <h4>{ats.check.title}</h4>
          <p>{ats.check.text}</p>
        </div>
      </div>
    </div>
  </section>

  <section class="band band--paper-2 faq" id="faq" aria-labelledby="faq-title">
    <div class="sheet">
      <p class="label" data-reveal>
        CV concepts · Questions
      </p>
      <h2 id="faq-title" class="display display--s" data-reveal="lines">
        Choosing a concept, <Shape kind="ring" tone="rose" /> answered.
      </h2>
      <ul class="faq__list">
        {portfolioFaq.map((item, i) => (
          <li data-rise={i % 2}>
            <details class="faq__item" open>
              <summary>
                <span class="faq__q">{item.q}</span>
                <span class="faq__toggle" aria-hidden="true" />
              </summary>
              <p class="faq__a">{item.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <WordLine
    words={['Your work.', 'Your name.', 'Your page.']}
    shapes={[
      { kind: 'arch', tone: 'lilac' },
      { kind: 'sparkle', tone: 'signal' },
    ]}
  />

  <TalkBanner />

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* The headline runs to four lines on phones: a shorter tall video keeps the hero in one window. */
  @media (max-width: 63.99rem) {
    :global(.ihero.ihero--video) {
      --hv-h: 46svh;
    }
  }

  .ptitle {
    display: block;
    max-width: 12em;
    font-size: 0.72em;
    line-height: 0.95;
  }

  .ptiers {
    padding-block: clamp(2.5rem, calc(var(--u) * 0.6), 3.5rem)
      clamp(3rem, calc(var(--u) * 0.66), 4rem);
    border-top: 1px solid var(--grid-line);
  }

  .ptiers__text {
    max-width: 42rem;
    margin-top: 0.5rem;
    font-size: clamp(1rem, calc(var(--u) * 0.18), 1.1rem);
    line-height: 1.5;
  }

  .ptiers__list {
    display: grid;
    gap: max(12px, calc(var(--u) * 0.2));
    margin-top: clamp(2rem, calc(var(--u) * 0.6), 3.5rem);
  }

  .ptier {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    padding: clamp(1.25rem, calc(var(--u) * 0.3), 2rem);
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .ptier--profile {
    background: var(--paper-2);
    border-top-right-radius: calc(var(--u) * 0.9);
  }

  .ptier--portfolio {
    background: var(--peach);
    border-top-left-radius: calc(var(--u) * 0.9);
    border-top-right-radius: calc(var(--u) * 0.9);
  }

  .ptier--portfolio-pro {
    background: var(--ink);
    color: var(--paper);
    border-top-right-radius: calc(var(--u) * 0.9);
  }

  .ptier__name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    font: 400 0.8125rem var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .ptier__tag {
    padding: 0.2rem 0.6rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font-size: 0.6875rem;
    letter-spacing: 0.12em;
  }

  .ptier__price {
    font: 800 clamp(2.6rem, calc(var(--u) * 0.7), 4rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .ptier__what {
    font-weight: 700;
  }

  .ptier__includes {
    display: grid;
    gap: 0.5rem;
    font-size: clamp(0.95rem, calc(var(--u) * 0.165), 1.05rem);
    line-height: 1.4;
  }

  .ptier__includes li {
    padding-left: 1rem;
    border-left: 2px solid currentColor;
  }

  .ptier__time {
    margin-top: auto;
    padding-top: 0.75rem;
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .ptier__btn {
    align-self: flex-start;
  }

  .ptier--portfolio-pro .ptier__btn {
    border-color: var(--paper);
  }

  .pconcepts {
    overflow: clip;
    padding-block: clamp(3rem, calc(var(--u) * 0.9), 5.5rem) clamp(4rem, calc(var(--u) * 1.6), 9rem);
    background: var(--ink);
    color: var(--paper);
  }

  .pconcepts .label {
    color: var(--muted-on-ink);
  }

  .pconcepts__text {
    max-width: 42rem;
    margin-top: 1rem;
    font-size: clamp(1rem, calc(var(--u) * 0.18), 1.1rem);
    line-height: 1.5;
  }

  /* ---------- CVs and applicant tracking systems ---------- */
  .ats {
    padding-block: clamp(3rem, calc(var(--u) * 0.9), 5.5rem);
  }

  .ats__sheet {
    display: grid;
    gap: var(--space-5);
  }

  .ats__text {
    max-width: 38rem;
    margin-top: 1rem;
    font-size: clamp(1rem, calc(var(--u) * 0.18), 1.1rem);
    line-height: 1.55;
  }

  .ats__sub {
    margin-top: clamp(1.75rem, calc(var(--u) * 0.4), 2.5rem);
    font: 400 0.8125rem var(--font-mono);
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* The three-stage guide, full width under the intro and the offers. */
  .ats__guide {
    min-width: 0;
  }

  .ats__guide .ats__sub {
    margin-top: 0;
  }

  .ats__stages {
    display: grid;
    gap: max(12px, calc(var(--u) * 0.2));
    margin-top: 1rem;
  }

  .ats__stage {
    display: grid;
    align-content: start;
    gap: 0.75rem;
    padding: clamp(1.25rem, calc(var(--u) * 0.3), 2rem);
    border: 1px solid var(--ink);
    background: var(--paper);
  }

  .ats__stage-n {
    font: 400 0.75rem var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ats__stage h4 {
    font: 800 clamp(1.2rem, calc(var(--u) * 0.26), 1.6rem) / 1.05 var(--font-display);
    text-transform: uppercase;
  }

  .ats__tips {
    display: grid;
    gap: 0.75rem;
    margin-top: 0.25rem;
    line-height: 1.5;
  }

  .ats__tips li {
    padding-left: 1rem;
    border-left: 2px solid var(--pink);
  }

  .ats__check {
    display: grid;
    gap: 0.4rem;
    margin-top: max(12px, calc(var(--u) * 0.2));
    padding: clamp(1.25rem, calc(var(--u) * 0.3), 2rem);
    background: var(--ink);
    color: var(--paper);
    border-bottom-right-radius: calc(var(--u) * 0.9);
    line-height: 1.5;
  }

  .ats__check h4 {
    font: 800 clamp(1.1rem, calc(var(--u) * 0.22), 1.4rem) / 1.1 var(--font-display);
    text-transform: uppercase;
  }

  .ats__check p {
    max-width: 52rem;
  }

  .ats__offers {
    display: grid;
    gap: max(12px, calc(var(--u) * 0.2));
  }

  .ats__offer {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.25rem, calc(var(--u) * 0.3), 2rem);
    border: 1px solid var(--ink);
    background: var(--paper);
    line-height: 1.5;
  }

  .ats__offer h3 {
    font: 800 clamp(1.2rem, calc(var(--u) * 0.26), 1.6rem) / 1.05 var(--font-display);
    text-transform: uppercase;
  }

  .ats__offer--1 {
    border-top-right-radius: calc(var(--u) * 0.9);
  }

  .ats__offer--2 {
    background: var(--peach);
  }

  .ats__offer--3 {
    background: var(--ink);
    color: var(--paper);
    border-bottom-left-radius: calc(var(--u) * 0.9);
  }

  .ats__tag {
    justify-self: start;
    padding: 0.2rem 0.6rem;
    border: 1px solid currentColor;
    border-radius: 999px;
    font: 400 0.6875rem var(--font-mono);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .ats__note {
    max-width: 36rem;
    margin-top: 1.25rem;
    color: var(--muted);
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .ats__btn {
    margin-top: 1rem;
  }

  /* ---------- CV concepts FAQ (same cards as the About FAQ) ---------- */
  .faq {
    padding-block: clamp(3rem, calc(var(--u) * 0.9), 5.5rem);
  }

  .faq__list {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, calc(var(--u) * 0.6), 3.5rem);
  }

  .faq__item {
    position: relative;
    min-height: 100%;
    padding: clamp(1.25rem, calc(var(--u) * 0.38), 2.25rem);
    border: 1px solid var(--ink);
    border-radius: 0 calc(var(--u) * 0.72) calc(var(--u) * 0.72) 0;
    background: var(--paper);
  }

  .faq__item summary {
    display: block;
    padding-right: 3.5rem;
    list-style: none;
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font: 800 clamp(1.05rem, calc(var(--u) * 0.225), 1.4rem) / 1.05 var(--font-display);
    text-transform: uppercase;
  }

  .faq__toggle {
    position: absolute;
    right: clamp(1.25rem, calc(var(--u) * 0.34), 2.25rem);
    top: 50%;
    translate: 0 -50%;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item:not([open]) .faq__toggle {
    top: clamp(1.25rem, calc(var(--u) * 0.38), 2.25rem);
    translate: none;
  }

  .faq__item[open] .faq__toggle::after {
    display: none;
  }

  .faq__list li:first-child .faq__toggle {
    background: var(--pink);
  }

  .faq__a {
    max-width: 36rem;
    margin-top: 0.5rem;
    padding-right: 3.5rem;
    font-size: clamp(0.9rem, calc(var(--u) * 0.165), 1rem);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .faq__list {
      grid-template-columns: repeat(2, 1fr);
      gap: calc(var(--u) * 0.22) calc(var(--u) * 0.33);
    }

    .faq__list li:nth-child(odd) .faq__item {
      border-radius: calc(var(--u) * 0.72) calc(var(--u) * 0.72) calc(var(--u) * 0.72) 0;
    }
  }

  @media (min-width: 64rem) {
    .faq__item {
      min-height: calc(var(--u) * 1.44);
    }

    .faq__toggle {
      width: calc(var(--u) * 0.49);
      height: calc(var(--u) * 0.49);
    }
  }

  .pextras {
    padding-block: clamp(3rem, calc(var(--u) * 0.9), 5.5rem);
  }

  .pextras__sheet {
    display: grid;
    gap: var(--space-5);
  }

  .pextras__list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1.5rem;
  }

  .pextras__list .pill {
    padding: 0.65rem 1rem;
    background: transparent;
    font-size: 0.75rem;
    white-space: normal;
  }

  .pextras__express {
    display: grid;
    align-content: start;
    gap: 0.5rem;
    padding: clamp(1.25rem, calc(var(--u) * 0.3), 2rem);
    border: 1px solid var(--ink);
    background: var(--paper);
    line-height: 1.45;
  }

  .pextras__price {
    font: 800 clamp(2.2rem, calc(var(--u) * 0.55), 3.2rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  @media (min-width: 40rem) {
    .ptiers__list {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .ptier {
      min-height: calc(var(--u) * 5.2);
    }

    .ptier__name,
    .ptier__time {
      font-size: calc(var(--u) * 0.115);
    }

    .ptier__tag {
      font-size: calc(var(--u) * 0.095);
    }

    .pextras__sheet {
      grid-template-columns: 7fr 4fr;
      align-items: start;
    }

    .ats__sheet {
      grid-template-columns: 6fr 5fr;
      gap: calc(var(--u) * 0.66);
      align-items: start;
    }

    .ats__guide {
      grid-column: 1 / -1;
    }

    .ats__stages {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
