---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import WorkGrid from '../../components/WorkGrid.astro';
import { withBase } from '../../config/paths';
---

<BaseLayout
  title="Work | Hu/man Software Agency"
  description="Websites and web apps designed and built by Hu/man in Bradford: live projects and labelled concept work."
>
  <SiteHeader slot="header" />

  <section class="work-page" aria-labelledby="work-page-title">
    <div class="wrap">
      <div class="work-page__head">
        <h1 id="work-page-title" class="work-page__title">
          Work
        </h1>
        <p>
          Live sites we've designed and built, and concept work that isn't live. Every project says
          which. For design ideas for fictional businesses, see the
          <a href={`${withBase('/')}#concepts`}>concept lab</a>.
        </p>
      </div>
      <WorkGrid heading="h2" />
    </div>
  </section>

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  .work-page {
    padding-block: clamp(2.5rem, 6vw, 4.5rem) clamp(4rem, 9vw, 7rem);
    background: var(--brand-ink);
  }

  .work-page__head {
    display: grid;
    gap: var(--space-4);
    margin-bottom: clamp(2rem, 5vw, 3rem);
  }

  .work-page__title {
    font-size: clamp(3rem, 10vw, 7rem);
    line-height: 0.9;
    letter-spacing: -0.03em;
  }

  .work-page__head p {
    max-width: 36rem;
    font-size: 1.125rem;
    color: var(--ink-muted);
  }

  .work-page__head a {
    color: var(--signal-text);
  }

  @media (min-width: 48rem) {
    .work-page__head {
      grid-template-columns: 1fr 1fr;
      align-items: end;
    }
  }
</style>
