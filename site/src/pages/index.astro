---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Stats from '../components/home/Stats.astro';
import IdeasToLife from '../components/sections/IdeasToLife.astro';
import PrettyEnough from '../components/sections/PrettyEnough.astro';
import FreeCheck from '../components/home/FreeCheck.astro';
import AgentReady from '../components/sections/AgentReady.astro';
import RoofTiles from '../components/home/RoofTiles.astro';
import WorkCards from '../components/home/WorkCards.astro';
import AtTheCentre from '../components/sections/AtTheCentre.astro';
import PricingTeaser from '../components/home/PricingTeaser.astro';
import TalkBanner from '../components/TalkBanner.astro';
---

<BaseLayout page="index">
  <SiteHeader slot="header" />

  <HomeHero />
  <Stats />
  <IdeasToLife n="01" />
  <PrettyEnough n="02" />
  <FreeCheck />
  <AgentReady n="04" />
  <RoofTiles />
  <WorkCards />
  <AtTheCentre n="07" />
  <PricingTeaser />
  <TalkBanner />

  <SiteFooter slot="footer" />
</BaseLayout>
