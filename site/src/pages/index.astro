---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Stats from '../components/home/Stats.astro';
import Honest from '../components/home/Honest.astro';
import Loop from '../components/home/Loop.astro';
import Dashboard from '../components/home/Dashboard.astro';
import AgentReady from '../components/home/AgentReady.astro';
import OurWork from '../components/home/OurWork.astro';
import PricingTeaser from '../components/home/PricingTeaser.astro';
import YourMove from '../components/home/YourMove.astro';
import TalkBanner from '../components/TalkBanner.astro';
---

<BaseLayout
  title="Hu/man Software Agency | Your human in the loop."
  description="Leeds web studio for small businesses: agent-ready websites, your own owner dashboard, booking and payments, AI enquiry assistants and support that stays. Free AI check."
  structuredData
>
  <SiteHeader slot="header" />

  <HomeHero />
  <Stats />
  <Honest />
  <Loop />
  <Dashboard />
  <AgentReady />
  <OurWork />
  <PricingTeaser />
  <YourMove />
  <TalkBanner />

  <SiteFooter slot="footer" />
</BaseLayout>
