---
import BaseLayout from '../layouts/BaseLayout.astro';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../config/site';
---

<BaseLayout
  title={`${site.name} — website design and AI enquiry assistants in Bradford`}
  description="Phase 0 scaffold. Content lands in Phase 1."
>
  <header slot="header" class="site-header">
    <div class="wrap site-header__inner">
      <a href="/" class="site-header__name">
        {site.name}
      </a>
      <ThemeToggle />
    </div>
  </header>

  <section class="wrap" style="padding-block: var(--space-6);">
    <h1>{site.tagline}</h1>
    <p>
      Phase 0 scaffold: tokens, fonts, theme toggle and layout are in place. Page content is built
      in Phase 1.
    </p>
  </section>

  <footer
    slot="footer"
    class="wrap"
    style="padding-block: var(--space-5); color: var(--color-text-muted);"
  >
    <p>
      {site.name} · {site.location.town}, {site.location.region}
    </p>
  </footer>
</BaseLayout>

<style>
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block: var(--space-3);
  }

  .site-header__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.1rem;
    color: var(--color-text);
    text-decoration: none;
  }
</style>
