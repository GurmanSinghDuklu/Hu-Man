---
/**
 * "What is an agentic AI-ready website?": the definition of the phrase the brand is built on,
 * written to be quoted. The answer comes first (people and AI tools both read the top), then what
 * it takes, Draft copy (2026-10-26) for Gurman's sign-off.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InnerHero from '../components/InnerHero.astro';
import TalkBanner from '../components/TalkBanner.astro';
import { agenticFaq } from '../data/faq';
import { definition, ingredients } from '../data/agentic';
import { fromPrice, priceOf } from '../data/pricing';
import { withBase } from '../config/paths';

const selfCheck = [
  'Ask ChatGPT about your business. Does it get your prices, hours and area right?',
  'Does your robots.txt, or your host, block AI crawlers such as GPTBot or ClaudeBot?',
  'Are your services and prices written on the page as text, not only in images or PDFs?',
  'Can someone enquire or book without having to phone you?',
  'Does your site load in a couple of seconds on a phone?',
];
---

<BaseLayout page="agentic-ai-ready">
  <SiteHeader slot="header" />

  <InnerHero label="Agentic AI-ready" lens="Lens 07 / Agentic AI-ready">
    <Fragment slot="title">
      What is an
      <br />
      agentic AI-ready
      <br />
      website?
    </Fragment>
    <Fragment slot="lede">{definition}</Fragment>
  </InnerHero>

  <section class="band band--ink why" aria-labelledby="why-title">
    <div class="grid grid--ink">
      <div class="sheet section why__sheet">
        <div>
          <p class="label" data-reveal>
            01 / Why it matters
          </p>
          <h2 id="why-title" class="display display--m" data-reveal="lines">
            Customers are asking AI first.
          </h2>
        </div>
        <div class="why__text" data-reveal>
          <p>
            More people now ask ChatGPT, Gemini or Google’s AI Overviews for a recommendation before
            they open a website. AI agents are starting to go further: searching, comparing and
            booking on someone’s behalf.
          </p>
          <p>
            AI tools can only recommend what they can reach, read and trust. A site that blocks
            their crawlers, hides its prices in images or makes every enquiry a phone call gets
            skipped, however good it looks.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="band grid takes section" aria-labelledby="takes-title">
    <div class="sheet">
      <p class="label" data-reveal>
        02 / What it takes
      </p>
      <h2 id="takes-title" class="display display--m" data-reveal="lines">
        Eight things, done properly.
      </h2>
      <ol class="takes__list">
        {ingredients.map((item, i) => (
          <li class="takes__item" data-reveal style={`--reveal-delay:${(i % 4) * 0.05}s`}>
            <span class="takes__n">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{item.title}</h3>
              <p>{item.text}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="takes__note">
        It comes as standard on every website we build from our {priceOf('spark')} Spark tier up.
        Our
        {fromPrice} Essential tier is a standard website without it.
      </p>
    </div>
  </section>

  <section class="band band--paper-2 self section" aria-labelledby="self-title">
    <div class="sheet self__sheet">
      <div>
        <p class="label" data-reveal>
          03 / Check your own
        </p>
        <h2 id="self-title" class="display display--m" data-reveal="lines">
          Five quick questions.
        </h2>
        <p class="self__text">
          If any answer is “no” or “not sure”, the{' '}
          <a href={withBase('/free-ai-check/')}>free AI check</a> shows exactly what to fix.
        </p>
        <a class="pill-btn self__btn" href={withBase('/free-ai-check/')}>
          Get my free AI check
        </a>
      </div>
      <ol class="self__list">
        {selfCheck.map((q) => (
          <li>{q}</li>
        ))}
      </ol>
    </div>
  </section>

  <section class="band grid faq section" aria-labelledby="faq-title">
    <div class="sheet">
      <p class="label">04 / Questions</p>
      <h2 id="faq-title" class="display display--s">
        Agentic AI-ready, answered
      </h2>
      <dl class="faq__list">
        {agenticFaq.map((item) => (
          <div class="faq__item">
            <dt>{item.q}</dt>
            <dd>{item.a}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <TalkBanner />

  <SiteFooter slot="footer" />
</BaseLayout>

<style>
  /* ---------- why ---------- */
  .why .label,
  .why .display,
  .why__text {
    color: var(--paper);
  }

  .why__sheet {
    display: grid;
    gap: var(--space-5);
  }

  .why__text {
    display: grid;
    gap: 1.25rem;
    max-width: 38rem;
    font-size: clamp(1rem, calc(var(--u) * 0.2), 1.2rem);
    line-height: 1.6;
  }

  /* ---------- eight things ---------- */
  .takes__list {
    display: grid;
    gap: 0 max(16px, calc(var(--u) * 0.33));
    margin-top: clamp(2rem, calc(var(--u) * 0.7), 4rem);
  }

  .takes__item {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.25rem;
    padding-block: clamp(1rem, calc(var(--u) * 0.25), 1.5rem);
    border-top: 1px solid var(--line-soft);
  }

  .takes__n {
    display: grid;
    place-items: center;
    width: clamp(2.75rem, calc(var(--u) * 0.66), 3.75rem);
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--grad-lilac);
    font: 800 clamp(0.95rem, calc(var(--u) * 0.2), 1.2rem) / 1 var(--font-display);
  }

  .takes__item h3 {
    font-size: clamp(1.1rem, calc(var(--u) * 0.27), 1.6rem);
    line-height: 1;
  }

  .takes__item p {
    margin-top: 0.4rem;
    color: #2f312d;
    font-size: clamp(0.95rem, calc(var(--u) * 0.175), 1.05rem);
    line-height: 1.5;
  }

  .takes__note {
    margin-top: clamp(1.5rem, calc(var(--u) * 0.45), 2.5rem);
    max-width: 44rem;
    font-size: clamp(1rem, calc(var(--u) * 0.19), 1.15rem);
  }

  .self__sheet {
    display: grid;
    gap: var(--space-5);
  }

  .self__text {
    max-width: 30rem;
    margin-top: 1.25rem;
    font-size: clamp(1rem, calc(var(--u) * 0.19), 1.15rem);
    line-height: 1.55;
  }

  .self__text a {
    font-weight: 600;
  }

  /* ---------- self-check ---------- */
  .self__btn {
    margin-top: 1.5rem;
  }

  .self__list {
    display: grid;
    gap: 0.75rem;
    counter-reset: q;
  }

  .self__list li {
    position: relative;
    padding: 1.1rem 1.25rem 1.1rem 4rem;
    border: 1px solid var(--ink);
    background: var(--paper);
    font-size: clamp(1rem, calc(var(--u) * 0.185), 1.1rem);
    line-height: 1.45;
    counter-increment: q;
  }

  .self__list li::before {
    content: counter(q);
    position: absolute;
    left: 1.1rem;
    top: 50%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 2rem;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--ink);
    color: var(--paper);
    font: 500 0.8rem var(--font-mono);
  }

  /* ---------- FAQ ---------- */
  .faq__list {
    display: grid;
    gap: 1rem max(16px, calc(var(--u) * 0.33));
    margin: clamp(2rem, calc(var(--u) * 0.6), 3.5rem) 0 0;
  }

  .faq__item {
    padding: clamp(1.25rem, calc(var(--u) * 0.33), 2rem);
    border: 1px solid var(--ink);
    border-top-right-radius: calc(var(--u) * 0.72);
    background: var(--paper);
  }

  .faq__item dt {
    font: 800 clamp(1.05rem, calc(var(--u) * 0.22), 1.35rem) / 1.05 var(--font-display);
    text-transform: uppercase;
  }

  .faq__item dd {
    margin: 0.6rem 0 0;
    font-size: clamp(0.95rem, calc(var(--u) * 0.17), 1.05rem);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .takes__list,
    .faq__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .why__sheet,
    .self__sheet {
      grid-template-columns: calc(var(--u) * 6.2) 1fr;
      gap: calc(var(--u) * 0.66);
    }
  }
</style>
