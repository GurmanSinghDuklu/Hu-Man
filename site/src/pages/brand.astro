---
import BaseLayout from '../layouts/BaseLayout.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import InnerHero from '../components/InnerHero.astro';
import TalkBanner from '../components/TalkBanner.astro';
import ScrollCue from '../components/ScrollCue.astro';
import BookingLink from '../components/BookingLink.astro';
import Shape from '../components/play/Shape.astro';
import Sticker from '../components/play/Sticker.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Gallery from '../components/brand-studio/Gallery.astro';
import CaseStudies from '../components/brand-studio/CaseStudies.astro';
import Board from '../components/brand-studio/Board.astro';
import Get from '../components/brand-studio/Get.astro';
import Viewer from '../components/brand-studio/Viewer.astro';
import { gallery } from '../data/brandStudio';
import { brandSteps } from '../data/brandPage';
import { brandFaq } from '../data/faq';
import { withBase } from '../config/paths';
import '../styles/brand-studio.css';

const files = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/brand-studio/gallery/*.webp',
  {
    eager: true,
  },
);
const meta = (slug: string) => files[`../assets/brand-studio/gallery/${slug}.webp`].default;
// Three columns of posters for the hero wall, in an order that keeps neighbours different.
const wall = [
  ['salvatore', 'cake-corp', 'palermo', 'bliss', 'cluck'],
  ['latte', 'prosecco', 'boston', 'divinite', 'mango'],
  ['unstyle', 'nova', 'tee-time', 'pura', 'aquos'],
];
---

<BaseLayout page="brand">
  <SiteHeader slot="header" />

  <InnerHero label="Brand identity" lens="Lens 11 / Brand identity">
    <Fragment slot="title">
      <span class="bs-title">Anyone can prompt a logo. Not everyone should.</span>
    </Fragment>
    <Fragment slot="lede">
      Brand identities built by people: logo, type, colour, mockups and the guidelines to keep it
      all consistent. Start with what you love. Finish with a human.
    </Fragment>
    <div slot="after" class="bs-hero__actions">
      <a class="btn btn--display" href="#board">
        Start your brand board
      </a>
      <BookingLink class="btn btn--display btn--outline" />
      <ScrollCue href="#gallery" label={`See ${gallery.length} directions below`} />
    </div>
    <div slot="media" class="bsw" aria-hidden="true">
      <span class="bsw__arch fill--lilac"></span>
      <div class="bsw__cols">
        {wall.map((col, c) => (
          <div class={`bsw__col bsw__col--${c + 1}`}>
            {[0, 1].map((copy) => (
              <ul class="bsw__list">
                {col.map((slug) => (
                  <li>
                    <Image
                      src={meta(slug)}
                      alt=""
                      widths={[220, 340]}
                      sizes="(min-width: 64rem) 12vw, 30vw"
                      format="webp"
                      loading={copy === 0 ? 'eager' : 'lazy'}
                      decoding="async"
                      fetchpriority="low"
                    />
                  </li>
                ))}
              </ul>
            ))}
          </div>
        ))}
      </div>
      <span class="pill bsw__pill">{gallery.length} Concept directions</span>
    </div>
  </InnerHero>

  <Gallery />
  <CaseStudies />
  <Board />
  <Get />

  <section class="band grid bs-how" aria-labelledby="how-title">
    <div class="sheet">
      <p class="label" data-reveal>
        How it works{' '}
        <Sticker tone="peach" tilt={-4}>
          5 steps
        </Sticker>
      </p>
      <h2 id="how-title" class="display display--s" data-reveal="lines">
        From your board <Shape kind="ring" tone="rose" /> to your brand.
      </h2>
      <ol class="bs-how__steps" data-pick>
        {brandSteps.map((s, i) => (
          <li class="bs-how__step" data-reveal tabindex="0" style={`--reveal-delay:${i * 0.07}s`}>
            <span class="bs-how__n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
      <p class="bs-how__more" data-reveal>
        Need the website too? We build that next, on-brand from day one.
        <a class="more-link" href={withBase('/business-websites/')}>
          See business websites
        </a>
      </p>
    </div>
  </section>

  <section class="band band--paper-2 faq" id="faq" aria-labelledby="faq-title">
    <div class="sheet">
      <p class="label" data-reveal>
        Brand identity · Questions
      </p>
      <h2 id="faq-title" class="display display--s" data-reveal="lines">
        Before you start, <Shape kind="pill" tone="lilac" /> answered.
      </h2>
      <ul class="faq__list">
        {brandFaq.map((item, i) => (
          <li data-rise={i % 2}>
            <details class="faq__item" open>
              <summary>
                <span class="faq__q">{item.q}</span>
                <span class="faq__toggle" aria-hidden="true"></span>
              </summary>
              <p class="faq__a">{item.a}</p>
            </details>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <TalkBanner />

  <Viewer />
  <p id="bs-live" class="visually-hidden" role="status" aria-live="polite"></p>

  <SiteFooter slot="footer" />
</BaseLayout>

<script>
  import '../scripts/brand-studio/index.ts';
</script>

<style>
  .bs-title {
    display: block;
    max-width: 11em;
    font-size: 0.62em;
    line-height: 0.95;
  }

  .bs-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1rem;
  }

  .bs-hero__actions :global(.btn--display) {
    font-size: 0.875rem;
  }

  /* The scroll cue is drawn for Ink heroes; here the ground is Paper. */
  .bs-hero__actions :global(.scroll-cue) {
    flex-basis: 100%;
    color: var(--ink);
  }

  .bs-hero__actions :global(.scroll-cue__arrow) {
    border-color: var(--ink);
    color: var(--ink);
  }

  /* On Ink the outline button is Paper. */
  :global(.ihero--video) .btn--outline,
  .bs-hero__actions :global(.btn--outline) {
    --btn: var(--ink);
  }

  /* ---------- hero wall: three columns of posters sliding in turn ---------- */
  .bsw {
    position: relative;
    width: 100%;
    height: var(--collage-h, 34svh);
    overflow: hidden;
    isolation: isolate;
  }

  .bsw__cols {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: max(8px, calc(var(--u) * 0.14));
    height: 100%;
  }

  .bsw__col {
    display: flex;
    flex-direction: column;
    gap: max(8px, calc(var(--u) * 0.14));
    animation: bsw-up 46s linear infinite;
  }

  .bsw__col--2 {
    animation-direction: reverse;
    animation-duration: 52s;
  }

  .bsw__col--3 {
    animation-duration: 40s;
  }

  .bsw__list {
    display: contents;
  }

  .bsw__list li {
    aspect-ratio: 4 / 5;
  }

  .bsw__list img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  @keyframes bsw-up {
    to {
      translate: 0 calc(-50% - max(4px, calc(var(--u) * 0.07)));
    }
  }

  .bsw__arch {
    position: absolute;
    z-index: 2;
    right: 0;
    bottom: 0;
    width: calc(var(--u) * 1.3);
    height: calc(var(--u) * 2);
    border-radius: calc(var(--u) * 0.65) calc(var(--u) * 0.65) 0 0;
    pointer-events: none;
  }

  .bsw__pill {
    position: absolute;
    z-index: 3;
    left: 0;
    bottom: calc(var(--u) * 0.3);
  }

  @media (min-width: 64rem) {
    .bsw {
      width: calc(var(--u) * 6.6);
      height: calc(var(--u) * 7.5);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .bsw__col {
      animation: none;
    }
  }

  /* ---------- how it works ---------- */
  .bs-how {
    padding-block: clamp(3rem, calc(var(--u) * 0.9), 5.5rem);
    border-top: 1px solid var(--grid-line);
  }

  .bs-how__steps {
    display: grid;
    gap: max(12px, calc(var(--u) * 0.2));
    margin-top: clamp(2rem, calc(var(--u) * 0.6), 3.5rem);
  }

  .bs-how__step {
    display: grid;
    align-content: start;
    gap: 0.6rem;
    padding: clamp(1.25rem, calc(var(--u) * 0.3), 2rem);
    border: 1px solid var(--ink);
    background: var(--paper);
    line-height: 1.5;
  }

  .bs-how__step:nth-child(1) {
    border-top-right-radius: calc(var(--u) * 0.9);
  }

  .bs-how__step:nth-child(2) {
    background: var(--peach);
  }

  .bs-how__step:nth-child(5) {
    background: var(--ink);
    color: var(--paper);
    border-bottom-left-radius: calc(var(--u) * 0.9);
  }

  .bs-how__n {
    font: 800 clamp(2.6rem, calc(var(--u) * 0.7), 4rem) / 1 var(--font-display);
    letter-spacing: -0.03em;
  }

  .bs-how__step h3 {
    font: 800 clamp(1.1rem, calc(var(--u) * 0.24), 1.5rem) / 1.05 var(--font-display);
    text-transform: uppercase;
  }

  .bs-how__more {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
    margin-top: clamp(1.5rem, calc(var(--u) * 0.4), 2.5rem);
    font-size: clamp(1rem, calc(var(--u) * 0.2), 1.25rem);
  }

  @media (min-width: 40rem) {
    .bs-how__steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .bs-how__steps {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }

    .bs-how__step {
      min-height: calc(var(--u) * 3.4);
    }
  }

  /* ---------- FAQ (same cards as the About and CV FAQs) ---------- */
  .faq {
    padding-block: clamp(3rem, calc(var(--u) * 0.9), 5.5rem);
  }

  .faq__list {
    display: grid;
    gap: 1rem;
    margin-top: clamp(2rem, calc(var(--u) * 0.6), 3.5rem);
  }

  .faq__item {
    position: relative;
    min-height: 100%;
    padding: clamp(1.25rem, calc(var(--u) * 0.38), 2.25rem);
    border: 1px solid var(--ink);
    border-radius: 0 calc(var(--u) * 0.72) calc(var(--u) * 0.72) 0;
    background: var(--paper);
  }

  .faq__item summary {
    display: block;
    padding-right: 3.5rem;
    list-style: none;
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__q {
    font: 800 clamp(1.05rem, calc(var(--u) * 0.225), 1.4rem) / 1.05 var(--font-display);
    text-transform: uppercase;
  }

  .faq__toggle {
    position: absolute;
    right: clamp(1.25rem, calc(var(--u) * 0.34), 2.25rem);
    top: 50%;
    translate: 0 -50%;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ink);
  }

  .faq__toggle::before,
  .faq__toggle::after {
    content: '';
    position: absolute;
    left: 50%;
    top: 50%;
    width: 12px;
    height: 1.5px;
    background: var(--paper);
    transform: translate(-50%, -50%);
  }

  .faq__toggle::after {
    transform: translate(-50%, -50%) rotate(90deg);
  }

  .faq__item:not([open]) .faq__toggle {
    top: clamp(1.25rem, calc(var(--u) * 0.38), 2.25rem);
    translate: none;
  }

  .faq__item[open] .faq__toggle::after {
    display: none;
  }

  .faq__list li:first-child .faq__toggle {
    background: var(--pink);
  }

  .faq__a {
    max-width: 36rem;
    margin-top: 0.5rem;
    padding-right: 3.5rem;
    font-size: clamp(0.9rem, calc(var(--u) * 0.165), 1rem);
    line-height: 1.5;
  }

  @media (min-width: 48rem) {
    .faq__list {
      grid-template-columns: repeat(2, 1fr);
      gap: calc(var(--u) * 0.22) calc(var(--u) * 0.33);
    }

    .faq__list li:nth-child(odd) .faq__item {
      border-radius: calc(var(--u) * 0.72) calc(var(--u) * 0.72) calc(var(--u) * 0.72) 0;
    }
  }

  @media (min-width: 64rem) {
    .faq__item {
      min-height: calc(var(--u) * 1.44);
    }

    .faq__toggle {
      width: calc(var(--u) * 0.49);
      height: calc(var(--u) * 0.49);
    }
  }
</style>
