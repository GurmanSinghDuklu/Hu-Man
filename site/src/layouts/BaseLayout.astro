---
import '../styles/base.css';
import Seo from '../components/Seo.astro';

interface Props {
  title: string;
  description: string;
  /** Set to false on utility pages (currently just the 404) to add noindex. */
  index?: boolean;
  /** Emit the ProfessionalService JSON-LD. The homepage sets this to true. */
  structuredData?: boolean;
}

const { title, description, index = true, structuredData = false } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} index={index} structuredData={structuredData} />
    <script is:inline>
      // Runs before paint to avoid a flash of the wrong theme.
      (function () {
        try {
          const stored = window.localStorage.getItem('duklu-theme');
          if (stored === 'light' || stored === 'dark') {
            document.documentElement.setAttribute('data-theme', stored);
          }
        } catch {
          // localStorage unavailable — prefers-color-scheme in CSS still applies
        }
      })();
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to main content
    </a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
