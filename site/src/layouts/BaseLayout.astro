---
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  /** Set to false on utility pages (currently just the 404) to add noindex. */
  index?: boolean;
  /** Emit the ProfessionalService JSON-LD. The homepage sets this to true. */
  structuredData?: boolean;
}

const { title, description, index = true, structuredData = false } = Astro.props;
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="generator" content={Astro.generator} />
    <Seo title={title} description={description} index={index} structuredData={structuredData} />
    <meta name="theme-color" content="#050810" />
    <link rel="preload" href={interLatin} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to main content
    </a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
  </body>
</html>
