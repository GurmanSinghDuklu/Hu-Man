---
import '../styles/base.css';
import Seo from '../components/Seo.astro';
import { withBase } from '../config/paths';
import { pages, type PageKey } from '../data/pages';
import montserrat800 from '../fonts/montserrat-latin-800-normal.woff2?url';
import archivo400 from '../fonts/archivo-latin-400-normal.woff2?url';

interface Props {
  /** The page's key in src/data/pages.ts: its title, description and schema all come from there. */
  page: PageKey;
}

const { page } = Astro.props;
const { title, description } = pages[page];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={withBase('/favicon-96.png')} type="image/png" sizes="96x96" />
    <meta name="generator" content={Astro.generator} />
    <Seo page={page} />
    <meta name="theme-color" content="#F1F2EC" />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
    <link rel="preload" href={montserrat800} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={archivo400} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a href="#main" class="skip-link">
      Skip to main content
    </a>
    <slot name="header" />
    <main id="main">
      <slot />
    </main>
    <slot name="footer" />
    <script>
      import '../scripts/motion.ts';
    </script>
  </body>
</html>
